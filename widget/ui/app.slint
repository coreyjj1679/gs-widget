                                    key: fact.key;
                                    icon: fact.icon;
                                    has-icon: fact.has-icon;
                                    selected: root.task-picked(i);
                                    line-height: root.quest-fact-row;
                                    last: i + 1 == root.facts.length;
                                    open => {
                                        if (fact.key != "") {
                                            root.open-hit(fact.key);
                                        }
                                    }
                                }
                            }
                        }
                    }
                    if root.quest-has-reward: Text {
                        x: root.side-gap;
                        y: root.quest-reward-y;
                        text: root.lang == "en-zh" ? "Reward" : "獎勵";
                        font-size: 12px;
                        color: #a3988c;
                    }
                    if root.quest-has-reward: Rectangle {
                        x: root.side-gap;
                        y: root.quest-scalar-y;
                        width: max(parent.width - 2 * root.side-gap, 80px);
                        height: root.quest-scalar-h;
                        background: #1c1916;
                        border-radius: 10px;
                        border-width: 1px;
                        border-color: #3a342c;
                        reward-box := Flickable {
                            width: 100%;
                            height: 100%;
                            content-width: self.width;
