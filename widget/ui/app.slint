                        y: 54px;
                        width: max(root.pane-w - 2 * root.page-pad, 40px);
                        height: max(parent.height - 70px, 80px);
                        background: DesktopTheme.surface;
                        border-radius: 10px;
                        border-width: 1px;
                        border-color: DesktopTheme.border;
                        note := TextEdit {
                            x: 16px;
                            y: 14px;
                            width: parent.width - 32px;
                            height: parent.height - 28px;
                            text: root.detail;
                            read-only: true;
                            wrap: word-wrap;
                            font-size: 15px;
                            init => { self.focus(); }
                        }
                    }
                }
            }
            Rectangle {
                height: root.foot;
                Rectangle {
                    y: 0px;
                    height: 1px;
                    background: #3a342c88;
                }
                Text {
                    width: 100%;
                    height: 100%;
                    text: (root.lang == "en-zh" ? "Client  " : "對應版本  ") + root.client-version;
                    font-size: 11px;
                    color: DesktopTheme.secondary;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                }
            }
            }
        }
    }

        if root.settings-open && !root.collapsed: Rectangle {
            x: root.full-mode ? root.nav-w : 0px;
