                                    if root.fold-row(fact.key): SectionToggle {
                                        width: parent.width;
                                        label: fact.label;
                                        open: root.fold-open(fact.key);
                                        picked: (fact.key == "fold:item" && root.fold-focus == 0) || (fact.key == "fold:set" && root.fold-focus == 1) || (fact.key == "fold:total" && root.fold-focus == 2);
                                        clicked => {
                                            root.focus-fold(fact.key);
                                            root.toggle-fold(fact.key);
                                            keys.focus();
                                        }
                                    }
                                    if !root.fold-row(fact.key) && root.section-open(fact.section): FactLine {
