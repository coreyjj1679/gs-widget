                        horizontal-alignment: center;
                        overflow: elide;
                    }
                    if root.quest-sheet && root.sheet-note != "": note-scroll := Flickable {
                        x: root.side-gap;
                        y: root.quest-note-y;
                        width: max(parent.width - 2 * root.side-gap, 40px);
