                                if root.expanded != "" && root.board-monsters.length == 0: Text {
                                    x: 20px; y: 28px; width: parent.width - 40px;
                                    text: root.expanded == "saved:" ? (UiLanguage.tr("Star a monster to add it to your favourites.", "在怪物旁點星號，就能加入收藏。")) : (UiLanguage.tr("No matches. Try clearing your filters.", "沒有符合的怪物，試試清除篩選條件。") );
                                    wrap: word-wrap; color: DesktopTheme.secondary; font-size: 13px;
