                        legacy: root.legacy-mode;
                        battle: root.battle-view;
                        motion: root.animate-battle;
                        toggle => {
                            root.monster-page-settings-open = !root.monster-page-settings-open;
                            if (root.monster-page-settings-open) {
                                root.legacy-nav-open = false;
                                root.filter-drop-open = false;
                            }
                            keys.focus();
                        }
                        dismiss => { root.monster-page-settings-open = false; keys.focus(); }
                        choose-legacy(on) => { root.choose-legacy(on); }
                        choose-battle(on) => { root.choose-battle(on); }
                        choose-animate(on) => { root.choose-animate(on); }
                    }
                }
            }
            Rectangle {
                height: root.foot;
                Rectangle {
                    y: 0px;
                    height: 1px;
                    background: DesktopTheme.border;
                }
                HorizontalLayout {
                    width: 100%;
                    y: parent.height - 26px;
                    height: 26px;
                    alignment: center;
                    spacing: 8px;
                    Text {
                        text: root.calculator-export-busy ? (UiLanguage.primary == "ko" ? "이미지 내보내는 중…" : UiLanguage.tr("Exporting image…", "正在匯出圖片…")) : (UiLanguage.tr("Client  ", "對應版本  ")) + root.client-version;
                        font-size: 11px;
                        color: DesktopTheme.secondary;
                        vertical-alignment: center;
                    }
                    Text {
                        text: "·";
                        font-size: 11px;
                        color: DesktopTheme.muted;
                        vertical-alignment: center;
                    }
                    OpenSourceLink {
                        english: UiLanguage.primary == "en";
                        clicked => { root.open-source(); }
                    }
                }
            }
            }
        }
    }

        if root.settings-open && !root.collapsed: Rectangle {
            x: root.full-mode ? root.nav-w : 0px;
            y: 42px;
            width: root.full-mode ? root.pane-w : parent.width;
            height: parent.height - 42px - root.foot;
            background: DesktopTheme.inset;
            if !root.full-mode: WinButton {
                x: 14px;
                y: 14px;
                glyph: "←";
                clicked => { root.close-settings(); }
            }
            if !root.full-mode: Text {
                x: 52px;
                y: 16px;
                text: UiLanguage.tr("Settings", "設定");
                font-size: 16px;
                font-weight: 600;
                color: DesktopTheme.text;
            }
            if root.full-mode: Text {
                x: 24px;
                y: 16px;
                text: UiLanguage.tr("Settings", "設定");
                font-size: 21px;
                font-weight: 600;
                color: DesktopTheme.text;
            }
            Rectangle {
                x: root.full-mode ? 24px : 16px;
                y: 52px;
                width: root.full-mode ? parent.width - 48px : min(parent.width - 32px, 300px);
                height: 32px;
                border-radius: 8px;
                clip: true;
                background: DesktopTheme.inset;
                border-width: 1px;
                border-color: DesktopTheme.border;
                HorizontalLayout {
                    spacing: 1px;
                    settings-tab-0 := PatchTab {
                        label: UiLanguage.tr("Look", "外觀");
                        active: root.settings-tab == 0;
                        tab-stop: self.active;
                        arrow-navigation: true;
                        init => { if (self.active) { self.focus(); } }
                        changed active => { if (self.active) { self.focus(); } }
                        clicked => { root.select-settings(0); self.focus(); }
                        navigate(delta) => { root.navigate-settings(delta); }
                    }
                    settings-tab-1 := PatchTab {
                        label: UiLanguage.tr("Bar", "浮動列");
                        active: root.settings-tab == 1;
                        tab-stop: self.active;
                        arrow-navigation: true;
                        init => { if (self.active) { self.focus(); } }
                        changed active => { if (self.active) { self.focus(); } }
                        clicked => { root.select-settings(1); self.focus(); }
                        navigate(delta) => { root.navigate-settings(delta); }
                    }
                    settings-tab-2 := PatchTab {
                        label: UiLanguage.tr("Aliases", "別名");
                        active: root.settings-tab == 2;
                        tab-stop: self.active;
                        arrow-navigation: true;
                        init => { if (self.active) { self.focus(); } }
                        changed active => { if (self.active) { self.focus(); } }
                        clicked => { root.select-settings(2); self.focus(); }
                        navigate(delta) => { root.navigate-settings(delta); }
                    }
                    if !root.full-mode: settings-tab-3 := PatchTab {
                        label: UiLanguage.tr("Keys", "快捷鍵");
                        active: root.settings-tab == 3;
                        tab-stop: self.active;
                        arrow-navigation: true;
                        init => { if (self.active) { self.focus(); } }
                        changed active => { if (self.active) { self.focus(); } }
                        clicked => { root.select-settings(3); self.focus(); }
                        navigate(delta) => { root.navigate-settings(delta); }
                    }
                    settings-tab-4 := PatchTab {
                        label: UiLanguage.tr("App", "程式");
                        active: root.settings-tab == 4;
                        tab-stop: self.active;
                        arrow-navigation: true;
                        init => { if (self.active) { self.focus(); } }
                        changed active => { if (self.active) { self.focus(); } }
                        clicked => { root.select-settings(4); self.focus(); }
                        navigate(delta) => { root.navigate-settings(delta); }
                    }
                }
            }

            settings-sheet := Flickable {
                interactive: !root.dock-sort-dragging;
                // Wheel and keyboard scroll the Bar; dragging its rows sorts them.
                mouse-drag-pan-enabled: root.settings-tab != 1;
                x: 0px;
                y: 96px;
                width: parent.width;
                height: parent.height - 96px;
                content-width: self.width;
                content-height: settings-body.height;
                content-y <=> root.settings-scroll-y;
                changed content-height => { root.settings-scroll-span = max(self.content-height - self.height, 0px); }
                changed height => { root.settings-scroll-span = max(self.content-height - self.height, 0px); }
                settings-body := Rectangle {
                    width: parent.width;
                    height: inner.preferred-height;
                    inner := VerticalLayout {
                width: parent.width;
                padding: root.full-mode ? 24px : 16px;
                padding-bottom: 24px;
                spacing: 16px;
                alignment: start;
                if root.settings-tab == 1: bar-layout := Rectangle {
                    property <bool> split: root.full-mode && self.width >= 720px;
                    property <length> column-w: self.split ? min(280px, self.width * 0.34) : self.width;
                    height: self.split ? max(bar-left.preferred-height, bar-right.preferred-height) : bar-left.preferred-height + 24px + bar-right.preferred-height;
                    bar-left := VerticalLayout {
                        x: 0px; y: 0px; width: parent.column-w; height: self.preferred-height;
                        spacing: 16px; alignment: start;
                        Text {
                            text: UiLanguage.tr("Direction", "方向");
                            font-size: 12px;
                            color: DesktopTheme.secondary;
                        }
                        ChoiceBar {
                            label: UiLanguage.tr("Direction", "方向");
                            focus-changed(focused) => { if (focused) { root.reveal-setting(self.focus-y, self.height); } }
                            first: UiLanguage.tr("Row", "橫向");
                            second: UiLanguage.tr("Column", "直向");
                            picked: root.dock-vertical ? 1 : 0;
                            pick(index) => {
                                root.dock-vertical = index == 1;
                                root.publish-dock();
                            }
                        }

                        Text {
                            text: UiLanguage.tr("Drag to reorder, or focus a row and press Alt+↑/↓. Space shows or hides it.", "拖曳可排序；鍵盤選中後按 Alt+↑/↓ 調整，空白鍵切換顯示。");
                            font-size: 13px;
                            color: DesktopTheme.muted;
                            wrap: word-wrap;
                        }
                    }
                    bar-right := VerticalLayout {
                        x: parent.split ? parent.column-w + 24px : 0px;
                        y: parent.split ? 0px : bar-left.preferred-height + 24px;
                        width: parent.width - self.x; height: self.preferred-height;
                        spacing: 16px; alignment: start;
                        order-list := Rectangle {
                            height: root.dock-draft.length * 48px;
                            property <int> from-row: -1;
                            property <int> over-row: -1;
                            property <length> grab: 0px;
                            property <length> nudge: 0px;
                            for slot[i] in root.dock-draft: DockSortRow {
                                x: order-list.from-row == i ? 8px : 0px;
                                y: order-list.from-row == i ? max(0px, i * 48px + order-list.nudge) : i * 48px;
                                width: order-list.from-row == i ? parent.width - 8px : parent.width;
                                horizontal-stretch: 1;
                                label: root.category-short(slot);
                                logo: root.category-logo(slot);
                                glyph: root.category-glyph(slot);
                                badge: root.dock-on(slot) ? ("F" + root.visible-index(slot)) : "–";
                                on: root.dock-on(slot);
                                lifted: order-list.from-row == i;
                                marked: order-list.over-row == i && order-list.from-row != i;
                                english: UiLanguage.primary == "en";
                                focus-requested: root.dock-focus-slot == slot;
                                focus-changed(focused) => {
                                    if (focused) { root.dock-focus-slot = slot; root.reveal-setting(self.focus-y, self.height); }
                                }
                                move-step(delta) => {
                                    root.dock-focus-slot = slot;
                                    root.dock-moved(i, clamp(i + delta, 0, root.dock-draft.length - 1));
                                }
                                toggled => { root.dock-focus-slot = slot; root.toggle-dock(slot); }
                                grip-pressed(py) => {
                                    root.dock-sort-dragging = true;
                                    order-list.from-row = i;
                                    order-list.over-row = i;
                                    order-list.grab = py;
                                    order-list.nudge = 0px;
                                }
                                grip-moved(py) => {
                                    order-list.nudge = py - order-list.grab;
                                    let row = round((i * 48px + order-list.nudge) / 48px - 0.5);
                                    if (row < 0) {
                                        order-list.over-row = 0;
                                    } else if (row >= root.dock-draft.length) {
                                        order-list.over-row = root.dock-draft.length - 1;
                                    } else {
                                        order-list.over-row = row;
                                    }
                                }
                                grip-released => {
                                    root.dock-sort-dragging = false;
                                    if (order-list.from-row >= 0 && order-list.over-row >= 0 && order-list.from-row != order-list.over-row) {
                                        root.dock-moved(order-list.from-row, order-list.over-row);
                                    }
                                    order-list.from-row = -1;
                                    order-list.over-row = -1;
                                    order-list.nudge = 0px;
                                }
                                grip-cancelled => {
                                    root.dock-sort-dragging = false;
                                    order-list.from-row = -1;
                                    order-list.over-row = -1;
                                    order-list.nudge = 0px;
                                }
                            }
                        }
                    }
                }
                if root.settings-tab == 4: app-layout := Rectangle {
                    property <bool> split: root.full-mode && self.width >= 720px;
                    property <length> column-w: self.split ? max(260px, self.width * 0.32) : self.width;
                    height: self.split ? max(app-left.preferred-height, app-right.preferred-height) : app-left.preferred-height + (root.full-mode ? 24px : 16px) + app-right.preferred-height;
                    app-left := VerticalLayout {
                        x: 0px; y: 0px; width: parent.column-w; height: self.preferred-height;
                        spacing: 16px; alignment: start;
                        Text {
                            text: UiLanguage.tr("App updates", "程式更新");
                            font-size: 18px;
                            font-weight: 600;
                            color: DesktopTheme.text;
                        }
                        Text {
                            text: "Gersang v" + root.app-version;
                            font-size: 14px;
                            color: DesktopTheme.text;
                        }
                        Text {
                            text: (UiLanguage.tr("Game data: ", "遊戲資料版本：")) + root.client-version;
                            font-size: 12px;
                            color: DesktopTheme.secondary;
                        }
                        Text {
                            text: root.update-status;
                            font-size: 14px;
                            color: DesktopTheme.text;
                            wrap: word-wrap;
                        }
                        if root.update-state == 4: Rectangle {
                            height: 4px;
                            background: DesktopTheme.border;
                            Rectangle {
                                width: parent.width * root.update-progress / 100;
                                height: parent.height;
                                background: DesktopTheme.accent;
                            }
                        }
                        if root.update-error != "": Text {
                            text: root.update-error;
                            color: DesktopTheme.secondary;
                            font-size: 12px;
                            wrap: word-wrap;
                        }
                        if root.updates-supported: Button {
                            text: root.update-busy ? (UiLanguage.tr("Please wait…", "請稍候…")) : root.update-action;
                            enabled: !root.update-busy;
                            min-height: 36px;
                            clicked => { root.request-update(); }
                        }
                        if root.updates-supported: Text {
                            text: UiLanguage.tr("Your favourites, aliases and settings are kept when you update. You can keep browsing while the download runs.", "更新會保留收藏、別名和設定。下載期間可繼續使用圖鑑。");
                            font-size: 12px;
                            color: DesktopTheme.secondary;
                            wrap: word-wrap;
                        }
                    }
                    app-right := VerticalLayout {
                        x: parent.split ? parent.column-w + 24px : 0px;
                        y: parent.split ? 0px : app-left.preferred-height + (root.full-mode ? 24px : 16px);
                        width: parent.width - self.x; height: self.preferred-height;
                        spacing: 16px; alignment: start;
                        ChangelogHistory {
                            releases: root.changelog-releases;
                            installed-version: root.app-version;
                            english: UiLanguage.primary == "en";
                        }
                    }
                }
                if root.settings-tab == 0 && root.full-mode: look-layout := Rectangle {
                    property <bool> split: root.full-mode && self.width >= 720px;
                    property <length> column-w: self.split ? (self.width - 24px) / 2 : self.width;
                    height: self.split ? max(look-left.preferred-height, look-right.preferred-height) : look-left.preferred-height + 24px + look-right.preferred-height;
                    look-left := VerticalLayout {
                        x: 0px; y: 0px; width: parent.column-w; height: self.preferred-height;
                        spacing: 16px; alignment: start;
                        FormBlock {
                            title: UiLanguage.tr("Window", "視窗");
                            HorizontalLayout {
                                alignment: space-between;
                                Text {
                                    text: UiLanguage.tr("Opacity", "透明度");
                                    font-size: 13px;
                                    color: DesktopTheme.text;
                                    vertical-alignment: center;
                                }
                                Text {
                                    text: root.opacity-percent + "%";
                                    font-size: 13px;
                                    color: DesktopTheme.accent;
                                    vertical-alignment: center;
                                }
                            }
                            OpacitySlider {
                                label: UiLanguage.tr("Opacity", "透明度");
                                focus-changed(focused) => { if (focused) { root.reveal-setting(self.focus-y, self.height); } }
                                value: root.window-opacity;
                                edited(value) => {
                                    root.window-opacity = value;
                                    root.opacity-changed(value);
                                }
                            }
                            Text {
                                text: UiLanguage.tr("Stay on top", "置頂");
                                font-size: 13px;
                                color: DesktopTheme.secondary;
                            }
                            ChoiceBar {
                                label: UiLanguage.tr("Stay on top", "置頂");
                                focus-changed(focused) => { if (focused) { root.reveal-setting(self.focus-y, self.height); } }
                                first: UiLanguage.tr("Follow", "跟隨");
                                second: UiLanguage.tr("Always", "置頂");
                                third: UiLanguage.tr("Never", "不置頂");
                                picked: root.pin-top;
                                pick(index) => { root.choose-pin(index); }
                            }
                            Text {
                                text: UiLanguage.tr("Follow keeps only the small window above other programs.", "跟隨時，只有小窗會留在其他程式前面。");
                                font-size: 12px;
                                color: DesktopTheme.muted;
                                wrap: word-wrap;
                            }
                        }
                        FormBlock {
                            title: UiLanguage.tr("Widget monster layout", "小窗怪物排列");
                            ChoiceBar {
                                label: UiLanguage.tr("Monster layout", "小窗排列");
                                focus-changed(focused) => { if (focused) { root.reveal-setting(self.focus-y, self.height); } }
                                first: UiLanguage.tr("List", "清單");
                                second: UiLanguage.tr("Gallery", "圖鑑");
                                picked: root.monster-gallery ? 1 : 0;
                                pick(index) => { root.choose-gallery(index == 1); }
                            }
                            Text {
                                text: UiLanguage.tr("List and gallery only change the small window.", "清單和圖鑑只影響小窗。");
                                font-size: 12px;
                                color: DesktopTheme.muted;
                                wrap: word-wrap;
                            }
                        }
                    }
                    look-right := VerticalLayout {
                        x: parent.split ? parent.column-w + 24px : 0px;
                        y: parent.split ? 0px : look-left.preferred-height + 24px;
                        width: parent.width - self.x; height: self.preferred-height;
                        spacing: 16px; alignment: start;
                        FormBlock {
                            title: UiLanguage.tr("Languages", "語言");
                            LanguageSettings {
                                primary: root.primary-language; secondary: root.secondary-language;
                                primary-changed(code) => { root.primary-language-changed(code); }
                                secondary-changed(code) => { root.secondary-language-changed(code); }
                                reveal(y, height) => { root.reveal-setting(y, height); }
                            }
                        }
                        FormBlock {
                            title: UiLanguage.tr("Icons", "圖示");
                            ChoiceBar {
                                label: UiLanguage.tr("Icon size", "圖示大小");
                                focus-changed(focused) => { if (focused) { root.reveal-setting(self.focus-y, self.height); } }
                                first: UiLanguage.tr("Small", "小");
                                second: UiLanguage.tr("Medium", "中");
                                third: UiLanguage.tr("Large", "大");
                                picked: root.icon-size;
                                pick(index) => {
                                    root.icon-size = index;
                                    root.icon-size-set(index);
                                }
                            }
                        }
                        FormBlock {
                            title: UiLanguage.tr("Sets", "套裝");
                            ChoiceBar {
                                label: UiLanguage.tr("Set pieces", "套裝部件");
                                focus-changed(focused) => { if (focused) { root.reveal-setting(self.focus-y, self.height); } }
                                first: UiLanguage.tr("Hide extras", "隱藏期限");
                                second: UiLanguage.tr("Show extras", "顯示期限");
                                picked: root.show-set-extra ? 1 : 0;
                                pick(index) => {
                                    root.show-set-extra = index == 1;
                                    root.show-set-extra-changed(root.show-set-extra);
                                }
                            }
                            Text {
                                text: UiLanguage.tr("Extras are the timed and event copies.", "期限和活動版可以一起隱藏。");
                                font-size: 12px;
                                color: DesktopTheme.muted;
                                wrap: word-wrap;
                            }
                        }
                    }
                }
                if root.settings-tab == 0 && !root.full-mode: HorizontalLayout {
                    alignment: space-between;
                    Text {
                        text: UiLanguage.tr("Opacity", "透明度");
                        font-size: 11px;
                        color: DesktopTheme.secondary;
                        vertical-alignment: center;
                    }
                    Text {
                        text: root.opacity-percent + "%";
                        font-size: 12px;
                        font-weight: 600;
                        color: DesktopTheme.accent;
                        vertical-alignment: center;
                    }
                }
                if root.settings-tab == 0 && !root.full-mode: OpacitySlider {
                    label: UiLanguage.tr("Opacity", "透明度");
                    focus-changed(focused) => { if (focused) { root.reveal-setting(self.focus-y, self.height); } }
                    value: root.window-opacity;
                    edited(value) => {
                        root.window-opacity = value;
                        root.opacity-changed(value);
                    }
                }
                if root.settings-tab == 0 && !root.full-mode: LanguageSettings {
                    primary: root.primary-language; secondary: root.secondary-language;
                    primary-changed(code) => { root.primary-language-changed(code); }
                    secondary-changed(code) => { root.secondary-language-changed(code); }
                    reveal(y, height) => { root.reveal-setting(y, height); }
                }
                if root.settings-tab == 0 && !root.full-mode: Text {
                    text: UiLanguage.tr("Set pieces", "套裝部件");
                    font-size: 11px;
                    color: DesktopTheme.secondary;
                }
                if root.settings-tab == 0 && !root.full-mode: HorizontalLayout {
                    spacing: 6px;
                    LangChip {
                        label: UiLanguage.tr("Timed and event", "期限與活動");
                        checkable: true;
                        focus-changed(focused) => { if (focused) { root.reveal-setting(self.focus-y, self.height); } }
                        active: root.show-set-extra;
                        clicked => {
                            root.show-set-extra = !root.show-set-extra;
                            root.show-set-extra-changed(root.show-set-extra);
                        }
                    }
                }
                if root.settings-tab == 0 && !root.full-mode: Text {
                    text: UiLanguage.tr("Off hides timed and event copies.", "關閉時不顯示期限和活動版。");
                    font-size: 11px;
                    color: DesktopTheme.muted;
                    wrap: word-wrap;
                }
                if root.settings-tab == 0 && !root.full-mode: Text {
                    text: UiLanguage.tr("Icon size", "圖示大小");
                    font-size: 11px;
                    color: DesktopTheme.secondary;
                }
                if root.settings-tab == 0 && !root.full-mode: ChoiceBar {
                    focus-changed(focused) => { if (focused) { root.reveal-setting(self.focus-y, self.height); } }
                    label: UiLanguage.tr("Icon size", "圖示大小");
                    first: UiLanguage.tr("Small", "小");
                    second: UiLanguage.tr("Medium", "中");
                    third: UiLanguage.tr("Large", "大");
                    picked: root.icon-size;
                    pick(index) => { root.icon-size = index; root.icon-size-set(index); }
                }
                if root.settings-tab == 0 && !root.full-mode: Text {
                    text: UiLanguage.tr("Stay on top", "置頂");
                    font-size: 11px;
                    color: DesktopTheme.secondary;
                }
                if root.settings-tab == 0 && !root.full-mode: ChoiceBar {
                    focus-changed(focused) => { if (focused) { root.reveal-setting(self.focus-y, self.height); } }
                    label: UiLanguage.tr("Stay on top", "置頂");
                    first: UiLanguage.tr("Follow", "跟隨");
                    second: UiLanguage.tr("Always", "置頂");
                    third: UiLanguage.tr("Never", "不置頂");
                    picked: root.pin-top;
                    pick(index) => { root.choose-pin(index); }
                }
                if root.settings-tab == 0 && !root.full-mode: Text {
                    text: UiLanguage.tr("Follow keeps only the small window on top.", "跟隨時，只有小窗會留在最前面。");
                    font-size: 11px;
                    color: DesktopTheme.muted;
                    wrap: word-wrap;
                }
                if root.settings-tab == 0 && !root.full-mode: Text {
                    text: UiLanguage.tr("Monster picture", "怪物圖");
                    font-size: 11px;
                    color: DesktopTheme.secondary;
                }
                if root.settings-tab == 0 && !root.full-mode: ChoiceBar {
                    focus-changed(focused) => { if (focused) { root.reveal-setting(self.focus-y, self.height); } }
                    label: UiLanguage.tr("Monster picture", "怪物圖");
                    first: UiLanguage.tr("Face", "頭像");
                    second: UiLanguage.tr("Battle", "戰鬥");
                    picked: root.battle-view ? 1 : 0;
                    pick(index) => { root.choose-battle(index == 1); }
                }
                if root.settings-tab == 0 && !root.full-mode: Text {
                    text: UiLanguage.tr("Battle motion", "戰鬥動畫");
                    font-size: 11px;
                    color: DesktopTheme.secondary;
                }
                if root.settings-tab == 0 && !root.full-mode: ChoiceBar {
                    focus-changed(focused) => { if (focused) { root.reveal-setting(self.focus-y, self.height); } }
                    label: UiLanguage.tr("Battle motion", "戰鬥動畫");
                    first: UiLanguage.tr("Play", "播放");
                    second: UiLanguage.tr("Still", "靜止");
                    picked: root.animate-battle ? 0 : 1;
                    pick(index) => { root.choose-animate(index == 0); }
                }
                if root.settings-tab == 0 && !root.full-mode: Text {
                    text: UiLanguage.tr("Monster layout", "小窗排列");
                    font-size: 11px;
                    color: DesktopTheme.secondary;
                }
                if root.settings-tab == 0 && !root.full-mode: ChoiceBar {
                    focus-changed(focused) => { if (focused) { root.reveal-setting(self.focus-y, self.height); } }
                    label: UiLanguage.tr("Monster layout", "小窗排列");
                    first: UiLanguage.tr("List", "清單");
                    second: UiLanguage.tr("Gallery", "圖鑑");
                    picked: root.monster-gallery ? 1 : 0;
                    pick(index) => { root.choose-gallery(index == 1); }
                }
                if root.settings-tab == 2: Text {
                    text: UiLanguage.tr("Search aliases", "搜尋別名");
                    font-size: 11px;
                    color: DesktopTheme.secondary;
                }
                if root.settings-tab == 2: Text {
                    text: UiLanguage.tr("One line per alias. Edit a row to search and add items.", "一行一個別名。點該列的編輯，再用右邊搜尋加入道具。");
                    font-size: 11px;
                    color: DesktopTheme.muted;
                    wrap: word-wrap;
                }
                if root.settings-tab == 2: VerticalLayout {
                    spacing: 6px;
                    for row[i] in root.alias-rows: AliasCard {
                        full-mode: root.full-mode;
                        reveal-focus(y, height) => { root.reveal-setting(y, height); }
                        name: row.name;
                        codes: row.codes;
                        detail: row.detail;
                        count: row.count;
                        editing: root.alias-edit == i;
                        edit-label: UiLanguage.tr("Edit", "編輯");
                        row-mark: "" + i;
                        icons: root.alias-icons;
                        find-hint: UiLanguage.tr("Search item", "搜尋道具");
                        save-label: UiLanguage.tr("Save", "儲存");
                        delete-label: UiLanguage.tr("Delete", "刪除");
                        suggesting: root.alias-edit == i && root.alias-target == i && root.alias-hits.length > 0;
                        hits: root.alias-hits;
                        pick: root.alias-pick;
                        name-edited(text) => { root.alias-name(i, text); }
                        codes-edited(text) => { root.alias-codes(i, text); }
                        remove => { root.alias-remove(i); }
                        begin-edit => { root.alias-edit = i; }
                        done => {
                            root.alias-edit = -1;
                            root.alias-hits = [];
                            root.alias-target = -1;
                        }
                        save => {
                            root.alias-name(i, self.name-draft);
                            root.alias-finish(i);
                            if (root.alias-save()) {
                                root.alias-edit = -1;
                                root.alias-hits = [];
                                root.alias-target = -1;
                            }
                        }
                        find-edited(text) => { root.alias-query(i, text); }
                        find-accepted => { root.alias-finish(i); }
                        toggle-hit(index) => { root.alias-toggle(index); }
                        drop-code(key) => { root.alias-drop(i, key); }
                    }
                }
                if root.settings-tab == 2 && root.alias-rows.length == 0 && root.alias-edit < 0: Text {
                    text: UiLanguage.tr("No aliases yet.", "還沒有別名。");
                    font-size: 12px;
                    color: DesktopTheme.muted;
                }
                if root.settings-tab == 2: HorizontalLayout {
                    spacing: 8px;
                    alignment: start;
                    Button {
                        changed has-focus => { if (self.has-focus) { root.reveal-setting(self.absolute-position.y, self.height); } }
                        horizontal-stretch: root.full-mode ? 0 : 1;
                        text: UiLanguage.tr("Add", "新增");
                        clicked => { root.alias-add(); }
                    }
                    Button {
                        changed has-focus => { if (self.has-focus) { root.reveal-setting(self.absolute-position.y, self.height); } }
                        horizontal-stretch: root.full-mode ? 0 : 1;
                        text: UiLanguage.tr("Save all", "全部儲存");
                        clicked => {
                            if (root.alias-edit >= 0) { root.alias-finish(root.alias-edit); }
                            if (root.alias-save()) {
                                root.alias-edit = -1;
                                root.alias-hits = [];
                                root.alias-target = -1;
                            }
                        }
                    }
                    Button {
                        changed has-focus => { if (self.has-focus) { root.reveal-setting(self.absolute-position.y, self.height); } }
                        horizontal-stretch: root.full-mode ? 0 : 1;
                        text: UiLanguage.tr("Discard", "取消修改");
                        clicked => {
                            root.alias-cancel();
                            root.alias-edit = -1;
                            root.alias-hits = [];
                            root.alias-target = -1;
                        }
                    }
                }
                if root.settings-tab == 3 && !root.full-mode: keys-layout := Rectangle {
                    property <bool> split: root.full-mode && self.width >= 720px;
                    property <length> column-w: self.split ? (self.width - 24px) / 2 : self.width;
                    height: self.split ? max(keys-left.preferred-height, keys-right.preferred-height) : keys-left.preferred-height + 16px + keys-right.preferred-height;
                    keys-left := VerticalLayout {
                        x: 0px; y: 0px; width: parent.column-w; height: self.preferred-height;
                        spacing: 16px; alignment: start;
                        Text {
                            text: UiLanguage.tr("Global keys", "全域快捷鍵");
                            font-size: 13px;
                            color: DesktopTheme.text;
                        }
                        ChoiceBar {
                            label: UiLanguage.tr("Global keys", "全域快捷鍵");
                            focus-changed(focused) => { if (focused) { root.reveal-setting(self.focus-y, self.height); } }
                            first: UiLanguage.tr("On", "開啟");
                            second: UiLanguage.tr("Off", "關閉");
                            picked: root.hotkeys-on ? 0 : 1;
                            pick(index) => { root.choose-hotkeys(index == 0); }
                        }

                        Text {
                            text: UiLanguage.tr("Off gives F1–F9 back to the game. Keys inside this window stay the same.", "關閉後，F1–F9 還給遊戲。這個視窗裡的按鍵不變。");
                            font-size: 12px;
                            color: DesktopTheme.muted;
                            wrap: word-wrap;
                        }
                        KeyLine {
                            wrap-action: root.full-mode;
                            keys: "F1–F9";
                            action: UiLanguage.tr("Open that bar item", "開啟浮動列對應項目");
                        }
                        KeyLine {
                            wrap-action: root.full-mode;
                            keys: "Ctrl+-";
                            action: UiLanguage.tr("Shrink to the bar. Press again to open the window", "把介面收成浮動列，再按一次展開");
                        }
                        Text {
                            text: UiLanguage.tr("While this window is open, F1–F9 open the bar.", "視窗開著時，F1–F9 用來開浮動列。");
                            font-size: 11px;
                            color: DesktopTheme.muted;
                            wrap: word-wrap;
                        }
                    }
                    keys-right := VerticalLayout {
                        x: parent.split ? parent.column-w + 24px : 0px;
                        y: parent.split ? 0px : keys-left.preferred-height + 16px;
                        width: parent.width - self.x; height: self.preferred-height;
                        spacing: 16px; alignment: start;
                        if root.full-mode: Text {
                            text: UiLanguage.tr("Inside this window", "視窗內操作");
                            font-size: 13px; font-weight: 600; color: DesktopTheme.text;
                        }
                        KeyLine {
                            wrap-action: root.full-mode;
                            keys: "Ctrl+F";
                            action: UiLanguage.tr("Search", "搜尋");
                        }
                        KeyLine {
                            wrap-action: root.full-mode;
                            keys: "Esc";
                            action: UiLanguage.tr("Back, or close search and settings", "返回，或關閉搜尋和設定");
                        }
                        KeyLine {
                            wrap-action: root.full-mode;
                            keys: "Backspace";
                            action: UiLanguage.tr("Back", "返回");
                        }
                        KeyLine {
                            wrap-action: root.full-mode;
                            keys: "Home";
                            action: UiLanguage.tr("Home page; in a text field, move to the start", "回主目錄；輸入框內則移至行首");
                        }
                        KeyLine {
                            wrap-action: root.full-mode;
                            keys: "↑  ↓";
                            action: UiLanguage.tr("Move in the list. On a set, move between Item, Set, and Total", "移動清單；套裝資料是在道具、套裝、合計之間");
                        }
                        KeyLine {
                            wrap-action: root.full-mode;
                            keys: "←  →";
                            action: UiLanguage.tr("Home grid, bar, scroll a set, or the previous and next quest", "主目錄、浮動列、套裝資料捲動，或任務的上一個和下一個");
                        }
                        KeyLine {
                            wrap-action: root.full-mode;
                            keys: "Enter";
                            action: UiLanguage.tr("Open. Expand a related heading, or save a monster", "開啟；相關分類是展開或收合，怪物是收藏");
                        }
                        KeyLine {
                            wrap-action: root.full-mode;
                            keys: "Space";
                            action: UiLanguage.tr("Open. Expand a heading or a set section", "開啟；相關分類和套裝分類是展開或收合");
                        }
                        KeyLine {
                            wrap-action: root.full-mode;
                            keys: "Tab";
                            action: UiLanguage.tr("Switch the page filter; in settings, move between controls", "切換本頁篩選；設定頁內移動控制焦點");
                        }
                        KeyLine {
                            wrap-action: root.full-mode;
                            keys: "Ctrl+Tab";
                            action: UiLanguage.tr("Next settings tab; add Shift for previous", "切換設定分頁；加 Shift 返回上一頁");
                        }
                        KeyLine {
                            wrap-action: root.full-mode;
                            keys: "Ctrl+I";
                            action: UiLanguage.tr("Show the focused row's full names and source; Esc closes", "查看所選列的完整名稱與來源；Esc 關閉");
                        }
                        KeyLine {
                            wrap-action: root.full-mode;
                            keys: "Ctrl+C";
                            action: UiLanguage.tr("Copy an update note", "複製更新內文");
                        }
                    }
                }
                }
                }
            }
        }

        if RecordInfo.text != "" && !root.settings-open && !root.collapsed && !root.calculator-open && !root.mcp-open: Rectangle {
            x: root.width - self.width - 16px;
            y: 58px;
            width: min(440px, root.pane-w - 32px);
            height: min(info-text.preferred-height + 64px, root.height - 116px);
            background: DesktopTheme.raised;
            border-radius: 8px;
            border-width: 1px;
            border-color: DesktopTheme.accent;
            Text {
                x: 14px; y: 12px; width: parent.width - 66px; height: 22px;
                text: UiLanguage.tr("Full names and source · Esc to close", "完整名稱與來源 · Esc 關閉");
                font-size: 12px; color: DesktopTheme.secondary;
            }
            WinButton {
                x: parent.width - 40px; y: 8px;
                glyph: "×";
                clicked => { RecordInfo.text = ""; }
            }
            Flickable {
                x: 14px; y: 44px; width: parent.width - 28px; height: parent.height - 58px;
                content-width: self.width;
                content-height: info-text.preferred-height;
                info-text := Text {
                    width: parent.width; height: self.preferred-height;
                    text: RecordInfo.text;
                    font-size: 14px; color: DesktopTheme.text;
                    wrap: word-wrap;
                    accessible-label: RecordInfo.text;
                }
            }
        }
    }
    if NameCopy.notice != "" && !root.collapsed: Rectangle {
        x: (root.full-mode ? root.nav-w : 0px) + (root.pane-w - self.width) / 2;
        y: root.height - root.foot - self.height - 12px;
        width: min(root.pane-w - 24px, 360px); height: 36px;
        background: DesktopTheme.raised; border-radius: 6px;
        border-width: 1px; border-color: DesktopTheme.border;
        Text {
            x: 12px; width: parent.width - 24px; height: 100%;
            text: NameCopy.notice; color: DesktopTheme.text; font-size: 13px;
            vertical-alignment: center; horizontal-alignment: center; overflow: elide;
        }
    }

    feedback-banner := FeedbackBanner {
        visible: root.feedback-message != "" && !root.collapsed;
        x: (root.full-mode ? root.nav-w : 0px) + 12px;
        y: root.height - 26px - self.height - 6px;
        width: max(root.pane-w - 24px, 120px);
        message: root.feedback-message;
        error: root.feedback-error;
        retry: root.feedback-retry;
        heading: root.feedback-error ? (UiLanguage.primary == "ko" ? "작업을 완료하지 못했습니다" : UiLanguage.tr("Action needed", "操作未完成")) : (UiLanguage.primary == "ko" ? "완료" : UiLanguage.tr("Done", "已完成"));
        retry-label: UiLanguage.primary == "ko" ? "다시 저장" : UiLanguage.tr("Retry saving", "重試儲存");
        dismiss-label: UiLanguage.primary == "ko" ? "닫기" : UiLanguage.tr("Dismiss", "關閉提示");
        retry-clicked => { root.retry-preferences(); }
        dismissed => { root.dismiss-feedback(); }
    }

}
