                        text: root.quest-sheet ? (UiLanguage.tr("No links", "沒有連結")) : root.viewing-npc ? (UiLanguage.tr("No quests", "沒有任務")) : root.recipe-sheet ? (UiLanguage.tr("No materials", "沒有材料")) : root.viewing-set ? (UiLanguage.tr("No pieces", "沒有部件")) : root.viewing-item ? (UiLanguage.tr("Nothing related", "沒有相關")) : (UiLanguage.tr("No monsters drop this", "沒有怪物掉落"));
                        font-size: 13px;
                        color: DesktopTheme.text;
                    }
                    if root.viewing != "" && !root.viewing-hero && !root.record-sheet && !root.quest-sheet && root.category != "patch" && root.viewing-no-image: NoImage {
                        x: 0px;
                        y: 48px;
                        side: 64px;
                        label: root.no-image-label;
                    }
                    if root.viewing != "" && !root.viewing-hero && root.category != "patch" && !root.monster-sheet && !root.record-sheet && !root.quest-sheet: stats := Flickable {
                        x: 0px;
                        y: 120px;
                        width: max(root.pane-w - 2 * root.page-pad, 80px);
                        height: root.links.length > 0 ? 112px : max(root.height - foot - 200px, 80px);
