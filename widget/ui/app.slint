                        background: #1c1916;
                        border-radius: 10px;
                        border-width: 1px;
                        border-color: #3a342c;
                        item-drops := Flickable {
                            width: 100%;
                            height: 100%;
                            content-width: self.width;
                            content-height: max(root.links.length * root.link-row, 1px);
                            content-y <=> root.drop-offset;
                            for row[i] in root.links: HitRow {
