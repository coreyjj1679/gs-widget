    in-out property <image> hero-logo;
    in-out property <bool> hero-logo-ready: false;
    in-out property <image> enchant-logo;

    title: UiLanguage.tr("Gersang", "巨商");
    no-frame: true;
    always-on-top: pin-top == 1 || (pin-top == 0 && !full-mode);
    icon: @image-url("app-icon.png");
    in property <string> ui-font: "Microsoft JhengHei UI";
    default-font-family: root.ui-font;
    default-font-size: 14px;
    default-font-weight: 400;
    background: transparent;
    preferred-width: 560px;
    preferred-height: 740px;
    resize-border-width: 6px;

    function open-category(id: string) {
        root.mcp-open = false;
        root.calculator-open = false;
        root.quest-map-open = false;
        root.category = id;
        root.nation = "";
        root.nation-name = "";
        root.area = "";
        root.area-name = "";
        root.place = "";
        root.place-name = "";
        root.viewing = "";
        root.query = "";
        root.search-open = false;
        root.favourites-only = false;
        root.ship = "";
        if (id == "quest") { root.quest-summary = true; root.quest-category = "qcat:all"; root.quest-grouping = ""; root.quest-group-query = ""; }
        root.query-changed(id, "");
    }

    function open-enchant() {
        if (root.settings-open) { root.close-settings(); }
        root.collapsed = false;
        root.open-category("enchant");
        keys.focus();
    }

    function choose-enchant-page(mode: string) {
        if (root.ship == mode && root.place == "" && root.query == "") { return; }
        root.ship = mode;
        root.place = ""; root.place-name = "";
        root.area = ""; root.area-name = "";
        root.query = ""; root.search-open = false;
        root.expanded = ""; root.catalog-category = "";
        root.detail-key = ""; root.detail-index = -1;
        root.cursor = 0; root.list-offset = 0px;
        root.query-changed("enchant", "");
    }

    function choose-quest-mode(summary: bool) {
        root.quest-summary = summary;
        root.quest-map-open = false;
        if (summary) { root.query = ""; root.quest-category = "qcat:all"; root.quest-grouping = ""; root.quest-group-query = ""; }
        root.query-changed("quest", root.query);
    }

    function quest-type-index() -> int {
        if (root.area == "0") { return 1; }
        if (root.area == "2") { return 2; }
        if (root.area == "5") { return 3; }
        if (root.area == "7") { return 4; }
        return 0;
    }

    function cycle-set-type(step: int) {
        if (!root.set-browser) {
            return;
        }
        if (root.area == "" || root.area == "0") {
            root.area = step > 0 ? "2" : "1";
        } else if (root.area == "2") {
            root.area = step > 0 ? "1" : "0";
        } else {
            root.area = step > 0 ? "0" : "2";
        }
        root.cursor = 0;
        root.list-offset = 0px;
        root.query-changed(root.category, root.query);
    }

    function cycle-quest-type(step: int) {
        if (root.category != "quest" || root.place != "main" || root.viewing != "") {
            return;
        }
        let index = root.quest-type-index();
        if (step > 0) {
            if (index == 0) { root.area = "0"; }
            else if (index == 1) { root.area = "2"; }
            else if (index == 2) { root.area = "5"; }
            else if (index == 3) { root.area = "7"; }
            else { root.area = ""; }
        } else if (index == 0) {
            root.area = "7";
        } else if (index == 1) {
            root.area = "";
        } else if (index == 2) {
            root.area = "0";
        } else if (index == 3) {
            root.area = "2";
        } else {
            root.area = "5";
        }
        root.query-changed(root.category, root.query);
    }

    function set-item-tab(mode: string) {
        if (!root.viewing-item) {
            return;
        }
        root.item-tab = mode;
        // Full mode shows both columns; Tab only changes keyboard focus.
        if (root.full-item-sheet) { return; }
        root.drop-offset = 0px;
        root.form-offset = 0px;
        root.cursor = 0;
    }

    function scroll-form(dir: int) {
        if (!root.viewing-item || root.item-links) {
            return;
        }
        let span = root.form-span;
        let next = root.form-offset - dir * 44px;
        if (next > 0px) {
            root.form-offset = 0px;
        } else if (next < -span) {
            root.form-offset = -span;
        } else {
            root.form-offset = next;
        }
    }

    function fold-row(key: string) -> bool {
        key == "fold:item" || key == "fold:set" || key == "fold:total"
    }

    function fold-open(key: string) -> bool {
        key == "fold:item" ? root.show-item-fx : key == "fold:set" ? root.show-set-fx : root.show-total-fx
    }

    function section-open(section: string) -> bool {
        section == "item" ? root.show-item-fx : section == "set" ? root.show-set-fx : section == "total" ? root.show-total-fx : true
    }

    function focus-fold(key: string) {
        if (root.full-item-sheet) { root.item-tab = ""; }
        if (key == "fold:item") {
            root.fold-focus = 0;
        } else if (key == "fold:set") {
            root.fold-focus = 1;
        } else if (key == "fold:total") {
            root.fold-focus = 2;
        }
    }

    function toggle-fold(key: string) {
        if (key == "fold:item") {
            root.show-item-fx = !root.show-item-fx;
        } else if (key == "fold:set") {
            root.show-set-fx = !root.show-set-fx;
        } else if (key == "fold:total") {
            root.show-total-fx = !root.show-total-fx;
        }
        root.reveal-fold();
    }

    function toggle-fold-focus() {
        if (root.fold-focus == 0 && root.has-item-fx) {
            root.show-item-fx = !root.show-item-fx;
        } else if (root.fold-focus == 1 && root.has-set-fx) {
            root.show-set-fx = !root.show-set-fx;
        } else if (root.fold-focus == 2 && root.has-total-fx) {
            root.show-total-fx = !root.show-total-fx;
        }
        root.reveal-fold();
    }

    function step-fold(delta: int) {
        if (delta > 0) {
            if (root.fold-focus <= 0 && root.has-set-fx) {
                root.fold-focus = 1;
            } else if (root.fold-focus <= 1 && root.has-total-fx) {
                root.fold-focus = 2;
            }
        } else if (root.fold-focus >= 2 && root.has-set-fx) {
            root.fold-focus = 1;
        } else if (root.fold-focus >= 1 && root.has-item-fx) {
            root.fold-focus = 0;
        }
        root.reveal-fold();
    }

    function reveal-fold() {
        if (!root.viewing-set || root.item-links) {
            return;
        }
        let y = root.fold-focus == 1 ? root.set-fold-y : root.fold-focus == 2 ? root.total-fold-y : root.item-fold-y;
        let view = root.item-form-h;
        if (view < 40px) {
            return;
        }
        let top = -root.form-offset;
        if (y < top + 4px) {
            root.form-offset = -max(y - 4px, 0px);
        } else if (y + 40px > top + view) {
            root.form-offset = -(y + 40px - view);
        }
        if (root.form-offset > 0px) {
            root.form-offset = 0px;
        }
    }

    function set-hero-group(mode: string) {
        if (root.category != "hero" || root.viewing != "") {
            return;
        }
        root.hero-group = mode;
        root.place = "";
        root.place-name = "";
        root.area = "";
        root.area-name = "";
        root.query = "";
        root.search-open = false;
        root.query-changed("hero", "");
    }

    function toggle-saved() {
        if (root.category != "monster") {
            return;
        }
        root.favourites-only = !root.favourites-only;
        root.query-changed(root.category, root.query);
    }

    function mark-favourite() {
        if (root.viewing-monster) {
            root.toggle-favourite(root.viewing);
            return;
        }
        if (root.viewing == "" && root.cursor >= 0 && root.cursor < root.hits.length && root.hits[root.cursor].can-favourite) {
            root.toggle-favourite(root.hits[root.cursor].key);
            return;
        }
        root.activate();
    }

    function close-settings() {
        root.dock-sort-dragging = false;
        if (root.dock-editing) {
            root.dock-order-cancel();
            root.dock-editing = false;
        }
        root.settings-open = false;
        keys.focus();
    }

    function select-settings(index: int) {
        let next = root.full-mode && index == 3 ? 0 : index;
        if (root.settings-tab == 2 && next != 2) {
            root.alias-edit = -1;
            root.alias-hits = [];
            root.alias-target = -1;
        }
        root.settings-tab = next;
        if (next == 2) { root.alias-refresh(); }
    }

    function cycle-settings(delta: int) {
        let next = mod(root.settings-tab + delta + 5, 5);
        root.select-settings(root.full-mode && next == 3 ? (delta > 0 ? 4 : 2) : next);
    }

    function navigate-settings(delta: int) {
        if (delta == -2) { root.select-settings(0); }
        else if (delta == 2) { root.select-settings(4); }
        else { root.cycle-settings(delta); }
    }

    function reveal-setting(y: length, height: length) {
        // The settings viewport begins below the 42px title bar and 96px header.
        let top = 138px;
        let bottom = top + root.settings-page-height;
        if (y < top + 8px) {
            root.settings-scroll-y = min(0px, root.settings-scroll-y + top + 8px - y);
        } else if (y + height > bottom - 8px) {
            root.settings-scroll-y = max(-root.settings-scroll-span, root.settings-scroll-y - (y + min(height, root.settings-page-height - 16px) - bottom + 8px));
        }
    }

    function go-home() {
        root.mcp-open = false;
        root.calculator-open = false;
        if (root.collapsed) {
            root.collapsed = false;
        }
        if (root.settings-open) {
            root.close-settings();
        }
        root.search-open = false;
        root.arranging = false;
        if (root.category == "" && root.viewing == "") {
            keys.focus();
            return;
        }
        root.category = "";
        root.nation = "";
        root.nation-name = "";
        root.area = "";
        root.area-name = "";
        root.place = "";
        root.place-name = "";
        root.viewing = "";
        root.viewing-monster = false;
        root.viewing-recipe = false;
        root.viewing-quest = false;
        root.viewing-npc = false;
        root.viewing-item = false;
        root.viewing-set = false;
        root.item-tab = "";
        root.viewing-favourite = false;
        root.query = "";
        root.detail = "";
        root.show-icon = false;
        root.show-battle = false;
        root.show-element = false;
        root.form-open = false;
        root.drops-open = false;
        root.related-open = false;
        root.went-home();
        keys.focus();
    }

    public function show-record-calculator(tab: int) {
        root.go-home();
        root.calculator-library-open = false;
        if (!root.full-mode) {
            root.full-mode = true;
            root.mode-changed(true);
        }
        root.calculator-tab = tab;
        root.calculator-open = true;
        root.calculator-refresh();
        keys.focus();
    }

    function choose-lang(code: string) {
        root.lang = code;
        root.lang-changed(code);
    }

    function choose-pin(mode: int) {
        root.pin-top = mode;
        root.pin-changed(mode);
    }

    function choose-battle(battle: bool) {
        if (root.battle-view == battle) {
            return;
        }
        root.battle-view = battle;
        root.battle-changed(battle);
    }

    function choose-gallery(on: bool) {
        if (root.monster-gallery == on) {
            return;
        }
        root.monster-gallery = on;
        root.gallery-changed(on);
        if (root.category == "monster" && root.viewing == "" && !root.full-mode) {
            root.list-offset = 0px;
            root.query-changed(root.category, root.query);
        }
    }

    function choose-animate(on: bool) {
        if (root.animate-battle == on) {
            return;
        }
        root.animate-battle = on;
        root.animate-changed(on);
    }

    function choose-hotkeys(on: bool) {
        if (root.hotkeys-on == on) {
            return;
        }
        root.hotkeys-on = on;
        root.hotkeys-changed(on);
    }

    function go-back() {
        if (root.quest-map-open && (root.quest-browser || root.quest-sheet)) { root.quest-map-open = false; return; }
        if (root.monster-page-settings-open) {
            root.monster-page-settings-open = false;
            return;
        }
        if (root.legacy-nav-open) {
            root.legacy-nav-open = false;
            return;
        }
        if (root.monster-board && root.legacy-mode && !root.menu-open) {
            root.menu-open = true;
            return;
        }
        if (root.viewing != "") {
            if (root.restore-view()) {
                return;
            }
            root.forget-view();
            root.viewing = "";
            root.viewing-monster = false;
            root.viewing-recipe = false;
            root.viewing-quest = false;
            root.viewing-npc = false;
            root.viewing-hero = false;
            root.viewing-item = false;
            root.viewing-set = false;
            root.item-tab = "";
            root.viewing-favourite = false;
            root.detail = "";
            root.show-icon = false;
            root.show-battle = false;
            root.show-element = false;
            if (root.full-board && root.catalog-category != root.category) {
                root.query-changed(root.category, root.query);
            }
            if (root.full-mode && (root.category != "monster" || !root.legacy-mode) && root.detail-key != "") {
                root.reload-inline-detail();
            }
        } else if (root.quest-browser && !root.quest-summary) {
            if (root.quest-grouping != "") { root.quest-groups-requested(root.quest-grouping, root.quest-group-query); }
            else { root.choose-quest-mode(true); }
        } else if (root.quest-browser && root.quest-grouping != "") {
            root.choose-quest-mode(true);
        } else if (root.category == "quest" && root.area != "") {
            root.search-open = false;
            root.area = "";
            root.query = "";
            root.detail = "";
            root.show-icon = false;
            root.show-element = false;
            root.query-changed("quest", "");
        } else if (root.category == "quest" && root.place != "") {
            root.search-open = false;
            root.place = "";
            root.place-name = "";
            root.area = "";
            root.query = "";
            root.detail = "";
            root.show-icon = false;
            root.show-element = false;
            root.query-changed("quest", "");
        } else if (root.category == "atlas" && root.area != "") {
            root.search-open = false;
            root.area = "";
            root.area-name = "";
            root.query = "";
            root.detail = "";
            root.show-icon = false;
            root.show-element = false;
            root.query-changed("atlas", "");
        } else if (root.category == "atlas" && root.place != "") {
            root.search-open = false;
            root.place = "";
            root.place-name = "";
            root.query = "";
            root.detail = "";
            root.show-icon = false;
            root.show-element = false;
            root.query-changed("atlas", "");
        } else if (root.category == "works" && root.area != "") {
            root.search-open = false;
            root.area = "";
            root.area-name = "";
            root.query = "";
            root.detail = "";
            root.show-icon = false;
            root.show-element = false;
            root.query-changed("works", "");
        } else if (root.category == "works" && root.place != "") {
            root.search-open = false;
            root.place = "";
            root.place-name = "";
            root.query = "";
            root.detail = "";
            root.show-icon = false;
            root.show-element = false;
            root.query-changed("works", "");
        } else if (root.category == "hero" && root.area != "") {
            root.search-open = false;
            root.area = "";
            root.area-name = "";
            root.query = "";
            root.detail = "";
            root.show-icon = false;
            root.show-element = false;
            root.query-changed("hero", "");
        } else if (root.category == "hero" && root.place != "") {
            root.search-open = false;
            root.place = "";
            root.place-name = "";
            root.query = "";
            root.detail = "";
            root.show-icon = false;
            root.show-element = false;
            root.query-changed("hero", "");
        } else if (root.category == "item" && root.area != "" && root.place != "set") {
            root.search-open = false;
            root.area = "";
            root.area-name = "";
            root.query = "";
            root.detail = "";
            root.show-icon = false;
            root.show-element = false;
            root.query-changed("item", "");
        } else if (root.category == "item" && root.place != "") {
            root.search-open = false;
            root.place = "";
            root.place-name = "";
            root.area = "";
            root.area-name = "";
            root.query = "";
            root.detail = "";
            root.show-icon = false;
            root.show-element = false;
            root.query-changed("item", "");
        } else if (root.category == "enchant" && root.place != "") {
            root.search-open = false;
            root.place = "";
            root.place-name = "";
            root.query = "";
            root.detail = "";
            root.show-icon = false;
            root.show-element = false;
            root.query-changed("enchant", "");
        } else if (root.category == "recipe" && root.place != "") {
            root.search-open = false;
            root.place = "";
            root.place-name = "";
            root.query = "";
            root.detail = "";
            root.show-icon = false;
            root.show-element = false;
            root.viewing-recipe = false;
            root.query-changed("recipe", "");
        } else if (root.category == "monster" && root.place != "") {
            root.search-open = false;
            root.place = "";
            root.place-name = "";
            root.query = "";
            root.detail = "";
            root.show-icon = false;
            root.show-element = false;
            root.query-changed("monster", "");
        } else if (root.category == "monster" && root.area != "") {
            root.search-open = false;
            root.area = "";
            root.area-name = "";
            root.query = "";
            root.detail = "";
            root.show-icon = false;
            root.show-element = false;
            root.query-changed("monster", "");
        } else if (root.category == "monster" && root.nation != "") {
            root.search-open = false;
            root.nation = "";
            root.nation-name = "";
            root.area = "";
            root.area-name = "";
            root.query = "";
            root.detail = "";
            root.show-icon = false;
            root.show-element = false;
            root.query-changed("monster", "");
        } else if (root.category != "") {
            root.search-open = false;
            root.category = "";
            root.nation = "";
            root.nation-name = "";
            root.area = "";
            root.area-name = "";
            root.place = "";
            root.place-name = "";
            root.viewing = "";
            root.query = "";
            root.detail = "";
            root.show-icon = false;
            root.show-element = false;
            root.went-home();
            keys.focus();
        }
    }

    function list-count() -> int {
        if (root.viewing == "") {
            return root.hits.length;
        }
        if (root.viewing-monster && root.related-open) {
            return root.related.length;
        }
        if (root.viewing != "" && root.viewing-monster && !root.drops-open) {
            return 0;
        }
        return root.links.length;
    }

    public function reveal-list(index: int) {
        if (root.hero-record-list) { return; }
        if (root.quest-browser) {
            if (root.quest-summary || root.quest-map-open) { return; }
            let row = index * 142px;
            let stride = 142px;
            let view = max(root.list-view - 60px, 1px);
            if (row < -root.list-offset) { root.list-offset = -row; }
            else if (row + stride > -root.list-offset + view) { root.list-offset = view - row - stride; }
            return;
        }
        if (root.hits.length == 0) {
            return;
        }
        if (root.monster-board && root.legacy-mode) {
            let row = root.flow-y[index] * 1px;
            let view = max(root.list-view - root.filter-h - 60px, 1px);
            if (row < -root.directory-offset) { root.directory-offset = -row; }
            else if (row + 32px > -root.directory-offset + view) { root.directory-offset = view - row - 32px; }
            root.directory-offset = clamp(root.directory-offset, min(0px, view - root.flow-h * 1px), 0px);
            return;
        }
        if (root.full-mode && root.legacy-mode && root.monster-cards) { return; }
        if (root.monster-board) {
            let row = index * 40px;
            let view = root.directory-view;
            let top = -root.directory-offset;
            if (row < top) {
                root.directory-offset = -row;
            } else if (row + 36px > top + view) {
                root.directory-offset = view - row - 36px;
            }
            root.directory-offset = clamp(root.directory-offset, min(0px, view - root.hits.length * 40px + 4px), 0px);
            return;
        }
        if (root.full-board) {
            // Enchant rows wrap their equipment icons. CatalogRow's init and
            // selection handlers reveal their actual slot instead of a fixed stride.
            if (root.category == "enchant" && root.catalog-result-list) { return; }
            let stride = root.catalog-result-list ? 60px : 50px;
            let row-height = stride - 2px;
            let row = index * stride;
            let view = max(root.list-view - (root.catalog-result-list ? 56px : 16px), 1px);
            let offset = root.catalog-result-list ? root.list-offset : root.directory-offset;
            let top = -offset;
            let next = row < top ? -row : row + row-height > top + view ? view - row - row-height : offset;
            let bounded = clamp(next, min(0px, view - root.hits.length * stride + 2px), 0px);
            if (root.catalog-result-list) {
                root.list-offset = bounded;
            } else {
                root.directory-offset = bounded;
            }
            return;
        }
        let columns = root.full-mode && root.monster-cards ? root.monster-list-columns : 1;
        let row = floor(index / columns) * root.list-row;
        let view = root.list-view;
        let top = -root.list-offset;
        if (row < top) {
            root.list-offset = -row;
        } else if (row + root.list-row > top + view) {
            root.list-offset = view - row - root.list-row;
        }
        let floor = min(0px, view - ceil(root.hits.length / columns) * root.list-row);
        if (root.list-offset < floor) {
            root.list-offset = floor;
        }
        if (root.list-offset > 0px) {
            root.list-offset = 0px;
        }
    }

    function reveal-drops(index: int) {
        if (root.viewing-hero) { return; }
        let related-list = root.viewing-monster && root.related-open;
        let count = related-list ? root.related.length : root.links.length;
        if (count == 0) {
            return;
        }
        let stride = related-list ? 52px : root.card-sheet ? root.link-row : 36px;
        let row = index * stride;
        let view = related-list ? root.related-list-h : root.monster-sheet ? root.drops-list-h : root.viewing-hero ? max(root.height - root.foot - 136px, 180px) : root.quest-sheet ? root.quest-scalar-h : root.card-sheet ? root.card-list-h : root.drops-view;
        let tail = root.quest-sheet ? root.reward-facts.length * 30px : 0px;
        let top = -root.drop-offset;
        if (row < top) {
            root.drop-offset = -row;
        } else if (row + stride > top + view) {
            root.drop-offset = view - row - stride;
        }
        let floor = min(0px, view - tail - count * stride);
        if (root.drop-offset < floor) {
            root.drop-offset = floor;
        }
        if (root.drop-offset > 0px) {
            root.drop-offset = 0px;
        }
    }

    function reveal-task(index: int) {
        if (root.facts.length == 0 || index < 0) {
            return;
        }
        let count = max(root.facts.length, 1);
        let body = max(root.quest-facts-body, count * root.quest-fact-row);
        let row-h = body / count;
        let row = index * row-h;
        let view = root.quest-form-h;
        let top = -root.task-offset;
        if (row < top) {
            root.task-offset = -row;
        } else if (row + row-h > top + view) {
            root.task-offset = view - row - row-h;
        }
        let floor = min(0px, view - body);
        if (root.task-offset < floor) {
            root.task-offset = floor;
        }
        if (root.task-offset > 0px) {
            root.task-offset = 0px;
        }
    }

    pure function task-picked(index: int) -> bool {
        if (root.task-focus < 0 || root.task-focus >= root.task-picks.length) {
            return false;
        }
        return root.task-picks[root.task-focus] == index;
    }

    function focus-task(index: int) {
        root.task-focus = index;
        root.next-focus = -1;
    }

    function focus-reward(index: int) {
        root.task-focus = -1;
        root.next-focus = -1;
        root.cursor = index;
        root.reveal-drops(index);
    }

    function move-quest(delta: int) {
        if (root.task-focus >= root.task-picks.length) {
            root.task-focus = -1;
        }
        if (root.task-focus >= 0) {
            if (delta < 0) {
                if (root.task-focus > 0) {
                    root.focus-task(root.task-focus - 1);
                }
                return;
            }
            if (root.task-focus + 1 < root.task-picks.length) {
                root.focus-task(root.task-focus + 1);
                return;
            }
            if (root.links.length > 0) {
                root.focus-reward(0);
                return;
            }
            if (root.chain-next.length > 1) {
                root.task-focus = -1;
                root.next-focus = 0;
                return;
            }
            return;
        }
        if (root.next-focus >= 0) {
            let next = root.next-focus + delta;
            if (next < 0) {
                root.next-focus = -1;
                if (root.links.length > 0) {
                    root.focus-reward(root.links.length - 1);
                    return;
                }
                if (root.task-picks.length > 0) {
                    root.focus-task(root.task-picks.length - 1);
                }
                return;
            }
            if (next >= root.chain-next.length) {
                return;
            }
            root.next-focus = next;
            return;
        }
        if (root.links.length == 0) {
            if (delta < 0 && root.task-picks.length > 0) {
                root.focus-task(root.task-picks.length - 1);
                return;
            }
            if (delta > 0 && root.task-picks.length > 0) {
                root.focus-task(0);
                return;
            }
            if (delta > 0 && root.chain-next.length > 1) {
                root.next-focus = 0;
            }
            return;
        }
        let next = root.cursor + delta;
        if (next < 0) {
            if (root.task-picks.length > 0) {
                root.focus-task(root.task-picks.length - 1);
            }
            return;
        }
        if (next >= root.links.length) {
            if (delta > 0 && root.chain-next.length > 1) {
                root.task-focus = -1;
                root.next-focus = 0;
            }
            return;
        }
        root.focus-reward(next);
    }

    function move-list(delta: int) {
        if (root.quest-browser && (root.quest-summary || root.quest-map-open)) { return; }
        if (root.full-mode && root.quest-sheet) { return; }
        if (root.monster-board && !root.legacy-mode && root.menu-open) { root.move-region(delta); return; }
        if (root.quest-sheet) {
            root.move-quest(delta);
            return;
        }
        if (root.list-count() <= 0) {
            return;
        }
        root.cursor = root.cursor + delta;
        if (root.cursor < 0) {
            root.cursor = 0;
        }
        if (root.cursor >= root.list-count()) {
            root.cursor = root.list-count() - 1;
        }
        if (root.viewing == "") {
            root.reveal-list(root.cursor);
        } else {
            root.reveal-drops(root.cursor);
        }
    }

    function dock-on(index: int) -> bool {
        if (index == 0) { return root.dock-monster; }
        if (index == 1) { return root.dock-item; }
        if (index == 2) { return root.dock-recipe; }
        if (index == 3) { return root.dock-quest; }
        if (index == 4) { return root.dock-patch; }
        if (index == 5) { return root.dock-npc; }
        if (index == 6) { return root.dock-hero; }
        if (index == 7) { return root.dock-works; }
        if (index == 8) { return root.dock-atlas; }
        return false;
    }

    function toggle-dock(index: int) {
        if (index == 0) { root.dock-monster = !root.dock-monster; }
        else if (index == 1) { root.dock-item = !root.dock-item; }
        else if (index == 2) { root.dock-recipe = !root.dock-recipe; }
        else if (index == 3) { root.dock-quest = !root.dock-quest; }
        else if (index == 4) { root.dock-patch = !root.dock-patch; }
        else if (index == 5) { root.dock-npc = !root.dock-npc; }
        else if (index == 6) { root.dock-hero = !root.dock-hero; }
        else if (index == 7) { root.dock-works = !root.dock-works; }
        else if (index == 8) { root.dock-atlas = !root.dock-atlas; }
        else { return; }
        root.publish-dock();
        root.dock-park();
    }

    function category-short(index: int) -> string {
        if (index == 0) { return UiLanguage.tr("Monsters", "怪物"); }
        if (index == 1) { return UiLanguage.tr("Items", "道具"); }
        if (index == 2) { return UiLanguage.tr("Crafting", "合成"); }
        if (index == 3) { return UiLanguage.tr("Quests", "任務"); }
        if (index == 4) { return UiLanguage.tr("Updates", "更新"); }
        if (index == 5) { return "NPC"; }
        if (index == 6) { return UiLanguage.tr("Roster", "角色"); }
        if (index == 7) { return UiLanguage.tr("Production", "生產"); }
        return UiLanguage.tr("Shop", "商店");
    }

    function home-at(cat: int) -> int {
        if (root.home-order[0] == cat) { return 0; }
        if (root.home-order[1] == cat) { return 1; }
        if (root.home-order[2] == cat) { return 2; }
        if (root.home-order[3] == cat) { return 3; }
        if (root.home-order[4] == cat) { return 4; }
        if (root.home-order[5] == cat) { return 5; }
        if (root.home-order[6] == cat) { return 6; }
        if (root.home-order[7] == cat) { return 7; }
        if (root.home-order[8] == cat) { return 8; }
        return 0;
    }

    function dock-at(cat: int) -> int {
        if (root.dock-order[0] == cat) { return 0; }
        if (root.dock-order[1] == cat) { return 1; }
        if (root.dock-order[2] == cat) { return 2; }
        if (root.dock-order[3] == cat) { return 3; }
        if (root.dock-order[4] == cat) { return 4; }
        if (root.dock-order[5] == cat) { return 5; }
        if (root.dock-order[6] == cat) { return 6; }
        if (root.dock-order[7] == cat) { return 7; }
        if (root.dock-order[8] == cat) { return 8; }
        return 0;
    }

    function visible-index(cat: int) -> int {
        if (!root.dock-on(cat)) { return 0; }
        let at = root.dock-at(cat);
        return 1
            + (at > 0 && root.dock-on(root.dock-order[0]) ? 1 : 0)
            + (at > 1 && root.dock-on(root.dock-order[1]) ? 1 : 0)
            + (at > 2 && root.dock-on(root.dock-order[2]) ? 1 : 0)
            + (at > 3 && root.dock-on(root.dock-order[3]) ? 1 : 0)
            + (at > 4 && root.dock-on(root.dock-order[4]) ? 1 : 0)
            + (at > 5 && root.dock-on(root.dock-order[5]) ? 1 : 0)
            + (at > 6 && root.dock-on(root.dock-order[6]) ? 1 : 0)
            + (at > 7 && root.dock-on(root.dock-order[7]) ? 1 : 0)
            + (at > 8 && root.dock-on(root.dock-order[8]) ? 1 : 0);
    }

    function advance-dock(pos: int, offset: int) {
        let next = pos + offset;
        if (next < 0 || next >= root.dock-order.length) { return; }
        if (root.home-cursor == root.dock-order[pos] && root.dock-on(root.dock-order[next])) {
            root.home-cursor = root.dock-order[next];
        }
    }

    function step-dock(delta: int) {
        if (delta == 0) { return; }
        let pos = root.dock-at(root.home-cursor);
        if (delta > 0) {
            root.advance-dock(pos, 1);
            root.advance-dock(pos, 2);
            root.advance-dock(pos, 3);
            root.advance-dock(pos, 4);
            root.advance-dock(pos, 5);
            root.advance-dock(pos, 6);
            root.advance-dock(pos, 7);
            root.advance-dock(pos, 8);
        } else {
            root.advance-dock(pos, -1);
            root.advance-dock(pos, -2);
            root.advance-dock(pos, -3);
            root.advance-dock(pos, -4);
            root.advance-dock(pos, -5);
            root.advance-dock(pos, -6);
            root.advance-dock(pos, -7);
            root.advance-dock(pos, -8);
        }
    }

    function open-nth-visible(n: int) {
        root.try-open(0, n);
        root.try-open(1, n);
        root.try-open(2, n);
        root.try-open(3, n);
        root.try-open(4, n);
        root.try-open(5, n);
        root.try-open(6, n);
        root.try-open(7, n);
        root.try-open(8, n);
    }

    function try-open(pos: int, n: int) {
        if (pos < 0 || pos >= root.dock-order.length) {
            return;
        }
        if (root.visible-index(root.dock-order[pos]) == n) {
            root.open-dock(root.dock-order[pos]);
        }
    }

    function move-home(dx: int, dy: int) {
        let pos = root.home-at(root.home-cursor);
        let cols = root.home-span;
        let row = floor(pos / cols);
        let col = pos - row * cols;
        let ncol = col + dx;
        let nrow = row + dy;
        if (ncol < 0 || ncol >= cols || nrow < 0) {
            return;
        }
        let next = nrow * cols + ncol;
        if (next >= 0 && next < root.home-order.length) {
            root.home-cursor = root.home-order[next];
        }
    }

    function grid-slot(ax: length, ay: length, origin-x: length, origin-y: length, tile-w: length, tile-h: length, gap: length, cols: int, count: int) -> int {
        if (tile-w <= 1px || tile-h <= 1px || ax < origin-x || ay < origin-y) {
            return -1;
        }
        let col = round((ax - origin-x) / (tile-w + gap) - 0.5);
        let row = round((ay - origin-y) / (tile-h + gap) - 0.5);
        if (col < 0 || row < 0 || col >= cols) {
            return -1;
        }
        let index = row * cols + col;
        if (index < 0 || index >= count) {
            return -1;
        }
        return index;
    }

    function category-logo(index: int) -> image {
        if (index == 0) { return @image-url("icons/monster.png"); }
        if (index == 1) { return @image-url("icons/item.png"); }
        if (index == 2) { return @image-url("icons/recipe.png"); }
        if (index == 3) { return @image-url("icons/quest.png"); }
        if (index == 4) { return @image-url("logo.png"); }
        if (index == 5) { return @image-url("icons/npc.png"); }
        if (index == 6) { return root.hero-logo-ready ? root.hero-logo : @image-url("logo.png"); }
        if (index == 7) { return @image-url("icons/works.png"); }
        return @image-url("icons/shop.png");
    }

    function category-glyph(index: int) -> string {
        if (index == 6 && !root.hero-logo-ready) { return UiLanguage.tr("H", "將"); }
        return "";
    }

    function publish-dock() {
        root.dock-changed(root.dock-vertical, root.dock-monster, root.dock-item, root.dock-recipe, root.dock-quest, root.dock-patch, root.dock-npc, root.dock-hero, root.dock-works, root.dock-atlas);
    }

    function open-dock(index: int) {
        if (!root.dock-on(index)) { return; }
        root.home-cursor = index;
        if (root.settings-open) {
            root.close-settings();
        }
        root.collapsed = false;
        root.open-category(root.categories[index].id);
    }

    function activate() {
        if (root.quest-browser && (root.quest-summary || root.quest-map-open)) { return; }
        if (root.monster-board && !root.legacy-mode && root.menu-open) { root.activate-region(); return; }
        if (root.collapsed) {
            root.open-dock(root.home-cursor);
            return;
        }
        if (root.category == "") {
            if (root.arranging) {
                return;
            }
            root.open-category(root.categories[root.home-cursor].id);
            return;
        }
        if (root.viewing == "") {
            if (root.cursor >= 0 && root.cursor < root.hits.length) {
                if (root.monster-board || (root.full-board && !root.catalog-searching && root.hits[root.cursor].chip == "label")) {
                    root.list-offset = 0px;
                    if (root.monster-board && root.legacy-mode) {
                        if (root.hits[root.cursor].key == "") { return; }
                        if (root.expanded != root.hits[root.cursor].key) { root.toggle-board(root.hits[root.cursor].key); }
                        root.legacy-place-title = root.hits[root.cursor].title;
                        root.menu-open = false;
                    } else {
                        root.toggle-board(root.hits[root.cursor].key);
                    }
                } else if (root.full-board) {
                    root.open-catalog-record(root.hits[root.cursor].key, root.cursor);
                } else {
                    root.open-hit(root.hits[root.cursor].key);
                }
            }
            return;
        }
        if (root.viewing-monster && root.related-open) {
            if (root.cursor >= 0 && root.cursor < root.related.length && root.related[root.cursor].key != "") {
                root.open-hit(root.related[root.cursor].key);
            }
            return;
        }
        if (root.viewing-monster && !root.drops-open) {
            return;
        }
        if (root.full-mode && root.quest-sheet) { return; }
        if (root.quest-sheet && root.next-focus >= 0 && root.next-focus < root.chain-next.length) {
            root.open-hit(root.chain-next[root.next-focus].key);
            return;
        }
        if (root.quest-sheet && root.task-focus >= 0) {
            if (root.task-focus < root.task-picks.length) {
                let index = root.task-picks[root.task-focus];
                if (index >= 0 && index < root.facts.length && root.facts[index].key != "") {
                    root.open-hit(root.facts[index].key);
                }
            }
            return;
        }
        if (root.full-item-sheet && !root.item-links) {
            return;
        }
        if ((root.item-links || root.viewing-hero) && root.cursor >= 0 && root.cursor < root.links.length && root.links[root.cursor].chip == "section") {
            root.source-changed(root.links[root.cursor].key);
            return;
        }
        if (root.cursor >= 0 && root.cursor < root.links.length && root.links[root.cursor].key != "") {
            root.open-hit(root.links[root.cursor].key);
        }
    }

    function open-prev() {
        if (root.chain-prev.length > 0) {
            root.open-hit(root.chain-prev[0].key);
        }
    }

    function open-next() {
        if (root.chain-next.length == 0) {
            return;
        }
        if (root.next-focus >= 0 && root.next-focus < root.chain-next.length) {
            root.open-hit(root.chain-next[root.next-focus].key);
            return;
        }
        root.open-hit(root.chain-next[0].key);
    }

    function shrink-window() {
        root.collapsed = !root.collapsed;
    }

    function handle-key(event: KeyEvent) -> EventResult {
        if (RecordInfo.text != "" && event.text == Key.Escape) {
            RecordInfo.text = "";
            return accept;
        }
        if (!root.settings-open && !root.collapsed && !root.calculator-open && !root.mcp-open && (event.modifiers.control || event.modifiers.meta) && (event.text == "i" || event.text == "I")) {
            if (root.viewing == "" && root.cursor >= 0 && root.cursor < root.hits.length) {
                RecordInfo.show(root.hits[root.cursor]);
            } else if (root.viewing-monster && root.related-open && root.cursor >= 0 && root.cursor < root.related.length) {
                RecordInfo.show(root.related[root.cursor]);
            } else if (root.viewing != "" && root.cursor >= 0 && root.cursor < root.links.length) {
                RecordInfo.show(root.links[root.cursor]);
            }
            return accept;
        }

        if (root.monster-page-settings-open && event.text == Key.Escape) {
            root.monster-page-settings-open = false;
            return accept;
        }
        if (root.legacy-nav-open && event.text == Key.Escape) {
            root.legacy-nav-open = false;
            return accept;
        }
        if (event.modifiers.control && event.text == "-") {
            root.shrink-window();
            return accept;
        }
        if ((root.calculator-open || root.mcp-open) && !root.settings-open && !root.collapsed) {
            // These are top-level destinations. Local controls dismiss their own UI.
            return reject;
        }
        if (event.text == Key.Home && !root.settings-open && keys.has-focus) {
            root.go-home();
            return accept;
        }
        if (root.collapsed) {
            if (event.text == Key.LeftArrow || event.text == Key.UpArrow) {
                root.step-dock(-1);
                return accept;
            }
            if (event.text == Key.RightArrow || event.text == Key.DownArrow) {
                root.step-dock(1);
                return accept;
            }
            if (event.text == Key.Space || event.text == Key.Return) {
                root.open-dock(root.home-cursor);
                return accept;
            }
            if (event.text == Key.Escape) {
                root.collapsed = false;
                return accept;
            }
            return reject;
        }
        if (root.settings-open) {
            if (((root.settings-tab == 4 || root.settings-tab == 1) && (event.text == Key.UpArrow || event.text == Key.DownArrow)) || event.text == Key.PageUp || event.text == Key.PageDown) {
                let step = event.text == Key.PageUp || event.text == Key.PageDown ? max(root.settings-page-height - 32px, 48px) : 48px;
                let direction = event.text == Key.UpArrow || event.text == Key.PageUp ? 1 : -1;
                root.settings-scroll-y = max(-root.settings-scroll-span, min(0px, root.settings-scroll-y + direction * step));
                return accept;
            }
            // Slint maps macOS Control to meta; allow physical Ctrl+Tab there too.
            if ((event.modifiers.control || event.modifiers.meta) && (event.text == Key.Tab || event.text == Key.Backtab)) {
                root.cycle-settings(event.text == Key.Backtab || event.modifiers.shift ? -1 : 1);
                return accept;
            }
            if (event.text == Key.Escape) {
                if (root.alias-hits.length > 0) {
                    root.alias-hits = [];
                    root.alias-target = -1;
                    return accept;
                }
                root.close-settings();
                return accept;
            }
            if (event.text == Key.Backspace && !(root.settings-tab == 2 && root.alias-edit >= 0)) {
                root.close-settings();
                return accept;
            }
            if (root.settings-tab == 2 && root.alias-hits.length > 0 && event.text == Key.UpArrow) {
                root.alias-pick = max(root.alias-pick - 1, 0);
                return accept;
            }
            if (root.settings-tab == 2 && root.alias-hits.length > 0 && event.text == Key.DownArrow) {
                root.alias-pick = min(root.alias-pick + 1, root.alias-hits.length - 1);
                return accept;
            }
            if (root.settings-tab == 4 && (event.text == Key.Return || event.text == Key.Space) && root.updates-supported && !root.update-busy) {
                root.request-update();
                return accept;
            }
            return reject;
        }
        if (root.viewing-hero && root.viewing != "" && (event.text == Key.PageUp || event.text == Key.PageDown || (root.links.length == 0 && (event.text == Key.UpArrow || event.text == Key.DownArrow)))) {
            let direction = event.text == Key.PageUp || event.text == Key.UpArrow ? 1 : -1;
            let step = event.text == Key.PageUp || event.text == Key.PageDown ? max(root.height - root.foot - 120px, 80px) : 48px;
            root.drop-offset = max(-root.hero-scroll-span, min(0px, root.drop-offset + direction * step));
            return accept;
        }
        if (event.modifiers.control && (event.text == "f" || event.text == "F")) {
            if (root.viewing == "" && root.category != "") {
                root.search-open = true;
            }
            return accept;
        }
        // Keep Tab's catalog shortcuts; reverse Tab reaches the record's action.
        if (keys.has-focus && root.sheet-can-calculate && (event.text == Key.Backtab || (event.text == Key.Tab && event.modifiers.shift))
            && ((root.record-sheet && root.viewing-item && root.viewing.starts-with("item:"))
                || (root.viewing-hero && root.viewing.starts-with("hero:"))
                || (root.full-board && (root.detail-key.starts-with("item:") || root.detail-key.starts-with("hero:"))))) {
            root.record-calculator-focus-request += 1;
            return accept;
        }
        if ((event.text == Key.Tab || event.text == Key.Backtab) && root.category == "quest" && root.place == "main" && root.viewing == "") {
            root.cycle-quest-type(event.text == Key.Tab ? 1 : -1);
            return accept;
        }
        if ((event.text == Key.Tab || event.text == Key.Backtab) && root.set-browser) {
            root.cycle-set-type(event.text == Key.Tab ? 1 : -1);
            return accept;
        }
        if ((event.text == Key.Tab || event.text == Key.Backtab) && root.category == "hero" && root.viewing == "") {
            root.set-hero-group(root.hero-group == "land" ? "rank" : "land");
            return accept;
        }
        if ((event.text == Key.Tab || event.text == Key.Backtab) && root.viewing-item && root.viewing != "") {
            root.set-item-tab(root.item-tab == "links" ? "" : "links");
            keys.focus();
            return accept;
        }
        if ((event.text == Key.Tab || event.text == Key.Backtab) && root.category == "monster") {
            if (root.full-mode) { return reject; }
            root.toggle-saved();
            return accept;
        }
        if (root.category == "" && root.full-mode && root.hits.length > 0) {
            if (event.text == Key.UpArrow) {
                root.cursor = max(root.cursor - 1, 0);
                keys.focus();
                return accept;
            }
            if (event.text == Key.DownArrow) {
                root.cursor = min(root.cursor + 1, root.hits.length - 1);
                keys.focus();
                return accept;
            }
            if (event.text == Key.Space || event.text == Key.Return) {
                root.home-open(root.hits[root.cursor].key);
                return accept;
            }
            return reject;
        }
        if (root.category == "" && root.arranging && event.text == Key.Escape) {
            root.arranging = false;
            return accept;
        }
        if (event.text == Key.Escape) {
            if (root.search-open) {
                root.close-search();
            } else {
                root.go-back();
            }
            return accept;
        }
        if (event.text == Key.Backspace) {
            root.go-back();
            return accept;
        }
        if (root.category == "") {
            if (event.text == Key.LeftArrow) {
                root.move-home(-1, 0);
                return accept;
            }
            if (event.text == Key.RightArrow) {
                root.move-home(1, 0);
                return accept;
            }
            if (event.text == Key.UpArrow) {
                root.move-home(0, -1);
                return accept;
            }
            if (event.text == Key.DownArrow) {
                root.move-home(0, 1);
                return accept;
            }
            if (event.text == Key.Space || event.text == Key.Return) {
                root.activate();
                return accept;
            }
            return reject;
        }
        if (root.category == "patch" && root.viewing != "") {
            if (event.text == Key.Escape) {
                root.go-back();
                return accept;
            }
            if (event.modifiers.control && (event.text == "c" || event.text == "C")) {
                root.copy-note();
                return accept;
            }
            return reject;
        }
        if (root.viewing != "" && root.viewing-monster && !root.drops-open && !root.related-open && (event.text == Key.UpArrow || event.text == Key.DownArrow || event.text == Key.LeftArrow || event.text == Key.RightArrow)) {
            root.move-sheet(event.text == Key.DownArrow || event.text == Key.RightArrow ? 1 : -1);
            return accept;
        }
        if (root.viewing != "" && root.viewing-monster && root.drops-open && event.text == Key.LeftArrow) {
            root.drops-open = false;
            root.sheet-focus = root.drops-slot();
            return accept;
        }
        if (root.viewing != "" && root.viewing-monster && root.related-open && event.text == Key.LeftArrow) {
            root.related-open = false;
            root.sheet-focus = root.related-slot();
            return accept;
        }
        if (root.quest-sheet && !root.full-mode && event.text == Key.LeftArrow) {
            root.open-prev();
            return accept;
        }
        if (root.quest-sheet && !root.full-mode && event.text == Key.RightArrow) {
            root.open-next();
            return accept;
        }
        if (root.viewing != "" && root.viewing-set && !root.item-links && (event.text == Key.UpArrow || event.text == Key.DownArrow)) {
            root.step-fold(event.text == Key.DownArrow ? 1 : -1);
            return accept;
        }
        if (root.viewing != "" && root.viewing-set && !root.item-links && (event.text == Key.LeftArrow || event.text == Key.RightArrow)) {
            root.scroll-form(event.text == Key.RightArrow ? 1 : -1);
            return accept;
        }
        if (root.viewing != "" && root.viewing-set && !root.item-links && event.text == Key.Space) {
            root.toggle-fold-focus();
            return accept;
        }
        if (root.viewing != "" && root.viewing-item && !root.item-links && (event.text == Key.UpArrow || event.text == Key.DownArrow)) {
            root.scroll-form(event.text == Key.DownArrow ? 1 : -1);
            return accept;
        }
        if (event.text == Key.UpArrow) {
            root.move-list(-1);
            keys.focus();
            return accept;
        }
        if (event.text == Key.DownArrow) {
            root.move-list(1);
            keys.focus();
            return accept;
        }
        if (event.text == Key.Space) {
            if (root.viewing != "" && root.viewing-monster && !root.drops-open && !root.related-open) {
                root.toggle-sheet();
                return accept;
            }
            root.activate();
            return accept;
        }
        if (event.text == Key.Return || event.text == "\n") {
            if (root.category == "monster") {
                root.mark-favourite();
            } else {
                root.activate();
            }
            return accept;
        }
        return reject;
    }

    changed hits => {
        RecordInfo.text = "";
        if (!root.full-board) { root.directory-offset = 0px; }
        if (root.stick-cursor) {
            root.stick-cursor = false;
            return;
        }
        root.cursor = 0;
        root.list-offset = 0px;
    }

    changed links => {
        root.drop-offset = 0px;
    }

    changed cursor => {
        RecordInfo.text = "";
        if (root.item-links) {
            root.reveal-drops(root.cursor);
        }
    }

    property <bool> in-detail: false;

    changed task-picks => {
        root.task-offset = 0px;
        root.quest-facts-body = 0px;
    }

    changed task-focus => {
        if (root.task-focus < 0 || root.task-focus >= root.task-picks.length) {
            return;
        }
        root.reveal-task(root.task-picks[root.task-focus]);
    }

    changed viewing => {
        RecordInfo.text = "";
        root.catalog-keyboard-index = -1;
        root.next-focus = -1;
        root.task-focus = -1;
        root.task-offset = 0px;
        root.form-offset = 0px;
        root.show-item-fx = false;
        root.show-set-fx = false;
        root.show-total-fx = false;
        root.fold-focus = 0;
        if (root.viewing != "") {
            if (!root.in-detail) {
                root.saved-cursor = root.cursor;
            }
            root.in-detail = true;
            root.cursor = 0;
            keys.focus();
        } else {
            root.in-detail = false;
            root.cursor = root.saved-cursor;
            root.reveal-list(root.cursor);
        }
        root.form-open = false;
        root.drops-open = false;
        root.related-open = false;
        root.sheet-focus = 0;
    }

    function drops-slot() -> int {
        return root.links.length > 0 ? 1 : -1;
    }

    function related-slot() -> int {
        if (root.related.length == 0) {
            return -1;
        }
        return root.links.length > 0 ? 2 : 1;
    }

    function move-sheet(delta: int) {
        if (!root.monster-sheet) {
            return;
        }
        let count = 1 + (root.links.length > 0 ? 1 : 0) + (root.related.length > 0 ? 1 : 0);
        root.sheet-focus = root.sheet-focus + delta;
        if (root.sheet-focus < 0) {
            root.sheet-focus = 0;
        }
        if (root.sheet-focus >= count) {
            root.sheet-focus = count - 1;
        }
    }

    function choose-catalog-section(index: int, key: string) {
        if (root.query != "") {
            root.query = "";
            root.query-changed(root.category, "");
        }
        root.cursor = index;
        root.list-offset = 0px;
        if (root.expanded != key || key.starts-with("land:")) { root.toggle-board(key); }
        keys.focus();
    }

    function record-key(key: string) -> bool {
        return key.starts-with("item:") || key.starts-with("set:")
            || key.starts-with("quest:") || key.starts-with("npc:")
            || key.starts-with("recipe:") || key.starts-with("hero:")
            || key.starts-with("monster:") || key.starts-with("patch:")
            || key.starts-with("chart:");
    }

    function open-catalog-record(key: string, index: int) {
        if (root.record-key(key)) { root.toggle-detail(key, index); }
        else { root.open-hit(key); }
    }

    function close-search() {
        root.search-open = false;
        if (root.query != "") {
            root.query = "";
            root.cursor = 0;
            root.query-changed(root.category, "");
        }
        keys.focus();
    }

    function toggle-search() {
        if (root.viewing != "" || root.category == "") {
            return;
        }
        if (root.search-open) {
            root.close-search();
        } else {
            root.search-open = true;
        }
    }

    function toggle-sheet() {
        if (!root.monster-sheet) {
            return;
        }
        if (root.sheet-focus == 0) {
            root.form-open = !root.form-open;
            if (root.form-open) {
                root.drops-open = false;
                root.related-open = false;
            }
            return;
        }
        if (root.sheet-focus == root.drops-slot()) {
            root.drops-open = !root.drops-open;
            if (root.drops-open) {
                root.form-open = false;
                root.related-open = false;
                root.drop-offset = 0px;
                root.cursor = 0;
            }
            return;
        }
        root.related-open = !root.related-open;
        if (root.related-open) {
            root.form-open = false;
            root.drops-open = false;
            root.drop-offset = 0px;
            root.cursor = 0;
        }
    }

