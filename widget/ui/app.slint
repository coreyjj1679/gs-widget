import { Palette, LineEdit, TextEdit } from "std-widgets.slint";
import { DesktopTheme, DesktopNavRow, DesktopEntry, DesktopIcon } from "desktop.slint";

export struct Hit {
    title: string,
    subtitle: string,
    detail: string,
    stat-kind: string,
    stat-element: string,
    stat-hp: string,
    stat-mp: string,
    stat-hit: string,
    stat-magic: string,
    stat-atk: string,
    stat-exp: string,
    drop1: image,
    drop2: image,
    drop3: image,
    drop4: image,
    drop5: image,
    drop6: image,
    drop7: image,
    drop8: image,
    drop9: image,
    drop10: image,
    drop-total: int,
    battle: image,
    has-battle: bool,
    key: string,
    icon: image,
    has-icon: bool,
    no-image: bool,
    can-favourite: bool,
    favourite: bool,
    solo: bool,
    has-badge: bool,
    badge: image,
    aside: string,
    chip: string,
}

export struct Fact {
    label: string,
    value: string,
    key: string,
    icon: image,
    has-icon: bool,
    section: string,
}

export struct AliasRow {
    name: string,
    codes: string,
    detail: string,
    count: int,
}

struct Category {
    id: string,
    name: string,
}

component NoImage inherits Rectangle {
    in property <string> label;
    in property <length> side: 36px;
    width: side;
    height: side;
    border-radius: 4px;
    background: DesktopTheme.surface;
    border-width: 1px;
    border-color: DesktopTheme.border;
    Text {
        width: parent.width - 4px;
        height: parent.height - 2px;
        text: root.label;
        wrap: word-wrap;
        font-size: root.side >= 56px ? 12px : 8px;
        color: DesktopTheme.secondary;
        horizontal-alignment: center;
        vertical-alignment: center;
    }
}

component WinButton inherits Rectangle {
    in property <string> glyph;
    accessible-role: button;
    accessible-label: glyph == "×" ? "關閉 / Close" : glyph == "–" ? "收合 / Collapse" : glyph == "←" ? "返回 / Back" : glyph;
    accessible-action-default => { root.clicked(); }
    in property <bool> danger: false;
    callback clicked();
    width: glyph == "Setting" || glyph == "Widget" ? 64px : glyph == "設定" || glyph == "完整" || glyph == "小窗" ? 48px : glyph == "Full" ? 44px : glyph == "EN" ? 34px : 30px;
    height: DesktopTheme.active ? 26px : 24px;
    border-radius: DesktopTheme.active ? 5px : 6px;
    background: tap.has-hover ? (danger ? #7f1d1d : DesktopTheme.hover-strong) : (danger ? (DesktopTheme.active ? transparent : #4a3030) : (DesktopTheme.active ? transparent : DesktopTheme.control));
    Text {
        text: root.glyph;
        color: DesktopTheme.text;
        font-size: 12px;
        horizontal-alignment: center;
        vertical-alignment: center;
    }
    tap := TouchArea {
        width: 100%;
        height: 100%;
        clicked => { root.clicked(); }
        mouse-cursor: pointer;
    }
}

component SearchToggle inherits Rectangle {
    in property <bool> open;
    in property <string> label;
    callback clicked();
    height: 28px;
    border-radius: 7px;
    background: open ? DesktopTheme.accent : (tap.has-hover ? DesktopTheme.hover-strong : DesktopTheme.control);
    label-text := Text {
        x: 12px;
        text: root.label;
        color: open ? DesktopTheme.on-accent : DesktopTheme.text;
        font-size: 12px;
        font-weight: 600;
        vertical-alignment: center;
    }
    width: label-text.preferred-width + 24px;
    tap := TouchArea {
        width: 100%;
        height: 100%;
        clicked => { root.clicked(); }
        mouse-cursor: pointer;
    }
}

component StarMark inherits Rectangle {
    in property <bool> filled;
    callback clicked();
    width: 32px;
    height: 32px;
    Path {
        x: 6px;
        y: 5px;
        width: 20px;
        height: 20px;
        fill: root.filled ? DesktopTheme.accent : transparent;
        stroke: root.filled ? #e6c98a : DesktopTheme.muted;
        stroke-width: 1.4px;
        commands: "M 10 0.6 L 12.7 6.4 L 19 6.9 L 14.2 11.1 L 15.8 17.4 L 10 14 L 4.2 17.4 L 5.8 11.1 L 1 6.9 L 7.3 6.4 Z";
    }
    TouchArea {
        width: 100%;
        height: 100%;
        clicked => { root.clicked(); }
        mouse-cursor: pointer;
    }
}

