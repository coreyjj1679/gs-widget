    function move-region(delta: int) {
        root.region-cursor = clamp(root.region-cursor + delta, 0, root.region-rows.length + 1);
        if (root.region-cursor >= 2) {
            let row = (root.region-cursor - 2) * 36px;
            let view = root.region-directory-view;
            if (row < -root.directory-offset) { root.directory-offset = -row; }
            else if (row + 34px > -root.directory-offset + view) { root.directory-offset = view - row - 34px; }
            root.directory-offset = clamp(root.directory-offset, min(0px, view - root.region-rows.length * 36px), 0px);
        }
        keys.focus();
    }
    function activate-region() {
        if (root.region-cursor == 0) { root.choose-monster-place("all:", UiLanguage.tr("All monsters", "所有怪物")); }
        else if (root.region-cursor == 1) { root.choose-monster-place("saved:", UiLanguage.tr("Favourites", "收藏怪物")); }
        else if (root.region-cursor >= 2 && root.region-cursor - 2 < root.region-rows.length) {
            root.choose-monster-place(root.region-rows[root.region-cursor - 2].key, root.region-rows[root.region-cursor - 2].title);
        }
