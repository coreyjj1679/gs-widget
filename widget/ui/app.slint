component ChoiceBar inherits Rectangle {
    in property <string> label;
    in property <string> first;
    in property <string> second;
    in property <string> third: "";
    in property <int> picked: 0;
    out property <length> focus-y: self.absolute-position.y;
    out property <bool> has-focus: choice-focus.has-focus;
    callback pick(int);
    callback focus-changed(bool);
    height: 32px;
    border-radius: 6px;
    background: DesktopTheme.sidebar;
    border-width: 1px;
    border-color: DesktopTheme.border;
    forward-focus: choice-focus;
    accessible-role: radio-group;
    accessible-label: root.label;
    accessible-orientation: horizontal;
    accessible-item-count: root.third == "" ? 2 : 3;
    accessible-value: root.picked == 0 ? root.first : root.picked == 1 ? root.second : root.third;
    // Keep the keyboard target outside the visual clip so Slint can Tab to
    // controls below the Flickable viewport and scroll them into view.
    Rectangle {
        width: 100%; height: 100%;
        border-radius: root.border-radius;
        clip: true;
        HorizontalLayout {
            spacing: 1px;
            Rectangle {
                horizontal-stretch: 1;
                background: root.picked == 0 ? DesktopTheme.raised : transparent;
                accessible-role: radio-button;
                accessible-label: root.first;
                accessible-checkable: true;
                accessible-checked: root.picked == 0;
                accessible-item-index: 0;
                accessible-action-default => { choice-focus.focus(); root.pick(0); }
                Text {
                    width: 100%;
                    height: 100%;
                    text: root.first;
                    accessible-role: none;
                    font-size: 13px;
                    color: root.picked == 0 ? DesktopTheme.text : DesktopTheme.secondary;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                }
                TouchArea {
                    width: 100%;
                    height: 100%;
                    clicked => { choice-focus.focus(); root.pick(0); }
                    mouse-cursor: pointer;
                }
            }
            Rectangle {
                horizontal-stretch: 1;
                background: root.picked == 1 ? DesktopTheme.raised : transparent;
                accessible-role: radio-button;
                accessible-label: root.second;
                accessible-checkable: true;
                accessible-checked: root.picked == 1;
                accessible-item-index: 1;
                accessible-action-default => { choice-focus.focus(); root.pick(1); }
                Text {
                    width: 100%;
                    height: 100%;
                    text: root.second;
                    accessible-role: none;
                    font-size: 13px;
                    color: root.picked == 1 ? DesktopTheme.text : DesktopTheme.secondary;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                }
                TouchArea {
                    width: 100%;
                    height: 100%;
                    clicked => { choice-focus.focus(); root.pick(1); }
                    mouse-cursor: pointer;
                }
            }
            if root.third != "": Rectangle {
                horizontal-stretch: 1;
                background: root.picked == 2 ? DesktopTheme.raised : transparent;
                accessible-role: radio-button;
                accessible-label: root.third;
                accessible-checkable: true;
                accessible-checked: root.picked == 2;
                accessible-item-index: 2;
                accessible-action-default => { choice-focus.focus(); root.pick(2); }
                Text {
                    width: 100%;
                    height: 100%;
                    text: root.third;
                    accessible-role: none;
                    font-size: 13px;
                    color: root.picked == 2 ? DesktopTheme.text : DesktopTheme.secondary;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                }
                TouchArea {
                    width: 100%;
                    height: 100%;
                    clicked => { choice-focus.focus(); root.pick(2); }
                    mouse-cursor: pointer;
                }
            }
        }
    }
    Rectangle {
        width: 100%; height: 100%;
        border-radius: root.border-radius;
        border-width: 1px;
        border-color: choice-focus.has-focus ? DesktopTheme.accent : transparent;
        background: transparent;
    }
    choice-focus := FocusScope {
        width: 100%; height: 100%;
        focus-on-click: false;
        focus-gained => { root.focus-changed(true); }
        focus-lost => { root.focus-changed(false); }
        key-pressed(event) => {
            let last = root.third == "" ? 1 : 2;
            if (event.text == Key.Return || event.text == Key.Space) { root.pick(root.picked); return accept; }
            if (event.text == Key.RightArrow || event.text == Key.DownArrow) {
                root.pick(root.picked >= last ? 0 : root.picked + 1);
                return accept;
            }
            if (event.text == Key.LeftArrow || event.text == Key.UpArrow) {
                root.pick(root.picked <= 0 ? last : root.picked - 1);
                return accept;
            }
            if (event.text == Key.Home) { root.pick(0); return accept; }
            if (event.text == Key.End) { root.pick(last); return accept; }
            return reject;
        }
    }
}

// Keep both language selectors native to the existing keyboard-aware settings controls.
component LanguageSettings inherits Rectangle {
    in property <string> primary: "zh";
    in property <string> secondary: "en";
    callback primary-changed(string);
    callback secondary-changed(string);
    callback reveal(length, length);
    property <string> other-first: root.primary == "zh" ? "en" : "zh";
    property <string> other-second: root.primary == "ko" ? "en" : "ko";
    height: language-fields.preferred-height;
    language-fields := VerticalLayout {
        spacing: 8px;
        Text { text: UiLanguage.tr("Primary language", "主要語言"); font-size: 13px; color: DesktopTheme.text; }
        ChoiceBar {
            label: UiLanguage.tr("Primary language", "主要語言");
            first: "中文"; second: "English"; third: "한국어";
            picked: root.primary == "en" ? 1 : root.primary == "ko" ? 2 : 0;
            focus-changed(focused) => { if (focused) { root.reveal(self.focus-y, self.height); } }
            pick(index) => { root.primary-changed(index == 1 ? "en" : index == 2 ? "ko" : "zh"); }
        }
        Rectangle { height: 4px; }
        Text { text: UiLanguage.tr("Secondary language (optional)", "次要語言（可選）"); font-size: 13px; color: DesktopTheme.text; }
        ChoiceBar {
            label: UiLanguage.tr("Secondary language (optional)", "次要語言（可選）");
            first: UiLanguage.tr("None", "無");
            second: root.other-first == "zh" ? "中文" : "English";
            third: root.other-second == "ko" ? "한국어" : "English";
            picked: root.secondary == root.other-first ? 1 : root.secondary == root.other-second ? 2 : 0;
            focus-changed(focused) => { if (focused) { root.reveal(self.focus-y, self.height); } }
            pick(index) => { root.secondary-changed(index == 1 ? root.other-first : index == 2 ? root.other-second : ""); }
        }
        Text {
            text: UiLanguage.tr("The interface follows your primary language. Choose None to show one language.", "介面跟隨主要語言；次要語言選「無」時，只顯示一種語言。");
            font-size: 12px; color: DesktopTheme.muted; wrap: word-wrap;
        }
    }
}

component MonsterPageSettings inherits Rectangle {
    in property <bool> english;
    in property <bool> open;
    in property <bool> legacy;
    in property <bool> battle;
    in property <bool> motion;
    callback toggle();
    callback dismiss();
    callback choose-legacy(bool);
    callback choose-battle(bool);
    callback choose-animate(bool);

    if root.open: TouchArea {
        x: 0px; y: 0px; width: 100%; height: 100%;
        clicked => { root.dismiss(); }
    }
    if root.open: Rectangle {
        x: parent.width - self.width - 24px;
        y: 54px;
        width: min(320px, parent.width - 48px);
        height: settings-content.preferred-height + 74px;
        background: DesktopTheme.surface-alt;
        border-radius: 8px;
        border-width: 1px;
        border-color: DesktopTheme.border;
        TouchArea { x: 0px; y: 0px; width: 100%; height: 100%; }
        Text {
            x: 16px; y: 12px;
            width: parent.width - 64px; height: 22px;
            text: UiLanguage.tr("Monster display", "怪物頁設定");
            font-size: 15px; font-weight: 600; color: DesktopTheme.text;
        }
        WinButton {
            x: parent.width - 42px; y: 10px;
            glyph: "×";
            clicked => { root.dismiss(); }
        }
        Rectangle {
            x: 16px; y: 46px;
            width: parent.width - 32px; height: 1px;
            background: DesktopTheme.border;
        }
        settings-content := VerticalLayout {
            x: 16px; y: 58px;
            width: parent.width - 32px;
            height: self.preferred-height;
            spacing: 16px;
            VerticalLayout {
                spacing: 8px;
                Text { height: 18px; text: UiLanguage.tr("Legacy mode", "傳統模式"); font-size: 13px; color: DesktopTheme.text; }
                ChoiceBar {
                    first: UiLanguage.tr("Off", "關閉");
                    second: UiLanguage.tr("On", "開啟");
                    picked: root.legacy ? 1 : 0;
                    pick(index) => { root.choose-legacy(index == 1); }
                }
                Text {
                    text: UiLanguage.tr("Classic region index and three-column records in full mode.", "完整模式使用傳統地區索引與三欄資料表。");
                    height: self.preferred-height;
                    font-size: 12px; color: DesktopTheme.secondary; wrap: word-wrap;
                }
            }
            VerticalLayout {
                spacing: 8px;
                Text { height: 18px; text: UiLanguage.tr("Monster image", "怪物圖片"); font-size: 13px; color: DesktopTheme.text; }
                ChoiceBar {
                    first: UiLanguage.tr("Portrait", "大頭像");
                    second: UiLanguage.tr("Battle", "戰鬥圖");
                    picked: root.battle ? 1 : 0;
                    pick(index) => { root.choose-battle(index == 1); }
                }
            }
            VerticalLayout {
                spacing: 8px;
                Text { height: 18px; text: UiLanguage.tr("Battle animation", "戰鬥動畫"); font-size: 13px; color: DesktopTheme.text; }
                ChoiceBar {
                    first: UiLanguage.tr("Play", "播放");
                    second: UiLanguage.tr("Still", "靜止");
                    picked: root.motion ? 0 : 1;
                    pick(index) => { root.choose-animate(index == 0); }
                }
            }
        }
    }
    Rectangle {
        x: parent.width - 58px; y: 10px;
        width: 34px; height: 32px;
        border-radius: 6px;
        border-width: 1px;
        border-color: entry-focus.has-focus || root.open ? DesktopTheme.accent : DesktopTheme.border;
        background: root.open ? DesktopTheme.control : entry-tap.has-hover ? DesktopTheme.hover : transparent;
        forward-focus: entry-focus;
        accessible-role: button;
        accessible-label: UiLanguage.tr("Monster page settings", "怪物頁設定");
        accessible-action-default => { root.toggle(); }
        Text {
            x: 0px; y: 0px; width: 100%; height: 100%;
            text: "⚙️"; font-size: 17px; color: DesktopTheme.text;
            horizontal-alignment: center; vertical-alignment: center;
        }
        entry-focus := FocusScope {
            x: 0px; y: 0px; width: 100%; height: 100%;
            key-pressed(event) => {
                if (event.text == Key.Return || event.text == Key.Space) { root.toggle(); return accept; }
                if (event.text == Key.Escape && root.open) { root.dismiss(); return accept; }
                return reject;
            }
        }
        entry-tap := TouchArea {
            x: 0px; y: 0px; width: 100%; height: 100%; mouse-cursor: pointer;
            clicked => { entry-focus.focus(); root.toggle(); }
        }
    }
}

component FormBlock inherits Rectangle {
    in property <string> title;
    background: DesktopTheme.surface;
    border-radius: 8px;
    border-width: 1px;
    border-color: DesktopTheme.border;
    VerticalLayout {
        padding: 14px;
        spacing: 10px;
        if root.title != "": Text {
            text: root.title;
            font-size: 13px;
            font-weight: 600;
            color: DesktopTheme.accent;
        }
        @children
    }
}

component LangChip inherits Rectangle {
    in property <string> label;
    in property <bool> active;
    in property <bool> checkable: false;
    out property <length> focus-y: self.absolute-position.y;
    out property <bool> has-focus: chip-focus.has-focus;
    callback clicked();
    callback focus-changed(bool);
    height: 30px;
    horizontal-stretch: 1;
    border-radius: 6px;
    background: active ? DesktopTheme.raised : (tap.has-hover ? DesktopTheme.hover : DesktopTheme.sidebar);
    border-width: 1px;
    border-color: chip-focus.has-focus ? DesktopTheme.accent : DesktopTheme.border;
    forward-focus: chip-focus;
    accessible-role: button;
    accessible-label: root.label;
    accessible-checkable: root.checkable;
    accessible-checked: root.active;
    accessible-action-default => { chip-focus.focus(); root.clicked(); }
    Text {
        text: root.label;
        accessible-role: none;
        color: active ? DesktopTheme.text : DesktopTheme.secondary;
        font-size: 13px;
        font-weight: root.active ? 600 : 400;
        horizontal-alignment: center;
        vertical-alignment: center;
    }
    chip-focus := FocusScope {
        width: 100%; height: 100%;
        focus-on-click: false;
        focus-gained => { root.focus-changed(true); }
        focus-lost => { root.focus-changed(false); }
        key-pressed(event) => {
            if (event.text == Key.Return || event.text == Key.Space) { root.clicked(); return accept; }
            return reject;
        }
    }
    tap := TouchArea {
        width: 100%;
        height: 100%;
        clicked => { chip-focus.focus(); root.clicked(); }
        mouse-cursor: pointer;
    }
}

component PatchTab inherits Rectangle {
    in property <string> label;
    in property <bool> active;
    in property <bool> arrow-navigation: false;
    in property <bool> tab-stop: true;
    out property <length> focus-y: self.absolute-position.y;
    out property <bool> has-focus: tab-focus.has-focus;
    callback clicked();
    callback navigate(int);
    callback focus-changed(bool);
    accessible-role: tab;
    accessible-label: root.label;
    accessible-item-selectable: true;
    accessible-item-selected: root.active;
    accessible-action-default => { tab-focus.focus(); root.clicked(); }
    forward-focus: tab-focus;
    horizontal-stretch: 1;
    background: active ? DesktopTheme.accent : (tap.has-hover ? DesktopTheme.hover : transparent);
    Text {
        text: root.label;
        accessible-role: none;
        color: active ? DesktopTheme.on-accent : DesktopTheme.text;
        font-size: 12px;
        font-weight: 600;
        horizontal-alignment: center;
        vertical-alignment: center;
    }
    Rectangle {
        x: 2px; y: 2px;
        width: max(0px, parent.width - 4px); height: max(0px, parent.height - 4px);
        border-radius: 3px;
        border-width: 1px;
        border-color: tab-focus.has-focus ? (root.active ? DesktopTheme.on-accent : DesktopTheme.accent) : transparent;
        background: transparent;
    }
    tab-focus := FocusScope {
        focus-on-tab-navigation: root.tab-stop;
        width: 100%; height: 100%;
        focus-on-click: false;
        focus-gained => { root.focus-changed(true); }
        focus-lost => { root.focus-changed(false); }
        key-pressed(event) => {
            if (event.text == Key.Return || event.text == Key.Space) { root.clicked(); return accept; }
            if root.arrow-navigation {
                if (event.text == Key.LeftArrow) { root.navigate(-1); return accept; }
                if (event.text == Key.RightArrow) { root.navigate(1); return accept; }
                if (event.text == Key.Home) { root.navigate(-2); return accept; }
                if (event.text == Key.End) { root.navigate(2); return accept; }
            }
            return reject;
        }
    }
    tap := TouchArea {
        width: 100%;
        height: 100%;
        clicked => { tab-focus.focus(); root.clicked(); }
        mouse-cursor: pointer;
    }
}

component PatchPill inherits Rectangle {
    in property <string> label;
    in property <bool> active;
    callback clicked();
    height: 26px;
    border-radius: 13px;
    background: active ? DesktopTheme.accent : DesktopTheme.surface;
    border-width: 1px;
    border-color: active ? DesktopTheme.accent : DesktopTheme.border;
    label-text := Text {
        x: 12px;
        height: 100%;
        text: root.label;
        font-size: 12px;
        font-weight: 600;
        color: active ? DesktopTheme.on-accent : DesktopTheme.secondary;
        vertical-alignment: center;
    }
    width: label-text.preferred-width + 24px;
    tap := TouchArea {
        width: 100%;
        height: 100%;
        clicked => { root.clicked(); }
        mouse-cursor: pointer;
    }
}

component OpacitySlider inherits Rectangle {
    in property <string> label;
    in property <float> value: 1;
    out property <length> focus-y: self.absolute-position.y;
    out property <bool> has-focus: slider-focus.has-focus;
    callback focus-changed(bool);
    callback edited(float);
    height: 22px;
    forward-focus: slider-focus;
    accessible-role: slider;
    accessible-label: root.label;
    accessible-orientation: horizontal;
    accessible-value: round(root.value * 100);
    accessible-value-minimum: 25;
    accessible-value-maximum: 100;
    accessible-value-step: 1;
    accessible-action-set-value(value) => {
        if value.is-float() { root.edited(max(0.25, min(1, value.to-float() / 100))); }
    }
    accessible-action-increment => { root.adjust(0.01); }
    accessible-action-decrement => { root.adjust(-0.01); }
    property <float> ratio: max(0, min(1, (root.value - 0.25) / 0.75));

    function adjust(step: float) {
        root.edited(max(0.25, min(1, round(root.value * 100) / 100 + step)));
    }

    function pick(x: length) {
        if (track.width <= 1px) {
            return;
        }
        root.edited(0.25 + max(0, min(1, x / track.width)) * 0.75);
    }

    track := Rectangle {
        y: (parent.height - self.height) / 2;
        width: 100%;
        height: 6px;
        border-radius: 3px;
        background: DesktopTheme.border;
        Rectangle {
            x: 0px;
            width: parent.width * root.ratio;
            height: 100%;
            border-radius: 3px;
            background: DesktopTheme.accent;
        }
        Rectangle {
            width: 14px;
            height: 14px;
            border-radius: 7px;
            y: -4px;
            x: min(max(0px, parent.width * root.ratio - 7px), max(0px, parent.width - 14px));
            background: DesktopTheme.text;
            border-width: 1px;
            border-color: DesktopTheme.accent;
        }
        TouchArea {
            y: -10px;
            width: 100%;
            height: 26px;
            mouse-cursor: pointer;
            pointer-event(event) => {
                if (event.button == PointerEventButton.left && event.kind == PointerEventKind.down) {
                    slider-focus.focus();
                    root.pick(self.mouse-x);
                }
            }
            moved => {
                if (self.pressed) {
                    root.pick(self.mouse-x);
                }
            }
        }
    }
    Rectangle {
        width: 100%; height: 100%;
        border-radius: 6px;
        border-width: 1px;
        border-color: slider-focus.has-focus ? DesktopTheme.accent : transparent;
        background: transparent;
    }
    slider-focus := FocusScope {
        width: 100%; height: 100%;
        focus-on-click: false;
        focus-gained => { root.focus-changed(true); }
        focus-lost => { root.focus-changed(false); }
        key-pressed(event) => {
            if (event.text == Key.LeftArrow || event.text == Key.DownArrow) { root.adjust(-0.01); return accept; }
            if (event.text == Key.RightArrow || event.text == Key.UpArrow) { root.adjust(0.01); return accept; }
            if (event.text == Key.PageDown) { root.adjust(-0.10); return accept; }
            if (event.text == Key.PageUp) { root.adjust(0.10); return accept; }
            if (event.text == Key.Home) { root.edited(0.25); return accept; }
            if (event.text == Key.End) { root.edited(1); return accept; }
            return reject;
        }
    }
}

component AliasCard inherits Rectangle {
    in property <string> name;
    in property <string> codes;
    in property <string> detail;
    in property <bool> editing;
    in property <bool> full-mode: false;
    out property <length> focus-y: self.absolute-position.y;
    callback focus-changed(bool);
    callback reveal-focus(length, length);
    in-out property <string> name-draft;
    in-out property <string> codes-draft;
    callback name-edited(string);
    callback codes-edited(string);
    callback remove();
    callback find-edited(string);
    callback find-accepted();
    callback choose(string);
    callback drop-code(string);
    callback begin-edit();
    callback done();
    callback save();
    callback toggle-hit(int);
    in property <string> find-hint: UiLanguage.tr("Search item", "搜尋道具");
    in property <string> edit-label: UiLanguage.tr("Edit", "編輯");
    in property <string> save-label: UiLanguage.tr("Save", "儲存");
    in property <string> delete-label: UiLanguage.tr("Delete", "刪除");
    in property <string> row-mark: "";
    in property <int> count: 0;
    in property <[Hit]> icons;
    in property <bool> suggesting: false;
    in property <[Hit]> hits;
    in property <int> pick: 0;
    in-out property <string> find-draft: "";
    init => {
        root.name-draft = root.name;
        root.codes-draft = root.codes;
    }
    changed name => { root.name-draft = root.name; }
    changed codes => { root.codes-draft = root.codes; }
    border-radius: 8px;
    background: DesktopTheme.surface;
    border-width: 1px;
    border-color: DesktopTheme.border;
    VerticalLayout {
        padding: 8px;
        spacing: 8px;
        alignment: start;
        if !editing: HorizontalLayout {
            width: 100%;
            spacing: 10px;
            alignment: stretch;
            cross-axis-alignment: center;
            Text {
                text: root.name;
                width: root.full-mode ? min(240px, max(root.width * 0.28, 144px)) : 72px;
                horizontal-stretch: 0;
                font-size: 14px;
                font-weight: 700;
                color: DesktopTheme.accent;
                vertical-alignment: center;
                overflow: elide;
            }
            HorizontalLayout {
                horizontal-stretch: 1;
                spacing: 0px;
                alignment: start;
                for icon in root.icons: Rectangle {
                    visible: icon.aside == root.row-mark;
                    width: icon.aside == root.row-mark ? 36px : 0px;
                    height: 32px;
                    if icon.has-icon && icon.aside == root.row-mark: Image {
                        width: 28px;
                        height: 28px;
                        y: 2px;
                        source: icon.icon;
                        image-fit: contain;
                    }
                }
            }
            LangChip {
                horizontal-stretch: 0;
                width: 52px;
                height: 28px;
                border-radius: 7px;
                label: root.edit-label;
                active: false;
                accessible-label: root.edit-label + ": " + root.name;
                focus-changed(focused) => {
                    root.focus-changed(focused);
                    if (focused) { root.reveal-focus(self.absolute-position.y, self.height); }
                }
                clicked => { root.begin-edit(); }
            }
        }
        if editing: HorizontalLayout {
            spacing: 8px;
            alignment: root.full-mode ? stretch : start;
            cross-axis-alignment: center;
            Rectangle {
                horizontal-stretch: 2;
                min-width: 72px;
                height: 32px;
                clip: true;
                LineEdit {
                    width: 100%;
                    height: 100%;
                    font-size: 13px;
                    placeholder-text: UiLanguage.tr("Alias", "別名");
                    accessible-label: UiLanguage.tr("Alias", "別名");
                    text <=> root.name-draft;
                    init => { self.focus(); }
                    changed has-focus => {
                        root.focus-changed(self.has-focus);
                        if (self.has-focus) { root.reveal-focus(self.absolute-position.y, self.height); }
                    }
                    edited => { root.name-edited(self.text); }
                }
            }
            Rectangle {
                horizontal-stretch: 3;
                min-width: 96px;
                height: 32px;
                clip: true;
                LineEdit {
                    width: 100%;
                    height: 100%;
                    font-size: 13px;
                    placeholder-text: root.find-hint;
                    accessible-label: root.find-hint;
                    text <=> root.find-draft;
                    changed has-focus => {
                        root.focus-changed(self.has-focus);
                        if (self.has-focus) { root.reveal-focus(self.absolute-position.y, self.height); }
                    }
                    edited => { root.find-edited(self.text); }
                    accepted => { root.find-accepted(); }
                }
            }
        }
        if editing: HorizontalLayout {
            width: root.full-mode ? 200px : root.width - 16px;
            spacing: 8px;
            LangChip {
                label: root.save-label;
                active: true;
                focus-changed(focused) => {
                    root.focus-changed(focused);
                    if (focused) { root.reveal-focus(self.absolute-position.y, self.height); }
                }
                clicked => { root.save(); }
            }
            LangChip {
                label: root.delete-label;
                active: false;
                focus-changed(focused) => {
                    root.focus-changed(focused);
                    if (focused) { root.reveal-focus(self.absolute-position.y, self.height); }
                }
                clicked => { root.remove(); }
            }
        }
        if editing: VerticalLayout {
            spacing: 4px;
            alignment: start;
            for icon in root.icons: HorizontalLayout {
                visible: icon.aside == root.row-mark;
                height: icon.aside == root.row-mark ? 32px : 0px;
                spacing: 8px;
                alignment: root.full-mode ? stretch : start;
                if icon.aside == root.row-mark && icon.has-icon: Image {
                    width: 28px;
                    height: 28px;
                    source: icon.icon;
                    image-fit: contain;
                }
                if icon.aside == root.row-mark: Text {
                    text: icon.subtitle;
                    font-size: 12px;
                    color: DesktopTheme.accent;
                    vertical-alignment: center;
                }
                if icon.aside == root.row-mark: Text {
                    horizontal-stretch: 1;
                    min-width: 0px;
                    text: icon.title;
                    font-size: 13px;
                    color: DesktopTheme.text;
                    vertical-alignment: center;
                    overflow: elide;
                }
                if icon.aside == root.row-mark: LangChip {
                    horizontal-stretch: 0;
                    width: 24px;
                    height: 24px;
                    label: "×";
                    active: false;
                    accessible-label: root.delete-label + ": " + icon.title;
                    focus-changed(focused) => {
                        root.focus-changed(focused);
                        if (focused) { root.reveal-focus(self.absolute-position.y, self.height); }
                    }
                    clicked => { root.drop-code(icon.key); }
                }
            }
        }
        if root.suggesting: VerticalLayout {
            spacing: 4px;
            alignment: start;
            for hit[j] in root.hits: Rectangle {
                height: 36px;
                border-radius: 6px;
                background: j == root.pick ? DesktopTheme.selected : DesktopTheme.sidebar;
                border-width: 1px;
                border-color: hit.chip == "yes" ? DesktopTheme.accent : DesktopTheme.border;
                HorizontalLayout {
                    padding-left: 8px;
                    padding-right: 8px;
                    spacing: 8px;
                    alignment: root.full-mode ? stretch : start;
                    cross-axis-alignment: center;
                    height: 100%;
                    Rectangle {
                        width: 16px;
                        height: 100%;
                        Rectangle {
                            width: 16px;
                            height: 16px;
                            y: (parent.height - self.height) / 2;
                            border-radius: 3px;
                            border-width: 1px;
                            border-color: DesktopTheme.accent;
                            background: hit.chip == "yes" ? DesktopTheme.accent : transparent;
                        }
                    }
                    if hit.has-icon: Image {
                        width: 28px;
                        height: 28px;
                        source: hit.icon;
                        image-fit: contain;
                    }
                    Text {
                        horizontal-stretch: 1;
                        min-width: 0px;
                        text: hit.title;
                        font-size: 13px;
                        color: DesktopTheme.text;
                        vertical-alignment: center;
                        overflow: elide;
                    }
                    Text {
                        text: hit.subtitle;
                        font-size: 12px;
                        color: DesktopTheme.accent;
                        vertical-alignment: center;
                    }
                }
                TouchArea {
                    width: 100%;
                    height: 100%;
                    clicked => { root.toggle-hit(j); }
                    mouse-cursor: pointer;
                }
            }
        }
    }
}

component SectionToggle inherits Rectangle {
    in property <string> label;
    in property <bool> open;
    in property <bool> picked;
    callback clicked();
    height: 36px;
    border-radius: 8px;
    background: open ? DesktopTheme.selected : DesktopTheme.surface;
    border-width: picked ? 2px : 1px;
    border-color: picked ? DesktopTheme.accent : DesktopTheme.border;
    Text {
        x: 12px;
        width: parent.width - 40px;
        height: 100%;
        text: root.label;
        font-size: 13px;
        color: DesktopTheme.text;
        vertical-alignment: center;
        overflow: elide;
    }
    Text {
        x: parent.width - 24px;
        width: 16px;
        height: 100%;
        text: open ? "–" : "+";
        font-size: 16px;
        color: DesktopTheme.accent;
        horizontal-alignment: center;
        vertical-alignment: center;
    }
    TouchArea {
        width: 100%;
        height: 100%;
        clicked => { root.clicked(); }
        mouse-cursor: pointer;
    }
}

component DockSortRow inherits Rectangle {
    in property <string> label;
    in property <string> badge;
    in property <image> logo;
    in property <string> glyph: "";
    in property <bool> on;
    in property <bool> lifted;
    in property <bool> marked;
    in property <bool> english: false;
    in property <bool> focus-requested: false;
    out property <length> focus-y: self.absolute-position.y;
    out property <bool> has-focus: row-focus.has-focus;
    callback focus-changed(bool);
    callback move-step(int);
    callback toggled();
    callback grip-pressed(length);
    callback grip-moved(length);
    callback grip-released();
    callback grip-cancelled();
    height: 44px;
    border-radius: 8px;
    background: lifted ? DesktopTheme.raised : (marked ? DesktopTheme.selection-low : DesktopTheme.surface);
    border-width: 1px;
    border-color: row-focus.has-focus || marked || lifted ? DesktopTheme.accent : DesktopTheme.border;
    forward-focus: row-focus;
    accessible-role: checkbox;
    accessible-label: root.label;
    accessible-checkable: true;
    accessible-checked: root.on;
    accessible-description: (root.badge != "–" ? root.badge + ". " : "") + (UiLanguage.tr("Space: show or hide. Alt + Up / Down: move.", "空白鍵：顯示或隱藏。Alt + 上／下：調整順序。"));
    accessible-action-default => { row-focus.focus(); root.toggled(); }
    init => { if (root.focus-requested) { row-focus.focus(); } }
    changed focus-requested => { if (root.focus-requested) { row-focus.focus(); } }
    row-focus := FocusScope {
        width: 100%; height: 100%;
        focus-on-click: false;
        focus-gained => { root.focus-changed(true); }
        focus-lost => { root.focus-changed(false); }
        key-pressed(event) => {
            if (event.text == Key.Return || event.text == Key.Space) {
                root.toggled();
                return accept;
            }
            if (event.modifiers.alt && event.text == Key.UpArrow) {
                root.move-step(-1);
                return accept;
            }
            if (event.modifiers.alt && event.text == Key.DownArrow) {
                root.move-step(1);
                return accept;
            }
            return reject;
        }
    }
    HorizontalLayout {
        width: 100%;
        padding-left: 4px;
        padding-right: 10px;
        spacing: 8px;
        cross-axis-alignment: center;
        Rectangle {
            horizontal-stretch: 1;
            height: 40px;
            HorizontalLayout {
                spacing: 8px;
                alignment: start;
                cross-axis-alignment: center;
                Text {
                    width: 16px;
                    text: "⋮⋮";
                    font-size: 14px;
                    color: DesktopTheme.muted;
                    vertical-alignment: center;
                }
                Rectangle {
                    width: 36px;
                    height: 36px;
                    border-radius: 8px;
                    background: DesktopTheme.inset;
                    border-width: 1px;
                    border-color: DesktopTheme.border;
                    if root.glyph == "": Image {
                        source: root.logo;
                        width: 26px;
                        height: 26px;
                        x: 5px;
                        y: 5px;
                        image-fit: contain;
                    }
                    if root.glyph != "": Text {
                        width: 100%;
                        height: 100%;
                        text: root.glyph;
                        font-size: 16px;
                        color: DesktopTheme.accent;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                    }
                }
                Text {
                    width: 28px;
                    text: root.badge;
                    font-size: 12px;
                    font-weight: 700;
                    color: root.on ? DesktopTheme.accent : DesktopTheme.muted;
                    vertical-alignment: center;
                }
                Text {
                    text: root.label;
                    font-size: 14px;
                    color: root.on ? DesktopTheme.text : DesktopTheme.muted;
                    vertical-alignment: center;
                }
            }
            grip := TouchArea {
                width: 100%;
                height: 100%;
                mouse-cursor: grab;
                pointer-event(event) => {
                    if (event.button == PointerEventButton.left && event.kind == PointerEventKind.down) {
                        row-focus.focus();
                        root.grip-pressed(self.mouse-y);
                    }
                    if (event.button == PointerEventButton.left && event.kind == PointerEventKind.up) {
                        root.grip-released();
                    }
                    if (event.kind == PointerEventKind.cancel) {
                        root.grip-cancelled();
                    }
                }
                moved => {
                    if (self.pressed) {
                        root.grip-moved(self.mouse-y);
                    }
                }
            }
        }
        Rectangle {
            width: 36px;
            height: 20px;
            border-radius: 10px;
            background: root.on ? DesktopTheme.accent : DesktopTheme.border;
            Rectangle {
                width: 14px;
                height: 14px;
                border-radius: 7px;
                x: root.on ? 19px : 3px;
                y: 3px;
                background: root.on ? DesktopTheme.on-accent : DesktopTheme.secondary;
            }
            TouchArea {
                width: 100%;
                height: 100%;
                clicked => { row-focus.focus(); root.toggled(); }
                mouse-cursor: pointer;
            }
        }
    }
}

component KeyLine inherits Rectangle {
    in property <string> keys;
    in property <string> action;
    in property <bool> wrap-action: false;
    property <length> key-width: wrap-action ? 96px : 188px;
    height: wrap-action ? max(28px, action-copy.preferred-height + 8px) : 28px;
    HorizontalLayout {
        width: 100%; height: 100%; spacing: 16px;
        key-box := Rectangle {
            width: root.key-width;
            clip: true;
            Text {
                width: parent.width; height: 100%;
                text: root.keys; font-size: 13px; font-weight: 600;
                color: DesktopTheme.accent; vertical-alignment: center; overflow: elide;
            }
        }
        action-copy := Text {
            width: max(root.width - root.key-width - 16px, 40px);
            horizontal-stretch: 1;
            text: root.action; font-size: 13px; color: DesktopTheme.secondary;
            vertical-alignment: center;
            wrap: root.wrap-action ? word-wrap : no-wrap;
            overflow: elide;
        }
    }
}

component CategoryTile inherits Rectangle {
    in property <image> logo;
    in property <string> glyph: "";
    in property <string> name;
    in property <bool> selected: false;
    in property <bool> arranging: false;
    in property <bool> lifted: false;
    in property <bool> drop-target: false;
    callback clicked();
    callback pressed(length, length);
    callback dragged(length, length);
    callback released();
    callback long-pressed(length, length);
    property <bool> arming: false;
    property <bool> latched: false;
    property <length> origin-x: 0px;
    property <length> origin-y: 0px;
    property <float> hold: arming ? 1 : 0;
    property <length> badge: min(max(root.width - 20px, 28px), max(root.height - 40px, 28px));
    animate hold {
        duration: 420ms;
        easing: linear;
    }
    changed hold => {
        if (root.hold > 0.98 && root.arming && !root.latched && !root.arranging) {
            root.latched = true;
            root.arming = false;
            root.long-pressed(area.mouse-x, area.mouse-y);
        }
    }
    border-radius: min(16px, root.width * 0.12);
    background: lifted ? DesktopTheme.raised : (selected || drop-target || area.has-hover ? DesktopTheme.selected : DesktopTheme.surface);
    border-width: selected || drop-target || lifted ? 2px : 1px;
    border-color: selected || drop-target || lifted ? DesktopTheme.accent : arranging ? DesktopTheme.accent : (area.has-hover ? DesktopTheme.accent : DesktopTheme.border);
    opacity: lifted ? 0.72 : 1;
    VerticalLayout {
        alignment: center;
        spacing: root.width < 120px ? 6px : 10px;
        HorizontalLayout {
            alignment: center;
            Rectangle {
                width: root.badge;
                height: root.badge;
                border-radius: root.badge * 0.2;
                background: DesktopTheme.inset;
                border-width: 1px;
                border-color: DesktopTheme.border;
                if root.glyph == "": Image {
                    source: root.logo;
                    width: root.badge * 0.84;
                    height: root.badge * 0.84;
                    image-fit: contain;
                    x: root.badge * 0.08;
                    y: root.badge * 0.08;
                }
                if root.glyph != "": Text {
                    width: 100%;
                    height: 100%;
                    text: root.glyph;
                    font-size: root.badge * 0.38;
                    color: DesktopTheme.accent;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                }
            }
        }
        Text {
            width: root.width - 12px;
            text: root.name;
            font-size: root.width < 120px ? 12px : 14px;
            font-weight: 600;
            color: DesktopTheme.text;
            horizontal-alignment: center;
            overflow: elide;
        }
    }
    area := TouchArea {
        width: 100%;
        height: 100%;
        clicked => {
            if (!root.arranging && !root.latched) {
                root.clicked();
            }
        }
        pointer-event(event) => {
            if (event.button != PointerEventButton.left) {
                return;
            }
            if (event.kind == PointerEventKind.down) {
                root.origin-x = self.mouse-x;
                root.origin-y = self.mouse-y;
                if (root.arranging) {
                    root.pressed(self.mouse-x, self.mouse-y);
                } else {
                    root.latched = false;
                    root.arming = true;
                }
            }
            if (event.kind == PointerEventKind.up) {
                root.arming = false;
                if (root.arranging) {
                    root.released();
                }
            }
        }
        moved => {
            if (root.arming && !root.latched && (self.mouse-x < root.origin-x - 8px || self.mouse-x > root.origin-x + 8px || self.mouse-y < root.origin-y - 8px || self.mouse-y > root.origin-y + 8px)) {
                root.arming = false;
            }
            if (root.arranging && self.pressed) {
                root.dragged(self.mouse-x, self.mouse-y);
            }
        }
        mouse-cursor: root.arranging ? grab : pointer;
    }
}

component HitRow inherits Rectangle {
    in property <Hit> hit;
    in property <color> title-color: DesktopTheme.text;
    in property <bool> selected: false;
    in property <bool> keyboard-focused: false;
    in property <bool> compact: false;
    in property <string> no-image-label: UiLanguage.tr("No image", "沒有圖片");
    callback clicked();
    callback favourite-clicked();
    callback focus-changed(bool);
    forward-focus: focus;
    accessible-role: button;
    accessible-enabled: !root.heading;
    accessible-label: root.hit.title;
    accessible-description: RecordText.description(root.hit) + "\nCtrl+I: " + UiLanguage.tr("Full names and source", "完整名稱與來源");
    accessible-action-default => { if (!root.heading) { root.clicked(); } }
    height: compact ? 36px : 52px;
    border-radius: 8px;
    border-width: 1px;
    border-color: focus.has-focus || root.keyboard-focused ? DesktopTheme.accent : root.selected ? DesktopTheme.border : transparent;
    property <bool> heading: hit.chip == "label";
    background: selected ? DesktopTheme.selected : (root.hit.chip == "section" || root.heading) ? (area.has-hover && !root.heading ? DesktopTheme.hover : DesktopTheme.surface-alt) : (area.has-hover ? DesktopTheme.hover : transparent);
    property <bool> marked: hit.can-favourite || hit.favourite;
    property <length> tail: (marked ? 62px : 0px) + (!marked && hit.has-badge ? 26px : 0px);
    property <bool> show-chip: hit.chip == "yes" || hit.chip == "no";
    property <bool> disclosure: hit.chip == "section";
    property <bool> disclosure-open: disclosure && hit.aside == "▼";
    property <bool> show-aside: !root.show-chip && !root.disclosure && hit.aside != "";
    property <length> chip-w: 68px;
    property <length> aside-box: root.show-chip ? root.chip-w : 108px;
    focus := FocusScope {
        x: 0px; y: 0px; width: 100%; height: 100%;
        enabled: !root.heading && (root.hit.key != "" || root.disclosure);
        focus-gained => { root.focus-changed(true); }
        focus-lost => { root.focus-changed(false); }
        key-pressed(event) => {
            if ((event.modifiers.control || event.modifiers.meta) && (event.text == "i" || event.text == "I")) { RecordInfo.show(root.hit); return accept; }
            if (event.text == Key.Return || event.text == Key.Space) { root.clicked(); return accept; }
            return reject;
        }
    }
    area := TouchArea {
        x: 0px;
        width: parent.width - root.tail;
        height: 100%;
        clicked => { focus.focus(); root.clicked(); }
        mouse-cursor: root.hit.key == "" && !root.disclosure ? default : pointer;
        HorizontalLayout {
            width: 100%;
            height: 100%;
            padding-left: 8px;
            padding-right: root.show-aside || root.show-chip ? root.aside-box + 12px : 8px;
            spacing: 8px;
            alignment: start;
            cross-axis-alignment: center;
            if root.hit.has-icon: Image {
                source: root.hit.icon;
                width: root.compact ? 22px : 36px;
                height: root.compact ? 22px : 36px;
                image-fit: contain;
            }
            if root.hit.no-image: NoImage {
                side: root.compact ? 28px : 36px;
                label: root.no-image-label;
            }
            VerticalLayout {
                horizontal-stretch: 1;
                min-width: 0px;
                alignment: center;
                cross-axis-alignment: stretch;
                Text {
                    horizontal-stretch: 1;
                    min-width: 0px;
                    text: root.hit.title;
                    overflow: elide;
                    font-weight: root.heading ? 600 : 400;
                    horizontal-alignment: left;
                    vertical-alignment: center;
                    color: root.hit.chip == "section" || root.heading ? DesktopTheme.accent : root.hit.solo ? #e24b4b : root.title-color;
                }
                if RecordText.secondary(root.hit) != "": Text {
                    horizontal-stretch: 1;
                    min-width: 0px;
                    text: RecordText.secondary(root.hit);
                    overflow: elide;
                    font-size: root.compact ? 11px : 12px;
                    horizontal-alignment: left;
                    vertical-alignment: center;
                    color: root.hit.solo ? #e24b4b : DesktopTheme.secondary;
                }
            }
        }
    }
    if root.show-chip: Rectangle {
        x: parent.width - root.tail - 8px - root.chip-w;
        y: (parent.height - 22px) / 2;
        width: root.chip-w;
        height: 22px;
        border-radius: 11px;
        background: root.hit.chip == "yes" ? #1d6b43 : #8a4034;
        Text {
            width: 100%;
            height: 100%;
            text: root.hit.aside;
            font-size: 11px;
            font-weight: 700;
            color: root.hit.chip == "yes" ? #e8f7ee : #fdece8;
            horizontal-alignment: center;
            vertical-alignment: center;
        }
    }
    if root.disclosure: Path {
        x: parent.width - 22px;
        y: (parent.height - 10px) / 2;
        width: 10px;
        height: 10px;
        stroke: DesktopTheme.muted;
        stroke-width: 1.6px;
        commands: root.disclosure-open ? "M 1 3 L 5 7 L 9 3" : "M 3 1 L 7 5 L 3 9";
    }
    if root.show-aside: Text {
        x: parent.width - root.tail - 10px - root.aside-box;
        y: 0px;
        width: root.aside-box;
        height: parent.height;
        text: root.hit.aside;
        font-size: 13px;
        font-weight: 600;
        color: DesktopTheme.accent;
        horizontal-alignment: right;
        vertical-alignment: center;
        overflow: elide;
    }
    if root.hit.has-badge: Image {
        x: parent.width - (root.marked ? 40px : 8px) - 18px;
        y: (parent.height - 18px) / 2;
        width: 18px;
        height: 18px;
        source: root.hit.badge;
        image-fit: contain;
    }
    if root.marked: StarMark {
        x: parent.width - 36px;
        y: (parent.height - self.height) / 2;
        filled: root.hit.favourite;
        clicked => {
            if (root.hit.can-favourite) {
                root.favourite-clicked();
            } else {
                root.clicked();
            }
        }
    }
    Tooltip {
        RecordTooltip { text: RecordText.full(root.hit); }
    }
}

component MetaRow inherits Rectangle {
    in property <string> label;
    in property <string> value;
    visible: value != "";
    height: value == "" ? 0px : 16px;
    HorizontalLayout {
        width: 100%;
        height: 100%;
        spacing: 8px;
        Text {
            width: 52px;
            text: root.label;
            font-size: 11px;
            color: DesktopTheme.muted;
            vertical-alignment: center;
            overflow: elide;
        }
        Text {
            horizontal-stretch: 1;
            text: root.value;
            font-size: 12px;
            color: DesktopTheme.text;
            vertical-alignment: center;
            overflow: elide;
        }
    }
}

