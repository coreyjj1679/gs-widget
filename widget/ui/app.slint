component PatchPill inherits Rectangle {
    in property <string> label;
    in property <bool> active;
    callback clicked();
    height: 26px;
    border-radius: 13px;
    background: active ? #d4b483 : #1c1916;
    border-width: 1px;
    border-color: active ? #d4b483 : #3a342c;
    label-text := Text {
        x: 12px;
        height: 100%;
        text: root.label;
        font-size: 12px;
        font-weight: 600;
        color: active ? #1a140e : #c8bfb4;
        vertical-alignment: center;
    }
    width: label-text.preferred-width + 24px;
    tap := TouchArea {
        width: 100%;
        height: 100%;
        clicked => { root.clicked(); }
