                                        x: mod(i, root.monster-board-columns) * (self.width + 16px);
                                        y: floor(i / root.monster-board-columns) * root.monster-row + (root.detail-index >= 0 && floor(i / root.monster-board-columns) > floor(root.detail-index / root.monster-board-columns) ? root.detail-h : 0px);
                                        width: (parent.width - (root.monster-board-columns - 1) * 16px) / root.monster-board-columns;
                                        height: root.monster-row - 8px;
                                        if root.detail-key == mon.key || (board-row-slot.y + board-row-slot.height >= -root.list-offset - 2 * root.monster-row && board-row-slot.y <= -root.list-offset + monster-board-list.height + 2 * root.monster-row): MonsterTableRow {
