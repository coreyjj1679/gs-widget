                    if root.viewing != "" && !root.record-sheet && !root.quest-sheet && root.category != "patch" && root.links.length > 0 && (!root.monster-sheet || root.drops-open) && !root.related-open: drops := Flickable {
                        x: root.monster-sheet ? root.side-gap : 0px;
                        y: root.monster-sheet ? root.drops-panel-y : (root.viewing-hero ? 124px : 240px);
                        width: root.monster-sheet ? max(parent.width - 2 * root.side-gap, 40px) : max(root.width - 28px, 40px);
                        height: root.monster-sheet ? root.drops-panel-h : (root.viewing-hero ? max(root.height - foot - 136px, 180px) : max(root.height - foot - 310px, 120px));
