                        wrap: word-wrap;
                        overflow: elide;
                        font-size: 13px;
                        color: DesktopTheme.soft;
                    }
                    if root.card-sheet && !root.quest-sheet && root.links.length > 0 && (!root.viewing-item || root.item-links || root.full-item-sheet): Rectangle {
                        x: root.item-sources-x;
                        y: root.card-list-y;
                        width: root.item-sources-w;
                        height: root.card-list-h;
