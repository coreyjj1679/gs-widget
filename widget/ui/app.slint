                                    x: 0px; y: 84px; width: parent.width - 16px; height: 32px;
                                    placeholder-text: UiLanguage.tr("Find a region…", "搜尋地區…");
                                    accessible-label: UiLanguage.tr("Find a region", "搜尋地區");
                                    text <=> root.region-query;
                                    edited => { root.refine-regions(); }
                                    accepted => { if (root.region-rows.length > 0) { root.region-cursor = 1; root.move-region(1); } }
                                    key-pressed(event) => {
                                        if (event.text == Key.Escape) {
                                            root.region-query = ""; root.refine-regions(); keys.focus(); return accept;
                                        }
                                        if (event.text == Key.DownArrow) { if (root.region-rows.length > 0) { root.region-cursor = 1; root.move-region(1); } return accept; }
                                        if (event.text == Key.UpArrow) { return accept; }
                                        return reject;
                                    }
