                                last: i + 1 == root.reward-facts.length;
                            }
                        }
                    }
                    if root.card-sheet && !root.quest-sheet && !root.viewing-item && (root.links.length == 0 || root.links[0].chip != "section") && (root.links.length > 0 || root.category != "hero"): Text {
                        x: root.side-gap;
                        y: root.card-list-y - 22px;
                        text: (root.category == "hero" ? (UiLanguage.tr("Class line", "轉職")) : root.quest-sheet ? (UiLanguage.tr("Links", "連結")) : root.viewing-npc ? (UiLanguage.tr("Quests", "任務")) : root.recipe-sheet ? (UiLanguage.tr("Materials", "材料")) : (UiLanguage.tr("Dropped by", "會掉落的怪物"))) + "  " + root.links.length;
                        font-size: 12px;
                        color: DesktopTheme.secondary;
                    }
                    if root.card-sheet && !root.quest-sheet && root.links.length == 0 && root.category != "hero" && (!root.viewing-item || root.item-links || root.full-item-sheet): Text {
                        x: root.item-sources-x;
                        y: root.card-list-y;
                        width: root.item-sources-w;
