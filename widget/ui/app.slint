    height: side;
    border-radius: 4px;
    background: DesktopTheme.surface;
    border-width: 1px;
    border-color: DesktopTheme.border;
    Text {
        width: parent.width - 4px;
        height: parent.height - 2px;
        text: root.label;
        wrap: word-wrap;
        font-size: root.side >= 56px ? 12px : 8px;
