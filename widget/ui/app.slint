                                width: max(reward-box.width - 8px, 40px);
                                selected: root.cursor == i && root.next-focus < 0 && root.task-focus < 0;
                                hit: row;
                                keyboard-focused: keys.has-focus && self.selected;
                                focus-changed(focused) => { if (focused) { RecordInfo.text = ""; root.focus-reward(i); } }
                                no-image-label: root.no-image-label;
                                clicked => {
                                    root.cursor = i;
                                    root.open-hit(row.key);
                                }
                            }
                            for fact[i] in root.reward-facts: FactLine {
                                y: root.links.length * root.link-row + i * 30px;
                                width: reward-box.width;
