import { Palette, LineEdit, TextEdit } from "std-widgets.slint";

export struct Hit {
    title: string,
    subtitle: string,
    key: string,
    icon: image,
    has-icon: bool,
    no-image: bool,
    can-favourite: bool,
    favourite: bool,
    solo: bool,
    has-badge: bool,
    badge: image,
    aside: string,
    chip: string,
}

export struct Fact {
    label: string,
    value: string,
    key: string,
    icon: image,
    has-icon: bool,
    section: string,
}

export struct AliasRow {
    name: string,
    codes: string,
    detail: string,
    count: int,
}

struct Category {
    id: string,
    name: string,
}

component NoImage inherits Rectangle {
    in property <string> label;
    in property <length> side: 36px;
    width: side;
    height: side;
    border-radius: 4px;
    background: #1c1916;
    border-width: 1px;
    border-color: #3a342c;
    Text {
        width: parent.width - 4px;
        height: parent.height - 2px;
        text: root.label;
        wrap: word-wrap;
        font-size: root.side >= 56px ? 12px : 8px;
        color: #a3988c;
        horizontal-alignment: center;
        vertical-alignment: center;
    }
}

component WinButton inherits Rectangle {
    in property <string> glyph;
    in property <bool> danger: false;
    callback clicked();
    width: glyph == "設定" ? 48px : glyph == "Setting" ? 64px : glyph == "EN" ? 34px : 30px;
    height: 24px;
    border-radius: 6px;
    background: tap.has-hover ? (danger ? #7f1d1d : #5c4e3a) : (danger ? #4a3030 : #3f362c);
    Text {
        text: root.glyph;
        color: #f3efe8;
        font-size: 12px;
        horizontal-alignment: center;
        vertical-alignment: center;
    }
    tap := TouchArea {
        width: 100%;
        height: 100%;
        clicked => { root.clicked(); }
        mouse-cursor: pointer;
    }
}

component SearchToggle inherits Rectangle {
    in property <bool> open;
    in property <string> label;
    callback clicked();
    height: 28px;
    border-radius: 7px;
    background: open ? #d4b483 : (tap.has-hover ? #5c4e3a : #3f362c);
    label-text := Text {
        x: 12px;
        text: root.label;
        color: open ? #1a140e : #f3efe8;
        font-size: 12px;
        font-weight: 600;
        vertical-alignment: center;
    }
    width: label-text.preferred-width + 24px;
    tap := TouchArea {
        width: 100%;
        height: 100%;
        clicked => { root.clicked(); }
        mouse-cursor: pointer;
    }
}

component StarMark inherits Rectangle {
    in property <bool> filled;
    callback clicked();
    width: 32px;
    height: 32px;
    Path {
        x: 6px;
        y: 5px;
        width: 20px;
        height: 20px;
        fill: root.filled ? #d4b483 : transparent;
        stroke: root.filled ? #e6c98a : #8a8076;
        stroke-width: 1.4px;
        commands: "M 10 0.6 L 12.7 6.4 L 19 6.9 L 14.2 11.1 L 15.8 17.4 L 10 14 L 4.2 17.4 L 5.8 11.1 L 1 6.9 L 7.3 6.4 Z";
    }
    TouchArea {
        width: 100%;
        height: 100%;
        clicked => { root.clicked(); }
        mouse-cursor: pointer;
    }
}

