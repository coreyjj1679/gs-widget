                            font-size: 13px;
                            color: DesktopTheme.text;
                        }
                    }
                    item-source-note := Text {
                        changed preferred-height => { root.item-source-text-h = self.preferred-height; }
                        visible: (root.item-links || root.full-item-sheet) && root.source-note != "";
                        x: root.item-sources-x;
                        y: root.item-form-y;
