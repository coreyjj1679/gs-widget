                        content-y: root.next-focus < 1 ? 0px : -min(root.next-focus * 44px, max(root.chain-next.length * 44px - self.height, 0px));
                        for row[i] in root.chain-next: ChainButton {
                            y: i * 44px;
                            width: next-scroll.width;
                            end: true;
                            picked: root.next-focus == i;
                            caption: UiLanguage.tr("Next  →", "下一個  →");
                            name: row.title;
                            clicked => {
                                root.next-focus = i;
                                root.open-hit(row.key);
                            }
                        }
                    }
                    if root.category == "patch" && root.viewing != "": Rectangle {
                        x: root.page-pad;
                        y: 54px;
                        width: max(root.pane-w - 2 * root.page-pad, 40px);
                        height: max(parent.height - 70px, 80px);
                        background: DesktopTheme.surface;
                        border-radius: 10px;
                        border-width: 1px;
                        border-color: DesktopTheme.border;
                        note := TextEdit {
                            x: 16px;
                            y: 14px;
                            width: parent.width - 32px;
                            height: parent.height - 28px;
                            text: root.detail;
                            read-only: true;
                            wrap: word-wrap;
                            font-size: 15px;
                            init => { self.focus(); }
                        }
                    }
                    if root.monster-page-settings-visible: MonsterPageSettings {
                        x: 0px; y: 0px; width: 100%; height: 100%;
                        english: UiLanguage.primary == "en";
