                        DesktopEntry {
                            y: 220px; width: parent.width; height: 88px;
                            title: UiLanguage.tr("Quests & crafting", "任務與製作");
                            description: UiLanguage.tr("Follow quest chains and their rewards", "追蹤任務流程、條件與獎勵");
                            logo: root.category-logo(3);
                            clicked => { root.open-category("quest"); keys.focus(); }
                        }
                        HorizontalLayout {
                            y: 338px; width: parent.width; height: 32px; spacing: 8px;
                            FilterChip { label: UiLanguage.tr("Recipes", "合成配方"); clicked => { root.open-category("recipe"); keys.focus(); } }
                            FilterChip { label: UiLanguage.tr("Production", "生產"); clicked => { root.open-category("works"); keys.focus(); } }
                            FilterChip { label: UiLanguage.tr("Shops", "商店"); clicked => { root.open-category("atlas"); keys.focus(); } }
                        }
                    }
                    Rectangle {
                        x: 44px + (parent.width - 72px) * 0.56;
                        y: 116px;
                        width: (parent.width - 72px) * 0.44;
                        height: max(parent.height - 144px, 380px);
                        background: DesktopTheme.surface;
                        border-radius: 12px;
                        Text {
                            x: 20px; y: 18px;
                            text: UiLanguage.tr("Your favourites", "我的收藏");
                            font-size: 15px; font-weight: 600; color: DesktopTheme.text;
                        }
                        if root.hits.length > 0: Text {
                            x: parent.width - 60px; y: 20px; width: 40px;
                            text: root.hits.length; color: DesktopTheme.muted; font-size: 12px;
                            horizontal-alignment: right;
                        }
                        Rectangle { x: 20px; y: 50px; width: parent.width - 40px; height: 1px; background: DesktopTheme.border; }
                        if root.hits.length == 0: Rectangle {
                            y: 88px; width: parent.width; height: 228px;
                            DesktopIcon {
                                x: (parent.width - 32px) / 2; y: 22px; width: 32px; height: 32px;
                                ink: DesktopTheme.accent;
                                path: "M12 2 L15 8.5 L22 9.3 L17 14.2 L18.3 21 L12 17.6 L5.7 21 L7 14.2 L2 9.3 L9 8.5 Z";
                            }
                            Text { x: 20px; y: 76px; width: parent.width - 40px; text: UiLanguage.tr("Keep your next target close", "把常看的怪物留在這裡"); horizontal-alignment: center; font-size: 14px; font-weight: 500; color: DesktopTheme.text; }
                            Text { x: 28px; y: 108px; width: parent.width - 56px; text: UiLanguage.tr("Star a monster to return to its stats and drops in one click.", "在怪物旁點星號，下次直接查看能力與掉落物。"); horizontal-alignment: center; wrap: word-wrap; font-size: 12px; color: DesktopTheme.secondary; }
                            SearchToggle { x: (parent.width - self.width) / 2; y: 168px; label: UiLanguage.tr("Explore monsters", "瀏覽怪物"); clicked => { root.open-category("monster"); keys.focus(); } }
                        }
                        if root.hits.length > 0: home-favourites := Flickable {
