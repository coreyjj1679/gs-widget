component OpacitySlider inherits Rectangle {
    in property <float> value: 1;
    callback edited(float);
    height: 22px;
    property <float> ratio: max(0, min(1, (root.value - 0.25) / 0.75));

    function pick(x: length) {
        if (track.width <= 1px) {
            return;
        }
        root.edited(0.25 + max(0, min(1, x / track.width)) * 0.75);
    }

    track := Rectangle {
        y: (parent.height - self.height) / 2;
        width: 100%;
        height: 6px;
        border-radius: 3px;
        background: DesktopTheme.border;
        Rectangle {
            x: 0px;
            width: parent.width * root.ratio;
            height: 100%;
            border-radius: 3px;
            background: DesktopTheme.accent;
        }
        Rectangle {
            width: 14px;
            height: 14px;
            border-radius: 7px;
            y: -4px;
            x: min(max(0px, parent.width * root.ratio - 7px), max(0px, parent.width - 14px));
            background: DesktopTheme.text;
            border-width: 1px;
            border-color: DesktopTheme.accent;
        }
        TouchArea {
            y: -10px;
            width: 100%;
            height: 26px;
            mouse-cursor: pointer;
            pointer-event(event) => {
                if (event.button == PointerEventButton.left && event.kind == PointerEventKind.down) {
                    root.pick(self.mouse-x);
                }
            }
            moved => {
                if (self.pressed) {
                    root.pick(self.mouse-x);
                }
            }
        }
    }
}

component AliasCard inherits Rectangle {
    in property <string> name;
    in property <string> codes;
    in property <string> detail;
    in property <bool> editing;
    in-out property <string> name-draft;
    in-out property <string> codes-draft;
    callback name-edited(string);
    callback codes-edited(string);
    callback remove();
    callback find-edited(string);
    callback find-accepted();
    callback choose(string);
    callback drop-code(string);
    callback begin-edit();
    callback done();
    callback save();
    callback toggle-hit(int);
    in property <string> find-hint: "搜尋道具";
    in property <string> edit-label: "編輯";
    in property <string> save-label: "儲存";
    in property <string> delete-label: "刪除";
    in property <string> row-mark: "";
    in property <int> count: 0;
    in property <[Hit]> icons;
    in property <bool> suggesting: false;
    in property <[Hit]> hits;
    in property <int> pick: 0;
    in-out property <string> find-draft: "";
    init => {
        root.name-draft = root.name;
        root.codes-draft = root.codes;
    }
    changed name => { root.name-draft = root.name; }
    changed codes => { root.codes-draft = root.codes; }
    border-radius: 8px;
    background: DesktopTheme.surface;
    border-width: 1px;
    border-color: DesktopTheme.border;
    clip: true;
    VerticalLayout {
        padding: 8px;
        spacing: 8px;
        alignment: start;
        if !editing: HorizontalLayout {
            width: 100%;
            spacing: 10px;
            alignment: stretch;
            cross-axis-alignment: center;
            Text {
                text: root.name;
                width: 72px;
                horizontal-stretch: 0;
                font-size: 14px;
                font-weight: 700;
                color: DesktopTheme.accent;
                vertical-alignment: center;
                overflow: elide;
            }
            HorizontalLayout {
                horizontal-stretch: 1;
                spacing: 0px;
                alignment: start;
                for icon in root.icons: Rectangle {
                    visible: icon.aside == root.row-mark;
                    width: icon.aside == root.row-mark ? 36px : 0px;
                    height: 32px;
                    if icon.has-icon && icon.aside == root.row-mark: Image {
                        width: 28px;
                        height: 28px;
                        y: 2px;
                        source: icon.icon;
                        image-fit: contain;
                    }
                }
            }
            Rectangle {
                horizontal-stretch: 0;
                width: 52px;
                height: 28px;
                border-radius: 7px;
                background: edit-tap.has-hover ? DesktopTheme.hover-strong : DesktopTheme.control;
                Text {
                    width: 100%;
                    height: 100%;
                    text: root.edit-label;
                    font-size: 12px;
                    color: DesktopTheme.text;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                }
                edit-tap := TouchArea {
                    width: 100%;
                    height: 100%;
                    clicked => { root.begin-edit(); }
                    mouse-cursor: pointer;
                }
            }
        }
        if editing: HorizontalLayout {
            spacing: 8px;
            alignment: start;
            cross-axis-alignment: center;
            Rectangle {
                horizontal-stretch: 2;
                min-width: 72px;
                height: 32px;
                clip: true;
                LineEdit {
                    width: 100%;
                    height: 100%;
                    font-size: 13px;
                    placeholder-text: "ALIAS";
                    text <=> root.name-draft;
                    edited => { root.name-edited(self.text); }
                }
            }
            Rectangle {
                horizontal-stretch: 3;
                min-width: 96px;
                height: 32px;
                clip: true;
                LineEdit {
                    width: 100%;
                    height: 100%;
                    font-size: 13px;
                    placeholder-text: root.find-hint;
                    text <=> root.find-draft;
                    edited => { root.find-edited(self.text); }
                    accepted => { root.find-accepted(); }
                }
            }
        }
        if editing: HorizontalLayout {
            spacing: 8px;
            LangChip {
                label: root.save-label;
                active: true;
                clicked => { root.save(); }
            }
            LangChip {
                label: root.delete-label;
                active: false;
                clicked => { root.remove(); }
            }
        }
        if editing: VerticalLayout {
            spacing: 4px;
            alignment: start;
            for icon in root.icons: HorizontalLayout {
                visible: icon.aside == root.row-mark;
                height: icon.aside == root.row-mark ? 32px : 0px;
                spacing: 8px;
                alignment: start;
                if icon.aside == root.row-mark && icon.has-icon: Image {
                    width: 28px;
                    height: 28px;
                    source: icon.icon;
                    image-fit: contain;
                }
                if icon.aside == root.row-mark: Text {
                    text: icon.subtitle;
                    font-size: 12px;
                    color: DesktopTheme.accent;
                    vertical-alignment: center;
                }
                if icon.aside == root.row-mark: Text {
                    horizontal-stretch: 1;
                    text: icon.title;
                    font-size: 13px;
                    color: DesktopTheme.text;
                    vertical-alignment: center;
                    overflow: elide;
                }
                if icon.aside == root.row-mark: Rectangle {
                    width: 24px;
                    height: 24px;
                    Text {
                        width: 100%;
                        height: 100%;
                        text: "×";
                        font-size: 14px;
                        color: DesktopTheme.secondary;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                    }
                    TouchArea {
                        width: 100%;
                        height: 100%;
                        clicked => { root.drop-code(icon.key); }
                        mouse-cursor: pointer;
                    }
                }
            }
        }
        if root.suggesting: VerticalLayout {
            spacing: 4px;
            alignment: start;
            for hit[j] in root.hits: Rectangle {
                height: 36px;
                border-radius: 6px;
                background: j == root.pick ? DesktopTheme.selected : DesktopTheme.sidebar;
                border-width: 1px;
                border-color: hit.chip == "yes" ? DesktopTheme.accent : DesktopTheme.border;
                HorizontalLayout {
                    padding-left: 8px;
                    padding-right: 8px;
                    spacing: 8px;
                    alignment: start;
                    cross-axis-alignment: center;
                    height: 100%;
                    Rectangle {
                        width: 16px;
                        height: 100%;
                        Rectangle {
                            width: 16px;
                            height: 16px;
                            y: (parent.height - self.height) / 2;
                            border-radius: 3px;
                            border-width: 1px;
                            border-color: DesktopTheme.accent;
                            background: hit.chip == "yes" ? DesktopTheme.accent : transparent;
                        }
                    }
                    if hit.has-icon: Image {
                        width: 28px;
                        height: 28px;
                        source: hit.icon;
                        image-fit: contain;
                    }
                    Text {
                        horizontal-stretch: 1;
                        text: hit.title;
                        font-size: 13px;
                        color: DesktopTheme.text;
                        vertical-alignment: center;
                        overflow: elide;
                    }
                    Text {
                        text: hit.subtitle;
                        font-size: 12px;
                        color: DesktopTheme.accent;
                        vertical-alignment: center;
                    }
                }
                TouchArea {
                    width: 100%;
                    height: 100%;
                    clicked => { root.toggle-hit(j); }
                    mouse-cursor: pointer;
                }
            }
        }
    }
}

component SectionToggle inherits Rectangle {
    in property <string> label;
    in property <bool> open;
    in property <bool> picked;
    callback clicked();
    height: 36px;
    border-radius: 8px;
    background: open ? DesktopTheme.selected : DesktopTheme.surface;
    border-width: picked ? 2px : 1px;
    border-color: picked ? DesktopTheme.accent : DesktopTheme.border;
    Text {
        x: 12px;
        width: parent.width - 40px;
        height: 100%;
        text: root.label;
        font-size: 13px;
        color: DesktopTheme.text;
        vertical-alignment: center;
        overflow: elide;
    }
    Text {
        x: parent.width - 24px;
        width: 16px;
        height: 100%;
        text: open ? "–" : "+";
        font-size: 16px;
        color: DesktopTheme.accent;
        horizontal-alignment: center;
        vertical-alignment: center;
    }
    TouchArea {
        width: 100%;
        height: 100%;
        clicked => { root.clicked(); }
        mouse-cursor: pointer;
    }
}

component DockSortRow inherits Rectangle {
    in property <string> label;
    in property <string> badge;
    in property <image> logo;
    in property <string> glyph: "";
    in property <bool> on;
    in property <bool> lifted;
    in property <bool> marked;
    callback toggled();
    callback grip-pressed(length);
    callback grip-moved(length);
    callback grip-released();
    height: 44px;
    border-radius: 8px;
    background: lifted ? #2c261f : (marked ? DesktopTheme.selection-low : DesktopTheme.surface);
    border-width: 1px;
    border-color: marked || lifted ? DesktopTheme.accent : DesktopTheme.border;
    HorizontalLayout {
        width: 100%;
        padding-left: 4px;
        padding-right: 10px;
        spacing: 8px;
        cross-axis-alignment: center;
        Rectangle {
            horizontal-stretch: 1;
            height: 40px;
            HorizontalLayout {
                spacing: 8px;
                alignment: start;
                cross-axis-alignment: center;
                Text {
                    width: 16px;
                    text: "⋮⋮";
                    font-size: 14px;
                    color: DesktopTheme.muted;
                    vertical-alignment: center;
                }
                Rectangle {
                    width: 36px;
                    height: 36px;
                    border-radius: 8px;
                    background: #120f0c;
                    border-width: 1px;
                    border-color: #5a4a34;
                    if root.glyph == "": Image {
                        source: root.logo;
                        width: 26px;
                        height: 26px;
                        x: 5px;
                        y: 5px;
                        image-fit: contain;
                    }
                    if root.glyph != "": Text {
                        width: 100%;
                        height: 100%;
                        text: root.glyph;
                        font-size: 16px;
                        color: DesktopTheme.accent;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                    }
                }
                Text {
                    width: 28px;
                    text: root.badge;
                    font-size: 12px;
                    font-weight: 700;
                    color: root.on ? DesktopTheme.accent : #6f675e;
                    vertical-alignment: center;
                }
                Text {
                    text: root.label;
                    font-size: 14px;
                    color: root.on ? DesktopTheme.text : DesktopTheme.muted;
                    vertical-alignment: center;
                }
            }
            grip := TouchArea {
                width: 100%;
                height: 100%;
                mouse-cursor: grab;
                pointer-event(event) => {
                    if (event.button == PointerEventButton.left && event.kind == PointerEventKind.down) {
                        root.grip-pressed(self.mouse-y);
                    }
                    if (event.button == PointerEventButton.left && event.kind == PointerEventKind.up) {
                        root.grip-released();
                    }
                }
                moved => {
                    if (self.pressed) {
                        root.grip-moved(self.mouse-y);
                    }
                }
            }
        }
        Rectangle {
            width: 36px;
            height: 20px;
            border-radius: 10px;
            background: root.on ? DesktopTheme.accent : DesktopTheme.border;
            Rectangle {
                width: 14px;
                height: 14px;
                border-radius: 7px;
                x: root.on ? 19px : 3px;
                y: 3px;
                background: root.on ? DesktopTheme.on-accent : #c8bfb4;
            }
            TouchArea {
                width: 100%;
                height: 100%;
                clicked => { root.toggled(); }
                mouse-cursor: pointer;
            }
        }
    }
}

component KeyLine inherits Rectangle {
