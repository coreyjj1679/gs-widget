                                    DesktopIcon { x: 28px; y: 34px; width: 28px; height: 28px; path: "M4 4 L10 4 L12 6 L20 6 L20 20 L4 20 Z M8 11 L16 11 M8 15 L14 15"; ink: DesktopTheme.accent; }
                                    Text { x: 28px; y: 82px; text: UiLanguage.tr("Browse the monster compendium", "瀏覽怪物圖鑑"); font-size: 18px; font-weight: 600; color: DesktopTheme.text; }
                                    Text { x: 28px; y: 116px; width: parent.width - 56px; text: UiLanguage.tr("Start with all monsters, or choose a country and region from the directory.", "直接查看所有怪物，或從左側按國家與地區尋找。"); wrap: word-wrap; font-size: 13px; color: DesktopTheme.secondary; }
                                    MonsterTool {
                                        x: 28px; y: 168px; width: 144px; active: true;
                                        label: UiLanguage.tr("All monsters", "所有怪物");
