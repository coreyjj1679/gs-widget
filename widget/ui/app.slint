                                    Text { x: 28px; y: 82px; text: root.lang == "en-zh" ? "Where do you want to explore?" : "從一個地區開始探索"; font-size: 18px; font-weight: 600; color: DesktopTheme.text; }
                                    Text { x: 28px; y: 116px; width: parent.width - 56px; text: root.lang == "en-zh" ? "Choose a region or habitat to compare monsters, attributes and drops." : "選擇左側的地區或出沒地，一起查看怪物能力與掉落物。"; wrap: word-wrap; font-size: 13px; color: DesktopTheme.secondary; }
                                }
                                if root.expanded != "" && root.board-monsters.length == 0: Text {
