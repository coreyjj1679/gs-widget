                        border-width: 1px;
                        border-color: DesktopTheme.border;
                        item-drops := Flickable {
                            width: 100%;
                            height: 100%;
                            content-width: self.width;
                            content-height: max(root.links.length * root.link-row, 1px);
                            content-y <=> root.drop-offset;
                            for row[i] in root.links: source-slot := Rectangle {
                                x: 4px;
                                y: i * root.link-row;
                                width: max(item-drops.width - 8px, 40px);
                                height: 52px;
                                if root.cursor == i || (source-slot.y + source-slot.height >= -item-drops.content-y - 2 * root.link-row && source-slot.y <= -item-drops.content-y + item-drops.height + 2 * root.link-row): HitRow {
                                    x: 0px; y: 0px; width: parent.width;
                                    selected: root.cursor == i && (!root.full-item-sheet || root.item-links);
                                    hit: row;
                                    keyboard-focused: keys.has-focus && self.selected;
                                    focus-changed(focused) => { if (focused) { RecordInfo.text = ""; if (root.full-item-sheet) { root.item-tab = "links"; } root.cursor = i; } }
                                    no-image-label: root.no-image-label;
                                    clicked => {
                                        if (root.full-item-sheet) { root.item-tab = "links"; keys.focus(); }
                                        if (row.chip == "section") {
                                            root.source-changed(row.key);
