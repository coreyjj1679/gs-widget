    // idle, checking, current, available, downloading, ready, error, restarting
    in-out property <int> update-state: 0;
    in-out property <string> update-version;
    in-out property <int> update-progress: 0;
    in-out property <string> update-error;
    callback request-update();
    callback prepare-update() -> bool;
    property <bool> update-busy: update-state == 1 || update-state == 4 || update-state == 7;
    property <string> update-action: update-state == 3 ? (UiLanguage.tr("Download update", "下載更新")) : update-state == 5 ? (UiLanguage.tr("Restart and update", "重新啟動並更新")) : update-state == 6 ? (UiLanguage.tr("Try again", "重試")) : (UiLanguage.tr("Check for updates", "檢查更新"));
    property <string> sidebar-update-action: update-state == 5 && update-error != "" ? (UiLanguage.tr("Update issue", "查看更新問題")) :
        update-state == 1 ? (UiLanguage.tr("Checking…", "正在檢查…")) :
        update-state == 3 ? (UiLanguage.tr("Update v", "更新 v") + update-version) :
        update-state == 4 ? (UiLanguage.tr("Download ", "下載 ") + update-progress + "%") :
        update-state == 5 ? (UiLanguage.tr("Restart update", "重啟更新")) :
        update-state == 6 ? (UiLanguage.tr("Retry check", "重試檢查")) :
        update-state == 7 ? (UiLanguage.tr("Restarting…", "正在重新啟動…")) :
        (UiLanguage.tr("Check updates", "檢查更新"));
    property <string> update-status: !updates-supported ? (UiLanguage.tr("In-app updates are available for the Windows x64 release.", "App 內更新目前支援 Windows x64 發布版。")) :
        update-state == 1 ? (UiLanguage.tr("Checking for updates…", "正在檢查更新…")) :
        update-state == 2 ? (UiLanguage.tr("You are using the latest published version.", "目前已是最新發布版本。")) :
        update-state == 3 ? (UiLanguage.tr("Version ", "有新版本 v") + update-version + UiLanguage.tr(" is available.", "。")) :
        update-state == 4 ? (UiLanguage.tr("Downloading and verifying… ", "下載並驗證更新中… ") + update-progress + "%") :
        update-state == 5 ? (UiLanguage.tr("Version ", "v") + update-version + UiLanguage.tr(" is ready. Restart when you are ready.", " 已準備好，可隨時重新啟動安裝。")) :
        update-state == 6 ? (UiLanguage.tr("The update could not be completed. See the details below before trying again.", "未能完成更新，請查看下方原因後重試。")) :
        update-state == 7 ? (UiLanguage.tr("Preparing to restart…", "正在準備重新啟動…")) :
        (UiLanguage.tr("Check GitHub for a newer version of Gersang.", "到 GitHub 檢查 Gersang 是否有新版本。"));
