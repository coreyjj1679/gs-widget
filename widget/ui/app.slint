                            if (!root.dock-vertical) {
                                root.dock-vertical = true;
                                root.publish-dock();
                            }
                        }
                    }
                }
                Text {
                    text: root.lang == "en-zh" ? "Drag a row to change the order." : "按住一列拖曳，就能調整順序。";
                    font-size: 13px;
                    color: DesktopTheme.muted;
                    wrap: word-wrap;
                }
                order-list := Rectangle {
                    height: root.dock-draft.length * 48px;
                    property <int> from-row: -1;
                    property <int> over-row: -1;
                    property <length> grab: 0px;
                    property <length> nudge: 0px;
                    for slot[i] in root.dock-draft: DockSortRow {
                        x: order-list.from-row == i ? 8px : 0px;
                        y: order-list.from-row == i ? max(0px, i * 48px + order-list.nudge) : i * 48px;
                        width: order-list.from-row == i ? parent.width - 8px : parent.width;
                        horizontal-stretch: 1;
                        label: root.category-short(slot);
                        logo: root.category-logo(slot);
                        glyph: root.category-glyph(slot);
                        badge: root.dock-on(slot) ? ("F" + root.visible-index(slot)) : "–";
                        on: root.dock-on(slot);
                        lifted: order-list.from-row == i;
                        marked: order-list.over-row == i && order-list.from-row != i;
                        toggled => { root.toggle-dock(slot); }
                        grip-pressed(py) => {
                            order-list.from-row = i;
                            order-list.over-row = i;
                            order-list.grab = py;
                            order-list.nudge = 0px;
                        }
                        grip-moved(py) => {
                            order-list.nudge = py - order-list.grab;
                            let row = round((i * 48px + order-list.nudge) / 48px - 0.5);
                            if (row < 0) {
                                order-list.over-row = 0;
                            } else if (row >= root.dock-draft.length) {
                                order-list.over-row = root.dock-draft.length - 1;
                            } else {
                                order-list.over-row = row;
                            }
                        }
                        grip-released => {
                            if (order-list.from-row >= 0 && order-list.over-row >= 0 && order-list.from-row != order-list.over-row) {
                                root.dock-moved(order-list.from-row, order-list.over-row);
                            }
                            order-list.from-row = -1;
                            order-list.over-row = -1;
                            order-list.nudge = 0px;
                        }
                    }
                }
            }
