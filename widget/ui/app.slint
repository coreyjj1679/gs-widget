                        height: 32px;
                        border-radius: 8px;
                        clip: true;
                        background: DesktopTheme.inset;
                        border-width: 1px;
                        border-color: DesktopTheme.border;
                        HorizontalLayout {
                            spacing: 1px;
                            PatchTab {
                                label: root.lang == "en-zh" ? "All" : "全部";
                                active: root.place == "";
