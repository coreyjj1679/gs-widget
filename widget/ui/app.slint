                        active: root.filter-active;
                        element: root.filter-element;
                        element-icons: root.filter-element-icons;
                        hit-min: root.filter-hit-min; hit-max: root.filter-hit-max;
                        magic-min: root.filter-magic-min; magic-max: root.filter-magic-max;
                        advanced-open <=> root.filter-advanced-open;
                        sort-key: root.monster-sort-key; sort-desc: root.monster-sort-desc;
                        sort-open <=> root.filter-sort-open;
                        ela-min: root.filter-ela-min; ela-max: root.filter-ela-max;
                        drop: root.filter-drop; drop-key: root.filter-drop-key;
                        drop-options: root.drop-options; drop-open <=> root.filter-drop-open;
                        scoped: root.monster-filter-scoped;
                        global-scope: root.filter-global || !root.monster-filter-scoped;
                        current-label: root.expanded == "saved:" ? (UiLanguage.tr("Favourites", "收藏怪物")) : (UiLanguage.tr("Current region", "目前地區"));
                        result-count: root.hits.length;
                        english: UiLanguage.primary == "en";
