                        height: 402px;
                        DesktopEntry {
                            x: 0px; y: 0px; width: parent.width; height: 112px;
                            title: UiLanguage.tr("Monster compendium", "怪物圖鑑");
                            description: UiLanguage.tr("Attributes, habitats and drops", "查屬性、找出沒地，比較掉落物");
                            logo: root.category-logo(0); prominent: true;
