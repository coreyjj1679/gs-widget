                                        line-height: fact.has-icon ? 40px : 32px;
                                        label: fact.label;
                                        value: fact.value;
                                        key: fact.key;
                                        icon: fact.icon;
                                        has-icon: fact.has-icon;
                                        open => { root.open-hit(fact.key); }
                                    }
                                }
                                if root.sheet-note != "": VerticalLayout {
                                    padding-left: 10px;
                                    padding-right: 10px;
                                    padding-top: 6px;
                                    padding-bottom: 10px;
                                    spacing: 8px;
                                    Rectangle {
                                        height: 1px;
                                        background: #2a241e;
                                    }
                                    Text {
