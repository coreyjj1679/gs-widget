}

component WinButton inherits Rectangle {
    in property <string> glyph;
    accessible-role: button;
    accessible-label: glyph == "×" ? UiLanguage.tr("Close", "關閉") : glyph == "–" ? UiLanguage.tr("Collapse", "收合") : glyph == "←" ? UiLanguage.tr("Back", "返回") : glyph == "⚙️" ? UiLanguage.tr("Settings", "設定") : glyph;
    accessible-action-default => { root.clicked(); }
    in property <bool> danger: false;
    callback clicked();
    width: max(30px, glyph-label.preferred-width + 20px);
    height: 26px;
    border-radius: 5px;
    background: tap.has-hover ? (danger ? #7f1d1d : DesktopTheme.hover-strong) : transparent;
    glyph-label := Text {
        text: root.glyph;
        color: DesktopTheme.text;
        font-size: root.glyph == "⚙️" ? 17px : 12px;
        horizontal-alignment: center;
        vertical-alignment: center;
    }
    tap := TouchArea {
        width: 100%;
        height: 100%;
        clicked => { root.clicked(); }
        mouse-cursor: pointer;
    }
}

