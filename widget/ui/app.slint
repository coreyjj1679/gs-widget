    forward-focus: focus;
    accessible-role: button;
    accessible-label: UiLanguage.tr("Open source on GitHub", "在 GitHub 查看開源專案");
    accessible-description: "https://github.com/coreyjj1679/gs-widget";
    accessible-action-default => { root.clicked(); }
    Path {
        x: 8px;
        y: 4px;
        width: 16px;
        height: 16px;
        viewbox-width: 24;
        viewbox-height: 24;
        fill: root.ink;
        commands: "M12 0C5.37 0 0 5.373 0 12c0 5.303 3.438 9.8 8.205 11.385.6.113.82-.258.82-.577 0-.285-.01-1.04-.015-2.04-3.338.724-4.043-1.61-4.043-1.61-.546-1.387-1.333-1.756-1.333-1.756-1.09-.745.083-.729.083-.729 1.205.084 1.838 1.237 1.838 1.237 1.07 1.835 2.809 1.305 3.495.998.108-.776.418-1.305.762-1.605-2.665-.304-5.467-1.334-5.467-5.931 0-1.31.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23A11.52 11.52 0 0 1 12 5.8c1.02.005 2.045.138 3.003.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.652.242 2.873.119 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222 0 1.606-.015 2.898-.015 3.293 0 .322.216.694.825.576C20.565 21.795 24 17.299 24 12c0-6.627-5.373-12-12-12Z";
    }
    label := Text {
        x: 30px;
        height: 100%;
        text: UiLanguage.tr("Open source", "開源專案");
        font-size: 11px;
        color: root.ink;
        vertical-alignment: center;
    }
    focus := FocusScope {
        width: 100%; height: 100%;
        key-pressed(event) => {
            if (event.text == Key.Return || event.text == Key.Space) {
                root.clicked();
                return accept;
            }
            return reject;
        }
    }
    area := TouchArea {
        width: 100%; height: 100%;
        mouse-cursor: pointer;
        clicked => { focus.focus(); root.clicked(); }
    }
}

component WindowModeSwitch inherits Rectangle {
    in property <bool> full;
    in property <bool> english;
    callback choose(bool);
    width: root.english ? 108px : 88px;
    height: 28px;
    border-radius: 7px;
    background: DesktopTheme.sidebar;
    border-width: 1px;
    border-color: focus.has-focus ? DesktopTheme.accent : DesktopTheme.border;
    forward-focus: focus;
    accessible-role: button;
    accessible-label: UiLanguage.tr("Window mode", "視窗模式");
    accessible-description: root.full ? (UiLanguage.tr("Full mode selected", "目前為完整模式")) : (UiLanguage.tr("Widget mode selected", "目前為小窗模式"));
    accessible-action-default => { root.choose(!root.full); }
    Rectangle {
        x: root.full ? parent.width / 2 : 2px;
        y: 2px;
        width: parent.width / 2 - 2px;
        height: parent.height - 4px;
        border-radius: 5px;
        background: DesktopTheme.raised;
    }
    Text {
        x: 0px; y: 0px;
        width: parent.width / 2;
        height: 100%;
        text: UiLanguage.tr("Widget", "小窗");
        color: root.full ? DesktopTheme.muted : DesktopTheme.text;
        font-size: 11px;
        font-weight: root.full ? 400 : 600;
        horizontal-alignment: center;
        vertical-alignment: center;
    }
    Text {
        x: parent.width / 2; y: 0px;
        width: parent.width / 2;
        height: 100%;
        text: UiLanguage.tr("Full", "完整");
        color: root.full ? DesktopTheme.text : DesktopTheme.muted;
        font-size: 11px;
        font-weight: root.full ? 600 : 400;
        horizontal-alignment: center;
        vertical-alignment: center;
    }
    focus := FocusScope {
        width: 100%; height: 100%;
        key-pressed(event) => {
            if (event.text == Key.Return || event.text == Key.Space) {
                root.choose(!root.full);
                return accept;
            }
            if (event.text == Key.LeftArrow || event.text == Key.RightArrow) {
                root.choose(event.text == Key.RightArrow);
                return accept;
            }
            return reject;
        }
    }
    TouchArea {
        x: 0px; y: 0px;
        width: parent.width / 2;
        height: 100%;
        mouse-cursor: pointer;
        clicked => { focus.focus(); if (root.full) { root.choose(false); } }
    }
    TouchArea {
        x: parent.width / 2; y: 0px;
        width: parent.width / 2;
        height: 100%;
        mouse-cursor: pointer;
        clicked => { focus.focus(); if (!root.full) { root.choose(true); } }
    }
}

component SidebarCategoryRow inherits Rectangle {
    in property <image> logo;
    in property <string> glyph;
    in property <string> label;
    in property <bool> selected;
    in property <bool> lifted;
    in property <bool> english;
    callback clicked();
    callback drag-start();
    callback drag-move(length);
    callback drag-end(bool);
    callback shift(int);
    property <length> press-y;
    property <bool> moved-far: false;
    height: 40px;
    border-radius: 7px;
    background: root.lifted ? DesktopTheme.raised : root.selected ? DesktopTheme.selected : area.has-hover ? DesktopTheme.hover : transparent;
    border-width: 1px;
    border-color: focus.has-focus || root.lifted ? DesktopTheme.accent : transparent;
    forward-focus: focus;
    accessible-role: button;
    accessible-label: root.label;
    accessible-description: UiLanguage.tr("Drag to reorder. Control plus up or down also changes the order.", "拖曳可調整順序，也可按 Control 加上或下方向鍵。");
    accessible-action-default => { root.clicked(); }
    if root.glyph == "": Image {
        x: 10px; y: 9px;
        width: 22px; height: 22px;
        source: root.logo;
        image-fit: contain;
    }
    if root.glyph != "": Text {
        x: 10px; y: 0px;
        width: 22px; height: 100%;
        text: root.glyph;
        font-size: 15px;
        color: root.selected ? DesktopTheme.accent : DesktopTheme.secondary;
        horizontal-alignment: center;
        vertical-alignment: center;
    }
    Text {
        x: 42px; y: 0px;
        width: max(parent.width - 70px, 20px);
        height: 100%;
        text: root.label;
        font-size: 13px;
        font-weight: root.selected ? 600 : 400;
        color: root.selected ? DesktopTheme.text : DesktopTheme.secondary;
        vertical-alignment: center;
        overflow: elide;
    }
    DesktopIcon {
        x: parent.width - 20px; y: 12px;
        width: 12px; height: 16px;
        ink: area.has-hover || root.lifted ? DesktopTheme.secondary : DesktopTheme.border;
        path: "M8 5 L8 6 M16 5 L16 6 M8 11 L8 12 M16 11 L16 12 M8 17 L8 18 M16 17 L16 18";
    }
    focus := FocusScope {
        width: 100%; height: 100%;
        key-pressed(event) => {
            if (event.modifiers.control && (event.text == Key.UpArrow || event.text == Key.DownArrow)) {
                root.shift(event.text == Key.UpArrow ? -1 : 1);
                return accept;
            }
            if (event.text == Key.Return || event.text == Key.Space) {
                root.clicked();
                return accept;
            }
            return reject;
        }
    }
    area := TouchArea {
        width: 100%; height: 100%;
        mouse-cursor: self.pressed && root.moved-far ? grabbing : pointer;
        clicked => { if (!root.moved-far) { focus.focus(); root.clicked(); } }
        pointer-event(event) => {
            if (event.button == PointerEventButton.left && event.kind == PointerEventKind.down) {
                root.press-y = self.mouse-y;
                root.moved-far = false;
                root.drag-start();
            }
            if (event.button == PointerEventButton.left && event.kind == PointerEventKind.up) {
                root.drag-end(root.moved-far);
            }
            if (event.kind == PointerEventKind.cancel) {
                root.drag-end(false);
            }
        }
        moved => {
            if (!self.pressed) { return; }
            if (abs(self.mouse-y - root.press-y) >= 5px) { root.moved-far = true; }
            if (root.moved-far) { root.drag-move(self.mouse-y); }
        }
    }
}

