                                            root.open-hit(row.key);
                                        }
                                    }
                                }
                            }
                        }
                    }
                    if root.monster-sheet && !root.full-mode && root.related-open: related-list := Flickable {
                        x: root.side-gap;
                        y: root.related-list-y;
