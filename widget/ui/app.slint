                        width: root.full-mode ? 280px : max(root.pane-w - 2 * root.page-pad, 40px);
                        placeholder-text: root.full-mode ? (root.lang == "en-zh" ? "Search this category…" : "搜尋此分類…") : (root.lang == "en-zh" ? "Search" : "搜尋");
                        text <=> root.query;
                        property <bool> focus-requested: root.search-open;
                        changed focus-requested => { if (self.focus-requested) { self.focus(); } }
                        init => { if (root.search-open) { self.focus(); } }
