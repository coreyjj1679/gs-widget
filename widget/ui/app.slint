                    }
                    Text {
                        text: root.lang == "en-zh" ? "Stay on top" : "置頂";
                        font-size: 13px;
                        color: DesktopTheme.secondary;
                    }
                    ChoiceBar {
                        first: root.lang == "en-zh" ? "Follow" : "跟隨";
                        second: root.lang == "en-zh" ? "Always" : "置頂";
