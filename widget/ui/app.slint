        }
    }
}

component CategoryTile inherits Rectangle {
    in property <image> logo;
    in property <string> glyph: "";
    in property <string> name;
    in property <bool> selected: false;
    in property <bool> arranging: false;
    in property <bool> lifted: false;
    in property <bool> drop-target: false;
    callback clicked();
    callback pressed(length, length);
    callback dragged(length, length);
    callback released();
    callback long-pressed(length, length);
    property <bool> arming: false;
    property <bool> latched: false;
    property <length> origin-x: 0px;
    property <length> origin-y: 0px;
    property <float> hold: arming ? 1 : 0;
    property <length> badge: min(max(root.width - 20px, 28px), max(root.height - 40px, 28px));
    animate hold {
        duration: 420ms;
        easing: linear;
    }
    changed hold => {
        if (root.hold > 0.98 && root.arming && !root.latched && !root.arranging) {
            root.latched = true;
            root.arming = false;
            root.long-pressed(area.mouse-x, area.mouse-y);
        }
    }
    border-radius: min(16px, root.width * 0.12);
    background: lifted ? DesktopTheme.raised : (selected || drop-target || area.has-hover ? DesktopTheme.selected : DesktopTheme.surface);
    border-width: selected || drop-target || lifted ? 2px : 1px;
    border-color: selected || drop-target || lifted ? DesktopTheme.accent : arranging ? #8a7048 : (area.has-hover ? #8a7048 : DesktopTheme.border);
    opacity: lifted ? 0.72 : 1;
    VerticalLayout {
        alignment: center;
        spacing: root.width < 120px ? 6px : 10px;
        HorizontalLayout {
            alignment: center;
            Rectangle {
                width: root.badge;
                height: root.badge;
                border-radius: root.badge * 0.2;
                background: #120f0c;
                border-width: 1px;
                border-color: #5a4a34;
                if root.glyph == "": Image {
                    source: root.logo;
                    width: root.badge * 0.84;
                    height: root.badge * 0.84;
                    image-fit: contain;
                    x: root.badge * 0.08;
                    y: root.badge * 0.08;
                }
                if root.glyph != "": Text {
                    width: 100%;
                    height: 100%;
                    text: root.glyph;
                    font-size: root.badge * 0.38;
                    color: DesktopTheme.accent;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                }
            }
        }
        Text {
            width: root.width - 12px;
            text: root.name;
            font-size: root.width < 120px ? 12px : 14px;
            font-weight: 600;
            color: DesktopTheme.text;
            horizontal-alignment: center;
            overflow: elide;
        }
    }
    area := TouchArea {
        width: 100%;
        height: 100%;
        clicked => {
            if (!root.arranging && !root.latched) {
                root.clicked();
            }
        }
        pointer-event(event) => {
            if (event.button != PointerEventButton.left) {
                return;
            }
            if (event.kind == PointerEventKind.down) {
                root.origin-x = self.mouse-x;
                root.origin-y = self.mouse-y;
                if (root.arranging) {
                    root.pressed(self.mouse-x, self.mouse-y);
                } else {
                    root.latched = false;
                    root.arming = true;
                }
            }
            if (event.kind == PointerEventKind.up) {
                root.arming = false;
                if (root.arranging) {
                    root.released();
                }
            }
        }
        moved => {
            if (root.arming && !root.latched && (self.mouse-x < root.origin-x - 8px || self.mouse-x > root.origin-x + 8px || self.mouse-y < root.origin-y - 8px || self.mouse-y > root.origin-y + 8px)) {
                root.arming = false;
            }
            if (root.arranging && self.pressed) {
                root.dragged(self.mouse-x, self.mouse-y);
            }
        }
        mouse-cursor: root.arranging ? grab : pointer;
    }
}

component HitRow inherits Rectangle {
    in property <Hit> hit;
    in property <color> title-color: DesktopTheme.text;
    in property <bool> selected: false;
    in property <bool> compact: false;
    in property <string> no-image-label: "沒有圖片";
    callback clicked();
    callback favourite-clicked();
    height: compact ? 36px : 52px;
    border-radius: 8px;
    border-width: 1px;
    border-color: selected ? DesktopTheme.accent : transparent;
    property <bool> heading: hit.chip == "label";
    background: selected ? DesktopTheme.selected : (root.hit.chip == "section" || root.heading) ? (area.has-hover && !root.heading ? #2c261f : DesktopTheme.surface-alt) : (area.has-hover ? DesktopTheme.hover : transparent);
    property <bool> marked: hit.can-favourite || hit.favourite;
    property <length> tail: (marked ? 62px : 0px) + (!marked && hit.has-badge ? 26px : 0px);
    property <bool> show-chip: hit.chip == "yes" || hit.chip == "no";
    property <bool> disclosure: hit.chip == "section";
    property <bool> disclosure-open: disclosure && hit.aside == "▼";
    property <bool> show-aside: !root.show-chip && !root.disclosure && hit.aside != "";
    property <length> chip-w: 68px;
    property <length> aside-box: root.show-chip ? root.chip-w : 108px;
    area := TouchArea {
        x: 0px;
        width: parent.width - root.tail;
        height: 100%;
        clicked => { root.clicked(); }
        mouse-cursor: root.hit.key == "" && !root.disclosure ? default : pointer;
        HorizontalLayout {
            width: 100%;
            height: 100%;
            padding-left: 8px;
            padding-right: root.show-aside || root.show-chip ? root.aside-box + 12px : 8px;
            spacing: 8px;
            alignment: start;
            cross-axis-alignment: center;
            if root.hit.has-icon: Image {
                source: root.hit.icon;
                width: root.compact ? 22px : 36px;
                height: root.compact ? 22px : 36px;
                image-fit: contain;
            }
            if root.hit.no-image: NoImage {
                side: root.compact ? 28px : 36px;
                label: root.no-image-label;
            }
            VerticalLayout {
                horizontal-stretch: 1;
                min-width: 0px;
                alignment: center;
                cross-axis-alignment: stretch;
                Text {
                    horizontal-stretch: 1;
                    min-width: 0px;
                    text: root.hit.title;
                    overflow: elide;
                    font-weight: root.heading ? 600 : 400;
                    horizontal-alignment: left;
                    vertical-alignment: center;
                    color: root.hit.chip == "section" || root.heading ? DesktopTheme.accent : root.hit.solo ? #e24b4b : root.title-color;
                }
                if root.hit.subtitle != "": Text {
                    horizontal-stretch: 1;
                    min-width: 0px;
                    text: root.hit.subtitle;
                    overflow: elide;
                    font-size: root.compact ? 11px : 12px;
                    horizontal-alignment: left;
                    vertical-alignment: center;
                    color: root.hit.solo ? #e24b4b : DesktopTheme.secondary;
                }
            }
        }
    }
    if root.show-chip: Rectangle {
        x: parent.width - root.tail - 8px - root.chip-w;
        y: (parent.height - 22px) / 2;
        width: root.chip-w;
        height: 22px;
        border-radius: 11px;
        background: root.hit.chip == "yes" ? #1d6b43 : #8a4034;
        Text {
            width: 100%;
            height: 100%;
            text: root.hit.aside;
            font-size: 11px;
            font-weight: 700;
            color: root.hit.chip == "yes" ? #e8f7ee : #fdece8;
            horizontal-alignment: center;
            vertical-alignment: center;
        }
    }
    if root.disclosure: Path {
        x: parent.width - 22px;
        y: (parent.height - 10px) / 2;
        width: 10px;
        height: 10px;
        stroke: DesktopTheme.muted;
        stroke-width: 1.6px;
        commands: root.disclosure-open ? "M 1 3 L 5 7 L 9 3" : "M 3 1 L 7 5 L 3 9";
    }
    if root.show-aside: Text {
        x: parent.width - root.tail - 10px - root.aside-box;
        y: 0px;
        width: root.aside-box;
        height: parent.height;
        text: root.hit.aside;
        font-size: 13px;
        font-weight: 600;
        color: DesktopTheme.accent;
        horizontal-alignment: right;
        vertical-alignment: center;
        overflow: elide;
    }
    if root.hit.has-badge: Image {
        x: parent.width - (root.marked ? 40px : 8px) - 18px;
        y: (parent.height - 18px) / 2;
        width: 18px;
        height: 18px;
        source: root.hit.badge;
        image-fit: contain;
    }
    if root.marked: StarMark {
        x: parent.width - 36px;
        y: (parent.height - self.height) / 2;
        filled: root.hit.favourite;
        clicked => {
            if (root.hit.can-favourite) {
                root.favourite-clicked();
            } else {
                root.clicked();
            }
        }
    }
}

component MetaRow inherits Rectangle {
    in property <string> label;
    in property <string> value;
    visible: value != "";
    height: value == "" ? 0px : 16px;
