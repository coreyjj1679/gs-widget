                        text: root.quest-sheet ? (root.lang == "en-zh" ? "No links" : "沒有連結") : root.viewing-npc ? (root.lang == "en-zh" ? "No quests" : "沒有任務") : root.recipe-sheet ? (root.lang == "en-zh" ? "No materials" : "沒有材料") : root.viewing-set ? (root.lang == "en-zh" ? "No pieces" : "沒有部件") : root.viewing-item ? (root.lang == "en-zh" ? "Nothing related" : "沒有相關") : (root.lang == "en-zh" ? "No monsters drop this" : "沒有怪物掉落");
                        font-size: 13px;
                        color: #f3efe8;
                    }
                    if root.viewing != "" && !root.record-sheet && !root.quest-sheet && root.category != "patch" && root.viewing-no-image: NoImage {
