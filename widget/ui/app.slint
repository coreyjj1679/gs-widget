    if !root.gallery: Rectangle {
        x: 10px;
        y: 13px;
        width: 16px;
        height: 2px;
        border-radius: 1px;
        background: root.ink;
    }
    if !root.gallery: Rectangle {
        x: 10px;
        y: 19px;
        width: 16px;
        height: 2px;
        border-radius: 1px;
        background: root.ink;
    }
    if root.gallery: Rectangle {
        x: 9px;
        y: 6px;
        width: 7px;
        height: 7px;
        border-radius: 1px;
        background: root.ink;
    }
    if root.gallery: Rectangle {
        x: 19px;
        y: 6px;
        width: 7px;
        height: 7px;
        border-radius: 1px;
        background: root.ink;
    }
    if root.gallery: Rectangle {
        x: 9px;
        y: 16px;
        width: 7px;
        height: 7px;
        border-radius: 1px;
        background: root.ink;
    }
    if root.gallery: Rectangle {
        x: 19px;
        y: 16px;
        width: 7px;
        height: 7px;
        border-radius: 1px;
        background: root.ink;
    }
    TouchArea {
        width: 100%;
        height: 100%;
        clicked => { root.clicked(); }
        mouse-cursor: pointer;
    }
}

component MonsterCard inherits Rectangle {
    in property <Hit> hit;
    in property <bool> selected: false;
    in property <string> no-image-label: UiLanguage.tr("No image", "沒有圖片");
    in property <bool> english: false;
    in property <bool> portrait: false;
    callback clicked();
    callback favourite-clicked();
    height: 214px;
    border-radius: 10px;
    border-width: 1px;
    border-color: selected ? DesktopTheme.accent : DesktopTheme.border;
    background: selected ? DesktopTheme.selected : (area.has-hover ? DesktopTheme.hover : DesktopTheme.surface-alt);
    area := TouchArea {
        width: parent.width - 40px;
        height: 100%;
        clicked => { root.clicked(); }
        mouse-cursor: pointer;
        HorizontalLayout {
            width: 100%;
            height: 100%;
            padding-left: 8px;
            padding-right: 4px;
            spacing: 8px;
                Rectangle {
                    width: root.hit.has-battle ? 128px : 88px;
                    height: 100%;
                    HorizontalLayout {
                        width: 100%;
                        height: 100%;
                        alignment: center;
                        spacing: 6px;
                        cross-axis-alignment: center;
                        if root.hit.has-icon && (!root.hit.has-battle || root.portrait): Image {
                            source: root.hit.icon;
                            width: 72px;
                            height: 72px;
                            image-fit: contain;
                        }
                        if root.hit.no-image && !root.hit.has-battle && !root.portrait: NoImage {
                            side: 72px;
                            label: root.no-image-label;
                        }
                        if root.hit.has-battle && !root.portrait: Image {
                            source: root.hit.battle;
                            width: 108px;
                            height: 156px;
                            image-fit: contain;
                        }
                    }
                }
            VerticalLayout {
                horizontal-stretch: 1;
                min-width: 0px;
                padding-top: 8px;
                padding-bottom: 8px;
                spacing: 1px;
                Text {
                    text: root.hit.title;
                    font-size: 15px;
                    font-weight: 600;
                    color: DesktopTheme.text;
                    overflow: elide;
                }
                if root.hit.subtitle != "": Text {
                    text: root.hit.subtitle;
                    font-size: 12px;
                    color: DesktopTheme.accent;
                    overflow: elide;
                }
                MetaRow { label: UiLanguage.tr("Type", "種類"); value: root.hit.stat-kind; }
                MetaRow { label: UiLanguage.tr("Element", "屬性"); value: root.hit.stat-element; }
                MetaRow { label: UiLanguage.tr("HP", "體力"); value: root.hit.stat-hp; }
                MetaRow { label: UiLanguage.tr("MP", "魔力"); value: root.hit.stat-mp; }
                MetaRow { label: UiLanguage.tr("Hit", "打擊"); value: root.hit.stat-hit; }
                MetaRow { label: UiLanguage.tr("Magic", "魔法"); value: root.hit.stat-magic; }
                MetaRow { label: UiLanguage.tr("Attack", "攻擊"); value: root.hit.stat-atk; }
                MetaRow { label: UiLanguage.tr("Exp", "經驗"); value: root.hit.stat-exp; }
                if root.hit.drop-total > 0: HorizontalLayout {
                    height: 26px;
                    spacing: 4px;
                    alignment: start;
                    cross-axis-alignment: center;
                    Text {
                        width: 52px;
                        text: UiLanguage.tr("Drops", "掉落");
                        font-size: 11px;
                        color: DesktopTheme.muted;
                        vertical-alignment: center;
                    }
                    if root.hit.drop1.width > 0: Image { source: root.hit.drop1; width: 22px; height: 22px; image-fit: contain; }
                    if root.hit.drop2.width > 0: Image { source: root.hit.drop2; width: 22px; height: 22px; image-fit: contain; }
                    if root.hit.drop3.width > 0: Image { source: root.hit.drop3; width: 22px; height: 22px; image-fit: contain; }
                    if root.hit.drop4.width > 0: Image { source: root.hit.drop4; width: 22px; height: 22px; image-fit: contain; }
                    if root.hit.drop-total > 4: Text {
                        text: "+" + (root.hit.drop-total - 4);
                        font-size: 11px;
                        color: DesktopTheme.accent;
                        vertical-alignment: center;
                    }
                }
            }
        }
    }
    StarMark {
        x: parent.width - 36px;
        y: 8px;
        filled: root.hit.favourite;
        clicked => { root.favourite-clicked(); }
    }
}

component MonsterTool inherits Rectangle {
    in property <string> label;
    in property <length> label-size: 13px;
    in property <bool> active;
    callback clicked();
    height: 28px;
    border-radius: 4px;
    border-width: 1px;
    border-color: focus.has-focus ? DesktopTheme.accent : transparent;
    background: active ? DesktopTheme.control : tap.has-hover ? DesktopTheme.hover : transparent;
    forward-focus: focus;
    accessible-role: button;
    accessible-label: label;
    accessible-action-default => { root.clicked(); }
    Text {
        width: 100%; height: 100%;
        text: root.label;
        font-size: root.label-size;
        color: root.active ? DesktopTheme.text : DesktopTheme.secondary;
        horizontal-alignment: center; vertical-alignment: center;
    }
    tap := TouchArea {
        width: 100%; height: 100%; mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
    focus := FocusScope {
        key-pressed(event) => {
            if (event.text == " " || event.text == "\n") { root.clicked(); return accept; }
            return reject;
        }
    }
}

component MonsterDropPicker inherits Rectangle {
    in property <string> query;
    in property <string> selected-key;
    in property <[Hit]> options;
    in property <bool> english;
    in-out property <bool> open: false;
    property <int> option-index: 0;
    property <length> option-height: 44px;
    property <bool> popup-visible: popup.is-open;
    callback request(string);
    callback edit(string);
    callback choose(string, string);
    callback clear();
    height: 32px;
    border-radius: 4px;
    border-width: 1px;
    border-color: root.open || focus.has-focus ? DesktopTheme.accent : DesktopTheme.border;
    background: DesktopTheme.control;
    accessible-role: button;
    accessible-label: (UiLanguage.tr("Find monsters by drop: ", "依掉落物找怪物：")) + root.query;
    accessible-action-default => { root.show-options(); }
    forward-focus: focus;
    function show-options() {
        root.option-index = 0;
        root.request(root.query);
        // Show synchronously, as Slint's ComboBox does. The shared flag follows
        // the actual popup instead of scheduling a second show via `changed`.
        popup.show();
        root.open = popup.is-open;
    }
    changed open => { if (!root.open && popup.is-open) { popup.close(); } }
    changed popup-visible => { root.open = root.popup-visible; }
    Text {
        x: 10px; y: 0px; width: parent.width - (root.query == "" ? 42px : 72px); height: 100%;
        text: root.query == "" ? (UiLanguage.tr("Item name or #ID…", "輸入道具名稱或 #編號…")) : root.query;
        color: root.query == "" ? DesktopTheme.secondary : DesktopTheme.text;
        font-size: 13px; overflow: elide; vertical-alignment: center;
    }
    DesktopIcon {
        x: parent.width - 24px; y: 9px; width: 14px; height: 14px;
        path: root.open ? "M6 15 L12 9 L18 15" : "M6 9 L12 15 L18 9";
        ink: DesktopTheme.secondary;
    }
    TouchArea {
        x: 0px; y: 0px; width: 100%; height: 100%; mouse-cursor: pointer;
        clicked => { root.show-options(); }
    }
    if root.query != "": MonsterTool {
        x: parent.width - 60px; y: 2px; width: 28px; height: 28px;
        label: "×";
        accessible-label: UiLanguage.tr("Clear drop", "清除掉落物");
        clicked => { root.clear(); }
    }
    focus := FocusScope {
        key-pressed(event) => {
            if (event.text == Key.Return || event.text == Key.Space || event.text == Key.DownArrow) {
                root.show-options(); return accept;
            }
            return reject;
        }
    }
    popup := PopupWindow {
        x: 0px; y: root.height + 4px;
        width: max(root.width, 320px);
        height: 64px + min(max(root.options.length, 1), 6) * root.option-height;
        close-policy: close-on-click-outside;
        forward-focus: query-input;
        Rectangle {
            x: 0px; y: 0px; width: 100%; height: 100%;
            background: DesktopTheme.surface-alt;
            border-radius: 6px; border-width: 1px; border-color: DesktopTheme.border;
            query-input := LineEdit {
                x: 8px; y: 8px; width: parent.width - 16px; height: 32px;
                text: root.query;
                placeholder-text: UiLanguage.tr("Name or #ID, e.g. #11608…", "名稱或 #編號，例如 #11608…");
                accessible-label: UiLanguage.tr("Search monster drops by item name or ID", "以道具名稱或編號搜尋怪物掉落物");
                edited => { root.option-index = 0; options-scroll.content-y = 0px; root.edit(self.text); }
                accepted => {
                    if (root.option-index >= 0 && root.option-index < root.options.length) {
                        root.choose(root.options[root.option-index].key, root.options[root.option-index].title);
                        root.open = false;
                    }
                }
                key-pressed(event) => {
                    if (event.text == Key.Escape) { root.open = false; return accept; }
                    if (event.text == Key.DownArrow || event.text == Key.UpArrow) {
                        root.option-index = max(0, min(root.options.length - 1, root.option-index + (event.text == Key.DownArrow ? 1 : -1)));
                        if (root.option-index * root.option-height < -options-scroll.content-y) { options-scroll.content-y = -root.option-index * root.option-height; }
                        else if ((root.option-index + 1) * root.option-height > -options-scroll.content-y + options-scroll.height) {
                            options-scroll.content-y = options-scroll.height - (root.option-index + 1) * root.option-height;
                        }
                        return accept;
                    }
                    return reject;
                }
            }
            options-scroll := Flickable {
                x: 4px; y: 48px; width: parent.width - 8px; height: parent.height - 56px;
                content-width: self.width;
                content-height: max(root.options.length * root.option-height, self.height);
                for option[i] in root.options: Rectangle {
                    x: 0px; y: i * root.option-height; width: parent.width; height: root.option-height;
                    border-radius: 3px;
                    background: option.key == root.selected-key ? DesktopTheme.selected : option-touch.has-hover || root.option-index == i ? DesktopTheme.hover-strong : transparent;
                    border-width: 1px;
                    border-color: option.key == root.selected-key ? DesktopTheme.accent : transparent;
                    accessible-role: button;
                    accessible-label: option.title + " · " + option.aside + " · " + option.subtitle + (UiLanguage.tr(" monsters", " 隻怪物"));
                    accessible-description: option.key == root.selected-key ? (UiLanguage.tr("Selected drop", "已選掉落物")) : "";
                    accessible-action-default => { root.choose(option.key, option.title); root.open = false; }
                    Text {
                        x: 10px; y: 4px; width: parent.width - 112px; height: 20px;
                        text: option.title; font-size: 13px; color: DesktopTheme.text;
                        overflow: elide; vertical-alignment: center;
                    }
                    Text {
                        x: 10px; y: 24px; width: parent.width - 112px; height: 16px;
                        text: option.aside; font-size: 11px; color: DesktopTheme.secondary;
                        vertical-alignment: center;
                    }
                    Text {
                        x: parent.width - 98px; y: 0px; width: 88px; height: 100%;
                        text: option.subtitle + (UiLanguage.tr(" monsters", " 隻怪物"));
                        font-size: 12px; color: DesktopTheme.secondary;
                        horizontal-alignment: right; vertical-alignment: center;
                    }
                    option-touch := TouchArea {
                        x: 0px; y: 0px; width: 100%; height: 100%; mouse-cursor: pointer;
                        clicked => { root.choose(option.key, option.title); root.open = false; }
                    }
                }
                if root.options.length == 0: Text {
                    x: 10px; y: 0px; width: parent.width - 20px; height: 36px;
                    text: UiLanguage.tr("No matching drops", "找不到符合的掉落物");
                    font-size: 13px; color: DesktopTheme.secondary; vertical-alignment: center;
                }
            }
        }
    }
}

component MonsterElementOption inherits Rectangle {
    in property <string> title;
    in property <image> icon;
    in property <bool> selected;
    callback clicked();
    width: root.icon.width > 0 ? 32px : max(40px, label.preferred-width + 16px);
    height: 32px;
    border-radius: 4px; border-width: 1px;
    border-color: root.selected || focus.has-focus ? DesktopTheme.accent : transparent;
    background: root.selected ? DesktopTheme.control : touch.has-hover ? DesktopTheme.hover : transparent;
    accessible-role: button;
    accessible-label: root.title;
    accessible-action-default => { root.clicked(); }
    forward-focus: focus;
    if root.icon.width > 0: Image {
        x: 4px; y: 4px; width: 24px; height: 24px;
        source: root.icon; image-fit: contain;
    }
    label := Text {
        x: 0px; y: 0px; width: 100%; height: 100%; visible: root.icon.width == 0;
        text: root.title; font-size: 13px;
        color: root.selected ? DesktopTheme.text : DesktopTheme.secondary;
        horizontal-alignment: center; vertical-alignment: center;
    }
    focus := FocusScope {
        x: 0px; y: 0px; width: 100%; height: 100%;
        key-pressed(event) => {
            if (event.text == Key.Return || event.text == Key.Space) { root.clicked(); return accept; }
            return reject;
        }
    }
    touch := TouchArea {
        x: 0px; y: 0px; width: 100%; height: 100%; mouse-cursor: pointer;
        clicked => { focus.focus(); root.clicked(); }
    }
    Tooltip {
        Rectangle {
            width: tip.preferred-width + 20px; height: 32px;
            background: DesktopTheme.raised; border-radius: 4px;
            border-width: 1px; border-color: DesktopTheme.border;
            tip := Text {
                x: 10px; y: 0px; width: parent.width - 20px; height: 100%;
                text: root.title; font-size: 13px; color: DesktopTheme.text; vertical-alignment: center;
            }
        }
    }
}

component MonsterSortPicker inherits Rectangle {
    in property <[string]> labels;
    in property <int> selected;
    in-out property <bool> open: false;
    property <bool> popup-visible: popup.is-open;
    property <int> option-index;
    callback pick(int);
    height: 32px;
    border-radius: 4px; border-width: 1px;
    border-color: root.open || focus.has-focus ? DesktopTheme.accent : DesktopTheme.border;
    background: DesktopTheme.control;
    accessible-role: combobox;
    accessible-label: root.labels[root.selected];
    accessible-expandable: true; accessible-expanded: root.open;
    accessible-action-expand => { root.show-options(); }
    forward-focus: focus;
    function show-options() {
        root.option-index = root.selected;
        popup.show();
        root.open = popup.is-open;
    }
    changed open => { if (!root.open && popup.is-open) { popup.close(); } }
    changed popup-visible => { root.open = root.popup-visible; }
    Text {
        x: 10px; y: 0px; width: parent.width - 38px; height: 100%;
        text: root.labels[root.selected]; color: DesktopTheme.text; font-size: 13px;
        overflow: elide; vertical-alignment: center;
    }
    DesktopIcon {
        x: parent.width - 24px; y: 9px; width: 14px; height: 14px;
        path: root.open ? "M6 15 L12 9 L18 15" : "M6 9 L12 15 L18 9";
        ink: DesktopTheme.secondary;
    }
    focus := FocusScope {
        x: 0px; y: 0px; width: 100%; height: 100%;
        key-pressed(event) => {
            if (event.text == Key.Return || event.text == Key.Space || event.text == Key.DownArrow) { root.show-options(); return accept; }
            return reject;
        }
    }
    TouchArea {
        x: 0px; y: 0px; width: 100%; height: 100%; mouse-cursor: pointer;
        clicked => { root.show-options(); }
    }
    popup := PopupWindow {
        x: 0px; y: root.height + 4px; width: root.width;
        height: root.labels.length * 32px + 8px;
        close-policy: close-on-click-outside;
        forward-focus: popup-focus;
        Rectangle {
            x: 0px; y: 0px; width: 100%; height: 100%;
            background: DesktopTheme.surface-alt; border-radius: 4px;
            border-width: 1px; border-color: DesktopTheme.border;
            popup-focus := FocusScope {
                x: 0px; y: 0px; width: 100%; height: 100%;
                key-pressed(event) => {
                    if (event.text == Key.Escape) { root.open = false; return accept; }
                    if (event.text == Key.UpArrow || event.text == Key.DownArrow) {
                        root.option-index = max(0, min(root.labels.length - 1, root.option-index + (event.text == Key.DownArrow ? 1 : -1)));
                        return accept;
                    }
                    if (event.text == Key.Return || event.text == Key.Space) { root.pick(root.option-index); root.open = false; return accept; }
                    return reject;
                }
            }
            for label[i] in root.labels: Rectangle {
                x: 4px; y: 4px + i * 32px; width: parent.width - 8px; height: 32px;
                border-radius: 3px;
                background: touch.has-hover || root.option-index == i ? DesktopTheme.hover-strong : transparent;
                accessible-role: button; accessible-label: label;
                accessible-action-default => { root.pick(i); root.open = false; }
                Text {
                    x: 8px; y: 0px; width: parent.width - 16px; height: 100%;
                    text: label; font-size: 13px; color: DesktopTheme.text; vertical-alignment: center;
                }
                touch := TouchArea {
                    x: 0px; y: 0px; width: 100%; height: 100%; mouse-cursor: pointer;
                    clicked => { root.pick(i); root.open = false; }
                }
            }
        }
    }
}

// The region directory stays separate from the monster search and filters.
component MonsterRegionLink inherits Rectangle {
    in property <string> title;
    in property <string> short-title: root.title;
    in property <bool> heading;
    in property <bool> selected;
    in property <bool> keyboard-current;
    callback clicked();
    callback step(int);
    height: 34px;
    border-radius: 5px;
    background: root.selected ? DesktopTheme.selected : touch.has-hover ? DesktopTheme.hover : transparent;
    border-width: 1px;
    border-color: focus.has-focus || root.keyboard-current ? DesktopTheme.accent : transparent;
    accessible-role: button;
    accessible-label: root.title;
    accessible-description: root.selected ? "Selected" : "";
    accessible-action-default => { root.clicked(); }
    forward-focus: focus;
    Text {
        x: 10px; y: 0px; width: parent.width - 20px; height: 100%;
        text: root.short-title; overflow: elide; vertical-alignment: center;
        font-size: 13px; font-weight: root.heading || root.selected ? 600 : 400;
        color: root.selected ? DesktopTheme.accent : root.heading ? DesktopTheme.text : DesktopTheme.secondary;
    }
    focus := FocusScope {
        width: 100%; height: 100%;
        key-pressed(event) => {
            if (event.text == Key.Return || event.text == Key.Space) { root.clicked(); return accept; }
            if (event.text == Key.UpArrow || event.text == Key.DownArrow) { root.step(event.text == Key.DownArrow ? 1 : -1); return accept; }
            return reject;
        }
    }
    touch := TouchArea {
        width: 100%; height: 100%; mouse-cursor: pointer;
        clicked => { focus.focus(); root.clicked(); }
    }
    Tooltip {
        Rectangle {
            width: min(tip.preferred-width + 20px, 420px); height: tip.preferred-height + 16px;
            background: DesktopTheme.raised; border-radius: 4px;
            border-width: 1px; border-color: DesktopTheme.border;
            tip := Text {
                x: 10px; y: 8px; width: parent.width - 20px;
                text: root.title; wrap: word-wrap; font-size: 13px; color: DesktopTheme.text;
            }
        }
    }
}

component MonsterRangeField inherits Rectangle {
    in property <string> label;
    in property <string> minimum;
    in property <string> maximum;
    in property <bool> english;
    in property <color> ink: DesktopTheme.secondary;
    callback edit-min(string);
    callback edit-max(string);
    height: 54px;
    Text {
        x: 0px; y: 0px; width: 100%; height: 18px;
        text: root.label; font-size: 12px; color: root.ink;
    }
    LineEdit {
        x: 0px; y: 22px; width: (parent.width - 24px) / 2; height: 32px;
        text: root.minimum; placeholder-text: UiLanguage.tr("Min", "最低（不限）");
        accessible-label: root.label + (UiLanguage.tr(" minimum", "最低值"));
        edited => { root.edit-min(self.text); }
    }
    Text {
        x: (parent.width - 24px) / 2; y: 22px; width: 24px; height: 32px;
        text: "–"; horizontal-alignment: center; vertical-alignment: center; color: DesktopTheme.secondary;
    }
    LineEdit {
        x: (parent.width + 24px) / 2; y: 22px; width: (parent.width - 24px) / 2; height: 32px;
        text: root.maximum; placeholder-text: UiLanguage.tr("Max", "最高（不限）");
        accessible-label: root.label + (UiLanguage.tr(" maximum", "最高值"));
        edited => { root.edit-max(self.text); }
    }
}

component BoardFilter inherits Rectangle {
    in property <bool> open;
    in property <bool> menu-open: true;
    in property <bool> show-menu: true;
    in property <bool> active;
    in property <int> element: -1;
    in property <[image]> element-icons;
    in property <string> hit-min;
    in property <string> hit-max;
    in property <string> magic-min;
    in property <string> magic-max;
    in-out property <bool> advanced-open: false;
    in property <int> sort-key: 0;
    in property <bool> sort-desc: true;
    in-out property <bool> sort-open: false;
    in property <string> ela-min;
    in property <string> ela-max;
    in property <string> drop;
    in property <string> drop-key;
    in property <[Hit]> drop-options;
    in-out property <bool> drop-open: false;
    in property <bool> global-scope;
    in property <bool> scoped: true;
    in property <int> result-count;
    in property <bool> result-known: true;
    in property <bool> english;
    in property <string> current-label: UiLanguage.tr("Current region", "目前地區");
    in property <string> scope-title: root.current-label;
    property <[string]> element-labels: [UiLanguage.tr("All", "全部"), UiLanguage.tr("None", "無"), UiLanguage.tr("Fire", "火"), UiLanguage.tr("Water", "水"), UiLanguage.tr("Wind", "風"), UiLanguage.tr("Thunder", "雷"), UiLanguage.tr("Earth", "地")];
    property <length> drop-width: (root.width - 20px) * 0.55;
    property <length> sort-width: root.width < 620px ? 168px : 200px;
    property <[string]> sort-labels: root.drop-key != ""
        ? ([UiLanguage.tr("Default order", "原排序"), UiLanguage.tr("ELA", "屬性值（ELA）"), UiLanguage.tr("Hit resist", "打擊抗性"), UiLanguage.tr("Magic resist", "魔法抗性"), UiLanguage.tr("HP", "體力"), UiLanguage.tr("MP", "魔力"), UiLanguage.tr("Experience", "經驗"), UiLanguage.tr("Name", "名稱"), UiLanguage.tr("Drop rate", "掉落率")])
        : ([UiLanguage.tr("Default order", "原排序"), UiLanguage.tr("ELA", "屬性值（ELA）"), UiLanguage.tr("Hit resist", "打擊抗性"), UiLanguage.tr("Magic resist", "魔法抗性"), UiLanguage.tr("HP", "體力"), UiLanguage.tr("MP", "魔力"), UiLanguage.tr("Experience", "經驗"), UiLanguage.tr("Name", "名稱")]);
    property <string> sort-direction: root.sort-desc ? "↓" : "↑";
    property <string> sort-direction-description: root.sort-key == 7 ? (root.sort-desc ? "Z → A" : "A → Z") : root.sort-desc ? (UiLanguage.tr("High → low", "由高至低")) : (UiLanguage.tr("Low → high", "由低至高"));
    property <string> sort-help: root.sort-direction-description + (root.sort-key == 8
        ? (UiLanguage.tr("\nSelected item only; unknown rates stay last.\nMultiple drop slots use the highest rate, without adding them.", "\n只比較所選道具，未記錄機率排最後。\n同一怪物有多個掉落欄時取最高值，不加總。")) : "");
    property <int> advanced-count: (root.hit-min != "" || root.hit-max != "" ? 1 : 0) + (root.magic-min != "" || root.magic-max != "" ? 1 : 0);
    property <string> summary: (root.sort-key > 0 ? root.sort-labels[root.sort-key] + " " + root.sort-direction + " · " : "")
        + (root.global-scope ? (UiLanguage.tr("All monsters", "所有怪物")) : root.scope-title)
        + (root.element >= 0 ? " · " + root.element-labels[root.element + 1] : "")
        + (root.ela-min != "" || root.ela-max != "" ? " · " + (UiLanguage.tr("Value ", "屬性值 ")) + (root.ela-min == "" ? "0" : root.ela-min) + "–" + (root.ela-max == "" ? "∞" : root.ela-max) : "")
        + (root.drop != "" ? " · " + root.drop : "")
        + (root.hit-min != "" || root.hit-max != "" ? " · " + (UiLanguage.tr("Hit ", "打抗 ")) + (root.hit-min == "" ? "0" : root.hit-min) + "–" + (root.hit-max == "" ? "∞" : root.hit-max) : "")
        + (root.magic-min != "" || root.magic-max != "" ? " · " + (UiLanguage.tr("Magic ", "魔抗 ")) + (root.magic-min == "" ? "0" : root.magic-min) + "–" + (root.magic-max == "" ? "∞" : root.magic-max) : "");
    callback toggle();
    callback toggle-menu();
    callback clear();
    callback pick(int);
    callback pick-scope(bool);
    callback edit-min(string);
    callback edit-max(string);
    callback edit-hit-min(string);
    callback edit-hit-max(string);
    callback edit-magic-min(string);
    callback edit-magic-max(string);
    callback pick-sort(int);
    callback toggle-sort-direction();
    callback edit-drop(string);
    callback request-drops(string);
    callback select-drop(string, string);
    callback clear-drop();
    height: open ? 212px + (root.advanced-open ? 76px : 0px) : 32px;
    if root.show-menu: MonsterTool {
        x: 0px; y: 0px; width: 64px; height: 30px;
        label: UiLanguage.tr("Regions", "目錄"); active: root.menu-open;
        clicked => { root.toggle-menu(); }
    }
    MonsterTool {
        x: root.show-menu ? 72px : 0px; y: 0px; width: 64px; height: 30px;
        label: UiLanguage.tr("Filters", "篩選"); active: root.open || root.active;
        clicked => { root.toggle(); }
    }
    Text {
        x: root.show-menu ? 148px : 76px; y: 0px;
        width: max(16px, parent.width - self.x - 116px - (root.active ? 72px : 0px)); height: 30px;
        text: root.summary; font-size: 12px; color: DesktopTheme.secondary;
        overflow: elide; vertical-alignment: center;
    }
    Text {
        x: parent.width - 112px - (root.active ? 72px : 0px); y: 0px; width: 112px; height: 30px;
        text: !root.result-known || root.result-count < 0 ? ""
            : root.result-count == 0 ? (UiLanguage.tr("No matches", "沒有符合的怪物"))
            : root.result-count + (UiLanguage.tr(" monsters", " 隻怪物"));
        font-size: 12px; color: root.result-count == 0 && root.result-known ? DesktopTheme.text : DesktopTheme.secondary;
        horizontal-alignment: right; vertical-alignment: center;
    }
    if root.active: MonsterTool {
        x: parent.width - 64px; y: 0px; width: 64px; height: 30px;
        label: UiLanguage.tr("Reset", "重設");
        clicked => { root.drop-open = false; root.sort-open = false; root.clear(); }
    }
    if root.open: Rectangle {
        x: 0px; y: 40px; width: 100%; height: root.height - 40px;
        Text { x: 0px; y: 0px; width: 56px; height: 28px; text: UiLanguage.tr("Scope", "範圍"); color: DesktopTheme.secondary; font-size: 12px; vertical-alignment: center; }
        if root.scoped: MonsterTool { x: 64px; y: 0px; width: 124px; label: root.current-label; active: !root.global-scope; clicked => { root.pick-scope(false); } }
        MonsterTool { x: root.scoped ? 192px : 64px; y: 0px; width: 124px; label: UiLanguage.tr("All monsters", "所有怪物"); active: root.global-scope; clicked => { root.pick-scope(true); } }
        Text { x: 0px; y: 36px; width: 56px; height: 28px; text: UiLanguage.tr("Element", "屬性"); color: DesktopTheme.secondary; font-size: 12px; vertical-alignment: center; }
        HorizontalLayout {
            x: 64px; y: 34px; width: parent.width - 64px; height: 32px;
            spacing: 6px; alignment: start;
            for label[i] in root.element-labels: MonsterElementOption {
                title: label; icon: root.element-icons[i]; selected: root.element == i - 1;
                clicked => { root.pick(i - 1); }
            }
        }
        Text { x: 0px; y: 72px; width: root.drop-width; height: 18px; text: UiLanguage.tr("Drop item", "掉落物"); font-size: 12px; color: DesktopTheme.secondary; }
        MonsterDropPicker {
            x: 0px; y: 94px; width: root.drop-width;
            query: root.drop; selected-key: root.drop-key; options: root.drop-options;
            english: root.english; open <=> root.drop-open;
            request(text) => { root.request-drops(text); }
            edit(text) => { root.edit-drop(text); }
            choose(key, title) => { root.select-drop(key, title); }
            clear => { root.clear-drop(); }
        }
        Text { x: root.drop-width + 20px; y: 72px; width: parent.width - self.x; height: 18px; text: UiLanguage.tr("ELA · min / max", "屬性值（ELA）· 最低／最高"); font-size: 12px; color: DesktopTheme.secondary; }
        LineEdit {
            x: root.drop-width + 20px; y: 94px; width: (parent.width - self.x - 24px) / 2; height: 32px;
            placeholder-text: UiLanguage.tr("Min", "不限"); text: root.ela-min;
            edited => { root.edit-min(self.text); }
        }
        Text { x: root.drop-width + 20px + (parent.width - root.drop-width - 44px) / 2; y: 94px; width: 24px; height: 32px; text: "–"; horizontal-alignment: center; vertical-alignment: center; color: DesktopTheme.secondary; }
        LineEdit {
            x: root.drop-width + 44px + (parent.width - root.drop-width - 44px) / 2; y: 94px; width: (parent.width - root.drop-width - 44px) / 2; height: 32px;
            placeholder-text: UiLanguage.tr("Max", "不限"); text: root.ela-max;
            edited => { root.edit-max(self.text); }
        }
        Text { x: 0px; y: 136px; width: 56px; height: 32px; text: UiLanguage.tr("Sort", "排序"); font-size: 12px; color: DesktopTheme.secondary; vertical-alignment: center; }
        MonsterSortPicker {
            x: 64px; y: 136px; width: root.sort-width;
            labels: root.sort-labels; selected: root.sort-key; open <=> root.sort-open;
            pick(key) => { root.pick-sort(key); }
        }
        if root.sort-key != 0: MonsterTool {
            x: 72px + root.sort-width; y: 136px; width: 36px; height: 32px;
            label: root.sort-direction; label-size: 18px; active: true;
            accessible-label: (UiLanguage.tr("Sort direction: ", "排序方向：")) + root.sort-help;
            clicked => { root.toggle-sort-direction(); }
            Tooltip {
                Rectangle {
                    width: min(direction-tip.preferred-width + 20px, 360px); height: direction-tip.preferred-height + 16px;
                    background: DesktopTheme.raised; border-radius: 4px;
                    border-width: 1px; border-color: DesktopTheme.border;
                    direction-tip := Text {
                        x: 10px; y: 8px; width: parent.width - 20px; height: self.preferred-height;
                        text: root.sort-help;
                        font-size: 13px; color: DesktopTheme.text; wrap: word-wrap;
                    }
                }
            }
        }
        MonsterTool {
            x: parent.width - 140px; y: 136px; width: 140px; height: 32px;
            label: (root.advanced-open ? (UiLanguage.tr("Less filters", "收起進階條件")) : (UiLanguage.tr("Advanced", "進階條件"))) + (root.advanced-count > 0 ? " · " + root.advanced-count : "");
            active: root.advanced-open || root.advanced-count > 0;
            clicked => { root.drop-open = false; root.sort-open = false; root.advanced-open = !root.advanced-open; }
        }
        if root.advanced-open: MonsterRangeField {
            x: 0px; y: 176px; width: (parent.width - 20px) / 2;
            label: UiLanguage.tr("Hit resist (%) · min / max", "打擊抗性（%）· 最低／最高");
            minimum: root.hit-min; maximum: root.hit-max; english: root.english; ink: #e3a1a1;
            edit-min(text) => { root.edit-hit-min(text); }
            edit-max(text) => { root.edit-hit-max(text); }
        }
        if root.advanced-open: MonsterRangeField {
            x: (parent.width + 20px) / 2; y: 176px; width: (parent.width - 20px) / 2;
            label: UiLanguage.tr("Magic resist (%) · min / max", "魔法抗性（%）· 最低／最高");
            minimum: root.magic-min; maximum: root.magic-max; english: root.english; ink: #a4c4e8;
            edit-min(text) => { root.edit-magic-min(text); }
            edit-max(text) => { root.edit-magic-max(text); }
        }
    }
}

// Full mode keeps one monster per row, with combat values always visible.
component MonsterStat inherits Rectangle {
    in property <string> label;
    in property <string> value;
    in property <color> ink: DesktopTheme.text;
    in property <color> label-ink: DesktopTheme.secondary;
    height: 36px;
    Text {
        x: 0px; y: 0px; width: 100%; height: 16px;
        text: root.label; font-size: 12px; color: root.label-ink;
    }
    Text {
        x: 0px; y: 17px; width: 100%; height: 19px;
        text: root.value; font-size: 13px; font-weight: 600; color: root.ink;
        overflow: elide;
    }
}

component DropContextMenu inherits PopupWindow {
    in property <bool> english;
    callback find-monsters();
    property <string> action-title: UiLanguage.tr("Find monsters with this drop", "查看掉落此道具的所有怪物");
    width: max(260px, action-label.preferred-width + 32px);
    height: 40px;
    close-policy: close-on-click-outside;
    forward-focus: menu-focus;
    function activate() {
        root.close();
        root.find-monsters();
    }
    Rectangle {
        x: 0px; y: 0px; width: 100%; height: 100%;
        background: DesktopTheme.raised; border-radius: 5px;
        border-width: 1px; border-color: DesktopTheme.border;
        menu-focus := FocusScope {
            x: 0px; y: 0px; width: 100%; height: 100%;
            key-pressed(event) => {
                if (event.text == Key.Escape) { root.close(); return accept; }
                if (event.text == Key.Return || event.text == Key.Space) { root.activate(); return accept; }
                return reject;
            }
        }
        Rectangle {
            x: 4px; y: 4px; width: parent.width - 8px; height: 32px;
            border-radius: 3px;
            background: action-touch.has-hover || menu-focus.has-focus ? DesktopTheme.hover-strong : transparent;
            accessible-role: button;
            accessible-label: root.action-title;
            accessible-action-default => { root.activate(); }
            action-label := Text {
                x: 12px; y: 0px; width: parent.width - 24px; height: 100%;
                text: root.action-title; font-size: 13px; color: DesktopTheme.text;
                vertical-alignment: center;
            }
            action-touch := TouchArea {
                x: 0px; y: 0px; width: 100%; height: 100%; mouse-cursor: pointer;
                clicked => { root.activate(); }
            }
        }
    }
}

component MonsterDropIcon inherits Rectangle {
    in property <MonsterDrop> drop;
    in property <bool> english;
    property <bool> rate-known: root.drop.drop-rate.ends-with("%");
    property <string> rate-description: root.rate-known
        ? (UiLanguage.tr("Drop rate: ", "掉落率：")) + root.drop.drop-rate
        : (UiLanguage.tr("Drop rate not recorded", "掉落率未記錄"));
    callback open(string);
    callback find-monsters(string, string);
    property <length> context-x: 0px;
    property <length> context-y: root.height;
    function show-context(x: length, y: length) {
        root.context-x = x; root.context-y = y;
        context.show();
    }
    width: 80px; height: 28px;
    border-radius: 4px;
    background: touch.has-hover ? DesktopTheme.hover-strong : root.drop.selected ? DesktopTheme.selected : transparent;
    border-width: 1px;
    border-color: root.drop.selected || focus.has-focus ? DesktopTheme.accent : transparent;
    accessible-role: button;
    accessible-label: drop.title;
    accessible-description: (root.drop.alternate-name != "" ? root.drop.alternate-name + " · " : "") + (root.drop.selected ? (UiLanguage.tr("Selected drop · ", "已選掉落物 · ")) : "") + root.rate-description;
    accessible-action-default => { root.open(root.drop.key); }
    forward-focus: focus;
    if root.drop.has-icon: Image {
        x: 3px; y: 3px; width: 22px; height: 22px;
        source: root.drop.icon; image-fit: contain;
    }
    if !root.drop.has-icon: DesktopIcon {
        x: 6px; y: 6px; width: 16px; height: 16px;
        path: "M4 6 L12 2 L20 6 L20 18 L12 22 L4 18 Z M4 6 L12 10 L20 6 M12 10 L12 22";
        ink: DesktopTheme.secondary;
    }
    Text {
        x: 28px; y: 0px; width: parent.width - 30px; height: 100%;
        text: root.rate-known ? root.drop.drop-rate : "—";
        font-size: 12px; font-weight: root.drop.selected ? 600 : 400;
        color: root.drop.selected ? DesktopTheme.text : DesktopTheme.secondary;
        vertical-alignment: center;
    }
    focus := FocusScope {
        x: 0px; y: 0px; width: 100%; height: 100%;
        key-pressed(event) => {
            if (event.text == Key.Menu || (event.modifiers.shift && event.text == Key.F10)) {
                root.show-context(0px, root.height); return accept;
            }
            if (event.text == Key.Return || event.text == Key.Space) {
                root.open(root.drop.key); return accept;
            }
            return reject;
        }
    }
    touch := TouchArea {
        x: 0px; y: 0px; width: 100%; height: 100%; mouse-cursor: pointer;
        clicked => { focus.focus(); root.open(root.drop.key); }
        pointer-event(event) => {
            if (event.button == PointerEventButton.right && event.kind == PointerEventKind.up) {
                focus.focus(); root.show-context(self.mouse-x, self.mouse-y);
            }
        }
    }
    context := DropContextMenu {
        x: root.context-x; y: root.context-y; english: root.english;
        find-monsters => { root.find-monsters(root.drop.key, root.drop.title); }
    }
    Tooltip {
        Rectangle {
            width: min(tip.preferred-width + 20px, 320px);
            height: tip.preferred-height + 16px;
            background: DesktopTheme.raised;
            border-radius: 5px;
            border-width: 1px; border-color: DesktopTheme.border;
            tip := Text {
                x: 10px; y: 8px; width: parent.width - 20px;
                height: self.preferred-height;
                text: root.drop.title + (root.drop.alternate-name != "" ? "\n" + root.drop.alternate-name : "") + "\n" + root.rate-description; font-size: 13px;
                color: DesktopTheme.text; wrap: word-wrap;
            }
        }
    }
}

component MonsterNames inherits Rectangle {
    in property <string> title;
    in property <string> alternate;
    in property <bool> compact: false;
    height: root.compact ? (root.alternate != "" ? 40px : 22px) : primary.preferred-height + (root.alternate != "" ? secondary.preferred-height + 4px : 0px);
    accessible-role: text;
    accessible-label: root.title;
    accessible-description: root.alternate;
    primary := Text {
        x: 0px; y: 0px; width: 100%; height: root.compact ? 22px : self.preferred-height;
        text: root.title; font-size: 15px; font-weight: 600; color: DesktopTheme.text;
        wrap: word-wrap; overflow: elide;
    }
    secondary := Text {
        x: 0px; y: root.compact ? 22px : primary.height + 4px;
        width: 100%; height: root.compact ? 18px : self.preferred-height;
        visible: root.alternate != "";
        text: root.alternate; font-size: 12px; color: DesktopTheme.secondary;
        wrap: word-wrap; overflow: elide;
    }
    Tooltip {
        Rectangle {
            width: min(380px, tip.preferred-width + 24px); height: tip.preferred-height + 20px;
            background: DesktopTheme.raised; border-radius: 5px;
            border-width: 1px; border-color: DesktopTheme.border;
            tip := Text {
                x: 12px; y: 10px; width: parent.width - 24px; height: self.preferred-height;
                text: root.title + (root.alternate != "" ? "\n" + root.alternate : "");
                font-size: 13px; color: DesktopTheme.text; wrap: word-wrap;
            }
        }
    }
}

component MonsterTableRow inherits Rectangle {
    in property <Hit> hit;
    in property <bool> selected: false;
    in property <bool> expanded: false;
    in property <string> no-image-label: UiLanguage.tr("No image", "沒有圖片");
    in property <bool> english: false;
    in property <bool> portrait: false;
    callback clicked();
    callback favourite-clicked();
    callback open-drop(string);
    callback find-drop-monsters(string, string);
    property <int> drop-columns: root.width >= 924px ? 10 : 5;
    property <length> drop-cell-width: (root.width - 124px - (root.drop-columns - 1) * 4px) / root.drop-columns;
    height: root.drop-columns == 10 ? 128px : 160px;
    border-radius: 6px;
    border-width: 1px;
    border-color: selected ? DesktopTheme.accent : transparent;
    background: selected ? DesktopTheme.selected : area.has-hover ? DesktopTheme.hover : DesktopTheme.surface-alt;
    property <length> identity-w: root.width < 660px ? 132px : 196px;
    property <length> stats-x: 76px + identity-w + 16px;
    property <length> stat-w: (root.width - stats-x - 48px) / 3;
    property <color> element-ink: hit.stat-element.starts-with("火") || hit.stat-element.starts-with("Fire") || hit.stat-element.starts-with("불") ? #e3a18b
        : hit.stat-element.starts-with("水") || hit.stat-element.starts-with("Water") || hit.stat-element.starts-with("물") ? #a4c4e8
        : hit.stat-element.starts-with("風") || hit.stat-element.starts-with("Wind") || hit.stat-element.starts-with("바람") ? #b3ceaa
        : hit.stat-element.starts-with("雷") || hit.stat-element.starts-with("Thunder") || hit.stat-element.starts-with("번개") || hit.stat-element.starts-with("뇌전") ? #ccb2e3
        : hit.stat-element.starts-with("地") || hit.stat-element.starts-with("Earth") || hit.stat-element.starts-with("땅") ? #ddc18e
        : DesktopTheme.secondary;
    accessible-role: button;
    accessible-label: hit.title;
    accessible-description: hit.alternate-name;
    accessible-action-default => { root.clicked(); }
    area := TouchArea {
        x: 0px; y: 0px; width: 100%; height: 100%;
        clicked => { root.clicked(); } mouse-cursor: pointer;
    }
    Rectangle {
        x: 12px; y: 12px; width: 52px; height: 72px;
        if root.hit.has-icon && (!root.hit.has-battle || root.portrait): Image {
            x: 0px; y: 6px; width: 52px; height: 52px;
            source: root.hit.icon; image-fit: contain;
        }
        if root.hit.no-image && !root.hit.has-battle: NoImage {
            x: 0px; y: 6px; side: 52px; label: root.no-image-label;
        }
        if root.hit.has-battle && !root.portrait: Image {
            x: 0px; y: 0px; width: 52px; height: 72px;
            source: root.hit.battle; image-fit: contain;
        }
    }
    MonsterNames {
        x: 76px; y: 10px; width: root.identity-w;
        title: root.hit.title; alternate: root.hit.alternate-name; compact: true;
    }
    Text {
        x: 76px; y: root.hit.alternate-name != "" ? 52px : 40px; width: root.identity-w; height: 18px;
        text: root.hit.stat-kind; font-size: 12px; color: DesktopTheme.secondary; overflow: elide;
    }
    if root.hit.has-badge: Image {
        x: 76px; y: root.hit.alternate-name != "" ? 72px : 62px; width: 18px; height: 18px;
        source: root.hit.badge; image-fit: contain;
    }
    Text {
        x: 76px + (root.hit.has-badge ? 24px : 0px); y: root.hit.alternate-name != "" ? 72px : 62px;
        width: root.identity-w - (root.hit.has-badge ? 24px : 0px); height: 18px;
        text: root.hit.stat-element; font-size: 12px; color: root.element-ink; overflow: elide;
    }
    MonsterStat { x: root.stats-x; y: 10px; width: root.stat-w; label: UiLanguage.tr("HP", "體力"); value: root.hit.stat-hp; ink: #e3a1a1; }
    MonsterStat { x: root.stats-x + root.stat-w + 8px; y: 10px; width: root.stat-w; label: UiLanguage.tr("MP", "魔力"); value: root.hit.stat-mp; ink: #a4c4e8; }
    MonsterStat { x: root.stats-x + 2 * (root.stat-w + 8px); y: 10px; width: root.stat-w; label: UiLanguage.tr("Attack", "攻擊"); value: root.hit.stat-atk; }
    MonsterStat { x: root.stats-x; y: 52px; width: root.stat-w; label: UiLanguage.tr("Hit resist", "打擊抗性"); value: root.hit.stat-hit; ink: #e3a1a1; label-ink: #e3a1a1; }
    MonsterStat { x: root.stats-x + root.stat-w + 8px; y: 52px; width: root.stat-w; label: UiLanguage.tr("Magic resist", "魔法抗性"); value: root.hit.stat-magic; ink: #a4c4e8; label-ink: #a4c4e8; }
    MonsterStat { x: root.stats-x + 2 * (root.stat-w + 8px); y: 52px; width: root.stat-w; label: UiLanguage.tr("Exp", "經驗"); value: root.hit.stat-exp; }
    Text {
        x: 12px; y: 99px; width: 64px; height: 22px;
        text: (UiLanguage.tr("Drops ", "掉落 ")) + root.hit.drop-total;
        font-size: 12px; color: DesktopTheme.secondary; vertical-alignment: center;
    }
    for drop[i] in root.hit.monster-drops: MonsterDropIcon {
        x: 80px + mod(i, root.drop-columns) * (root.drop-cell-width + 4px);
        y: 96px + floor(i / root.drop-columns) * 32px;
        width: root.drop-cell-width;
        drop: drop; english: root.english;
        open(key) => { root.open-drop(key); }
        find-monsters(key, title) => { root.find-drop-monsters(key, title); }
    }
    StarMark {
        x: parent.width - 32px; y: 6px; filled: root.hit.favourite;
        clicked => { root.favourite-clicked(); }
    }
    DesktopIcon {
        x: parent.width - 27px; y: 102px; width: 16px; height: 16px;
        path: root.expanded ? "M6 9 L12 15 L18 9" : "M9 6 L15 12 L9 18";
        ink: DesktopTheme.secondary;
    }
}

component CompactRecordLink inherits Rectangle {
    in property <string> title;
    in property <string> aside;
    in property <string> alternate: "";
    in property <image> icon;
    in property <bool> has-icon;
    in property <bool> drop-context-enabled: false;
    in property <bool> english;
    callback clicked();
    callback find-monsters();
    property <length> context-x: 0px;
    property <length> context-y: root.height;
    function show-context(x: length, y: length) {
        if (!root.drop-context-enabled) { return; }
        root.context-x = x; root.context-y = y;
        context.show();
    }
    height: max(30px, label.preferred-height + 10px + (root.alternate != "" ? secondary.preferred-height + 3px : 0px));
    border-radius: 4px;
    background: tap.has-hover ? DesktopTheme.hover-strong : transparent;
    accessible-role: button;
    accessible-label: title;
    accessible-description: root.alternate + (root.aside != "" ? (root.alternate != "" ? " · " : "") + (UiLanguage.tr("Drop rate: ", "掉落率：")) + root.aside : "");
    accessible-action-default => { root.clicked(); }
    forward-focus: focus;
    if root.has-icon: Image {
        x: 4px; y: (parent.height - 22px) / 2; width: 22px; height: 22px;
        source: root.icon; image-fit: contain;
    }
    label := Text {
        x: root.has-icon ? 32px : 4px; y: 5px;
        width: parent.width - self.x - (root.aside != "" ? rate-label.preferred-width + 16px : 4px); height: self.preferred-height;
        text: root.title; font-size: 13px; color: DesktopTheme.accent;
        wrap: word-wrap;
    }
    rate-label := Text {
        x: parent.width - self.preferred-width - 4px; y: 5px;
        width: self.preferred-width; height: 20px;
        text: root.aside; font-size: 12px; color: DesktopTheme.secondary;
        vertical-alignment: center;
    }
    secondary := Text {
        x: root.has-icon ? 32px : 4px; y: label.y + label.height + 3px;
        width: parent.width - self.x - 4px; height: self.preferred-height;
        visible: root.alternate != "";
        text: root.alternate; font-size: 12px; color: DesktopTheme.secondary;
        wrap: word-wrap;
    }
    if root.drop-context-enabled && focus.has-focus: Rectangle {
        x: 0px; y: 0px; width: 100%; height: 100%;
        border-radius: 4px; border-width: 1px; border-color: DesktopTheme.accent;
    }
    focus := FocusScope {
        x: 0px; y: 0px; width: 100%; height: 100%;
        enabled: root.drop-context-enabled;
        key-pressed(event) => {
            if (event.text == Key.Menu || (event.modifiers.shift && event.text == Key.F10)) {
                root.show-context(0px, root.height); return accept;
            }
            if (event.text == Key.Return || event.text == Key.Space) {
                root.clicked(); return accept;
            }
            return reject;
        }
    }
    tap := TouchArea {
        x: 0px; y: 0px; width: 100%; height: 100%; mouse-cursor: pointer;
        clicked => { if (root.drop-context-enabled) { focus.focus(); } root.clicked(); }
        pointer-event(event) => {
            if (root.drop-context-enabled && event.button == PointerEventButton.right && event.kind == PointerEventKind.up) {
                focus.focus(); root.show-context(self.mouse-x, self.mouse-y);
            }
        }
    }
    context := DropContextMenu {
        x: root.context-x; y: root.context-y; english: root.english;
        find-monsters => { root.find-monsters(); }
    }
}

// Classic reference-page structure using the app’s existing desktop palette.
component LegacyPlace inherits Rectangle {
    in property <string> title;
    in property <bool> heading;
    in property <bool> selected;
    callback clicked();
    height: 30px;
    background: selected ? DesktopTheme.selected : heading ? DesktopTheme.control : tap.has-hover ? DesktopTheme.hover : transparent;
    accessible-role: button;
    accessible-label: title;
    accessible-action-default => { root.clicked(); }
    Text {
        x: 8px; width: parent.width - 16px; height: 100%;
        text: root.title;
        font-size: root.heading ? 14px : 13px;
        font-weight: root.heading ? 600 : 400;
        color: DesktopTheme.text;
        vertical-alignment: center; overflow: elide;
    }
    tap := TouchArea {
        width: 100%; height: 100%;
        mouse-cursor: root.heading ? default : pointer;
        clicked => { root.clicked(); }
    }
}

component LegacyDropLink inherits Rectangle {
    in property <string> title;
    in property <string> drop-rate;
    in property <bool> selected: false;
    in property <string> alternate: "";
    in property <string> separator;
    in property <length> available-width;
    in property <bool> english;
    callback clicked();
    callback find-monsters();
    property <length> context-x: 0px;
    property <length> context-y: root.height;
    function show-context(x: length, y: length) {
        root.context-x = x; root.context-y = y;
        context.show();
    }
    width: min(label.preferred-width, max(1px, root.available-width));
    height: max(20px, label.preferred-height);
    background: root.selected ? DesktopTheme.selected : transparent;
    accessible-role: button;
    accessible-label: root.title;
    accessible-description: (root.alternate != "" ? root.alternate + " · " : "") + (root.selected ? (UiLanguage.tr("Selected drop · ", "已選掉落物 · ")) : "") + (UiLanguage.tr("Drop rate: ", "掉落率：")) + root.drop-rate;
    accessible-action-default => { root.clicked(); }
    forward-focus: focus;
    label := Text {
        x: 0px; y: 0px; width: parent.width; height: self.preferred-height;
        text: root.title + " (" + root.drop-rate + ")" + root.separator;
        font-size: 13px; font-weight: root.selected ? 600 : 400; wrap: word-wrap;
        color: root.selected || tap.has-hover || focus.has-focus ? DesktopTheme.text : DesktopTheme.accent;
    }
    if root.selected || focus.has-focus: Rectangle {
        x: 0px; y: parent.height - 1px; width: 100%; height: 1px;
        background: DesktopTheme.accent;
    }
    focus := FocusScope {
        x: 0px; y: 0px; width: 100%; height: 100%;
        key-pressed(event) => {
            if (event.text == Key.Menu || (event.modifiers.shift && event.text == Key.F10)) {
                root.show-context(0px, root.height); return accept;
            }
            if (event.text == Key.Return || event.text == Key.Space) {
                root.clicked(); return accept;
            }
            return reject;
        }
    }
    tap := TouchArea {
        x: 0px; y: 0px; width: 100%; height: 100%; mouse-cursor: pointer;
        clicked => { focus.focus(); root.clicked(); }
        pointer-event(event) => {
            if (event.button == PointerEventButton.right && event.kind == PointerEventKind.up) {
                focus.focus(); root.show-context(self.mouse-x, self.mouse-y);
            }
        }
    }
    context := DropContextMenu {
        x: root.context-x; y: root.context-y; english: root.english;
        find-monsters => { root.find-monsters(); }
    }
    Tooltip {
        Rectangle {
            width: min(320px, tip.preferred-width + 20px); height: tip.preferred-height + 16px;
            background: DesktopTheme.raised; border-radius: 5px;
            border-width: 1px; border-color: DesktopTheme.border;
            tip := Text {
                x: 10px; y: 8px; width: parent.width - 20px; height: self.preferred-height;
                text: root.title + (root.alternate != "" ? "\n" + root.alternate : "");
                font-size: 13px; color: DesktopTheme.text; wrap: word-wrap;
            }
        }
    }
}

component LegacyRegionNavigator inherits Rectangle {
    in property <[Hit]> rows;
    in property <[int]> flow-x;
    in property <[int]> flow-y;
    in property <[int]> flow-w;
    in property <int> flow-h;
    in property <string> selected-key;
    in property <string> current-title;
    in property <bool> english;
    in property <bool> open;
    in property <length> top-gap: 44px;
    callback toggle();
    callback dismiss();
    callback choose(int);
    callback reflow(length);

    if root.open: TouchArea {
        x: 0px; y: 0px; width: 100%; height: 100%;
        clicked => { root.dismiss(); }
    }
    if root.open: Rectangle {
        x: parent.width - self.width - 12px;
        y: parent.height - self.height - 60px;
        width: min(520px, parent.width - 24px);
        height: min(430px, max(160px, parent.height - root.top-gap - 68px));
        background: DesktopTheme.surface-alt;
        border-radius: 8px;
        border-width: 1px;
        border-color: DesktopTheme.border;
        clip: true;
        TouchArea { x: 0px; y: 0px; width: 100%; height: 100%; }
        Text {
            x: 16px; y: 12px;
            width: parent.width - 64px; height: 22px;
            text: UiLanguage.tr("Monster regions", "地區目錄");
            font-size: 15px; font-weight: 600; color: DesktopTheme.text;
        }
        Text {
            x: 16px; y: 38px;
            width: parent.width - 32px; height: 18px;
            text: (UiLanguage.tr("Current: ", "目前：")) + root.current-title;
            font-size: 12px; color: DesktopTheme.secondary; overflow: elide;
        }
        WinButton {
            x: parent.width - 42px; y: 10px;
            glyph: "×";
            clicked => { root.dismiss(); }
        }
        Rectangle {
            x: 12px; y: 64px;
            width: parent.width - 24px; height: 1px;
            background: DesktopTheme.border;
        }
        Flickable {
            x: 12px; y: 76px;
            width: parent.width - 24px; height: parent.height - 88px;
            property <length> span: self.width;
            init => { root.reflow(self.span); }
            changed span => { root.reflow(self.span); }
            content-width: self.width;
            content-height: max(root.flow-h * 1px + 8px, 1px);
            for row[i] in root.rows: LegacyPlace {
                x: root.flow-x[i] * 1px; y: root.flow-y[i] * 1px;
                width: root.flow-w[i] * 1px;
                title: row.title;
                heading: row.chip == "label";
                selected: row.key != "" && root.selected-key == row.key;
                clicked => { if (row.key != "") { root.choose(i); } }
            }
        }
    }
    MonsterTool {
        x: parent.width - self.width - 12px;
        y: parent.height - self.height - 12px;
        width: root.english ? 148px : 112px;
        height: 36px;
        border-radius: 6px;
        active: true;
        label: root.open ? (UiLanguage.tr("Close regions", "收起目錄")) : (UiLanguage.tr("Monster regions", "地區目錄"));
        clicked => { root.toggle(); }
    }
}

component LegacyMonsterRow inherits Rectangle {
    in property <Hit> hit;
    in property <bool> alternate;
    in property <bool> selected;
    in property <bool> english;
    in property <bool> portrait;
    in property <string> no-image-label;
    callback clicked();
    callback favourite-clicked();
    callback open-drop(string);
    callback find-drop-monsters(string, string);
    property <length> picture-w: root.width < 850px ? 88px : 112px;
    property <length> name-w: root.width < 850px ? 180px : 224px;
    height: max(180px, max(description.preferred-height, name-column.preferred-height) + 24px);
    background: root.selected ? DesktopTheme.selected : root.alternate ? DesktopTheme.surface : DesktopTheme.surface-alt;
    accessible-role: button;
    accessible-label: hit.title;
    accessible-description: hit.alternate-name;
    accessible-action-default => { root.clicked(); }
    tap := TouchArea {
        width: 100%; height: 100%; mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
    Rectangle {
        x: 0px; y: 0px; width: root.picture-w; height: parent.height;
        if root.hit.has-icon && (!root.hit.has-battle || root.portrait): Image {
            x: (parent.width - 64px) / 2; y: 24px;
            width: 64px; height: 64px; source: root.hit.icon; image-fit: contain;
        }
        if root.hit.has-battle && !root.portrait: Image {
            x: (parent.width - 72px) / 2; y: 16px;
            width: 72px; height: 88px; source: root.hit.battle; image-fit: contain;
        }
        if root.hit.no-image && !root.hit.has-battle: Text {
            x: 8px; y: 32px; width: parent.width - 16px;
            text: root.no-image-label; wrap: word-wrap;
            font-size: 12px; color: DesktopTheme.secondary; horizontal-alignment: center;
        }
        StarMark {
            x: (parent.width - 32px) / 2; y: 112px;
            filled: root.hit.favourite; ink: DesktopTheme.accent; outline: DesktopTheme.accent;
            clicked => { root.favourite-clicked(); }
        }
    }
    name-column := VerticalLayout {
        x: root.picture-w + 12px; y: 12px; width: root.name-w - 24px;
        height: self.preferred-height; spacing: 6px;
        MonsterNames {
            width: parent.width;
            title: root.hit.title; alternate: root.hit.alternate-name;
        }
        Text {
            height: 20px;
            text: (UiLanguage.tr("HP  ", "體力  ")) + root.hit.stat-hp;
            font-size: 13px; color: #e3a1a1;
        }
        Text {
            height: 20px;
            text: (UiLanguage.tr("MP  ", "魔力  ")) + root.hit.stat-mp;
            font-size: 13px; color: #a4c4e8;
        }
        Text {
            height: 20px;
            text: (UiLanguage.tr("Attack  ", "攻擊  ")) + root.hit.stat-atk;
            font-size: 13px; color: DesktopTheme.text;
        }
        Text {
            height: 20px;
            text: UiLanguage.tr("View details", "查看詳情");
            font-size: 12px; color: DesktopTheme.accent;
        }
    }
    description := VerticalLayout {
        x: root.picture-w + root.name-w + 16px; y: 12px;
        width: parent.width - self.x - 16px; height: self.preferred-height; spacing: 4px;
        FlexboxLayout {
            width: description.width; height: self.preferred-height;
            flex-direction: row; flex-wrap: wrap;
            alignment: start; cross-axis-alignment: start; cross-axis-line-alignment: start;
            spacing-horizontal: 12px; spacing-vertical: 2px;
            Text {
                width: min(self.preferred-width, description.width); height: self.preferred-height;
                text: root.hit.stat-kind; wrap: word-wrap;
                font-size: 13px; color: DesktopTheme.text;
            }
            Rectangle {
                width: min(element-label.preferred-width + (root.hit.has-badge ? 24px : 0px), description.width);
                height: max(18px, element-label.preferred-height);
                if root.hit.has-badge: Image {
                    x: 0px; y: 0px; width: 18px; height: 18px;
                    source: root.hit.badge; image-fit: contain;
                }
                element-label := Text {
                    x: root.hit.has-badge ? 24px : 0px; y: 0px;
                    width: parent.width - self.x; height: self.preferred-height;
                    text: root.hit.stat-element; wrap: word-wrap;
                    font-size: 13px; color: DesktopTheme.text;
                }
            }
        }
        FlexboxLayout {
            width: description.width; height: self.preferred-height;
            flex-direction: row; flex-wrap: wrap;
            alignment: start; cross-axis-alignment: start; cross-axis-line-alignment: start;
            spacing-horizontal: 12px; spacing-vertical: 2px;
            Text {
                width: min(self.preferred-width, description.width); height: self.preferred-height;
                text: (UiLanguage.tr("Exp: ", "經驗：")) + root.hit.stat-exp;
                wrap: word-wrap; font-size: 13px; color: DesktopTheme.secondary;
            }
            Text {
                width: min(self.preferred-width, description.width); height: self.preferred-height;
                text: (UiLanguage.tr("Hit resist: ", "打擊抗性：")) + root.hit.stat-hit;
                wrap: word-wrap; font-size: 13px; color: #e3a1a1;
            }
            Text {
                width: min(self.preferred-width, description.width); height: self.preferred-height;
                text: (UiLanguage.tr("Magic resist: ", "魔法抗性：")) + root.hit.stat-magic;
                wrap: word-wrap; font-size: 13px; color: #a4c4e8;
            }
        }
        Text {
            text: (UiLanguage.tr("Found in: ", "出沒地：")) + root.hit.spawn-places;
            wrap: word-wrap; font-size: 13px; color: DesktopTheme.secondary;
        }
        FlexboxLayout {
            width: description.width; height: self.preferred-height;
            flex-direction: row; flex-wrap: wrap;
            alignment: start; cross-axis-alignment: start; cross-axis-line-alignment: start;
            spacing-horizontal: 0px; spacing-vertical: 2px;
            Text {
                width: self.preferred-width; height: 20px;
                text: UiLanguage.tr("Drops: ", "掉落物：");
                font-size: 13px; color: DesktopTheme.secondary;
            }
            if root.hit.monster-drops.length == 0: Text {
                width: self.preferred-width; height: 20px;
                text: UiLanguage.tr("Not recorded", "未記錄");
                font-size: 13px; color: DesktopTheme.muted;
            }
            for drop[i] in root.hit.monster-drops: LegacyDropLink {
                available-width: description.width;
                title: drop.title; alternate: drop.alternate-name; drop-rate: drop.drop-rate; selected: drop.selected; english: root.english;
                separator: i + 1 < root.hit.monster-drops.length ? (UiLanguage.tr(", ", "、")) : "";
                clicked => { root.open-drop(drop.key); }
                find-monsters => { root.find-drop-monsters(drop.key, drop.title); }
            }
        }
    }
    Rectangle { x: root.picture-w; width: 1px; height: 100%; background: DesktopTheme.border; }
    Rectangle { x: root.picture-w + root.name-w; width: 1px; height: 100%; background: DesktopTheme.border; }
    Rectangle { y: parent.height - 1px; width: 100%; height: 1px; background: DesktopTheme.border; }
}

component LegacyMonsterTable inherits Rectangle {
    in property <[Hit]> rows;
    in property <int> cursor: -1;
    in property <string> title;
    in property <bool> english;
    in property <bool> portrait;
    in property <string> no-image-label;
    in-out property <length> scroll-y;
    callback open(int, string);
    callback favourite(string);
    callback open-drop(string);
    callback find-drop-monsters(string, string);
    background: DesktopTheme.surface-alt;
    function reveal(y: length, h: length) {
        if (y < -root.scroll-y) { root.scroll-y = -y; }
        else if (y + h > -root.scroll-y + rows-scroll.height) { root.scroll-y = min(0px, rows-scroll.height - y - h); }
    }
    Rectangle {
        x: 0px; y: 0px; width: 100%; height: 36px; background: DesktopTheme.control;
        Text {
            x: 12px; width: parent.width - 24px; height: 100%;
            text: root.title + "  (" + root.rows.length + ")";
            font-size: 14px; font-weight: 600; color: DesktopTheme.text; vertical-alignment: center;
        }
    }
    Rectangle {
        y: 36px; width: 100%; height: 30px; background: DesktopTheme.surface;
        property <length> picture-w: root.width < 850px ? 88px : 112px;
        property <length> name-w: root.width < 850px ? 180px : 224px;
        Text { x: 0px; width: parent.picture-w; height: 100%; text: UiLanguage.tr("Image", "圖片"); color: DesktopTheme.text; font-size: 12px; horizontal-alignment: center; vertical-alignment: center; }
        Text { x: parent.picture-w; width: parent.name-w; height: 100%; text: UiLanguage.tr("Name / Stats", "名稱／能力"); color: DesktopTheme.text; font-size: 12px; horizontal-alignment: center; vertical-alignment: center; }
        Text { x: parent.picture-w + parent.name-w + 16px; height: 100%; text: UiLanguage.tr("Description", "說明"); color: DesktopTheme.text; font-size: 12px; vertical-alignment: center; }
    }
    rows-scroll := Flickable {
        y: 66px; width: 100%; height: parent.height - 66px;
        content-width: self.width;
        content-height: max(list.preferred-height, self.height);
        content-y <=> root.scroll-y;
        list := VerticalLayout {
            x: 0px; y: 0px; width: parent.width; spacing: 0px;
            for mon[i] in root.rows: LegacyMonsterRow {
                hit: mon; alternate: mod(i, 2) == 1; selected: root.cursor == i;
                english: root.english; portrait: root.portrait; no-image-label: root.no-image-label;
                changed selected => { if (self.selected) { root.reveal(self.y, self.height); } }
                clicked => { root.open(i, mon.key); }
                favourite-clicked => { root.favourite(mon.key); }
                open-drop(key) => { root.open-drop(key); }
                find-drop-monsters(key, title) => { root.find-drop-monsters(key, title); }
            }
        }
    }
    if root.rows.length == 0: Text {
        x: 20px; y: 90px; width: parent.width - 40px;
        text: UiLanguage.tr("No matches. Try another region or clear your filters.", "沒有符合的怪物，請選擇其他地區或清除篩選。");
        wrap: word-wrap; font-size: 14px; color: DesktopTheme.secondary;
    }
}

component SectionPick inherits Rectangle {
    in property <string> title;
    in property <string> count;
    in property <image> icon;
    in property <bool> has-icon: false;
    in property <bool> selected: false;
    in property <bool> nested: false;
    in property <bool> expandable: false;
    in property <bool> expanded: false;
    property <length> indent: nested ? 14px : 0px;
    property <length> name-x: indent + (has-icon ? 48px : 10px);
    callback clicked();
    height: 48px;
    border-radius: 6px;
    background: selected ? DesktopTheme.selected : area.has-hover ? DesktopTheme.hover : transparent;
    accessible-role: button;
    accessible-label: title;
    accessible-description: count;
    accessible-expandable: root.expandable;
    accessible-expanded: root.expanded;
    accessible-action-default => { root.clicked(); }
    if root.nested: Rectangle {
        x: 6px; width: 1px; height: parent.height; background: DesktopTheme.border;
    }
    if root.has-icon: Image {
        x: root.indent + 8px; y: 8px; width: 32px; height: 32px;
        source: root.icon; image-fit: contain;
    }
    Text {
        x: root.name-x; y: 5px; width: max(parent.width - self.x - (root.expandable ? 24px : 10px), 1px);
        text: root.title; font-size: 13px; font-weight: root.selected ? 600 : 400;
        color: root.selected ? DesktopTheme.text : DesktopTheme.soft;
        overflow: elide;
    }
    Text {
        x: root.name-x; y: 25px; width: max(parent.width - self.x - 10px, 1px);
        text: root.count; font-size: 11px; color: DesktopTheme.muted;
        overflow: elide;
    }
    if root.expandable: Path {
        x: parent.width - 18px; y: 10px; width: 10px; height: 10px;
        stroke: DesktopTheme.muted; stroke-width: 1.6px;
        commands: root.expanded ? "M 1 3 L 5 7 L 9 3" : "M 3 1 L 7 5 L 3 9";
    }
    area := TouchArea {
        width: 100%; height: 100%;
        clicked => { root.clicked(); }
        mouse-cursor: pointer;
    }
}

global EnchantRate {
    public pure function ink(rate: int) -> color {
        return rate <= 20 ? #f28b82 : rate < 50 ? #e6c46a : #83d5a1;
    }
}

global CatalogLayout {
    public pure function equipment-columns(width: length) -> int {
        return max(1, floor((width - 20px + 4px) / 36px));
    }
    public pure function equipment-height(width: length, count: int) -> length {
        return count > 0 ? 24px + ceil(count / CatalogLayout.equipment-columns(width)) * 36px + 8px : 26px;
    }
    public pure function material-columns(width: length) -> int {
        return max(1, floor((width - 20px + 4px) / 56px));
    }
    public pure function material-height(width: length, count: int) -> length {
        return count > 0 ? 24px + ceil(count / CatalogLayout.material-columns(width)) * 54px + 8px : 26px;
    }
}

component EnchantBonusPreview inherits Rectangle {
    in property <string> summary;
    in property <bool> recorded;
    height: max(18px, summary-text.preferred-height) + 12px;
    Text {
        x: 0px; y: 0px; width: 52px; height: 18px;
        text: UiLanguage.tr("Bonuses", "附加能力");
        font-size: 11px; color: DesktopTheme.secondary;
        vertical-alignment: center;
    }
    summary-text := Text {
        x: 60px; y: 0px; width: max(parent.width - self.x, 0px);
        height: max(18px, self.preferred-height);
        text: root.summary; wrap: word-wrap;
        font-size: 12px;
        color: root.recorded ? DesktopTheme.text : DesktopTheme.secondary;
    }
}

component EnchantItemIcon inherits Rectangle {
    in property <EnchantEquipment> item;
    in property <string> purpose: UiLanguage.tr("Applicable equipment", "適用裝備");
    callback open(string);
    callback focused();
    width: item.quantity == "" ? 32px : 52px;
    height: item.quantity == "" ? 32px : 50px;
    border-radius: 4px;
    background: tap.has-hover ? DesktopTheme.hover-strong : transparent;
    border-width: 1px;
    border-color: focus.has-focus ? DesktopTheme.accent : transparent;
    accessible-role: button;
    accessible-label: item.title;
    accessible-description: purpose + (item.quantity != "" ? " · " + item.quantity : "") + (item.alternate-name != "" ? " · " + item.alternate-name : "");
    accessible-action-default => { root.open(root.item.key); }
    forward-focus: focus;
    if root.item.has-icon: Image {
        x: (parent.width - self.width) / 2; y: 2px; width: 28px; height: 28px;
        source: root.item.icon; image-fit: contain;
    }
    if !root.item.has-icon: DesktopIcon {
        x: (parent.width - self.width) / 2; y: 7px; width: 18px; height: 18px;
        path: "M4 6 L12 2 L20 6 L20 18 L12 22 L4 18 Z M4 6 L12 10 L20 6 M12 10 L12 22";
        ink: DesktopTheme.secondary;
    }
    if root.item.quantity != "": Text {
        x: 0px; y: 32px; width: 100%; height: 16px;
        text: root.item.quantity;
        font-size: 11px; color: DesktopTheme.secondary;
        horizontal-alignment: center; overflow: elide;
    }
    focus := FocusScope {
        width: 100%; height: 100%;
        focus-gained => { root.focused(); }
        key-pressed(event) => {
            if (event.text == Key.Return || event.text == Key.Space) { root.open(root.item.key); return accept; }
            return reject;
        }
    }
    tap := TouchArea {
        width: 100%; height: 100%; mouse-cursor: pointer;
        clicked => { focus.focus(); root.open(root.item.key); }
    }
    Tooltip {
        RecordTooltip {
            text: root.item.title + (root.item.alternate-name != "" ? "\n" + root.item.alternate-name : "")
                + (root.item.quantity != "" ? "\n" + root.purpose + " " + root.item.quantity : "");
        }
    }
}

component CatalogRow inherits Rectangle {
    in property <Hit> hit;
    in property <bool> selected: false;
    in property <bool> english: false;
    in property <bool> group-start: false;
    in property <bool> keyboard-focused: false;
    in property <bool> focus-requested: false;
    out property <bool> has-focus: focus.has-focus;
    callback focus-changed(bool);
    callback move-focus(int);
    forward-focus: focus;
    init => {
        if (root.focus-requested) { focus.focus(); }
        if (root.selected) { root.reveal(root.y, root.height); }
    }
    changed focus-requested => { if (root.focus-requested) { focus.focus(); } }
    callback clicked();
    callback open-equipment(string);
    callback preview-focused(length, length);
    callback reveal(length, length);
    property <bool> companion: hit.chip == "mount" || hit.chip.starts-with("spirit:");
    property <bool> show-aside: !companion && hit.aside != "" && self.width > 360px;
    property <length> name-x: hit.has-icon ? 52px : 10px;
    property <length> content-width: max(self.width - name-x - 12px, 0px);
    property <length> aside-width: show-aside ? min(aside-label.preferred-width, min(180px, content-width * 0.35)) : 0px;
    property <length> name-width: max(content-width - (show-aside ? aside-width + 10px : 0px), 0px);
    property <length> group-height: group-start ? 32px : 0px;
    property <length> heading-height: hit.enchant-scroll ? (hit.alternate-name != "" ? 76px : 58px)
        : companion ? max(78px, companion-meta.preferred-height + 52px) : 58px;
    property <length> bonus-height: hit.enchant-scroll ? bonus-preview.height : 0px;
    property <length> equipment-height: hit.enchant-scroll ? CatalogLayout.equipment-height(self.width, hit.enchant-equipment.length) : 0px;
    property <length> material-height: hit.enchant-scroll ? CatalogLayout.material-height(self.width, hit.enchant-materials.length) : 0px;
    property <length> body-height: heading-height + bonus-height + equipment-height + material-height;
    property <string> group-title: hit.chip == "spirit:1" ? (UiLanguage.tr("Fire", "火屬")) : hit.chip == "spirit:2" ? (UiLanguage.tr("Water", "水屬")) : hit.chip == "spirit:3" ? (UiLanguage.tr("Wind", "風屬")) : hit.chip == "spirit:4" ? (UiLanguage.tr("Thunder", "雷屬")) : hit.chip == "spirit:5" ? (UiLanguage.tr("Earth", "地屬")) : hit.chip == "spirit:0" ? (UiLanguage.tr("Non-elemental", "無屬性")) : (UiLanguage.tr("Element not recorded", "屬性未記錄"));
    accessible-role: button;
    accessible-label: hit.title;
    accessible-description: RecordText.description(root.hit)
        + (root.hit.enchant-scroll ? "\n" + UiLanguage.tr("Bonuses", "附加能力") + ": " + root.hit.enchant-bonuses : "")
        + "\nCtrl+I: " + UiLanguage.tr("Full names and source", "完整名稱與來源");
    accessible-action-default => { root.clicked(); }
    changed selected => { if (self.selected) { root.reveal(root.y, root.height); } }
    height: group-height + body-height;
    border-radius: 6px;
    if root.group-start: Text {
        x: 10px; y: 6px; width: parent.width - 20px; height: 20px;
        text: root.group-title; font-size: 12px; font-weight: 600; color: DesktopTheme.secondary;
    }
    Rectangle {
        x: 1px; y: root.group-height + 1px;
        width: max(parent.width - 2px, 0px); height: root.body-height - 2px; border-radius: 6px;
        border-width: 1px;
        border-color: root.selected || focus.has-focus || root.keyboard-focused ? DesktopTheme.accent : transparent;
        background: root.selected ? DesktopTheme.selected : area.has-hover ? DesktopTheme.hover : transparent;
    }
    focus := FocusScope {
        x: 0px; y: 0px; width: 100%; height: 100%;
        focus-gained => { root.focus-changed(true); }
        focus-lost => { root.focus-changed(false); }
        key-pressed(event) => {
            if ((event.modifiers.control || event.modifiers.meta) && (event.text == "i" || event.text == "I")) { RecordInfo.show(root.hit); return accept; }
            if (event.text == Key.UpArrow) { root.move-focus(-1); return accept; }
            if (event.text == Key.DownArrow) { root.move-focus(1); return accept; }
            if (event.text == Key.Return || event.text == Key.Space) { root.clicked(); return accept; }
            return reject;
        }
    }
    area := TouchArea {
        y: root.group-height;
        width: 100%;
        height: root.heading-height;
        clicked => { focus.focus(); root.clicked(); }
        mouse-cursor: pointer;
        if root.hit.has-icon: Image {
            x: 10px; y: (parent.height - self.height) / 2;
            source: root.hit.icon;
            width: 32px;
            height: 32px;
            image-fit: contain;
        }
        VerticalLayout {
            x: root.name-x; y: (parent.height - self.height) / 2;
            width: root.name-width;
            height: self.preferred-height;
            spacing: 1px;
            Text {
                text: root.hit.title;
                font-size: 13px;
                font-weight: 500;
                color: DesktopTheme.text;
                overflow: elide;
            }
            if !root.hit.enchant-scroll && RecordText.secondary(root.hit) != "": Text {
                text: RecordText.secondary(root.hit);
                font-size: 12px;
                color: DesktopTheme.secondary;
                overflow: elide;
            }
            if root.hit.enchant-scroll && root.hit.alternate-name != "": Text {
                text: root.hit.alternate-name;
                font-size: 12px; color: DesktopTheme.secondary; overflow: elide;
            }
            if root.hit.enchant-scroll: HorizontalLayout {
                spacing: 8px; alignment: start;
                Text {
                    text: UiLanguage.tr("Min. level", "最低等級") + " " + root.hit.enchant-level;
                    font-size: 12px; color: DesktopTheme.secondary; overflow: elide;
                }
                Text {
                    text: UiLanguage.tr("Success", "成功率") + " " + root.hit.enchant-rate + "%";
                    font-size: 12px; font-weight: 500;
                    color: EnchantRate.ink(root.hit.enchant-rate);
                }
            }
            companion-meta := Text {
                visible: root.companion;
                // Keep this width independent of the layout's intrinsic size, even when hidden.
                width: root.name-width;
                height: root.companion ? self.preferred-height : 0px;
                text: root.hit.aside; wrap: word-wrap;
                font-size: 12px; color: DesktopTheme.accent;
            }
        }
        aside-label := Text {
            visible: root.show-aside;
            x: parent.width - self.width - 12px;
            width: root.aside-width; height: 100%;
            text: root.hit.aside;
            font-size: 12px;
            color: DesktopTheme.accent;
            horizontal-alignment: right;
            vertical-alignment: center;
            overflow: elide;
        }
        Tooltip {
            RecordTooltip { text: RecordText.full(root.hit); }
        }
    }
    bonus-preview := EnchantBonusPreview {
        visible: root.hit.enchant-scroll;
        x: 10px; y: root.group-height + root.heading-height;
        width: max(parent.width - 20px, 0px);
        summary: root.hit.enchant-bonuses;
        recorded: root.hit.enchant-bonuses-recorded;
    }
    if root.hit.enchant-scroll: Rectangle {
        x: 10px; y: root.group-height + root.heading-height + root.bonus-height;
        width: max(parent.width - 20px, 0px); height: root.equipment-height;
        Text {
            x: 0px; y: 0px;
            width: 100%; height: 18px;
            text: root.hit.enchant-equipment.length > 0
                ? UiLanguage.tr("Applicable equipment", "適用裝備") + " · " + root.hit.enchant-equipment.length
                : UiLanguage.tr("Applicable equipment not recorded", "適用裝備未記錄");
            font-size: 11px; color: DesktopTheme.secondary; overflow: elide;
        }
        for item[i] in root.hit.enchant-equipment: EnchantItemIcon {
            x: mod(i, CatalogLayout.equipment-columns(root.width)) * 36px;
            y: 24px + floor(i / CatalogLayout.equipment-columns(root.width)) * 36px;
            item: item;
            open(key) => { root.open-equipment(key); }
            focused => { root.preview-focused(root.group-height + root.heading-height + root.bonus-height + self.y, self.height); }
        }
    }
    if root.hit.enchant-scroll: Rectangle {
        x: 10px; y: root.group-height + root.heading-height + root.bonus-height + root.equipment-height;
        width: max(parent.width - 20px, 0px); height: root.material-height;
        Text {
            x: 0px; y: 0px;
            width: 100%; height: 18px;
            text: root.hit.enchant-materials.length > 0
                ? UiLanguage.tr("Materials", "材料") + " · " + root.hit.enchant-materials.length
                : UiLanguage.tr("Materials not recorded", "材料未記錄");
            font-size: 11px; color: DesktopTheme.secondary; overflow: elide;
        }
        for item[i] in root.hit.enchant-materials: EnchantItemIcon {
            x: mod(i, CatalogLayout.material-columns(root.width)) * 56px;
            y: 24px + floor(i / CatalogLayout.material-columns(root.width)) * 54px;
            item: item;
            purpose: UiLanguage.tr("Materials", "材料");
            open(key) => { root.open-equipment(key); }
            focused => { root.preview-focused(root.group-height + root.heading-height + root.bonus-height + root.equipment-height + self.y, self.height); }
        }
    }
    if !root.selected && !focus.has-focus && !root.keyboard-focused && !area.has-hover: Rectangle {
        x: 10px;
        y: parent.height - 1px;
        width: max(parent.width - 20px, 0px);
        height: 1px;
        background: DesktopTheme.border;
    }
}

// Quest rows keep the category, level and full metadata separate from the title.
component QuestTab inherits Rectangle {
    in property <string> label;
    in property <bool> active;
    callback clicked();
    callback focused(length, length);
    height: 32px; min-width: caption.preferred-width + 24px;
    border-radius: 6px;
    background: active ? DesktopTheme.selected : tap.has-hover ? DesktopTheme.hover : DesktopTheme.surface;
    border-width: 1px; border-color: focus.has-focus || active ? DesktopTheme.accent : DesktopTheme.border;
    forward-focus: focus;
    accessible-role: button; accessible-label: label;
    accessible-description: active ? UiLanguage.tr("Selected", "已選取") : "";
    accessible-action-default => { root.clicked(); }
    caption := Text {
        width: 100%; height: 100%; text: root.label; font-size: 13px;
        color: root.active ? DesktopTheme.accent : DesktopTheme.text;
        horizontal-alignment: center; vertical-alignment: center;
    }
    focus := FocusScope {
        changed has-focus => { if (self.has-focus) { root.focused(root.y, root.height); } }
        key-pressed(event) => {
            if (event.text == Key.Return || event.text == Key.Space) { root.clicked(); return accept; }
            return reject;
        }
    }
    tap := TouchArea { width: 100%; height: 100%; mouse-cursor: pointer; clicked => { focus.focus(); root.clicked(); } }
}

component HeroStats inherits Rectangle {
    in property <bool> english;
    in property <bool> mount;
    in property <[Fact]> stats;
    height: content.preferred-height;
    content := VerticalLayout {
        width: parent.width; height: self.preferred-height; spacing: 8px;
                Text { text: root.mount ? (UiLanguage.tr("Bonuses", "能力加成")) : (UiLanguage.tr("Base stats", "基礎能力")); color: DesktopTheme.text; font-size: 15px; font-weight: 600; }
                if root.stats.length == 0: Text { text: UiLanguage.tr("No base stats recorded.", "尚未收錄基礎能力值。"); color: DesktopTheme.secondary; font-size: 12px; wrap: word-wrap; }
                if root.mount: VerticalLayout {
                    spacing: 12px;
                    for fact in root.stats: VerticalLayout {
                        spacing: 4px;
                        Text { text: fact.label; font-size: 12px; color: DesktopTheme.secondary; wrap: word-wrap; }
                        Text { width: parent.width; text: fact.value; font-size: 14px; color: DesktopTheme.text; wrap: word-wrap; }
                    }
                }
                if !root.mount: Rectangle {
                    property <int> columns: self.width >= 680px ? 4 : self.width >= 440px ? 3 : 2;
                    height: ceil(root.stats.length / self.columns) * 54px;
                    for fact[i] in root.stats: Rectangle {
                        x: mod(i, parent.columns) * parent.width / parent.columns;
                        y: floor(i / parent.columns) * 54px;
                        width: parent.width / parent.columns - 12px; height: 54px;
                        Text { y: 4px; width: parent.width; text: fact.label; font-size: 11px; color: DesktopTheme.secondary; overflow: elide; }
                        Text { y: 23px; width: parent.width; text: fact.value; font-size: 16px; font-weight: 500; color: DesktopTheme.text; overflow: elide; }
                        Rectangle { y: parent.height - 1px; width: 100%; height: 1px; background: DesktopTheme.border; }
                    }
                }
            }
}

component HeroDetailPane inherits Rectangle {
    in property <string> record-key;
    in property <bool> english;
    in property <string> title;
    in property <string> alt;
    in property <string> code;
    in property <string> note;
    in property <image> portrait;
    in property <bool> has-portrait;
    in property <image> battle;
    in property <bool> has-battle;
    in property <bool> animate;
    in property <bool> preview: false;
    in property <bool> can-calculate: false;
    in property <int> calculator-focus-request;
    in property <[Fact]> stats;
    in property <[Fact]> effects;
    in property <bool> spirit;
    property <bool> stats-open: false;
    changed record-key => { root.stats-open = false; }
    in property <[Fact]> facts;
    in property <[Hit]> links;
    in property <int> cursor;
    in-out property <length> scroll-y;
    callback open-key(string);
    callback section(string);
    callback selected(int);
    callback open-full();
    callback calculate();
    callback animate-changed(bool);
    callback scroll-span-changed(length);
    background: DesktopTheme.detail;
    border-radius: 8px;
    function reveal(top: length, size: length) {
        if (top < -body.content-y) { body.content-y = -top; }
        else if (top + size > -body.content-y + body.height) { body.content-y = min(0px, body.height - top - size); }
    }
    body := Flickable {
        x: 16px; y: 16px; width: parent.width - 32px; height: parent.height - 32px;
        content-width: self.width; content-height: max(contents.preferred-height, self.height);
        content-y <=> root.scroll-y;
        changed content-height => { root.scroll-span-changed(max(self.content-height - self.height, 0px)); }
        changed height => { root.scroll-span-changed(max(self.content-height - self.height, 0px)); }
        contents := VerticalLayout {
            width: parent.width; height: self.preferred-height; spacing: 18px; alignment: start;
            VerticalLayout {
                spacing: 5px;
                CopyName { width: parent.width; text: root.title; record-key: root.record-key; wrap: word-wrap; color: DesktopTheme.text; font-size: root.preview ? 18px : 23px; font-weight: 600; }
                if root.alt != "": CopyName { width: parent.width; text: root.alt; record-key: root.record-key; alternate: true; wrap: word-wrap; color: DesktopTheme.secondary; font-size: 13px; }
                Text { width: parent.width; text: root.code; color: DesktopTheme.muted; font-size: 11px; wrap: word-wrap; }
            }
            if root.preview: QuestTab { label: UiLanguage.tr("Open full details", "展開詳細頁"); active: false; clicked => { root.open-full(); } }
            if root.can-calculate: HorizontalLayout {
                alignment: start;
                Button {
                    width: min(224px, parent.width); height: 32px; horizontal-stretch: 0;
                    text: UiLanguage.tr("Calculate crafting cost", "計算合成成本");
                    property <int> focus-request: root.calculator-focus-request;
                    changed focus-request => {
                        root.reveal(parent.y, parent.height);
                        self.focus();
                    }
                    clicked => { root.calculate(); }
                }
            }
            if root.effects.length > 0: VerticalLayout {
                spacing: 8px;
                Text { text: UiLanguage.tr("Skill effects", "技能效果"); color: DesktopTheme.text; font-size: 15px; font-weight: 600; }
                for effect in root.effects: Text { width: parent.width; text: effect.value; wrap: word-wrap; font-size: 14px; color: DesktopTheme.text; }
            }
            HorizontalLayout {
                height: root.preview ? 144px : 176px; spacing: 16px; alignment: start;
                VerticalLayout {
                    width: root.preview ? 80px : 112px; spacing: 6px; alignment: start;
                    Text { text: UiLanguage.tr("Portrait", "大頭照"); color: DesktopTheme.secondary; font-size: 12px; }
                    Rectangle {
                        height: root.preview ? 80px : 112px; background: DesktopTheme.surface; border-radius: 6px;
                        if root.has-portrait: Image { width: 100%; height: 100%; source: root.portrait; image-fit: contain; }
                        if !root.has-portrait: Text { width: 100%; height: 100%; text: UiLanguage.tr("Unavailable", "暫無圖片"); color: DesktopTheme.muted; font-size: 11px; horizontal-alignment: center; vertical-alignment: center; }
                    }
                }
                VerticalLayout {
                    width: min(180px, parent.width - (root.preview ? 96px : 128px)); spacing: 6px; alignment: start;
                    Text { text: root.record-key.starts-with("hero:mount:") ? (UiLanguage.tr("Mount animation", "坐騎動畫")) : (UiLanguage.tr("Battle", "戰鬥動畫")); color: DesktopTheme.secondary; font-size: 12px; }
                    Rectangle {
                        height: root.preview ? 80px : 112px; background: DesktopTheme.surface; border-radius: 6px;
                        if root.has-battle: Image { width: 100%; height: 100%; source: root.battle; image-fit: contain; }
                        if !root.has-battle: Text { x: 8px; width: parent.width - 16px; height: 100%; text: UiLanguage.tr("Animation assets unavailable", "未提供動畫素材"); wrap: word-wrap; color: DesktopTheme.muted; font-size: 11px; horizontal-alignment: center; vertical-alignment: center; }
                    }
                    if root.has-battle: QuestTab { label: root.animate ? (UiLanguage.tr("Pause", "暫停")) : (UiLanguage.tr("Play", "播放")); active: false; clicked => { root.animate-changed(!root.animate); } }
                }
            }
            if !root.spirit: HeroStats { width: parent.width; english: root.english; mount: root.record-key.starts-with("hero:mount:"); stats: root.stats; }
            if root.note != "": Text { width: parent.width; text: root.note; wrap: word-wrap; font-size: 13px; color: DesktopTheme.soft; }
            for fact in root.facts: VerticalLayout {
                spacing: 5px;
                Text { text: fact.label; color: DesktopTheme.secondary; font-size: 12px; wrap: word-wrap; }
                Text { width: parent.width; text: fact.value; color: DesktopTheme.text; font-size: 13px; wrap: word-wrap; }
            }
            if root.links.length > 0: related := VerticalLayout {
                spacing: 4px;
                Text { text: UiLanguage.tr("Progression & materials", "轉職、升級與材料"); color: DesktopTheme.text; font-size: 15px; font-weight: 600; }
                for row[i] in root.links: Rectangle {
                    height: row.key == "" ? note-text.preferred-height + 12px : 52px;
                    property <bool> current: root.cursor == i;
                    changed current => { if (self.current && !root.preview) { root.reveal(related.y + self.y, self.height); } }
                    note-text := Text { visible: row.key == ""; x: 8px; y: 6px; width: parent.width - 16px; text: row.title + (row.subtitle == "" ? "" : "\n" + row.subtitle); wrap: word-wrap; font-size: 12px; color: DesktopTheme.secondary; }
                    if row.key != "": HitRow {
                        width: 100%; height: 52px; hit: row; selected: root.cursor == i;
                        clicked => { root.selected(i); if (row.chip == "section") { root.section(row.key); } else { root.open-key(row.key); } }
                    }
                }
            }
            if root.spirit: VerticalLayout {
                spacing: 12px;
                QuestTab { label: root.stats-open ? (UiLanguage.tr("Hide base stats", "收起基礎能力")) : (UiLanguage.tr("Show base stats", "查看基礎能力")); active: root.stats-open; clicked => { root.stats-open = !root.stats-open; } }
                if root.stats-open: HeroStats { width: parent.width; english: root.english; mount: false; stats: root.stats; }
            }
            Rectangle { height: 8px; }
        }
    }
}

component QuestPick inherits Rectangle {
    in property <Hit> hit;
    in property <string> alternate-title;
    in property <string> objective;
    in property <string> rewards;
    in property <string> reward-items;
    in property <string> reward-stats;
    in property <QuestItemRow> items;
    in property <bool> english;
    in property <bool> selected: false;
    in property <bool> keyboard-selected: false;
    callback clicked();
    height: 140px;
    border-radius: 6px;
    background: selected ? DesktopTheme.selection-low : tap.has-hover || focus.has-focus || keyboard-selected ? DesktopTheme.hover : transparent;
    accessible-role: button;
    accessible-label: hit.title;
    accessible-description: (alternate-title != "" ? alternate-title + " · " : "") + hit.aside + " · " + objective + " · " + rewards;
    accessible-action-default => { root.clicked(); }
    tap := TouchArea { width: 100%; height: 100%; mouse-cursor: pointer; clicked => { focus.focus(); root.clicked(); } }
    Rectangle {
        x: 0px; y: 10px; width: 1px; height: parent.height - 20px;
        background: root.selected || root.keyboard-selected || focus.has-focus ? DesktopTheme.accent : transparent;
    }
    Text {
        x: 12px; y: 8px; width: parent.width - 96px; height: root.alternate-title == "" ? 48px : 32px;
        text: root.hit.title; wrap: word-wrap; overflow: elide;
        font-size: 13px; font-weight: 600; color: DesktopTheme.text;
    }
    Text {
        x: parent.width - 84px; y: 10px; width: 72px;
        text: root.hit.aside == "" ? (UiLanguage.tr("Lv. —", "等級 —")) : root.hit.aside;
        font-size: 11px; color: DesktopTheme.secondary; horizontal-alignment: right; overflow: elide;
    }
    if root.alternate-title != "": Text {
        x: 12px; y: 40px; width: parent.width - 24px; height: 16px;
        text: root.alternate-title; overflow: elide;
        font-size: 12px; color: DesktopTheme.secondary;
    }
    QuestSummaryBadge {
        x: 12px; y: 62px;
        label: (UiLanguage.tr("Goal", "目標")) + (root.items.required-items.length > 0 && root.items.other-objectives != "" ? " +" : "");
        hint: root.items.required-items.length > 0 ? root.items.other-objectives : "";
        activated => { focus.focus(); root.clicked(); }
    }
    if root.items.required-items.length > 0: QuestItemStrip {
        x: 62px; y: 58px; width: parent.width - 74px;
        items: root.items.required-items; english: root.english;
        activated => { focus.focus(); root.clicked(); }
    }
    if root.items.required-items.length == 0: Text {
        x: 62px; y: 58px; width: parent.width - 74px; height: 26px;
        text: root.items.other-objectives != "" ? root.items.other-objectives : root.objective == "" ? (UiLanguage.tr("See quest details", "查看任務內容")) : root.objective;
        overflow: elide; wrap: word-wrap; font-size: 11px; color: DesktopTheme.secondary;
    }
    QuestSummaryBadge { x: 12px; y: 92px; label: UiLanguage.tr("Reward", "獎勵"); activated => { focus.focus(); root.clicked(); } }
    if root.items.reward-icons.length > 0: QuestItemStrip {
        x: 62px; y: 88px; width: parent.width - 74px;
        items: root.items.reward-icons; english: root.english;
        activated => { focus.focus(); root.clicked(); }
    }
    if root.items.reward-icons.length == 0: Text {
        x: 62px; y: 93px; width: parent.width - 74px; height: 16px;
        text: root.reward-items == "" ? (UiLanguage.tr("No items listed", "未記錄物品")) : root.reward-items;
        overflow: elide; font-size: 11px; color: DesktopTheme.secondary;
    }
    Text {
        x: 62px; y: 118px; width: parent.width - 74px; height: 16px;
        text: root.reward-stats == "" ? (UiLanguage.tr("XP / Credit —", "經驗／信用 —")) : root.reward-stats;
        overflow: elide; font-size: 11px; color: root.selected ? DesktopTheme.accent : DesktopTheme.secondary;
    }
    Rectangle { y: parent.height - 1px; x: 12px; width: parent.width - 24px; height: 1px; background: root.selected || root.keyboard-selected || focus.has-focus ? transparent : DesktopTheme.border; }
    focus := FocusScope {
        focus-on-click: false;
        key-pressed(event) => {
            if (event.text == Key.Return || event.text == Key.Space) { root.clicked(); return accept; }
            return reject;
        }
    }
}

component QuestCategoryRow inherits Rectangle {
    in property <Hit> hit;
    callback clicked();
    callback focused(length, length);
    height: 58px;
    border-radius: 6px;
    background: tap.has-hover ? DesktopTheme.hover : transparent;
    border-width: focus.has-focus ? 1px : 0px;
    border-color: DesktopTheme.accent;
    forward-focus: focus;
    accessible-role: button; accessible-label: hit.title;
    accessible-description: hit.aside + " · " + hit.subtitle;
    accessible-action-default => { root.clicked(); }
    Text { x: 12px; y: 8px; width: parent.width - 90px; text: root.hit.title; color: DesktopTheme.text; font-size: 14px; font-weight: 500; overflow: elide; }
    Text { x: 12px; y: 28px; width: parent.width - 68px; height: 28px; text: root.hit.subtitle; color: DesktopTheme.secondary; font-size: 11px; wrap: word-wrap; overflow: elide; }
    Text { x: parent.width - 74px; y: 10px; width: 42px; text: root.hit.aside; color: DesktopTheme.secondary; font-size: 13px; horizontal-alignment: right; }
    DesktopIcon { x: parent.width - 23px; y: 11px; width: 14px; height: 14px; path: "M9 5L16 12L9 19"; ink: tap.has-hover ? DesktopTheme.accent : DesktopTheme.muted; }
    Rectangle { x: 12px; y: parent.height - 1px; width: parent.width - 24px; height: 1px; background: DesktopTheme.border; }
    focus := FocusScope { changed has-focus => { if (self.has-focus) { root.focused(root.y, root.height); } } key-pressed(event) => { if (event.text == Key.Return || event.text == Key.Space) { root.clicked(); return accept; } return reject; } }
    tap := TouchArea { width: 100%; height: 100%; mouse-cursor: pointer; clicked => { focus.focus(); root.clicked(); } }
}

component QuestSectionHeading inherits Rectangle {
    in property <string> title;
    in property <string> subtitle;
    height: subtitle == "" ? 32px : 52px;
    Text { x: 12px; y: 5px; text: root.title; color: DesktopTheme.text; font-size: 17px; font-weight: 600; }
    if root.subtitle != "": Text { x: 12px; y: 30px; width: parent.width - 24px; text: root.subtitle; color: DesktopTheme.secondary; font-size: 12px; overflow: elide; }
}

component QuestFactRow inherits Rectangle {
    in property <Fact> fact;
    callback open();
    callback focused(length, length);
    height: max(32px, value.preferred-height + 12px);
    border-radius: 4px;
    background: tap.has-hover && fact.key != "" ? DesktopTheme.hover : transparent;
    border-width: focus.has-focus ? 1px : 0px; border-color: DesktopTheme.accent;
    Text { x: 0px; y: 7px; width: 92px; text: root.fact.label; font-size: 12px; color: DesktopTheme.secondary; overflow: elide; }
    if root.fact.has-icon: Image { x: 102px; y: 3px; width: 26px; height: 26px; source: root.fact.icon; image-fit: contain; }
    value := Text { x: root.fact.has-icon ? 138px : 102px; y: 6px; width: parent.width - self.x - 8px; text: root.fact.value; wrap: word-wrap; font-size: 13px; color: root.fact.key == "" ? DesktopTheme.text : DesktopTheme.accent; }
    focus := FocusScope {
        enabled: root.fact.key != "";
        changed has-focus => { if (self.has-focus) { root.focused(root.y, root.height); } }
        key-pressed(event) => { if (event.text == Key.Return || event.text == Key.Space) { root.open(); return accept; } return reject; }
    }
    tap := TouchArea {
        width: 100%; height: 100%; enabled: root.fact.key != ""; mouse-cursor: root.fact.key == "" ? default : pointer;
        accessible-role: button; accessible-label: root.fact.label + " " + root.fact.value; accessible-enabled: root.fact.key != "";
        accessible-action-default => { if (root.fact.key != "") { root.open(); } }
        clicked => { focus.focus(); root.open(); }
    }
}

component DockChip inherits Rectangle {
    in property <image> logo;
    in property <string> glyph: "";
    in property <bool> selected: false;
    in property <int> mark: 0;
    in property <length> side: 60px;
    callback clicked();
    callback right-clicked();
    width: side;
    height: side;
    border-radius: side * 0.22;
    background: DesktopTheme.inset.with-alpha(0.9);
    border-width: selected || tap.has-hover ? 2px : 1px;
    border-color: selected || tap.has-hover ? DesktopTheme.accent : DesktopTheme.border;
    if root.glyph == "": Image {
        source: root.logo;
        width: side - 16px;
        height: side - 16px;
        image-fit: contain;
        x: 8px;
        y: 8px;
    }
    if root.glyph != "": Text {
        width: 100%;
        height: 100%;
        text: root.glyph;
        font-size: side * 0.42;
        color: DesktopTheme.accent;
        horizontal-alignment: center;
        vertical-alignment: center;
    }
    if root.mark > 0: Rectangle {
        x: 3px;
        y: 3px;
        width: 26px;
        height: 14px;
        border-radius: 7px;
        background: DesktopTheme.inset.with-alpha(0.95);
        Text {
            width: 100%;
            height: 100%;
            text: "F" + root.mark;
            font-size: 9px;
            font-weight: 700;
            color: DesktopTheme.accent;
            horizontal-alignment: center;
            vertical-alignment: center;
        }
    }
    tap := TouchArea {
        width: 100%;
        height: 100%;
        clicked => { root.clicked(); }
        pointer-event(event) => {
            if (event.button == PointerEventButton.right && event.kind == PointerEventKind.up) {
                root.right-clicked();
            }
        }
        mouse-cursor: pointer;
    }
}

component FactLine inherits Rectangle {
    in property <string> label;
    in property <string> value;
    in property <int> success-rate: -1;
    in property <string> key: "";
    in property <image> icon;
    in property <bool> has-icon: false;
    in property <bool> selected: false;
    in property <bool> last: false;
    in property <length> line-height: 30px;
    in property <bool> wrap-value: false;
    in property <bool> align-value-left: false;
    in property <bool> keyboard-link: false;
    in property <length> label-width: 112px;
    callback open();
    property <bool> heading: value == "" && !has-icon;
    height: heading ? 28px : wrap-value ? max(line-height, value-text.preferred-height + 8px) : line-height;
    border-radius: 8px;
    border-width: 1px;
    border-color: selected ? DesktopTheme.accent : transparent;
    background: selected ? DesktopTheme.selected : transparent;
    HorizontalLayout {
        width: parent.width;
        height: 100%;
        padding-left: 10px;
        padding-right: 10px;
        spacing: 8px;
        alignment: start;
        cross-axis-alignment: center;
        Text {
            width: root.heading ? parent.width - 20px : root.label-width;
            text: root.label;
            font-size: root.heading ? 13px : 12px;
            font-weight: root.heading ? 600 : 400;
            color: root.heading ? DesktopTheme.accent : DesktopTheme.secondary;
            overflow: elide;
            vertical-alignment: center;
        }
        if root.has-icon: Image {
            width: 28px;
            height: 28px;
            source: root.icon;
            image-fit: contain;
        }
        value-text := Text {
            horizontal-stretch: 1;
            width: max(parent.width - root.label-width - (root.has-icon ? 64px : 28px), 24px);
            text: root.value;
            font-size: 13px;
            color: root.success-rate >= 0 ? EnchantRate.ink(root.success-rate)
                : root.key == "" ? DesktopTheme.text : DesktopTheme.soft;
            horizontal-alignment: root.has-icon || root.align-value-left ? left : right;
            wrap: root.wrap-value ? word-wrap : no-wrap;
            overflow: elide;
            vertical-alignment: center;
        }
    }
    if !root.last: Rectangle {
        y: root.height - 1px;
        height: 1px;
        background: DesktopTheme.selected;
    }
    if root.key != "" && !root.keyboard-link: TouchArea {
        width: 100%;
        height: 100%;
        clicked => { root.open(); }
        mouse-cursor: pointer;
    }
    if root.key != "" && root.keyboard-link: Rectangle {
        width: 100%; height: 100%; border-radius: 6px;
        border-width: link-focus.has-focus ? 1px : 0px;
        border-color: DesktopTheme.accent;
        accessible-role: button;
        accessible-label: root.label + " " + root.value;
        accessible-action-default => { root.open(); }
        link-focus := FocusScope {
            key-pressed(event) => {
                if (event.text == Key.Return || event.text == Key.Space) { root.open(); return accept; }
                return reject;
            }
        }
        TouchArea { width: 100%; height: 100%; mouse-cursor: pointer; clicked => { link-focus.focus(); root.open(); } }
    }
}

component QuestDetailPane inherits Rectangle {
    in property <string> quest-key;
    in property <bool> english;
    in property <string> title;
    in property <string> alt;
    in property <string> code;
    in property <string> note;
    in property <image> portrait;
    in property <bool> has-portrait;
    in property <[Fact]> classification;
    in property <[Fact]> facts;
    in property <[Fact]> rewards;
    in property <[Hit]> links;
    in property <int> dependency-count;
    callback open-key(string);
    callback open-map();
    changed quest-key => { detail-scroll.content-y = 0px; }
    function reveal-row(top: length, size: length) {
        if (top < -detail-scroll.content-y) { detail-scroll.content-y = -top; }
        else if (top + size > -detail-scroll.content-y + detail-scroll.height) { detail-scroll.content-y = min(0px, detail-scroll.height - top - size); }
    }
    background: DesktopTheme.detail;
    border-radius: 8px;
    VerticalLayout {
        padding: 20px; spacing: 14px;
        HorizontalLayout {
            spacing: 12px; alignment: start;
            if root.has-portrait: Image { source: root.portrait; width: 48px; height: 48px; image-fit: contain; }
            VerticalLayout {
                spacing: 4px;
                CopyName { text: root.title; record-key: root.quest-key; wrap: word-wrap; font-size: 17px; font-weight: 600; color: DesktopTheme.text; }
                if root.alt != "": CopyName { text: root.alt; record-key: root.quest-key; alternate: true; wrap: word-wrap; font-size: 12px; color: DesktopTheme.secondary; }
                Text { text: root.code; font-size: 11px; color: DesktopTheme.muted; }
            }
        }
        HorizontalLayout {
            height: 32px;
            QuestTab { label: (UiLanguage.tr("Explore dependency map", "查看依賴路線圖")) + " · " + root.dependency-count; active: false; clicked => { root.open-map(); } }
            Rectangle { horizontal-stretch: 1; }
        }
        Rectangle { height: 1px; background: DesktopTheme.border; }
        detail-scroll := Flickable {
            width: root.width - 40px; vertical-stretch: 1;
            content-width: self.width; content-height: max(detail-column.preferred-height, self.height);
            detail-column := VerticalLayout {
                x: 0px; y: 0px; width: parent.width; height: self.preferred-height; spacing: 4px; alignment: start;
                for fact in root.classification: QuestFactRow { width: root.width - 40px; fact: fact; focused(top, size) => { root.reveal-row(top, size); } open => { if (fact.key != "") { root.open-key(fact.key); } } }
                if root.note != "": Rectangle { height: 10px; }
                if root.note != "": Text { text: root.note; wrap: word-wrap; font-size: 13px; color: DesktopTheme.text; }
                if root.facts.length > 0: Rectangle { height: 12px; }
                if root.facts.length > 0: Text { text: UiLanguage.tr("Requirements & objectives", "條件與目標"); font-size: 13px; font-weight: 600; color: DesktopTheme.secondary; }
                for fact in root.facts: QuestFactRow { width: root.width - 40px; fact: fact; focused(top, size) => { root.reveal-row(top, size); } open => { if (fact.key != "") { root.open-key(fact.key); } } }
                if root.rewards.length > 0 || root.links.length > 0: Rectangle { height: 12px; }
                if root.rewards.length > 0 || root.links.length > 0: Text { text: UiLanguage.tr("Rewards", "獎勵"); font-size: 13px; font-weight: 600; color: DesktopTheme.secondary; }
                for fact in root.rewards: QuestFactRow { width: root.width - 40px; fact: fact; }
                for row[i] in root.links: QuestFactRow {
                    width: root.width - 40px;
                    fact: { label: i == 0 ? (UiLanguage.tr("Items", "物品")) : "", value: row.title + (row.subtitle == "" ? "" : "\n" + row.subtitle), key: row.key, icon: row.icon, has-icon: row.has-icon, section: "" };
                    focused(top, size) => { root.reveal-row(top, size); }
                    open => { root.open-key(row.key); }
                }
            }
        }
    }
}

component RecordDetail inherits Rectangle {
    in property <[Fact]> facts;
    in property <[Hit]> links;
    in property <string> note: "";
    in property <string> body: "";
    in property <string> link-label;
    in property <string> source-note: "";
    in property <string> no-image-label;
    callback open-key(string);
    callback choose-source(string);
    background: DesktopTheme.detail;
    detail-scroll := Flickable {
        width: 100%;
        height: 100%;
        content-width: self.width;
        content-height: max(column.preferred-height + 8px, 1px);
        changed content-height => { self.content-y = clamp(self.content-y, min(0px, self.height - self.content-height), 0px); }
        changed height => { self.content-y = clamp(self.content-y, min(0px, self.height - self.content-height), 0px); }
        column := VerticalLayout {
            width: parent.width;
            padding: 12px;
            spacing: 4px;
            if root.note != "": Text {
                width: parent.width - 24px;
                text: root.note;
                wrap: word-wrap;
                font-size: 13px;
                color: DesktopTheme.text;
            }
            if root.body != "" && root.facts.length == 0: Text {
                width: parent.width - 24px;
                text: root.body;
                wrap: word-wrap;
                font-size: 13px;
                color: DesktopTheme.text;
            }
            for fact[i] in root.facts: VerticalLayout {
                width: parent.width - 24px;
                padding-top: i > 0 && fact.value == "" && !fact.has-icon ? 8px : 0px;
                if fact.value == "" && !fact.has-icon: HorizontalLayout {
                    padding-left: 10px;
                    padding-right: 10px;
                    Text {
                        width: parent.width - 20px;
                        height: self.preferred-height;
                        text: fact.label;
                        font-size: 13px;
                        font-weight: 600;
                        color: DesktopTheme.accent;
                        wrap: word-wrap;
                    }
                }
                if fact.value != "" || fact.has-icon: FactLine {
                    width: parent.width;
                    label: fact.label;
                    label-width: fact.label == "" ? 0px : 80px;
                    align-value-left: fact.label == "";
                    wrap-value: true;
                    line-height: fact.has-icon ? 40px : 30px;
                    value: fact.value;
                    success-rate: fact.has-success-rate ? fact.success-rate : -1;
                    key: fact.key;
                    icon: fact.icon;
                    has-icon: fact.has-icon;
                    last: true;
                    open => {
                        if (fact.key != "") {
                            root.open-key(fact.key);
                        }
                    }
                }
            }
            if root.links.length > 0: Text {
                text: root.link-label;
                font-size: 12px;
                color: DesktopTheme.secondary;
            }
            if root.source-note != "": Text {
                width: parent.width - 24px;
                text: root.source-note;
                wrap: word-wrap;
                font-size: 12px;
                color: DesktopTheme.secondary;
            }
            if root.links.length > 0: detail-links := Rectangle {
                height: root.links.length * 36px;
                for row[i] in root.links: detail-link-slot := Rectangle {
                    x: 0px; y: i * 36px; width: parent.width; height: 36px;
                    if detail-links.y + detail-link-slot.y + detail-link-slot.height >= -detail-scroll.content-y - 72px && detail-links.y + detail-link-slot.y <= -detail-scroll.content-y + detail-scroll.height + 72px: HitRow {
                        x: 0px; y: 0px; width: parent.width;
                        compact: true;
                        hit: row;
                        no-image-label: root.no-image-label;
                        title-color: DesktopTheme.accent;
                        clicked => {
                            if (row.chip == "section") {
                                root.choose-source(row.key);
                            } else if (row.key != "") {
                                root.open-key(row.key);
                            }
                        }
                    }
                }
            }
        }
    }
}

component FullMonsterSheet inherits Flickable {
    in property <bool> english: false;
    in property <string> record-key;
    in property <string> title;
    in property <string> alt;
    in property <string> code;
    in property <image> icon;
    in property <bool> show-icon: false;
    in property <image> battle;
    in property <bool> show-battle: false;
    in property <image> element-icon;
    in property <bool> show-element: false;
    in property <[Fact]> facts;
    in property <[Hit]> drops;
    in property <[Hit]> related;
    in property <int> cursor: 0;
    in property <string> no-image-label;
    callback open-fact(string);
    callback open-drop(int);
    callback open-related(int);
    property <length> stage-h: 210px;
    property <int> fact-rows: floor((max(facts.length, 1) + 1) / 2);
    property <length> fact-top: stage-h + 12px;
    property <length> fact-h: fact-rows * 32px;
    property <length> lists-top: fact-top + fact-h + 12px;
    property <bool> split: drops.length > 0 && related.length > 0;
    property <length> list-h: max(drops.length * 36px, related.length * 52px);
    property <length> block-h: drops.length > 0 || related.length > 0 ? 26px + list-h : 0px;
    property <length> text-x: 16px + (show-icon ? 156px : 0px) + (show-battle ? 132px : 0px);
    content-width: self.width;
    content-height: max(lists-top + block-h + 8px, 1px);
    Rectangle {
        y: 0px;
        width: parent.width;
        height: root.stage-h;
        border-radius: 12px;
        background: DesktopTheme.surface;
        border-width: 1px;
        border-color: DesktopTheme.border;
        if root.show-icon: Image {
            x: 16px;
            y: (root.stage-h - 140px) / 2;
            width: 140px;
            height: 140px;
            source: root.icon;
            image-fit: contain;
        }
        if root.show-battle: Image {
            x: root.show-icon ? 164px : 16px;
            y: 12px;
            width: 116px;
            height: root.stage-h - 24px;
            source: root.battle;
            image-fit: contain;
        }
        if root.show-element: Image {
            x: 124px;
            y: root.stage-h - 52px;
            width: 32px;
            height: 32px;
            source: root.element-icon;
            image-fit: contain;
        }
        CopyName {
            x: root.text-x;
            y: (root.stage-h - (root.alt == "" ? 48px : 70px)) / 2;
            width: max(parent.width - root.text-x - 16px, 48px);
            text: root.title;
            font-size: 22px;
            font-weight: 600;
            color: DesktopTheme.text;
            overflow: elide;
            record-key: root.record-key;
        }
        if root.alt != "": CopyName {
            x: root.text-x;
            y: (root.stage-h - 70px) / 2 + 28px;
            width: max(parent.width - root.text-x - 16px, 48px);
            text: root.alt;
            font-size: 15px;
            color: DesktopTheme.accent;
            overflow: elide;
            record-key: root.record-key; alternate: true;
        }
        Text {
            x: root.text-x;
            y: (root.stage-h - (root.alt == "" ? 48px : 70px)) / 2 + (root.alt == "" ? 28px : 50px);
            width: max(parent.width - root.text-x - 16px, 48px);
            text: root.code;
            font-size: 13px;
            color: DesktopTheme.secondary;
            overflow: elide;
        }
    }
    Rectangle {
        y: root.fact-top;
        width: parent.width;
        height: root.fact-h;
        background: DesktopTheme.surface;
        border-radius: 10px;
        border-width: 1px;
        border-color: DesktopTheme.border;
        for fact[i] in root.facts: FactLine {
            x: mod(i, 2) == 0 ? 4px : parent.width / 2;
            y: floor(i / 2) * 32px;
            width: parent.width / 2 - 8px;
            label: fact.label;
            value: fact.value;
            success-rate: fact.has-success-rate ? fact.success-rate : -1;
            key: fact.key;
            last: true;
            open => { root.open-fact(fact.key); }
        }
    }
    if root.drops.length > 0: Text {
        x: 4px;
        y: root.lists-top;
        text: UiLanguage.tr("Drops", "掉落");
        font-size: 13px;
        color: DesktopTheme.secondary;
    }
    if root.related.length > 0: Text {
        x: root.split ? parent.width / 2 + 8px : 4px;
        y: root.lists-top;
        text: UiLanguage.tr("Related", "相關");
        font-size: 13px;
        color: DesktopTheme.secondary;
    }
    if root.drops.length > 0: Rectangle {
        x: 0px;
        y: root.lists-top + 24px;
        width: root.split ? parent.width / 2 - 6px : parent.width;
        height: root.drops.length * 36px;
        for row[i] in root.drops: HitRow {
            y: i * 36px;
            width: parent.width;
            compact: true;
            selected: root.cursor == i;
            hit: row;
            no-image-label: root.no-image-label;
            title-color: DesktopTheme.accent;
            clicked => { root.open-drop(i); }
        }
    }
    if root.related.length > 0: Rectangle {
        x: root.split ? parent.width / 2 + 6px : 0px;
        y: root.lists-top + 24px;
        width: root.split ? parent.width / 2 - 6px : parent.width;
        height: root.related.length * 52px;
        for row[i] in root.related: HitRow {
            y: i * 52px;
            width: parent.width;
            selected: root.cursor == i;
            hit: row;
            no-image-label: root.no-image-label;
            clicked => { root.open-related(i); }
        }
    }
}

component MonsterFact inherits Rectangle {
    in property <Fact> fact;
    callback open();
    height: max(28px, value-text.preferred-height + 8px);
    Text {
        x: 0px; y: 4px; width: 72px; height: 20px;
        text: root.fact.label; font-size: 12px; color: DesktopTheme.secondary; overflow: elide;
    }
    value-text := Text {
        x: 84px; y: 4px; width: parent.width - 84px; height: self.preferred-height;
        text: root.fact.value; font-size: 13px;
        color: root.fact.key == "" ? DesktopTheme.text : DesktopTheme.accent;
        wrap: word-wrap;
    }
    if root.fact.key != "": TouchArea {
        x: 0px; y: 0px; width: 100%; height: 100%;
        mouse-cursor: pointer; clicked => { root.open(); }
    }
}

component InlineMonster inherits Rectangle {
    in property <[Fact]> facts;
    in property <[Hit]> drops;
    in property <[Hit]> related;
    in property <bool> english;
    in property <string> no-image-label;
    in property <string> note: "";
    in property <string> alt;
    in property <string> code;
    in property <string> places;
    out property <length> content-height: column.preferred-height;
    callback measured(length);
    init => { root.measured(root.content-height); }
    changed content-height => { root.measured(root.content-height); }
    callback open-key(string);
    callback find-drop-monsters(string, string);
    property <int> drop-columns: root.width >= 800px ? 3 : 2;
    property <int> drop-rows: ceil(drops.length / drop-columns);
    background: DesktopTheme.surface;
    column := VerticalLayout {
        x: 0px; y: 0px; width: parent.width; height: self.preferred-height;
        padding: 12px; spacing: 4px;
        if root.alt != "" || root.code != "": HorizontalLayout {
            spacing: 12px;
            Text {
                horizontal-stretch: 1; min-width: 0px;
                text: root.alt; font-size: 12px; color: DesktopTheme.secondary; wrap: word-wrap;
            }
            Text { text: root.code; font-size: 12px; color: DesktopTheme.muted; }
        }
        if root.facts.length == 0 && root.note != "": Text {
            text: root.note; wrap: word-wrap; font-size: 13px; color: DesktopTheme.text;
        }
        MonsterFact {
            fact: { label: UiLanguage.tr("Found in", "出沒地"), value: root.places };
        }
        if root.drops.length > 0: Text {
            height: 24px; text: (UiLanguage.tr("Drops ", "掉落物 ")) + root.drops.length;
            font-size: 12px; font-weight: 600; color: DesktopTheme.secondary; vertical-alignment: center;
        }
        for r in root.drop-rows: HorizontalLayout {
            height: self.preferred-height; spacing: 12px; cross-axis-alignment: start;
            for c in root.drop-columns: Rectangle {
                width: (root.width - 24px - (root.drop-columns - 1) * 12px) / root.drop-columns; height: link.height;
                link := CompactRecordLink {
                    x: 0px; y: 0px; width: parent.width;
                    visible: r * root.drop-columns + c < root.drops.length;
                    title: root.drops[r * root.drop-columns + c].title;
                    aside: root.drops[r * root.drop-columns + c].aside;
                    alternate: root.drops[r * root.drop-columns + c].alternate-name;
                    icon: root.drops[r * root.drop-columns + c].icon;
                    has-icon: root.drops[r * root.drop-columns + c].has-icon;
                    drop-context-enabled: root.drops[r * root.drop-columns + c].key.starts-with("item:");
                    english: root.english;
                    clicked => { root.open-key(root.drops[r * root.drop-columns + c].key); }
                    find-monsters => { root.find-drop-monsters(root.drops[r * root.drop-columns + c].key, root.drops[r * root.drop-columns + c].title); }
                }
            }
        }
        if root.related.length > 0: Text {
            height: 24px; text: UiLanguage.tr("Related", "相關");
            font-size: 12px; font-weight: 600; color: DesktopTheme.secondary; vertical-alignment: center;
        }
        for row in root.related: CompactRecordLink {
            title: row.title; icon: row.icon; has-icon: row.has-icon;
            clicked => { root.open-key(row.key); }
        }
    }
}

component ChainButton inherits Rectangle {
    in property <string> caption;
    in property <string> name;
    in property <bool> end: false;
    in property <bool> picked: false;
    callback clicked();
    height: 40px;
    border-radius: 8px;
    background: root.picked ? DesktopTheme.selected : tap.has-hover ? DesktopTheme.raised : DesktopTheme.surface;
    border-width: 1px;
    border-color: root.picked || tap.has-hover ? DesktopTheme.accent : DesktopTheme.border;
    VerticalLayout {
        width: 100%;
        padding-left: 10px;
        padding-right: 10px;
        alignment: center;
        Text {
            width: 100%;
            text: root.caption;
            font-size: 10px;
            font-weight: 700;
            color: DesktopTheme.accent;
            horizontal-alignment: root.end ? right : left;
            overflow: elide;
        }
        Text {
            width: 100%;
            text: root.name;
            font-size: 12px;
            color: DesktopTheme.text;
            horizontal-alignment: root.end ? right : left;
            overflow: elide;
        }
    }
    tap := TouchArea {
        width: 100%;
        height: 100%;
        clicked => { root.clicked(); }
        mouse-cursor: pointer;
    }
}

export component StartupError inherits Window {
    title: "Gersang";
    width: 520px;
    height: 280px;
    in property <string> message;
    callback dismiss();
    VerticalLayout {
        padding: 24px;
        spacing: 16px;
        Text { text: "無法開啟 Gersang / Unable to open Gersang / Gersang을 열 수 없습니다"; font-size: 18px; wrap: word-wrap; }
        Text { text: root.message; wrap: word-wrap; vertical-stretch: 1; }
        Button { text: "關閉 / Close / 닫기"; clicked => { root.dismiss(); } }
    }
}

component SearchEmpty inherits Rectangle {
    in property <bool> english;
    callback clear();
    VerticalLayout {
        width: parent.width;
        spacing: 10px;
        alignment: start;
        Text {
            text: UiLanguage.tr("No matches", "沒有符合的資料");
            color: DesktopTheme.text; font-size: 15px; font-weight: 500;
            wrap: word-wrap;
        }
        Text {
            text: UiLanguage.tr("Try another name, or clear the search to return to the list.", "試試其他名稱，或清除搜尋返回列表。");
            color: DesktopTheme.secondary; font-size: 13px;
            wrap: word-wrap;
        }
        HorizontalLayout {
            alignment: start;
            Button {
                width: min(130px, root.width); height: 32px;
                text: UiLanguage.tr("Clear search", "清除搜尋");
                clicked => { root.clear(); }
            }
        }
    }
}

