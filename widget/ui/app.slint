    aside: string,
    chip: string,
}

// The compact rows elide visually; the same complete text is available to
// hover tooltips, keyboard help and accessibility without another catalog query.
global RecordText {
    public pure function alternate(hit: Hit) -> string {
        return hit.alternate-name != hit.title ? hit.alternate-name : "";
    }
    public pure function metadata(hit: Hit) -> string {
        return hit.subtitle != hit.title && hit.subtitle != hit.alternate-name ? hit.subtitle : "";
    }
    public pure function secondary(hit: Hit) -> string {
        return RecordText.alternate(hit) + (RecordText.alternate(hit) != "" && RecordText.metadata(hit) != "" ? " · " : "") + RecordText.metadata(hit);
    }
    public pure function description(hit: Hit) -> string {
        let alternate = RecordText.alternate(hit);
        let subtitle = RecordText.metadata(hit);
        let detail = hit.detail != hit.title && hit.detail != hit.alternate-name && hit.detail != hit.subtitle ? hit.detail : "";
        let places = hit.spawn-places != hit.title && hit.spawn-places != hit.alternate-name && hit.spawn-places != hit.subtitle && hit.spawn-places != hit.detail ? hit.spawn-places : "";
        let aside = hit.chip != "section" && hit.aside != hit.title && hit.aside != hit.alternate-name && hit.aside != hit.subtitle && hit.aside != hit.detail && hit.aside != hit.spawn-places ? hit.aside : "";
        return alternate
            + (subtitle != "" ? (alternate != "" ? "\n" : "") + subtitle : "")
            + (detail != "" ? (alternate != "" || subtitle != "" ? "\n" : "") + detail : "")
            + (places != "" ? (alternate != "" || subtitle != "" || detail != "" ? "\n" : "") + places : "")
            + (aside != "" ? (alternate != "" || subtitle != "" || detail != "" || places != "" ? "\n" : "") + aside : "");
    }
    public pure function full(hit: Hit) -> string {
        return hit.title + (RecordText.description(hit) != "" ? "\n" + RecordText.description(hit) : "");
    }
}

// One shared, non-modal information surface also serves deeply nested rows.
global RecordInfo {
    in-out property <string> text: "";
    public function show(hit: Hit) {
        root.text = RecordText.full(hit);
    }
}

component RecordTooltip inherits Rectangle {
    in property <string> text;
    width: min(420px, max(200px, label.preferred-width + 24px));
    height: label.preferred-height + 20px;
    background: DesktopTheme.raised;
    border-radius: 5px;
    border-width: 1px;
    border-color: DesktopTheme.border;
    accessible-role: AccessibleRole.text;
    accessible-label: root.text;
    label := Text {
        x: 12px; y: 10px; width: parent.width - 24px;
        height: self.preferred-height;
        text: root.text; font-size: 13px; color: DesktopTheme.text;
        wrap: word-wrap;
    }
}

