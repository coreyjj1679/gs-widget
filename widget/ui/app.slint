                            text: root.sheet-note;
                            wrap: word-wrap;
                            font-size: 13px;
                            color: #f3efe8;
                        }
                    }
                    if root.quest-sheet && root.facts.length > 0: Text {
                        x: root.side-gap;
                        y: root.quest-ask-y;
                        text: root.lang == "en-zh" ? "Task" : "要求";
                        font-size: 12px;
