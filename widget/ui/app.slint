                TableStat { label: root.english ? "Exp" : "經驗"; value: root.hit.stat-exp; }
            }
            if root.width >= 620px: VerticalLayout {
                horizontal-stretch: 1;
                alignment: start;
                spacing: 4px;
                Text {
                    height: 16px;
                    text: root.english ? "Drops" : "掉落";
                    font-size: 12px;
                    color: DesktopTheme.muted;
                    vertical-alignment: center;
                }
                HorizontalLayout {
                    height: 28px;
                    spacing: 4px;
                    alignment: start;
                    if root.hit.drop1.width > 0: Image { source: root.hit.drop1; width: root.width < 680px ? 20px : 28px; height: root.width < 680px ? 20px : 28px; image-fit: contain; }
                    if root.hit.drop2.width > 0: Image { source: root.hit.drop2; width: root.width < 680px ? 20px : 28px; height: root.width < 680px ? 20px : 28px; image-fit: contain; }
                    if root.hit.drop3.width > 0: Image { source: root.hit.drop3; width: root.width < 680px ? 20px : 28px; height: root.width < 680px ? 20px : 28px; image-fit: contain; }
                    if root.hit.drop4.width > 0: Image { source: root.hit.drop4; width: root.width < 680px ? 20px : 28px; height: root.width < 680px ? 20px : 28px; image-fit: contain; }
                    if root.hit.drop5.width > 0: Image { source: root.hit.drop5; width: root.width < 680px ? 20px : 28px; height: root.width < 680px ? 20px : 28px; image-fit: contain; }
                }
                if root.hit.drop6.width > 0: HorizontalLayout {
                    height: 28px;
                    spacing: 4px;
                    alignment: start;
                    if root.hit.drop6.width > 0: Image { source: root.hit.drop6; width: root.width < 680px ? 20px : 28px; height: root.width < 680px ? 20px : 28px; image-fit: contain; }
                    if root.hit.drop7.width > 0: Image { source: root.hit.drop7; width: root.width < 680px ? 20px : 28px; height: root.width < 680px ? 20px : 28px; image-fit: contain; }
                    if root.hit.drop8.width > 0: Image { source: root.hit.drop8; width: root.width < 680px ? 20px : 28px; height: root.width < 680px ? 20px : 28px; image-fit: contain; }
                    if root.hit.drop9.width > 0: Image { source: root.hit.drop9; width: root.width < 680px ? 20px : 28px; height: root.width < 680px ? 20px : 28px; image-fit: contain; }
                    if root.hit.drop10.width > 0: Image { source: root.hit.drop10; width: root.width < 680px ? 20px : 28px; height: root.width < 680px ? 20px : 28px; image-fit: contain; }
                }
                if root.hit.drop-total == 0: Text {
                    text: "—";
                    font-size: 12px;
                    color: DesktopTheme.muted;
                }
            }
        }
    }
    StarMark {
        x: parent.width - 36px;
        y: 8px;
        filled: root.hit.favourite;
        clicked => { root.favourite-clicked(); }
    }
}

component SectionPick inherits Rectangle {
    in property <string> title;
    in property <string> count;
    in property <bool> selected: false;
    callback clicked();
    height: 48px;
    border-radius: 6px;
    background: selected ? DesktopTheme.selected : area.has-hover ? DesktopTheme.hover : transparent;
    accessible-role: button;
    accessible-label: title;
    accessible-description: count;
    accessible-action-default => { root.clicked(); }
    Text {
        x: 10px; y: 5px; width: parent.width - 20px;
        text: root.title; font-size: 13px; font-weight: root.selected ? 600 : 400;
        color: root.selected ? DesktopTheme.text : DesktopTheme.soft;
        overflow: elide;
    }
    Text {
        x: 10px; y: 25px; width: parent.width - 20px;
        text: root.count; font-size: 11px; color: DesktopTheme.muted;
        overflow: elide;
    }
    area := TouchArea {
        width: 100%; height: 100%;
        clicked => { root.clicked(); }
        mouse-cursor: pointer;
    }
}

component CatalogRow inherits Rectangle {
    in property <Hit> hit;
    in property <bool> selected: false;
    callback clicked();
    accessible-role: button;
    accessible-label: hit.title;
    accessible-description: hit.subtitle;
    accessible-action-default => { root.clicked(); }
    height: 58px;
    border-radius: 6px;
    background: selected ? DesktopTheme.selected : area.has-hover ? DesktopTheme.hover : transparent;
    area := TouchArea {
        width: 100%;
        height: 100%;
        clicked => { root.clicked(); }
        mouse-cursor: pointer;
        HorizontalLayout {
            width: 100%;
            height: 100%;
            padding-left: 10px;
            padding-right: 12px;
            spacing: 10px;
            if root.hit.has-icon: Image {
                source: root.hit.icon;
                width: 32px;
                height: 32px;
                image-fit: contain;
            }
            VerticalLayout {
                horizontal-stretch: 1;
                min-width: 0px;
                alignment: center;
                spacing: 1px;
                Text {
                    text: root.hit.title;
                    font-size: 13px;
                    font-weight: 500;
                    color: DesktopTheme.text;
                    overflow: elide;
                }
                if root.hit.subtitle != "": Text {
                    text: root.hit.subtitle;
                    font-size: 12px;
                    color: DesktopTheme.secondary;
                    overflow: elide;
                }
            }
            if root.hit.aside != "" && root.width > 360px: Text {
                text: root.hit.aside;
                font-size: 12px;
                color: DesktopTheme.accent;
                vertical-alignment: center;
            }
        }
    }
    Rectangle {
        y: parent.height - 1px;
        width: 100%;
        height: 1px;
        background: DesktopTheme.border;
    }
}


component DockChip inherits Rectangle {
    in property <image> logo;
    in property <string> glyph: "";
    in property <bool> selected: false;
    in property <int> mark: 0;
    in property <length> side: 60px;
    callback clicked();
    callback right-clicked();
    width: side;
    height: side;
    border-radius: side * 0.22;
    background: #120f0ce6;
    border-width: selected || tap.has-hover ? 2px : 1px;
    border-color: selected || tap.has-hover ? DesktopTheme.accent : #5a4a34;
    if root.glyph == "": Image {
        source: root.logo;
        width: side - 16px;
        height: side - 16px;
        image-fit: contain;
        x: 8px;
        y: 8px;
    }
    if root.glyph != "": Text {
        width: 100%;
        height: 100%;
        text: root.glyph;
        font-size: side * 0.42;
        color: DesktopTheme.accent;
        horizontal-alignment: center;
        vertical-alignment: center;
    }
    if root.mark > 0: Rectangle {
        x: 3px;
        y: 3px;
        width: 26px;
        height: 14px;
        border-radius: 7px;
        background: #120f0cf2;
        Text {
            width: 100%;
            height: 100%;
            text: "F" + root.mark;
            font-size: 9px;
            font-weight: 700;
            color: DesktopTheme.accent;
            horizontal-alignment: center;
            vertical-alignment: center;
        }
    }
    tap := TouchArea {
        width: 100%;
        height: 100%;
        clicked => { root.clicked(); }
        pointer-event(event) => {
            if (event.button == PointerEventButton.right && event.kind == PointerEventKind.up) {
                root.right-clicked();
            }
        }
        mouse-cursor: pointer;
    }
}

component FactLine inherits Rectangle {
    in property <string> label;
    in property <string> value;
    in property <string> key: "";
    in property <image> icon;
    in property <bool> has-icon: false;
    in property <bool> selected: false;
    in property <bool> last: false;
    in property <length> line-height: 30px;
    in property <bool> wrap-value: false;
    in property <length> label-width: 112px;
    callback open();
    property <bool> heading: value == "" && !has-icon;
    height: heading ? 28px : wrap-value ? max(line-height, value-text.preferred-height + 8px) : line-height;
    border-radius: 8px;
    border-width: 1px;
    border-color: selected ? DesktopTheme.accent : transparent;
    background: selected ? DesktopTheme.selected : transparent;
    HorizontalLayout {
        width: parent.width;
        height: 100%;
        padding-left: 10px;
        padding-right: 10px;
        spacing: 8px;
        alignment: start;
        cross-axis-alignment: center;
        Text {
            width: root.heading ? parent.width - 20px : root.label-width;
            text: root.label;
            font-size: root.heading ? 13px : 12px;
            font-weight: root.heading ? 600 : 400;
            color: root.heading ? DesktopTheme.accent : DesktopTheme.secondary;
            overflow: elide;
            vertical-alignment: center;
        }
        if root.has-icon: Image {
            width: 28px;
            height: 28px;
            source: root.icon;
            image-fit: contain;
        }
        value-text := Text {
            horizontal-stretch: 1;
            width: max(parent.width - root.label-width - (root.has-icon ? 64px : 28px), 24px);
            text: root.value;
            font-size: 13px;
            color: root.key == "" ? DesktopTheme.text : DesktopTheme.soft;
            horizontal-alignment: root.has-icon ? left : right;
            wrap: root.wrap-value ? word-wrap : no-wrap;
            overflow: elide;
            vertical-alignment: center;
        }
    }
    if !root.last: Rectangle {
        y: root.height - 1px;
        height: 1px;
        background: DesktopTheme.selected;
    }
    if root.key != "": TouchArea {
        width: 100%;
        height: 100%;
        clicked => { root.open(); }
        mouse-cursor: pointer;
    }
}

component RecordDetail inherits Rectangle {
    in property <[Fact]> facts;
    in property <[Hit]> links;
    in property <string> note: "";
    in property <string> body: "";
    in property <string> link-label;
    in property <string> no-image-label;
    callback open-key(string);
    background: DesktopTheme.detail;
    Flickable {
        width: 100%;
        height: 100%;
        content-width: self.width;
        content-height: max(column.preferred-height + 8px, 1px);
        column := VerticalLayout {
            width: parent.width;
            padding: 12px;
            spacing: 4px;
            if root.note != "": Text {
                width: parent.width - 24px;
                text: root.note;
                wrap: word-wrap;
                font-size: 13px;
                color: DesktopTheme.text;
            }
            if root.body != "" && root.facts.length == 0: Text {
                width: parent.width - 24px;
                text: root.body;
                wrap: word-wrap;
                font-size: 13px;
                color: DesktopTheme.text;
            }
            for fact in root.facts: FactLine {
                width: parent.width - 24px;
                label: fact.label;
                label-width: 80px;
                wrap-value: true;
                value: fact.value;
                key: fact.key;
                icon: fact.icon;
                has-icon: fact.has-icon;
                last: true;
                open => {
                    if (fact.key != "") {
                        root.open-key(fact.key);
                    }
                }
            }
            if root.links.length > 0: Text {
                text: root.link-label;
                font-size: 12px;
                color: DesktopTheme.secondary;
            }
            if root.links.length > 0: VerticalLayout {
                spacing: 0px;
                for row in root.links: HitRow {
                    compact: true;
                    hit: row;
                    no-image-label: root.no-image-label;
                    title-color: DesktopTheme.accent;
                    clicked => {
                        if (row.key != "" && row.chip != "section") {
                            root.open-key(row.key);
                        }
                    }
                }
            }
        }
    }
}

component FullMonsterSheet inherits Flickable {
    in property <bool> english: false;
    in property <string> title;
    in property <string> alt;
    in property <string> code;
    in property <image> icon;
    in property <bool> show-icon: false;
    in property <image> battle;
    in property <bool> show-battle: false;
    in property <image> element-icon;
    in property <bool> show-element: false;
    in property <[Fact]> facts;
    in property <[Hit]> drops;
    in property <[Hit]> related;
    in property <int> cursor: 0;
    in property <string> no-image-label;
    callback open-fact(string);
    callback open-drop(int);
    callback open-related(int);
    property <length> stage-h: 210px;
    property <int> fact-rows: floor((max(facts.length, 1) + 1) / 2);
    property <length> fact-top: stage-h + 12px;
    property <length> fact-h: fact-rows * 32px;
    property <length> lists-top: fact-top + fact-h + 12px;
    property <bool> split: drops.length > 0 && related.length > 0;
    property <length> list-h: max(drops.length * 36px, related.length * 52px);
    property <length> block-h: drops.length > 0 || related.length > 0 ? 26px + list-h : 0px;
    property <length> text-x: 16px + (show-icon ? 156px : 0px) + (show-battle ? 132px : 0px);
    content-width: self.width;
    content-height: max(lists-top + block-h + 8px, 1px);
    Rectangle {
        y: 0px;
        width: parent.width;
        height: root.stage-h;
        border-radius: 12px;
        background: DesktopTheme.surface;
        border-width: 1px;
        border-color: DesktopTheme.border;
        if root.show-icon: Image {
            x: 16px;
            y: (root.stage-h - 148px) / 2;
            width: 140px;
            height: 140px;
            source: root.icon;
            image-fit: contain;
        }
        if root.show-battle: Image {
            x: root.show-icon ? 164px : 16px;
            y: 12px;
            width: 116px;
            height: root.stage-h - 24px;
            source: root.battle;
            image-fit: contain;
        }
        if root.show-element: Image {
            x: 124px;
            y: root.stage-h - 52px;
            width: 32px;
            height: 32px;
            source: root.element-icon;
            image-fit: contain;
        }
        Text {
            x: root.text-x;
            y: (root.stage-h - (root.alt == "" ? 48px : 70px)) / 2;
            width: max(parent.width - root.text-x - 16px, 48px);
            text: root.title;
            font-size: 22px;
            font-weight: 600;
            color: DesktopTheme.text;
            overflow: elide;
        }
        if root.alt != "": Text {
            x: root.text-x;
            y: (root.stage-h - 70px) / 2 + 28px;
            width: max(parent.width - root.text-x - 16px, 48px);
            text: root.alt;
            font-size: 15px;
            color: DesktopTheme.accent;
            overflow: elide;
        }
        Text {
            x: root.text-x;
            y: (root.stage-h - (root.alt == "" ? 48px : 70px)) / 2 + (root.alt == "" ? 28px : 50px);
            width: max(parent.width - root.text-x - 16px, 48px);
            text: root.code;
            font-size: 13px;
            color: DesktopTheme.secondary;
            overflow: elide;
        }
    }
    Rectangle {
        y: root.fact-top;
        width: parent.width;
        height: root.fact-h;
        background: DesktopTheme.surface;
        border-radius: 10px;
        border-width: 1px;
        border-color: DesktopTheme.border;
        for fact[i] in root.facts: FactLine {
            x: mod(i, 2) == 0 ? 4px : parent.width / 2;
            y: floor(i / 2) * 32px;
            width: parent.width / 2 - 8px;
            label: fact.label;
            value: fact.value;
            key: fact.key;
            last: true;
            open => { root.open-fact(fact.key); }
        }
    }
    if root.drops.length > 0: Text {
        x: 4px;
        y: root.lists-top;
        text: root.english ? "Drops" : "掉落";
        font-size: 13px;
        color: DesktopTheme.secondary;
    }
    if root.related.length > 0: Text {
        x: root.split ? parent.width / 2 + 8px : 4px;
        y: root.lists-top;
        text: root.english ? "Related" : "相關";
        font-size: 13px;
        color: DesktopTheme.secondary;
    }
    if root.drops.length > 0: Rectangle {
        x: 0px;
        y: root.lists-top + 24px;
        width: root.split ? parent.width / 2 - 6px : parent.width;
        height: root.drops.length * 36px;
        for row[i] in root.drops: HitRow {
            y: i * 36px;
            width: parent.width;
            compact: true;
            selected: root.cursor == i;
            hit: row;
            no-image-label: root.no-image-label;
            title-color: DesktopTheme.accent;
            clicked => { root.open-drop(i); }
        }
    }
    if root.related.length > 0: Rectangle {
        x: root.split ? parent.width / 2 + 6px : 0px;
        y: root.lists-top + 24px;
        width: root.split ? parent.width / 2 - 6px : parent.width;
        height: root.related.length * 52px;
        for row[i] in root.related: HitRow {
            y: i * 52px;
            width: parent.width;
            selected: root.cursor == i;
            hit: row;
            no-image-label: root.no-image-label;
            clicked => { root.open-related(i); }
        }
    }
}

component InlineMonster inherits Rectangle {
    in property <[Fact]> facts;
    in property <[Hit]> drops;
    in property <[Hit]> related;
    in property <bool> english;
    in property <string> no-image-label;
    in property <string> note: "";
    callback open-key(string);
    property <int> fact-rows: facts.length == 0 ? 0 : floor((facts.length + 1) / 2);
    property <length> list-top: 8px + fact-rows * 30px + (fact-rows > 0 ? 8px : 0px);
    background: DesktopTheme.surface;
    border-radius: 10px;
    border-width: 1px;
    border-color: DesktopTheme.border;
    if root.facts.length == 0 && root.note != "": Text {
        x: 12px;
        y: 10px;
        width: parent.width - 24px;
        text: root.note;
        wrap: word-wrap;
        font-size: 13px;
        color: DesktopTheme.text;
    }
    for fact[i] in root.facts: FactLine {
        x: mod(i, 2) == 0 ? 8px : parent.width / 2;
        y: 6px + floor(i / 2) * 30px;
        width: parent.width / 2 - 12px;
        label: fact.label;
        value: fact.value;
        key: fact.key;
        last: true;
        open => {
            if (fact.key != "") {
                root.open-key(fact.key);
            }
        }
    }
    if root.drops.length > 0: Text {
        x: 10px;
        y: root.list-top;
        text: root.english ? "Drops" : "掉落";
        font-size: 12px;
        color: DesktopTheme.secondary;
    }
    if root.related.length > 0: Text {
        x: root.drops.length > 0 ? parent.width / 2 + 8px : 10px;
        y: root.list-top;
        text: root.english ? "Related" : "相關";
        font-size: 12px;
        color: DesktopTheme.secondary;
    }
    if root.drops.length > 0: Rectangle {
        x: 6px;
        y: root.list-top + 20px;
        width: root.related.length > 0 ? parent.width / 2 - 10px : parent.width - 12px;
        height: root.drops.length * 36px;
        for row[i] in root.drops: HitRow {
            y: i * 36px;
            width: parent.width;
            compact: true;
            hit: row;
            no-image-label: root.no-image-label;
            title-color: DesktopTheme.accent;
            clicked => { root.open-key(row.key); }
        }
    }
    if root.related.length > 0: Rectangle {
        x: root.drops.length > 0 ? parent.width / 2 + 4px : 6px;
        y: root.list-top + 20px;
        width: root.drops.length > 0 ? parent.width / 2 - 10px : parent.width - 12px;
        height: root.related.length * 52px;
        for row[i] in root.related: HitRow {
            y: i * 52px;
            width: parent.width;
            hit: row;
            no-image-label: root.no-image-label;
            clicked => { root.open-key(row.key); }
        }
    }
}

component ChainButton inherits Rectangle {
    in property <string> caption;
    in property <string> name;
    in property <bool> end: false;
    in property <bool> picked: false;
    callback clicked();
    height: 40px;
    border-radius: 8px;
    background: root.picked ? DesktopTheme.selected : tap.has-hover ? DesktopTheme.raised : DesktopTheme.surface;
    border-width: 1px;
    border-color: root.picked || tap.has-hover ? DesktopTheme.accent : DesktopTheme.border;
    VerticalLayout {
        width: 100%;
        padding-left: 10px;
        padding-right: 10px;
        alignment: center;
        Text {
            width: 100%;
            text: root.caption;
            font-size: 10px;
            font-weight: 700;
            color: DesktopTheme.accent;
            horizontal-alignment: root.end ? right : left;
            overflow: elide;
        }
        Text {
            width: 100%;
            text: root.name;
            font-size: 12px;
            color: DesktopTheme.text;
            horizontal-alignment: root.end ? right : left;
            overflow: elide;
        }
    }
    tap := TouchArea {
        width: 100%;
        height: 100%;
        clicked => { root.clicked(); }
        mouse-cursor: pointer;
    }
}

export component App inherits Window {
    in-out property <string> query;
    in-out property <string> category;
    in-out property <string> nation;
    in-out property <string> nation-name;
    in-out property <string> place;
    in-out property <string> place-name;
    in-out property <string> area;
    in-out property <string> area-name;
    in-out property <string> viewing;
    in-out property <string> lang: "zh-en";
    in-out property <bool> collapsed: false;
    in-out property <bool> full-mode: false;
    callback mode-changed(bool);
    property <length> nav-w: root.width < 1100px ? 176px : 208px;
    property <length> page-pad: root.full-mode ? 24px : 14px;
    property <length> pane-w: full-mode && !collapsed ? max(root.width - nav-w, 280px) : root.width;
    in-out property <bool> dock-menu: false;
    callback dock-drag(length, length);
    in-out property <bool> settings-open: false;
    in-out property <[Hit]> hits;
    in-out property <[Hit]> links;
    in-out property <[Hit]> related;
    in-out property <string> detail;
    in-out property <[Fact]> facts;
    in-out property <[int]> task-picks;
    in-out property <[Fact]> reward-facts;
    in-out property <[Hit]> chain-prev;
    in-out property <[Hit]> chain-next;
    in-out property <string> quest-npc: "";
    in-out property <string> sheet-title;
    in-out property <string> sheet-alt;
    in-out property <string> sheet-code;
    in-out property <string> sheet-note;
    in-out property <image> item-icon;
    in-out property <bool> show-icon;
    in-out property <image> battle-icon;
    in-out property <bool> show-battle: false;
    in-out property <image> element-icon;
    in-out property <bool> show-element: false;
    in-out property <bool> copied: false;
    in-out property <string> ship: "";
    in-out property <string> client-version: "V3.4220";
    in-out property <bool> favourites-only: false;
    in-out property <bool> stick-cursor: false;
    in-out property <bool> viewing-monster: false;
    in-out property <bool> monster-gallery: false;
    in-out property <bool> viewing-recipe: false;
    in-out property <bool> viewing-quest: false;
    in-out property <bool> viewing-npc: false;
    in-out property <bool> viewing-hero: false;
    in-out property <bool> viewing-item: false;
    in-out property <bool> viewing-set: false;
    in-out property <string> item-tab: "";
    in-out property <string> item-source: "";
    in-out property <string> source-note: "";
    in-out property <int> source-note-lines: 0;
    in-out property <[Hit]> sources;
    in-out property <bool> viewing-favourite: false;
    in-out property <bool> viewing-no-image: false;
    property <string> no-image-label: lang == "en-zh" ? "No image" : "沒有圖片";
    in-out property <int> cursor: 0;
    in-out property <int> task-focus: -1;
    in-out property <int> next-focus: -1;
    in-out property <int> home-cursor: 0;
    in-out property <int> icon-size: 1;
    in-out property <[int]> home-order: [0, 1, 2, 3, 4, 5, 6, 7, 8];
    in-out property <[int]> dock-order: [0, 1, 2, 3, 4, 5, 6, 7, 8];
    in-out property <[int]> dock-draft: [0, 1, 2, 3, 4, 5, 6, 7, 8];
    in-out property <[int]> dock-shown: [0, 1, 2, 3, 4, 5, 6, 7, 8];
    in-out property <bool> dock-editing: false;
    in-out property <bool> nav-editing: false;
    in-out property <int> settings-tab: 0;
    in-out property <bool> arranging: false;
    in-out property <int> hotkey-nth: 0;
    property <length> home-pad: 16px;
    property <length> home-gap: 12px;
    property <length> icon-base: icon-size == 0 ? 72px : icon-size == 2 ? 168px : 96px;
    property <int> home-span: max(1, min(root.home-order.length, max(1, round(max(root.pane-w - 16px, 40px) / (root.icon-base + root.home-gap) - 0.5))));
    in-out property <int> saved-cursor: 0;
    in-out property <length> list-offset: 0px;
    property <length> directory-offset: 0px;
    property <length> directory-view: max(root.list-view - root.filter-h - 32px, 1px);
    in-out property <length> drop-offset: 0px;
    in-out property <length> task-offset: 0px;
    in-out property <length> form-offset: 0px;
    in-out property <length> form-body: 0px;
    property <length> form-span: max(form-body - item-form-h, 0px);
    in-out property <bool> show-item-fx: false;
    in-out property <bool> show-set-fx: false;
    in-out property <bool> show-total-fx: false;
    in-out property <bool> has-item-fx: false;
    in-out property <bool> has-set-fx: false;
    in-out property <bool> has-total-fx: false;
    in-out property <int> fold-focus: 0;
    property <length> item-fold-y: 0px;
    property <length> set-fold-y: 0px;
    property <length> total-fold-y: 0px;
    in-out property <length> quest-facts-body: 0px;
    callback query-changed(string, string);
    callback open-hit(string);
    callback source-changed(string);
    callback restore-view() -> bool;
    callback forget-view();
    callback request-close();
    callback went-home();
    callback home-open(string);
    callback lang-changed(string);
    callback collapse-changed(bool);
    callback copy-note();
    callback toggle-favourite(string);
    callback dock-changed(bool, bool, bool, bool, bool, bool, bool, bool, bool, bool);
    callback home-reordered(int, int);
    callback icon-size-set(int);
    callback dock-shift(int, int);
    callback dock-moved(int, int);
    callback dock-park();
    callback dock-order-save();
    callback dock-order-cancel();
    callback opacity-changed(float);
    callback show-set-extra-changed(bool);
    callback pin-changed(int);
    callback battle-changed(bool);
    callback gallery-changed(bool);
    callback animate-changed(bool);
    callback hotkeys-changed(bool);
    callback alias-save();
    callback alias-cancel();
    callback alias-add();
    callback alias-remove(int);
    callback alias-name(int, string);
    callback alias-codes(int, string);
    callback alias-query(int, string);
    callback alias-commit(int, string);
    callback alias-finish(int);
    callback alias-toggle(int);
    callback alias-drop(int, string);
    callback alias-refresh();
    in-out property <int> alias-edit: -1;
    in-out property <[AliasRow]> alias-rows;
    in-out property <[Hit]> alias-icons;
    in-out property <[Hit]> alias-hits;
    in-out property <int> alias-pick: 0;
    in-out property <int> alias-target: -1;
    in-out property <float> window-opacity: 1;
    in-out property <bool> show-set-extra: false;
    property <int> opacity-percent: round(root.window-opacity * 100);
    in-out property <bool> dock-vertical: false;
    in-out property <bool> dock-monster: true;
    in-out property <bool> dock-item: true;
    in-out property <bool> dock-recipe: true;
    in-out property <bool> dock-quest: true;
    in-out property <bool> dock-patch: true;
    in-out property <bool> dock-npc: true;
    in-out property <bool> dock-hero: true;
    in-out property <bool> dock-works: true;
    in-out property <bool> dock-atlas: true;
    in-out property <string> hero-group: "rank";
    in-out property <image> hero-logo;
    in-out property <bool> hero-logo-ready: false;

    title: "巨商";
    no-frame: true;
    always-on-top: pin-top == 1 || (pin-top == 0 && !full-mode);
    icon: @image-url("app-icon.png");
    in property <string> ui-font: "Microsoft JhengHei UI";
    default-font-family: root.ui-font;
    default-font-size: 14px;
    default-font-weight: 400;
    background: transparent;
    preferred-width: 560px;
    preferred-height: 740px;
    resize-border-width: 6px;

    function open-category(id: string) {
        root.category = id;
        root.nation = "";
        root.nation-name = "";
        root.area = "";
        root.area-name = "";
        root.place = "";
        root.place-name = "";
        root.viewing = "";
        root.query = "";
        root.search-open = false;
        root.favourites-only = false;
        root.ship = "";
        root.query-changed(id, "");
    }

    function quest-type-index() -> int {
        if (root.area == "0") { return 1; }
        if (root.area == "2") { return 2; }
        if (root.area == "5") { return 3; }
        if (root.area == "7") { return 4; }
        return 0;
    }

    function cycle-set-type(step: int) {
        if (!root.set-browser) {
            return;
        }
        if (root.area == "" || root.area == "0") {
            root.area = step > 0 ? "2" : "1";
        } else if (root.area == "2") {
            root.area = step > 0 ? "1" : "0";
        } else {
            root.area = step > 0 ? "0" : "2";
        }
        root.cursor = 0;
        root.list-offset = 0px;
        root.query-changed(root.category, root.query);
    }

    function cycle-quest-type(step: int) {
        if (root.category != "quest" || root.place != "main" || root.viewing != "") {
            return;
        }
        let index = root.quest-type-index();
        if (step > 0) {
            if (index == 0) { root.area = "0"; }
            else if (index == 1) { root.area = "2"; }
            else if (index == 2) { root.area = "5"; }
            else if (index == 3) { root.area = "7"; }
            else { root.area = ""; }
        } else if (index == 0) {
            root.area = "7";
        } else if (index == 1) {
            root.area = "";
        } else if (index == 2) {
            root.area = "0";
        } else if (index == 3) {
            root.area = "2";
        } else {
            root.area = "5";
        }
        root.query-changed(root.category, root.query);
    }

    function set-item-tab(mode: string) {
        if (!root.viewing-item) {
            return;
        }
        root.item-tab = mode;
        root.drop-offset = 0px;
        root.form-offset = 0px;
        root.cursor = 0;
    }

    function scroll-form(dir: int) {
        if (!root.viewing-item || root.item-links) {
            return;
        }
        let span = root.form-span;
        let next = root.form-offset - dir * 44px;
        if (next > 0px) {
            root.form-offset = 0px;
        } else if (next < -span) {
            root.form-offset = -span;
        } else {
            root.form-offset = next;
        }
    }

    function fold-row(key: string) -> bool {
        key == "fold:item" || key == "fold:set" || key == "fold:total"
    }

    function fold-open(key: string) -> bool {
        key == "fold:item" ? root.show-item-fx : key == "fold:set" ? root.show-set-fx : root.show-total-fx
    }

    function section-open(section: string) -> bool {
        section == "item" ? root.show-item-fx : section == "set" ? root.show-set-fx : section == "total" ? root.show-total-fx : true
    }

    function focus-fold(key: string) {
        if (key == "fold:item") {
            root.fold-focus = 0;
        } else if (key == "fold:set") {
            root.fold-focus = 1;
        } else if (key == "fold:total") {
            root.fold-focus = 2;
        }
    }

    function toggle-fold(key: string) {
        if (key == "fold:item") {
            root.show-item-fx = !root.show-item-fx;
        } else if (key == "fold:set") {
            root.show-set-fx = !root.show-set-fx;
        } else if (key == "fold:total") {
            root.show-total-fx = !root.show-total-fx;
        }
        root.reveal-fold();
    }

    function toggle-fold-focus() {
        if (root.fold-focus == 0 && root.has-item-fx) {
            root.show-item-fx = !root.show-item-fx;
        } else if (root.fold-focus == 1 && root.has-set-fx) {
            root.show-set-fx = !root.show-set-fx;
        } else if (root.fold-focus == 2 && root.has-total-fx) {
            root.show-total-fx = !root.show-total-fx;
        }
        root.reveal-fold();
    }

    function step-fold(delta: int) {
        if (delta > 0) {
            if (root.fold-focus <= 0 && root.has-set-fx) {
                root.fold-focus = 1;
            } else if (root.fold-focus <= 1 && root.has-total-fx) {
                root.fold-focus = 2;
            }
        } else if (root.fold-focus >= 2 && root.has-set-fx) {
            root.fold-focus = 1;
        } else if (root.fold-focus >= 1 && root.has-item-fx) {
            root.fold-focus = 0;
        }
        root.reveal-fold();
    }

    function reveal-fold() {
        if (!root.viewing-set || root.item-links) {
            return;
        }
        let y = root.fold-focus == 1 ? root.set-fold-y : root.fold-focus == 2 ? root.total-fold-y : root.item-fold-y;
        let view = root.item-form-h;
        if (view < 40px) {
            return;
        }
        let top = -root.form-offset;
        if (y < top + 4px) {
            root.form-offset = -max(y - 4px, 0px);
        } else if (y + 40px > top + view) {
            root.form-offset = -(y + 40px - view);
        }
        if (root.form-offset > 0px) {
            root.form-offset = 0px;
        }
    }

    function set-hero-group(mode: string) {
        if (root.category != "hero" || root.viewing != "") {
            return;
        }
        root.hero-group = mode;
        root.place = "";
        root.place-name = "";
        root.area = "";
        root.area-name = "";
        root.query = "";
        root.search-open = false;
        root.query-changed("hero", "");
    }

    function toggle-saved() {
        if (root.category != "monster") {
            return;
        }
        root.favourites-only = !root.favourites-only;
        root.query-changed(root.category, root.query);
    }

    function mark-favourite() {
        if (root.viewing-monster) {
            root.toggle-favourite(root.viewing);
            return;
        }
        if (root.viewing == "" && root.cursor >= 0 && root.cursor < root.hits.length && root.hits[root.cursor].can-favourite) {
            root.toggle-favourite(root.hits[root.cursor].key);
            return;
        }
        root.activate();
    }

    function close-settings() {
        if (root.dock-editing) {
            root.dock-order-cancel();
            root.dock-editing = false;
        }
        root.settings-open = false;
    }

    function cycle-settings(delta: int) {
        if (root.settings-tab == 2) {
            root.alias-edit = -1;
            root.alias-hits = [];
            root.alias-target = -1;
        }
        root.settings-tab = root.settings-tab + delta;
        if (root.settings-tab > 3) {
            root.settings-tab = 0;
        }
        if (root.settings-tab < 0) {
            root.settings-tab = 3;
        }
        if (root.settings-tab == 2) {
            root.alias-refresh();
        }
    }

    function go-home() {
        if (root.collapsed) {
            root.collapsed = false;
        }
        if (root.settings-open) {
            root.close-settings();
        }
        root.search-open = false;
        root.arranging = false;
        if (root.category == "" && root.viewing == "") {
            keys.focus();
            return;
        }
        root.category = "";
        root.nation = "";
        root.nation-name = "";
        root.area = "";
        root.area-name = "";
        root.place = "";
        root.place-name = "";
        root.viewing = "";
        root.viewing-monster = false;
        root.viewing-recipe = false;
        root.viewing-quest = false;
        root.viewing-npc = false;
        root.viewing-item = false;
        root.viewing-set = false;
        root.item-tab = "";
        root.viewing-favourite = false;
        root.query = "";
        root.detail = "";
        root.show-icon = false;
        root.show-battle = false;
        root.show-element = false;
        root.form-open = false;
        root.drops-open = false;
        root.related-open = false;
        root.went-home();
        keys.focus();
    }

    function choose-lang(code: string) {
        root.lang = code;
        root.lang-changed(code);
    }

    function choose-pin(mode: int) {
        root.pin-top = mode;
        root.pin-changed(mode);
    }

    function choose-battle(battle: bool) {
        if (root.battle-view == battle) {
            return;
        }
        root.battle-view = battle;
        root.battle-changed(battle);
    }

    function choose-gallery(on: bool) {
        if (root.monster-gallery == on) {
            return;
        }
        root.monster-gallery = on;
        root.gallery-changed(on);
        if (root.category == "monster" && root.viewing == "" && !root.full-mode) {
            root.list-offset = 0px;
            root.query-changed(root.category, root.query);
        }
    }

    function choose-animate(on: bool) {
        if (root.animate-battle == on) {
            return;
        }
        root.animate-battle = on;
        root.animate-changed(on);
    }

    function choose-hotkeys(on: bool) {
        if (root.hotkeys-on == on) {
            return;
        }
        root.hotkeys-on = on;
        root.hotkeys-changed(on);
    }

    function go-back() {
        if (root.viewing != "") {
            if (root.restore-view()) {
                return;
            }
            root.forget-view();
            root.viewing = "";
            root.viewing-monster = false;
            root.viewing-recipe = false;
            root.viewing-quest = false;
            root.viewing-npc = false;
            root.viewing-hero = false;
            root.viewing-item = false;
            root.viewing-set = false;
            root.item-tab = "";
            root.viewing-favourite = false;
            root.detail = "";
            root.show-icon = false;
            root.show-battle = false;
            root.show-element = false;
        } else if (root.category == "quest" && root.area != "") {
            root.search-open = false;
            root.area = "";
            root.query = "";
            root.detail = "";
            root.show-icon = false;
            root.show-element = false;
            root.query-changed("quest", "");
        } else if (root.category == "quest" && root.place != "") {
            root.search-open = false;
            root.place = "";
            root.place-name = "";
            root.area = "";
            root.query = "";
            root.detail = "";
            root.show-icon = false;
            root.show-element = false;
            root.query-changed("quest", "");
        } else if (root.category == "atlas" && root.area != "") {
            root.search-open = false;
            root.area = "";
            root.area-name = "";
            root.query = "";
            root.detail = "";
            root.show-icon = false;
            root.show-element = false;
            root.query-changed("atlas", "");
        } else if (root.category == "atlas" && root.place != "") {
            root.search-open = false;
            root.place = "";
            root.place-name = "";
            root.query = "";
            root.detail = "";
            root.show-icon = false;
            root.show-element = false;
            root.query-changed("atlas", "");
        } else if (root.category == "works" && root.area != "") {
            root.search-open = false;
            root.area = "";
            root.area-name = "";
            root.query = "";
            root.detail = "";
            root.show-icon = false;
            root.show-element = false;
            root.query-changed("works", "");
        } else if (root.category == "works" && root.place != "") {
            root.search-open = false;
            root.place = "";
            root.place-name = "";
            root.query = "";
            root.detail = "";
            root.show-icon = false;
            root.show-element = false;
            root.query-changed("works", "");
        } else if (root.category == "hero" && root.area != "") {
            root.search-open = false;
            root.area = "";
            root.area-name = "";
            root.query = "";
            root.detail = "";
            root.show-icon = false;
            root.show-element = false;
            root.query-changed("hero", "");
        } else if (root.category == "hero" && root.place != "") {
            root.search-open = false;
            root.place = "";
            root.place-name = "";
            root.query = "";
            root.detail = "";
            root.show-icon = false;
            root.show-element = false;
            root.query-changed("hero", "");
        } else if (root.category == "item" && root.area != "" && root.place != "set") {
            root.search-open = false;
            root.area = "";
            root.area-name = "";
            root.query = "";
            root.detail = "";
            root.show-icon = false;
            root.show-element = false;
            root.query-changed("item", "");
        } else if (root.category == "item" && root.place != "") {
            root.search-open = false;
            root.place = "";
            root.place-name = "";
            root.area = "";
            root.area-name = "";
            root.query = "";
            root.detail = "";
            root.show-icon = false;
            root.show-element = false;
            root.query-changed("item", "");
        } else if (root.category == "recipe" && root.place != "") {
            root.search-open = false;
            root.place = "";
            root.place-name = "";
            root.query = "";
            root.detail = "";
            root.show-icon = false;
            root.show-element = false;
            root.viewing-recipe = false;
            root.query-changed("recipe", "");
        } else if (root.category == "monster" && root.place != "") {
            root.search-open = false;
            root.place = "";
            root.place-name = "";
            root.query = "";
            root.detail = "";
            root.show-icon = false;
            root.show-element = false;
            root.query-changed("monster", "");
        } else if (root.category == "monster" && root.area != "") {
            root.search-open = false;
            root.area = "";
            root.area-name = "";
            root.query = "";
            root.detail = "";
            root.show-icon = false;
            root.show-element = false;
            root.query-changed("monster", "");
        } else if (root.category == "monster" && root.nation != "") {
            root.search-open = false;
            root.nation = "";
            root.nation-name = "";
            root.area = "";
            root.area-name = "";
            root.query = "";
            root.detail = "";
            root.show-icon = false;
            root.show-element = false;
            root.query-changed("monster", "");
        } else if (root.category != "") {
            root.search-open = false;
            root.category = "";
            root.nation = "";
            root.nation-name = "";
            root.area = "";
            root.area-name = "";
            root.place = "";
            root.place-name = "";
            root.viewing = "";
            root.query = "";
            root.detail = "";
            root.show-icon = false;
            root.show-element = false;
            root.went-home();
            keys.focus();
        }
    }

    function list-count() -> int {
        if (root.viewing == "") {
            return root.hits.length;
        }
        if (root.viewing-monster && root.related-open) {
            return root.related.length;
        }
        if (root.viewing != "" && root.viewing-monster && !root.drops-open) {
            return 0;
        }
        return root.links.length;
    }

    function reveal-list(index: int) {
        if (root.hits.length == 0) {
            return;
        }
        if (root.monster-board) {
            let row = index * 32px;
            let view = root.directory-view;
            let top = -root.directory-offset;
            if (row < top) {
                root.directory-offset = -row;
            } else if (row + 28px > top + view) {
                root.directory-offset = view - row - 28px;
            }
            root.directory-offset = clamp(root.directory-offset, min(0px, view - root.hits.length * 32px + 4px), 0px);
            return;
        }
        if (root.full-board) {
            let stride = root.full-flat ? 60px : 50px;
            let row-height = stride - 2px;
            let row = index * stride;
            let view = max(root.list-view - (root.full-flat ? 56px : 16px), 1px);
            let offset = root.full-flat ? root.list-offset : root.directory-offset;
            let top = -offset;
            let next = row < top ? -row : row + row-height > top + view ? view - row - row-height : offset;
            let bounded = clamp(next, min(0px, view - root.hits.length * stride + 2px), 0px);
            if (root.full-flat) {
                root.list-offset = bounded;
            } else {
                root.directory-offset = bounded;
            }
            return;
        }
        let row = index * root.list-row;
        let view = root.list-view;
        let top = -root.list-offset;
        if (row < top) {
            root.list-offset = -row;
        } else if (row + root.list-row > top + view) {
            root.list-offset = view - row - root.list-row;
        }
        let floor = min(0px, view - root.hits.length * root.list-row);
        if (root.list-offset < floor) {
            root.list-offset = floor;
        }
        if (root.list-offset > 0px) {
            root.list-offset = 0px;
        }
    }

    function reveal-drops(index: int) {
        let related-list = root.viewing-monster && root.related-open;
        let count = related-list ? root.related.length : root.links.length;
        if (count == 0) {
            return;
        }
        let stride = related-list ? 52px : root.card-sheet ? root.link-row : 36px;
        let row = index * stride;
        let view = related-list ? root.related-list-h : root.monster-sheet ? root.drops-list-h : root.viewing-hero ? max(root.height - root.foot - 136px, 180px) : root.quest-sheet ? root.quest-scalar-h : root.card-sheet ? root.card-list-h : root.drops-view;
        let tail = root.quest-sheet ? root.reward-facts.length * 30px : 0px;
        let top = -root.drop-offset;
        if (row < top) {
            root.drop-offset = -row;
        } else if (row + stride > top + view) {
            root.drop-offset = view - row - stride;
        }
        let floor = min(0px, view - tail - count * stride);
        if (root.drop-offset < floor) {
            root.drop-offset = floor;
        }
        if (root.drop-offset > 0px) {
            root.drop-offset = 0px;
        }
    }

    function reveal-task(index: int) {
        if (root.facts.length == 0 || index < 0) {
            return;
        }
        let count = max(root.facts.length, 1);
        let body = max(root.quest-facts-body, count * root.quest-fact-row);
        let row-h = body / count;
        let row = index * row-h;
        let view = root.quest-form-h;
        let top = -root.task-offset;
        if (row < top) {
            root.task-offset = -row;
        } else if (row + row-h > top + view) {
            root.task-offset = view - row - row-h;
        }
        let floor = min(0px, view - body);
        if (root.task-offset < floor) {
            root.task-offset = floor;
        }
        if (root.task-offset > 0px) {
            root.task-offset = 0px;
        }
    }

    pure function task-picked(index: int) -> bool {
        if (root.task-focus < 0 || root.task-focus >= root.task-picks.length) {
            return false;
        }
        return root.task-picks[root.task-focus] == index;
    }

    function focus-task(index: int) {
        root.task-focus = index;
        root.next-focus = -1;
    }

    function focus-reward(index: int) {
        root.task-focus = -1;
        root.next-focus = -1;
        root.cursor = index;
        root.reveal-drops(index);
    }

    function move-quest(delta: int) {
        if (root.task-focus >= root.task-picks.length) {
            root.task-focus = -1;
        }
        if (root.task-focus >= 0) {
            if (delta < 0) {
                if (root.task-focus > 0) {
                    root.focus-task(root.task-focus - 1);
                }
                return;
            }
            if (root.task-focus + 1 < root.task-picks.length) {
                root.focus-task(root.task-focus + 1);
                return;
            }
            if (root.links.length > 0) {
                root.focus-reward(0);
                return;
            }
            if (root.chain-next.length > 1) {
                root.task-focus = -1;
                root.next-focus = 0;
                return;
            }
            return;
        }
        if (root.next-focus >= 0) {
            let next = root.next-focus + delta;
            if (next < 0) {
                root.next-focus = -1;
                if (root.links.length > 0) {
                    root.focus-reward(root.links.length - 1);
                    return;
                }
                if (root.task-picks.length > 0) {
                    root.focus-task(root.task-picks.length - 1);
                }
                return;
            }
            if (next >= root.chain-next.length) {
                return;
            }
            root.next-focus = next;
            return;
        }
        if (root.links.length == 0) {
            if (delta < 0 && root.task-picks.length > 0) {
                root.focus-task(root.task-picks.length - 1);
                return;
            }
            if (delta > 0 && root.task-picks.length > 0) {
                root.focus-task(0);
                return;
            }
            if (delta > 0 && root.chain-next.length > 1) {
                root.next-focus = 0;
            }
            return;
        }
        let next = root.cursor + delta;
        if (next < 0) {
            if (root.task-picks.length > 0) {
                root.focus-task(root.task-picks.length - 1);
            }
            return;
        }
        if (next >= root.links.length) {
            if (delta > 0 && root.chain-next.length > 1) {
                root.task-focus = -1;
                root.next-focus = 0;
            }
            return;
        }
        root.focus-reward(next);
    }

    function move-list(delta: int) {
        if (root.quest-sheet) {
            root.move-quest(delta);
            return;
        }
        if (root.list-count() <= 0) {
            return;
        }
        root.cursor = root.cursor + delta;
        if (root.cursor < 0) {
            root.cursor = 0;
        }
        if (root.cursor >= root.list-count()) {
            root.cursor = root.list-count() - 1;
        }
        if (root.viewing == "") {
            root.reveal-list(root.cursor);
        } else {
            root.reveal-drops(root.cursor);
        }
    }

    function dock-on(index: int) -> bool {
        if (index == 0) { return root.dock-monster; }
        if (index == 1) { return root.dock-item; }
        if (index == 2) { return root.dock-recipe; }
        if (index == 3) { return root.dock-quest; }
        if (index == 4) { return root.dock-patch; }
        if (index == 5) { return root.dock-npc; }
        if (index == 6) { return root.dock-hero; }
        if (index == 7) { return root.dock-works; }
        if (index == 8) { return root.dock-atlas; }
        return false;
    }

    function toggle-dock(index: int) {
        if (index == 0) { root.dock-monster = !root.dock-monster; }
        else if (index == 1) { root.dock-item = !root.dock-item; }
        else if (index == 2) { root.dock-recipe = !root.dock-recipe; }
        else if (index == 3) { root.dock-quest = !root.dock-quest; }
        else if (index == 4) { root.dock-patch = !root.dock-patch; }
        else if (index == 5) { root.dock-npc = !root.dock-npc; }
        else if (index == 6) { root.dock-hero = !root.dock-hero; }
        else if (index == 7) { root.dock-works = !root.dock-works; }
        else if (index == 8) { root.dock-atlas = !root.dock-atlas; }
        else { return; }
        root.publish-dock();
        root.dock-park();
    }

    function category-short(index: int) -> string {
        if (index == 0) { return root.lang == "en-zh" ? "Monsters" : "怪物"; }
        if (index == 1) { return root.lang == "en-zh" ? "Items" : "道具"; }
        if (index == 2) { return root.lang == "en-zh" ? "Crafting" : "合成"; }
        if (index == 3) { return root.lang == "en-zh" ? "Quests" : "任務"; }
        if (index == 4) { return root.lang == "en-zh" ? "Updates" : "更新"; }
        if (index == 5) { return "NPC"; }
        if (index == 6) { return root.lang == "en-zh" ? "Roster" : "角色"; }
        if (index == 7) { return root.lang == "en-zh" ? "Production" : "生產"; }
        return root.lang == "en-zh" ? "Shop" : "商店";
    }

    function home-at(cat: int) -> int {
        if (root.home-order[0] == cat) { return 0; }
        if (root.home-order[1] == cat) { return 1; }
        if (root.home-order[2] == cat) { return 2; }
        if (root.home-order[3] == cat) { return 3; }
        if (root.home-order[4] == cat) { return 4; }
        if (root.home-order[5] == cat) { return 5; }
        if (root.home-order[6] == cat) { return 6; }
        if (root.home-order[7] == cat) { return 7; }
        if (root.home-order[8] == cat) { return 8; }
        return 0;
    }

    function dock-at(cat: int) -> int {
        if (root.dock-order[0] == cat) { return 0; }
        if (root.dock-order[1] == cat) { return 1; }
        if (root.dock-order[2] == cat) { return 2; }
        if (root.dock-order[3] == cat) { return 3; }
        if (root.dock-order[4] == cat) { return 4; }
        if (root.dock-order[5] == cat) { return 5; }
        if (root.dock-order[6] == cat) { return 6; }
        if (root.dock-order[7] == cat) { return 7; }
        if (root.dock-order[8] == cat) { return 8; }
        return 0;
    }

    function visible-index(cat: int) -> int {
        if (!root.dock-on(cat)) { return 0; }
        let at = root.dock-at(cat);
        return 1
            + (at > 0 && root.dock-on(root.dock-order[0]) ? 1 : 0)
            + (at > 1 && root.dock-on(root.dock-order[1]) ? 1 : 0)
            + (at > 2 && root.dock-on(root.dock-order[2]) ? 1 : 0)
            + (at > 3 && root.dock-on(root.dock-order[3]) ? 1 : 0)
            + (at > 4 && root.dock-on(root.dock-order[4]) ? 1 : 0)
            + (at > 5 && root.dock-on(root.dock-order[5]) ? 1 : 0)
            + (at > 6 && root.dock-on(root.dock-order[6]) ? 1 : 0)
            + (at > 7 && root.dock-on(root.dock-order[7]) ? 1 : 0)
            + (at > 8 && root.dock-on(root.dock-order[8]) ? 1 : 0);
    }

    function advance-dock(pos: int, offset: int) {
        let next = pos + offset;
        if (next < 0 || next >= root.dock-order.length) { return; }
        if (root.home-cursor == root.dock-order[pos] && root.dock-on(root.dock-order[next])) {
            root.home-cursor = root.dock-order[next];
        }
    }

    function step-dock(delta: int) {
        if (delta == 0) { return; }
        let pos = root.dock-at(root.home-cursor);
        if (delta > 0) {
            root.advance-dock(pos, 1);
            root.advance-dock(pos, 2);
            root.advance-dock(pos, 3);
            root.advance-dock(pos, 4);
            root.advance-dock(pos, 5);
            root.advance-dock(pos, 6);
            root.advance-dock(pos, 7);
            root.advance-dock(pos, 8);
        } else {
            root.advance-dock(pos, -1);
            root.advance-dock(pos, -2);
            root.advance-dock(pos, -3);
            root.advance-dock(pos, -4);
            root.advance-dock(pos, -5);
            root.advance-dock(pos, -6);
            root.advance-dock(pos, -7);
            root.advance-dock(pos, -8);
        }
    }

    function open-nth-visible(n: int) {
        root.try-open(0, n);
        root.try-open(1, n);
        root.try-open(2, n);
        root.try-open(3, n);
        root.try-open(4, n);
        root.try-open(5, n);
        root.try-open(6, n);
        root.try-open(7, n);
        root.try-open(8, n);
    }

    function try-open(pos: int, n: int) {
        if (pos < 0 || pos >= root.dock-order.length) {
            return;
        }
        if (root.visible-index(root.dock-order[pos]) == n) {
            root.open-dock(root.dock-order[pos]);
        }
    }

    function move-home(dx: int, dy: int) {
        let pos = root.home-at(root.home-cursor);
        let cols = root.home-span;
        let row = floor(pos / cols);
        let col = pos - row * cols;
        let ncol = col + dx;
        let nrow = row + dy;
        if (ncol < 0 || ncol >= cols || nrow < 0) {
            return;
        }
        let next = nrow * cols + ncol;
        if (next >= 0 && next < root.home-order.length) {
            root.home-cursor = root.home-order[next];
        }
    }

    function grid-slot(ax: length, ay: length, origin-x: length, origin-y: length, tile-w: length, tile-h: length, gap: length, cols: int, count: int) -> int {
        if (tile-w <= 1px || tile-h <= 1px || ax < origin-x || ay < origin-y) {
            return -1;
        }
        let col = round((ax - origin-x) / (tile-w + gap) - 0.5);
        let row = round((ay - origin-y) / (tile-h + gap) - 0.5);
        if (col < 0 || row < 0 || col >= cols) {
            return -1;
        }
        let index = row * cols + col;
        if (index < 0 || index >= count) {
            return -1;
        }
        return index;
    }

    function category-logo(index: int) -> image {
        if (index == 0) { return @image-url("icons/monster.png"); }
        if (index == 1) { return @image-url("icons/item.png"); }
        if (index == 2) { return @image-url("icons/recipe.png"); }
        if (index == 3) { return @image-url("icons/quest.png"); }
        if (index == 4) { return @image-url("logo.png"); }
        if (index == 5) { return @image-url("icons/npc.png"); }
        if (index == 6) { return root.hero-logo-ready ? root.hero-logo : @image-url("logo.png"); }
        if (index == 7) { return @image-url("icons/works.png"); }
        return @image-url("icons/shop.png");
    }

    function category-glyph(index: int) -> string {
        if (index == 6 && !root.hero-logo-ready) { return "將"; }
        return "";
    }

    function publish-dock() {
        root.dock-changed(root.dock-vertical, root.dock-monster, root.dock-item, root.dock-recipe, root.dock-quest, root.dock-patch, root.dock-npc, root.dock-hero, root.dock-works, root.dock-atlas);
    }

    function open-dock(index: int) {
        if (!root.dock-on(index)) { return; }
        root.home-cursor = index;
        if (root.settings-open) {
            root.close-settings();
        }
        root.collapsed = false;
        root.open-category(root.categories[index].id);
    }

    function activate() {
        if (root.collapsed) {
            root.open-dock(root.home-cursor);
            return;
        }
        if (root.category == "") {
            if (root.arranging) {
                return;
            }
            root.open-category(root.categories[root.home-cursor].id);
            return;
        }
        if (root.viewing == "") {
            if (root.cursor >= 0 && root.cursor < root.hits.length) {
                if (root.monster-board || (root.full-board && root.hits[root.cursor].chip == "label")) {
                    root.list-offset = 0px;
                    root.toggle-board(root.hits[root.cursor].key);
                } else if (root.full-board) {
                    root.toggle-detail(root.hits[root.cursor].key, root.cursor);
                } else {
                    root.open-hit(root.hits[root.cursor].key);
                }
            }
            return;
        }
        if (root.viewing-monster && root.related-open) {
            if (root.cursor >= 0 && root.cursor < root.related.length && root.related[root.cursor].key != "") {
                root.open-hit(root.related[root.cursor].key);
            }
            return;
        }
        if (root.viewing-monster && !root.drops-open) {
            return;
        }
        if (root.quest-sheet && root.next-focus >= 0 && root.next-focus < root.chain-next.length) {
            root.open-hit(root.chain-next[root.next-focus].key);
            return;
        }
        if (root.quest-sheet && root.task-focus >= 0) {
            if (root.task-focus < root.task-picks.length) {
                let index = root.task-picks[root.task-focus];
                if (index >= 0 && index < root.facts.length && root.facts[index].key != "") {
                    root.open-hit(root.facts[index].key);
                }
            }
            return;
        }
        if ((root.item-links || root.viewing-hero) && root.cursor >= 0 && root.cursor < root.links.length && root.links[root.cursor].chip == "section") {
            root.source-changed(root.links[root.cursor].key);
            return;
        }
        if (root.cursor >= 0 && root.cursor < root.links.length && root.links[root.cursor].key != "") {
            root.open-hit(root.links[root.cursor].key);
        }
    }

    function open-prev() {
        if (root.chain-prev.length > 0) {
            root.open-hit(root.chain-prev[0].key);
        }
    }

    function open-next() {
        if (root.chain-next.length == 0) {
            return;
        }
        if (root.next-focus >= 0 && root.next-focus < root.chain-next.length) {
            root.open-hit(root.chain-next[root.next-focus].key);
            return;
        }
        root.open-hit(root.chain-next[0].key);
    }

    function shrink-window() {
        root.collapsed = !root.collapsed;
    }

    function handle-key(event: KeyEvent) -> EventResult {
        if (event.modifiers.control && event.text == "-") {
            root.shrink-window();
            return accept;
        }
        if (event.text == Key.Home) {
            root.go-home();
            return accept;
        }
        if (root.collapsed) {
            if (event.text == Key.LeftArrow || event.text == Key.UpArrow) {
                root.step-dock(-1);
                return accept;
            }
            if (event.text == Key.RightArrow || event.text == Key.DownArrow) {
                root.step-dock(1);
                return accept;
            }
            if (event.text == Key.Space || event.text == Key.Return) {
                root.open-dock(root.home-cursor);
                return accept;
            }
            if (event.text == Key.Escape) {
                root.collapsed = false;
                return accept;
            }
            return reject;
        }
        if (root.settings-open) {
            if (event.text == Key.Tab || event.text == Key.Backtab) {
                root.cycle-settings(event.text == Key.Tab ? 1 : -1);
                return accept;
            }
            if (event.text == Key.Escape) {
                if (root.alias-hits.length > 0) {
                    root.alias-hits = [];
                    root.alias-target = -1;
                    return accept;
                }
                root.close-settings();
                return accept;
            }
            if (event.text == Key.Backspace && !(root.settings-tab == 2 && root.alias-edit >= 0)) {
                root.close-settings();
                return accept;
            }
            if (root.settings-tab == 2 && root.alias-hits.length > 0 && event.text == Key.UpArrow) {
                root.alias-pick = max(root.alias-pick - 1, 0);
                return accept;
            }
            if (root.settings-tab == 2 && root.alias-hits.length > 0 && event.text == Key.DownArrow) {
                root.alias-pick = min(root.alias-pick + 1, root.alias-hits.length - 1);
                return accept;
            }
            return reject;
        }
        if (event.modifiers.control && (event.text == "f" || event.text == "F")) {
            if (root.viewing == "" && root.category != "") {
                root.search-open = true;
            }
            return accept;
        }
        if ((event.text == Key.Tab || event.text == Key.Backtab) && root.category == "quest" && root.place == "main" && root.viewing == "") {
            root.cycle-quest-type(event.text == Key.Tab ? 1 : -1);
            return accept;
        }
        if ((event.text == Key.Tab || event.text == Key.Backtab) && root.set-browser) {
            root.cycle-set-type(event.text == Key.Tab ? 1 : -1);
            return accept;
        }
        if ((event.text == Key.Tab || event.text == Key.Backtab) && root.category == "hero" && root.viewing == "") {
            root.set-hero-group(root.hero-group == "land" ? "rank" : "land");
            return accept;
        }
        if ((event.text == Key.Tab || event.text == Key.Backtab) && root.viewing-item && root.viewing != "") {
            root.set-item-tab(root.item-tab == "links" ? "" : "links");
            return accept;
        }
        if ((event.text == Key.Tab || event.text == Key.Backtab) && root.category == "monster") {
            root.toggle-saved();
            return accept;
        }
        if (root.category == "" && root.full-mode && root.hits.length > 0) {
            if (event.text == Key.UpArrow) {
                root.cursor = max(root.cursor - 1, 0);
                return accept;
            }
            if (event.text == Key.DownArrow) {
                root.cursor = min(root.cursor + 1, root.hits.length - 1);
                return accept;
            }
            if (event.text == Key.Space || event.text == Key.Return) {
                root.home-open(root.hits[root.cursor].key);
                return accept;
            }
            return reject;
        }
        if (root.category == "" && root.arranging && event.text == Key.Escape) {
            root.arranging = false;
            return accept;
        }
        if (event.text == Key.Escape) {
            if (root.search-open) {
                root.close-search();
            } else {
                root.go-back();
            }
            return accept;
        }
        if (event.text == Key.Backspace) {
            root.go-back();
            return accept;
        }
        if (root.category == "") {
            if (event.text == Key.LeftArrow) {
                root.move-home(-1, 0);
                return accept;
            }
            if (event.text == Key.RightArrow) {
                root.move-home(1, 0);
                return accept;
            }
            if (event.text == Key.UpArrow) {
                root.move-home(0, -1);
                return accept;
            }
            if (event.text == Key.DownArrow) {
                root.move-home(0, 1);
                return accept;
            }
            if (event.text == Key.Space || event.text == Key.Return) {
                root.activate();
                return accept;
            }
            return reject;
        }
        if (root.category == "patch" && root.viewing != "") {
            if (event.text == Key.Escape) {
                root.go-back();
                return accept;
            }
            if (event.modifiers.control && (event.text == "c" || event.text == "C")) {
                root.copy-note();
                return accept;
            }
            return reject;
        }
        if (root.viewing != "" && root.viewing-monster && !root.drops-open && !root.related-open && (event.text == Key.UpArrow || event.text == Key.DownArrow || event.text == Key.LeftArrow || event.text == Key.RightArrow)) {
            root.move-sheet(event.text == Key.DownArrow || event.text == Key.RightArrow ? 1 : -1);
            return accept;
        }
        if (root.viewing != "" && root.viewing-monster && root.drops-open && event.text == Key.LeftArrow) {
            root.drops-open = false;
            root.sheet-focus = root.drops-slot();
            return accept;
        }
        if (root.viewing != "" && root.viewing-monster && root.related-open && event.text == Key.LeftArrow) {
            root.related-open = false;
            root.sheet-focus = root.related-slot();
            return accept;
        }
        if (root.quest-sheet && event.text == Key.LeftArrow) {
            root.open-prev();
            return accept;
        }
        if (root.quest-sheet && event.text == Key.RightArrow) {
            root.open-next();
            return accept;
        }
        if (root.viewing-set && !root.item-links && (event.text == Key.UpArrow || event.text == Key.DownArrow)) {
            root.step-fold(event.text == Key.DownArrow ? 1 : -1);
            return accept;
        }
        if (root.viewing-set && !root.item-links && (event.text == Key.LeftArrow || event.text == Key.RightArrow)) {
            root.scroll-form(event.text == Key.RightArrow ? 1 : -1);
            return accept;
        }
        if (root.viewing-set && !root.item-links && event.text == Key.Space) {
            root.toggle-fold-focus();
            return accept;
        }
        if (root.viewing-item && !root.item-links && (event.text == Key.UpArrow || event.text == Key.DownArrow)) {
            root.scroll-form(event.text == Key.DownArrow ? 1 : -1);
            return accept;
        }
        if (event.text == Key.UpArrow) {
            root.move-list(-1);
            return accept;
        }
        if (event.text == Key.DownArrow) {
            root.move-list(1);
            return accept;
        }
        if (event.text == Key.Space) {
            if (root.viewing != "" && root.viewing-monster && !root.drops-open && !root.related-open) {
                root.toggle-sheet();
                return accept;
            }
            root.activate();
            return accept;
        }
        if (event.text == Key.Return || event.text == "\n") {
            if (root.category == "monster") {
                root.mark-favourite();
            } else {
                root.activate();
            }
            return accept;
        }
        return reject;
    }

    changed hits => {
        root.directory-offset = 0px;
        if (root.stick-cursor) {
            root.stick-cursor = false;
            return;
        }
        root.cursor = 0;
        root.list-offset = 0px;
    }

    changed links => {
        root.drop-offset = 0px;
    }

    changed cursor => {
        if (root.item-links) {
            root.reveal-drops(root.cursor);
        }
    }

    property <bool> in-detail: false;

    changed task-picks => {
        root.task-offset = 0px;
        root.quest-facts-body = 0px;
    }

    changed task-focus => {
        if (root.task-focus < 0 || root.task-focus >= root.task-picks.length) {
            return;
        }
        root.reveal-task(root.task-picks[root.task-focus]);
    }

    changed viewing => {
        root.next-focus = -1;
        root.task-focus = -1;
        root.task-offset = 0px;
        root.form-offset = 0px;
        root.show-item-fx = false;
        root.show-set-fx = false;
        root.show-total-fx = false;
        root.fold-focus = 0;
        if (root.viewing != "") {
            if (!root.in-detail) {
                root.saved-cursor = root.cursor;
            }
            root.in-detail = true;
            root.cursor = 0;
            keys.focus();
        } else {
            root.in-detail = false;
            root.cursor = root.saved-cursor;
            root.reveal-list(root.cursor);
        }
        root.form-open = false;
        root.drops-open = false;
        root.related-open = false;
        root.sheet-focus = 0;
    }

    function drops-slot() -> int {
        return root.links.length > 0 ? 1 : -1;
    }

    function related-slot() -> int {
        if (root.related.length == 0) {
            return -1;
        }
        return root.links.length > 0 ? 2 : 1;
    }

    function move-sheet(delta: int) {
        if (!root.monster-sheet) {
            return;
        }
        let count = 1 + (root.links.length > 0 ? 1 : 0) + (root.related.length > 0 ? 1 : 0);
        root.sheet-focus = root.sheet-focus + delta;
        if (root.sheet-focus < 0) {
            root.sheet-focus = 0;
        }
        if (root.sheet-focus >= count) {
            root.sheet-focus = count - 1;
        }
    }

    function close-search() {
        root.search-open = false;
        if (root.query != "") {
            root.query = "";
            root.cursor = 0;
            root.query-changed(root.category, "");
        }
        keys.focus();
    }

    function toggle-search() {
        if (root.viewing != "" || root.category == "") {
            return;
        }
        if (root.search-open) {
            root.close-search();
        } else {
            root.search-open = true;
        }
    }

    function toggle-sheet() {
        if (!root.monster-sheet) {
            return;
        }
        if (root.sheet-focus == 0) {
            root.form-open = !root.form-open;
            if (root.form-open) {
                root.drops-open = false;
                root.related-open = false;
            }
            return;
        }
        if (root.sheet-focus == root.drops-slot()) {
            root.drops-open = !root.drops-open;
            if (root.drops-open) {
                root.form-open = false;
                root.related-open = false;
                root.drop-offset = 0px;
                root.cursor = 0;
            }
            return;
        }
        root.related-open = !root.related-open;
        if (root.related-open) {
            root.form-open = false;
            root.drops-open = false;
            root.drop-offset = 0px;
            root.cursor = 0;
        }
    }

    in-out property <bool> search-open: false;
    property <bool> set-browser: category == "item" && place == "set" && viewing == "";
    property <bool> monster-cards: category == "monster" && viewing == "" && (place != "" || favourites-only || (hits.length > 0 && hits[0].key.starts-with("monster:")));
    property <bool> monster-board: full-mode && category == "monster" && viewing == "" && place == "" && area == "" && !favourites-only && query == "";
    property <bool> full-board: full-mode && category != "" && category != "monster" && viewing == "" && query == "" && place == "" && area == "";
    property <bool> full-flat: full-board && hits.length > 0 && hits[0].chip != "label";
    property <length> record-row: 72px;
    in-out property <length> board-span: 960px;
    in-out property <[int]> flow-x;
    in-out property <[int]> flow-y;
    in-out property <[int]> flow-w;
    in-out property <int> flow-h: 0;
    callback reflow(length);
    in-out property <bool> menu-open: true;
    in-out property <int> pin-top: 0;
    in-out property <bool> battle-view: true;
    in-out property <bool> animate-battle: true;
    in-out property <bool> hotkeys-on: true;
    in-out property <string> expanded: "";
    in-out property <string> detail-key: "";
    in-out property <int> detail-index: -1;
    in-out property <bool> filter-open: false;
    in-out property <int> filter-element: -1;
    in-out property <string> filter-ela-min: "";
    in-out property <string> filter-ela-max: "";
    in-out property <string> filter-drop: "";
    callback toggle-detail(string, int);
    callback apply-filter(bool);
    in-out property <[Hit]> board-monsters;
    callback toggle-board(string);
    property <length> monster-row: 108px;
    property <int> inline-fact-rows: facts.length == 0 ? 0 : floor((facts.length + 1) / 2);
    property <length> detail-h: detail-index < 0 ? 0px : (facts.length == 0 && links.length == 0 && related.length == 0 ? 180px : 8px + (facts.length > 0 ? inline-fact-rows * 30px + 8px : 0px) + (links.length > 0 || related.length > 0 ? 24px + max(links.length * 36px, related.length * 52px) : 0px));
    property <length> filter-h: filter-open ? 112px : 32px;
    property <bool> filter-active: filter-element >= 0 || filter-ela-min != "" || filter-ela-max != "" || filter-drop != "";
    property <length> board-monsters-h: board-monsters.length * monster-row + detail-h;
    property <length> list-row: full-mode && monster-cards ? 108px : monster-gallery && monster-cards ? 220px : 52px;
    property <length> search-y: category == "patch" ? 128px : set-browser || (category == "monster" && !full-mode) || category == "hero" || (category == "quest" && place == "main") ? 86px : 50px;
    property <length> list-y: full-mode ? search-y + 16px : search-open ? (category == "patch" ? 176px : set-browser || (category == "monster" && !full-mode) || category == "hero" || (category == "quest" && place == "main") ? 132px : 100px) : search-y;
    property <length> foot: 26px;
    property <length> list-view: max(root.height - list-y - 68px, 80px);
    in-out property <bool> form-open: false;
    in-out property <bool> drops-open: false;
    in-out property <bool> related-open: false;
    in-out property <int> sheet-focus: 0;
    property <bool> monster-sheet: viewing-monster && viewing != "" && facts.length > 0;
    property <bool> recipe-sheet: viewing-recipe && viewing != "" && facts.length > 0;
    property <bool> quest-sheet: viewing-quest && viewing != "";
    property <bool> item-sheet: !viewing-hero && !viewing-monster && !viewing-recipe && !viewing-quest && viewing != "" && facts.length > 0;
    property <bool> item-links: viewing-item && viewing != "" && item-tab == "links";
    property <length> link-row: 52px;
    property <bool> record-sheet: item-sheet || recipe-sheet;
    property <bool> card-sheet: record-sheet || quest-sheet;
    property <length> item-icon-y: 56px;
    property <length> item-icon-side: 96px;
    property <length> item-form-y: (sheet-alt == "" ? 206px : 222px) + (viewing-item ? 40px : 0px);
    property <length> item-form-room: max(root.height - foot - item-form-y - 16px, 80px);
    property <length> item-form-h: item-links ? 0px : min(max(form-body, 36px), item-form-room);
    property <length> item-note-h: 0px;
    property <length> source-note-h: item-links && source-note-lines > 0 ? source-note-lines * 22px : 0px;
    property <length> item-list-y: item-links ? item-form-y + source-note-h : item-form-y + item-form-h + item-note-h + 28px;
    property <length> item-list-h: max(root.height - foot - 42px - item-list-y - 16px, 72px);
    property <length> quest-title-y: 56px;
    property <length> quest-code-y: quest-title-y + (sheet-alt == "" ? 26px : 46px);
    property <length> quest-note-y: quest-code-y + 22px;
    property <length> quest-note-h: sheet-note == "" ? 0px : 96px;
    property <bool> quest-has-reward: quest-sheet && (reward-facts.length > 0 || links.length > 0);
    property <length> quest-chain-h: !quest-sheet || (chain-prev.length == 0 && chain-next.length == 0) ? 0px : chain-next.length > 1 ? min(chain-next.length * 44px, 132px) : 52px;
    property <length> chain-w: max((root.pane-w - 36px) / 2, 96px);
    property <length> quest-ask-y: quest-note-y + quest-note-h + 8px;
    property <length> quest-ask-h: facts.length == 0 ? 0px : 20px;
    property <length> quest-form-y: quest-ask-y + quest-ask-h;
    property <length> quest-fact-row: 36px;
    property <length> quest-form-h: !quest-sheet || facts.length == 0 ? 0px : min(max(quest-facts-body, facts.length * quest-fact-row + 2px), 150px);
    property <length> quest-reward-y: quest-form-y + quest-form-h + (quest-has-reward ? 10px : 0px);
    property <length> quest-reward-h: quest-has-reward ? 20px : 0px;
    property <length> quest-scalar-y: quest-reward-y + quest-reward-h;
    property <length> quest-reward-body: reward-facts.length * 30px + links.length * link-row;
    property <length> quest-reward-room: max(root.height - foot - 42px - quest-scalar-y - quest-chain-h - 8px, 0px);
    property <length> quest-scalar-h: !quest-has-reward ? 0px : min(quest-reward-body + 2px, quest-reward-room);
    property <length> quest-list-y: quest-form-y + quest-form-h + 28px;
    property <length> quest-list-h: 0px;
    property <length> card-list-y: quest-sheet ? quest-list-y : item-list-y;
    property <length> card-list-h: quest-sheet ? quest-list-h : item-list-h;
    property <length> side-gap: 14px;
    property <length> portrait-y: 58px;
    property <length> portrait-side: 120px;
    property <length> stage-h: 168px;
    property <bool> battle-picture: show-battle && battle-view;
    property <length> face-side: battle-picture ? 96px : portrait-side;
    property <length> face-x: battle-picture ? side-gap + 8px : side-gap;
    property <length> face-y: battle-picture ? portrait-y + (stage-h - face-side) / 2 : portrait-y;
    property <length> toggle-y: battle-picture ? portrait-y + stage-h + 10px : portrait-y + portrait-side + (sheet-alt == "" ? 62px : 78px);
    property <length> body-room: max(root.height - foot - 42px - toggle-y - 16px, 120px);
    property <length> form-h: min(facts.length * 30px + 2px, body-room - (links.length > 0 ? 52px : 0px) - (related.length > 0 ? 44px : 0px));
    property <length> drops-header-y: form-open ? toggle-y + 52px + form-h : toggle-y + 44px;
    property <length> drops-list-y: drops-header-y + 44px;
    property <length> drops-room: max(root.height - foot - 42px - drops-list-y - (related.length > 0 ? 60px : 12px), 72px);
    property <length> drops-list-h: min(max(links.length * 36px, 36px), drops-room);
    property <length> related-header-y: links.length == 0 ? drops-header-y : drops-open ? drops-list-y + drops-list-h + 8px : drops-header-y + 44px;
    property <length> related-list-y: related-header-y + 44px;
    property <length> related-room: max(root.height - foot - 42px - related-list-y - 12px, 72px);
    property <length> related-list-h: min(max(related.length * 52px, 52px), related-room);
    property <length> stats-y: show-icon ? 124px : 48px;
    property <length> detail-block: links.length > 0 ? 132px : max(root.height - foot - stats-y - 80px, 80px);
    property <length> drops-y: stats-y + detail-block + 4px;
    property <length> drops-view: max(root.height - foot - drops-y - 58px, 48px);

    property <length> dock-side: root.dock-vertical ? min(max(root.width - 28px, 40px), 96px) : min(max(root.height - 28px, 40px), 96px);

    property <[Category]> categories: [
        { id: "monster", name: root.lang == "en-zh" ? "Monsters · 怪物" : "怪物 · Monsters" },
        { id: "item", name: root.lang == "en-zh" ? "Items · 道具" : "道具 · Items" },
        { id: "recipe", name: root.lang == "en-zh" ? "Crafting · 合成" : "合成 · Crafting" },
        { id: "quest", name: root.lang == "en-zh" ? "Quests · 任務" : "任務 · Quests" },
        { id: "patch", name: root.lang == "en-zh" ? "Updates · 更新" : "更新 · Updates" },
        { id: "npc", name: root.lang == "en-zh" ? "NPCs · 人物" : "人物 · NPCs" },
        { id: "hero", name: root.lang == "en-zh" ? "Roster · 角色" : "角色 · Roster" },
        { id: "works", name: root.lang == "en-zh" ? "Production · 生產" : "生產 · Production" },
        { id: "atlas", name: root.lang == "en-zh" ? "Shop · 商店" : "商店 · Shop" },
    ];

    changed full-mode => { DesktopTheme.active = root.full-mode && !root.collapsed; }

    changed collapsed => {
        DesktopTheme.active = root.full-mode && !root.collapsed;
        root.collapse-changed(root.collapsed);
    }

    changed hotkey-nth => {
        if (root.hotkey-nth >= 1) {
            root.open-nth-visible(root.hotkey-nth);
            root.hotkey-nth = 0;
        }
    }

    init => {
        Palette.color-scheme = ColorScheme.dark;
        DesktopTheme.active = root.full-mode && !root.collapsed;
        keys.focus();
    }

    keys := FocusScope {
        width: 100%;
        height: 100%;
        focus-on-click: true;
        key-pressed(event) => {
            return root.handle-key(event);
        }

    Rectangle {
        width: 100%;
        height: 100%;
        opacity: root.window-opacity;
        background: root.collapsed ? transparent : DesktopTheme.canvas;
        border-radius: root.collapsed ? 0px : root.full-mode ? 12px : 20px;
        clip: !root.collapsed;
        border-width: root.collapsed ? 0px : 1px;
        border-color: DesktopTheme.border;

        if root.collapsed: dock-bar := TouchArea {
            width: 100%;
            height: 100%;
            property <bool> moving: false;
            property <length> grab-x: 0px;
            property <length> grab-y: 0px;
            pointer-event(event) => {
                if (event.button == PointerEventButton.right && event.kind == PointerEventKind.up) {
                    root.dock-menu = !root.dock-menu;
                }
                if (event.button == PointerEventButton.left && event.kind == PointerEventKind.down) {
                    self.moving = true;
                    self.grab-x = self.mouse-x;
                    self.grab-y = self.mouse-y;
                    root.dock-menu = false;
                }
                if (event.button == PointerEventButton.left && event.kind == PointerEventKind.up) {
                    self.moving = false;
                }
            }
            moved => {
                if (self.pressed && self.moving) {
                    root.dock-drag(self.mouse-x - self.grab-x, self.mouse-y - self.grab-y);
                }
            }
            Rectangle {
                x: 4px;
                y: 4px;
                width: parent.width - 8px;
                height: parent.height - 8px;
                border-radius: 20px;
                background: #141210d4;
                border-width: 1px;
                border-color: #d4b48355;
                if !root.dock-vertical: HorizontalLayout {
                    padding-left: 12px;
                    padding-right: 12px;
                    spacing: 12px;
                    alignment: center;
                    cross-axis-alignment: center;
                    for slot in root.dock-shown: DockChip {
                        side: root.dock-side;
                        logo: root.category-logo(slot);
                        glyph: root.category-glyph(slot);
                        mark: root.visible-index(slot);
                        selected: root.home-cursor == slot;
                        clicked => { root.dock-menu = false; root.open-dock(slot); }
                        right-clicked => { root.dock-menu = true; }
                    }
                    Rectangle { horizontal-stretch: 1; min-width: 4px; }
                }
                if root.dock-vertical: VerticalLayout {
                    padding-top: 12px;
                    padding-bottom: 12px;
                    spacing: 12px;
                    alignment: center;
                    cross-axis-alignment: center;
                    for slot in root.dock-shown: DockChip {
                        side: root.dock-side;
                        logo: root.category-logo(slot);
                        glyph: root.category-glyph(slot);
                        mark: root.visible-index(slot);
                        selected: root.home-cursor == slot;
                        clicked => { root.dock-menu = false; root.open-dock(slot); }
                        right-clicked => { root.dock-menu = true; }
                    }
                    Rectangle { vertical-stretch: 1; min-height: 4px; }
                }
            }
            if root.dock-menu && !root.dock-vertical: HorizontalLayout {
                x: max(8px, parent.width - self.width - 8px);
                y: max(4px, (parent.height - self.height) / 2);
                spacing: 4px;
                DockMenuButton {
                    label: root.lang == "en-zh" ? "Open" : "放大";
                    clicked => {
                        root.dock-menu = false;
                        root.collapsed = false;
                    }
                }
                DockMenuButton {
                    label: root.lang == "en-zh" ? "Close" : "關閉";
                    danger: true;
                    clicked => {
                        root.dock-menu = false;
                        root.request-close();
                    }
                }
            }
            if root.dock-menu && root.dock-vertical: VerticalLayout {
                x: max(4px, (parent.width - self.width) / 2);
                y: max(4px, parent.height - self.height - 8px);
                width: min(parent.width - 8px, 72px);
                spacing: 4px;
                DockMenuButton {
                    horizontal-stretch: 1;
                    label: root.lang == "en-zh" ? "Open" : "放大";
                    clicked => {
                        root.dock-menu = false;
                        root.collapsed = false;
                    }
                }
                DockMenuButton {
                    horizontal-stretch: 1;
                    label: root.lang == "en-zh" ? "Close" : "關閉";
                    danger: true;
                    clicked => {
                        root.dock-menu = false;
                        root.request-close();
                    }
                }
            }
        }

        if !root.collapsed: HorizontalLayout {
            spacing: 0;
            width: 100%;
            height: 100%;
            if root.full-mode: Rectangle {
                min-width: root.nav-w;
                max-width: root.nav-w;
                horizontal-stretch: 0;
                height: 100%;
                clip: true;
                background: DesktopTheme.sidebar;
                Rectangle {
                    x: 0px; y: 0px;
                    width: root.nav-w;
                    height: 88px;
                    Image { x: 20px; y: 25px; width: 32px; height: 32px; source: @image-url("app-icon.png"); image-fit: contain; }
                    Text { x: 62px; y: 23px; text: root.lang == "en-zh" ? "Gersang" : "巨商圖鑑"; font-size: 17px; font-weight: 600; color: DesktopTheme.text; }
                    Text { x: 62px; y: 48px; text: root.lang == "en-zh" ? "Game companion" : "Gersang companion"; font-size: 11px; color: DesktopTheme.muted; }
                    WindowMoveArea { width: 100%; height: 100%; }
                }
                Rectangle {
                    y: 88px;
                    width: root.nav-w;
                    height: max(root.height - 200px, 80px);
                    clip: true;
                nav-scroll := Flickable {
                    width: 100%;
                    height: 100%;
                        content-width: self.width;
                        content-height: max(nav-col.preferred-height + 8px, 1px);
                        nav-col := VerticalLayout {
                            width: parent.width;
                            padding-left: 12px;
                            padding-right: 12px;
                            padding-top: 8px;
                            spacing: 4px;
                            DesktopNavRow {
                                width: root.nav-w - 24px;
                                label: root.lang == "en-zh" ? "Overview" : "圖鑑總覽";
                                icon-path: "M3 10 L12 3 L21 10 M5 9 L5 21 L10 21 L10 14 L14 14 L14 21 L19 21 L19 9";
                                selected: root.category == "" && !root.settings-open;
                                clicked => { root.go-home(); }
                            }
                            if !root.nav-editing: VerticalLayout {
                                spacing: 4px;
                                width: root.nav-w - 24px;
                                for slot in root.dock-shown: DesktopNavRow {
                                    width: root.nav-w - 24px;
                                    logo: root.category-logo(slot);
                                    glyph: root.category-glyph(slot);
                                    show-logo: root.category-glyph(slot) == "";
                                    label: root.category-short(slot);
                                    shortcut: "F" + root.visible-index(slot);
                                    selected: !root.settings-open && root.category == root.categories[slot].id;
                                    clicked => { root.open-dock(slot); keys.focus(); }
                                }
                            }
                            if root.nav-editing: nav-drag := Rectangle {
                                height: root.dock-shown.length * 44px;
                                width: 100%;
                                property <int> from-row: -1;
                                property <int> over-row: -1;
                                property <length> grab-y: 0px;
                                property <length> nudge: 0px;
                                for slot[i] in root.dock-shown: Rectangle {
                                    y: nav-drag.from-row == i ? max(0px, i * 44px + nav-drag.nudge) : i * 44px;
                                    width: parent.width;
                                    height: 40px;
                                    border-radius: 8px;
                                    background: nav-drag.from-row == i ? DesktopTheme.raised : nav-drag.over-row == i && nav-drag.from-row != i ? DesktopTheme.selection-low : DesktopTheme.surface;
                                    border-width: 1px;
                                    border-color: nav-drag.from-row == i || nav-drag.over-row == i ? DesktopTheme.accent : DesktopTheme.border;
                                    HorizontalLayout {
                                        width: 100%;
                                        height: 100%;
                                        padding-left: 8px;
                                        padding-right: 8px;
                                        spacing: 8px;
                                        alignment: start;
                                        Text {
                                            width: 16px;
                                            text: "⋮⋮";
                                            font-size: 14px;
                                            color: DesktopTheme.muted;
                                            vertical-alignment: center;
                                        }
                                        if root.category-glyph(slot) == "": Image {
                                            source: root.category-logo(slot);
                                            width: 22px;
                                            height: 22px;
                                            image-fit: contain;
                                        }
                                        if root.category-glyph(slot) != "": Text {
                                            width: 22px;
                                            text: root.category-glyph(slot);
                                            font-size: 14px;
                                            color: DesktopTheme.accent;
                                            horizontal-alignment: center;
                                            vertical-alignment: center;
                                        }
                                        Text {
                                            horizontal-stretch: 1;
                                            text: root.category-short(slot);
                                            font-size: 14px;
                                            color: DesktopTheme.text;
                                            vertical-alignment: center;
                                            overflow: elide;
                                        }
                                    }
                                    TouchArea {
                                        width: 100%;
                                        height: 100%;
                                        mouse-cursor: grab;
                                        pointer-event(event) => {
                                            if (event.button == PointerEventButton.left && event.kind == PointerEventKind.down) {
                                                nav-drag.from-row = i;
                                                nav-drag.over-row = i;
                                                nav-drag.grab-y = self.mouse-y;
                                                nav-drag.nudge = 0px;
                                            }
                                            if (event.button == PointerEventButton.left && event.kind == PointerEventKind.up) {
                                                if (nav-drag.from-row >= 0 && nav-drag.over-row >= 0 && nav-drag.from-row != nav-drag.over-row) {
                                                    root.dock-moved(nav-drag.from-row, nav-drag.over-row);
                                                }
                                                nav-drag.from-row = -1;
                                                nav-drag.over-row = -1;
                                                nav-drag.nudge = 0px;
                                            }
                                        }
                                        moved => {
                                            if (!self.pressed || nav-drag.from-row != i) {
                                                return;
                                            }
                                            nav-drag.nudge = self.mouse-y - nav-drag.grab-y;
                                            let row = round((i * 44px + nav-drag.nudge) / 44px - 0.5);
                                            if (row < 0) {
                                                nav-drag.over-row = 0;
                                            } else if (row >= root.dock-shown.length) {
                                                nav-drag.over-row = root.dock-shown.length - 1;
                                            } else {
                                                nav-drag.over-row = row;
                                            }
                                        }
                                    }
                                }
                            }
                        }
                    }
                    }
                    Rectangle {
                        y: root.height - 112px;
                        height: 112px;
                        width: root.nav-w;
                        background: DesktopTheme.sidebar;
                        Rectangle {
                            width: 100%;
                            height: 1px;
                            background: DesktopTheme.border;
                        }
                        DesktopNavRow {
                            x: 12px;
                            y: 12px;
                            width: root.nav-w - 24px;
                            icon-path: "M4 7 L20 7 M4 12 L16 12 M4 17 L12 17";
                            label: root.nav-editing ? (root.lang == "en-zh" ? "Done" : "完成") : (root.lang == "en-zh" ? "Order" : "順序");
                            selected: root.nav-editing;
                            clicked => { root.nav-editing = !root.nav-editing; }
                        }
                        DesktopNavRow {
                            x: 12px;
                            y: 56px;
                            width: root.nav-w - 24px;
                            icon-path: "M8 4 L8 20 M16 4 L16 20 M4 8 L12 8 M12 16 L20 16";
                            label: root.lang == "en-zh" ? "Settings" : "設定";
                            selected: root.settings-open;
                            clicked => {
                                root.nav-editing = false;
                                if (root.settings-open) {
                                    root.close-settings();
                                } else {
                                    root.settings-open = true;
                                }
                            }
                        }
                    }
                    Rectangle {
                        x: parent.width - 1px;
                        width: 1px;
                        height: 100%;
                        background: DesktopTheme.border;
                    }
                }
            VerticalLayout {
            spacing: 0;
            horizontal-stretch: 1;
            min-width: 0px;

            Rectangle {
                width: root.pane-w;
                height: 42px;
                background: DesktopTheme.chrome;
                HorizontalLayout {
                    width: 100%;
                    height: 100%;
                    padding-left: 16px;
                    padding-right: 8px;
                    spacing: 4px;
                    Text {
                        text: root.full-mode ? (root.lang == "en-zh" ? "Reference workspace" : "圖鑑工作台") : (root.lang == "en-zh" ? "GERSANG" : "巨商");
                        font-size: 13px;
                        font-weight: 600;
                        color: DesktopTheme.accent;
                        vertical-alignment: center;
                    }
                    Rectangle {
                        horizontal-stretch: 1;
                        min-width: 0px;
                        WindowMoveArea {
                            width: 100%;
                            height: 100%;
                        }
                    }
                }
                if !root.full-mode: WinButton {
                    x: 96px;
                    y: 9px;
                    glyph: root.lang == "en-zh" ? "Setting" : "設定";
                    clicked => {
                        if (root.settings-open) {
                            root.close-settings();
                        } else {
                            root.settings-open = true;
                        }
                    }
                }
                WinButton {
                    x: parent.width - 156px;
                    y: 9px;
                    glyph: root.full-mode ? (root.lang == "en-zh" ? "Widget" : "小窗") : (root.lang == "en-zh" ? "Full" : "完整");
                    clicked => {
                        root.nav-editing = false;
                        root.full-mode = !root.full-mode;
                        root.mode-changed(root.full-mode);
                    }
                }
                WinButton {
                    x: parent.width - 78px;
                    y: 9px;
                    glyph: "–";
                    clicked => { root.collapsed = true; }
                }
                WinButton {
                    x: parent.width - 40px;
                    y: 9px;
                    glyph: "×";
                    danger: true;
                    clicked => { root.request-close(); }
                }
            }

            body := Rectangle {
                vertical-stretch: 1;

                if root.category == "" && !root.settings-open && !root.full-mode: home := Rectangle {
                    width: parent.width;
                    height: 100%;
                    property <length> board-w: max(self.width - 16px, 40px);
                    property <length> board-h: max(self.height - 52px, 40px);
                    property <int> rows: max(1, (root.home-order.length + root.home-span - 1) / root.home-span);
                    property <length> col-side: (board-w - (root.home-span - 1) * root.home-gap) / root.home-span;
                    property <length> row-side: (board-h - (rows - 1) * root.home-gap) / rows;
                    property <length> side: max(1px, min(col-side, max(root.icon-base, row-side)));
                    property <length> grid-h: rows * side + (rows - 1) * root.home-gap;
                    property <length> origin-x: 8px + max(0px, (board-w - (root.home-span * side + (root.home-span - 1) * root.home-gap)) / 2);
                    property <int> drag-index: -1;
                    property <int> drop-index: -1;
                    property <bool> dragged: false;
                    property <length> press-x: 0px;
                    property <length> press-y: 0px;
                    function stop-arrange() {
                        root.arranging = false;
                        home.drag-index = -1;
                        home.drop-index = -1;
                        home.dragged = false;
                    }
                    Text {
                        x: root.home-pad;
                        y: 14px;
                        width: root.arranging ? max(root.pane-w - 96px, 40px) : max(root.pane-w - 32px, 40px);
                        overflow: elide;
                        text: root.arranging ? (root.lang == "en-zh" ? "Drag to move. Tap empty space when done." : "拖曳換位，點空白處完成") : (root.lang == "en-zh" ? "Browse" : "分類");
                        font-size: 12px;
                        color: DesktopTheme.secondary;
                        vertical-alignment: center;
                    }
                    if root.arranging: done-btn := LangChip {
                        x: parent.width - self.width - 14px;
                        y: 8px;
                        width: root.lang == "en-zh" ? 64px : 56px;
                        horizontal-stretch: 0;
                        label: root.lang == "en-zh" ? "Done" : "完成";
                        active: true;
                        clicked => { home.stop-arrange(); }
                    }
                    home-grid := Flickable {
                        y: 44px;
                        width: 100%;
                        height: max(parent.height - 44px, 1px);
                        content-width: self.width;
                        content-height: max(home.grid-h, self.height);
                        if root.arranging: TouchArea {
                            width: parent.width;
                            height: max(home.grid-h, parent.height);
                            clicked => { home.stop-arrange(); }
                        }
                        for slot[i] in root.home-order: CategoryTile {
                            property <int> line: floor(i / root.home-span);
                            property <int> column: i - line * root.home-span;
                            x: home.origin-x + column * (home.side + root.home-gap);
                            y: line * (home.side + root.home-gap) + (home.drag-index == i ? -6px : 0px);
                            width: home.side;
                            height: home.side;
                            selected: root.home-cursor == slot && !root.arranging;
                            arranging: root.arranging;
                            lifted: root.arranging && home.drag-index == i;
                            drop-target: root.arranging && home.drop-index == i && home.drag-index != -1 && home.drag-index != i;
                            logo: root.category-logo(slot);
                            glyph: root.category-glyph(slot);
                            name: root.category-short(slot);
                            clicked => {
                                root.home-cursor = slot;
                                root.open-category(root.categories[slot].id);
                            }
                            pressed(px, py) => {
                                home.drag-index = i;
                                home.drop-index = i;
                                home.dragged = false;
                                home.press-x = px;
                                home.press-y = py;
                            }
                            long-pressed(px, py) => {
                                root.arranging = true;
                                home.drag-index = i;
                                home.drop-index = i;
                                home.dragged = false;
                                home.press-x = px;
                                home.press-y = py;
                            }
                            dragged(px, py) => {
                                if (home.drag-index != i) {
                                    return;
                                }
                                if (px < home.press-x - 6px || px > home.press-x + 6px || py < home.press-y - 6px || py > home.press-y + 6px) {
                                    home.dragged = true;
                                }
                                let hit = root.grid-slot(self.x + px, self.y + py, home.origin-x, 0px, home.side, home.side, root.home-gap, root.home-span, root.home-order.length);
                                if (hit >= 0) {
                                    home.drop-index = hit;
                                }
                            }
                            released => {
                                if (home.drag-index == i && home.dragged && home.drop-index >= 0 && home.drop-index != i) {
                                    root.home-reordered(i, home.drop-index);
                                }
                                home.drag-index = -1;
                                home.drop-index = -1;
                                home.dragged = false;
                            }
                        }
                    }
                    if root.detail != "": Text {
                        x: root.home-pad;
                        y: 48px;
                        width: max(root.pane-w - 2 * root.home-pad, 40px);
                        text: root.detail;
                        wrap: word-wrap;
                        color: #e7c7c7;
                    }
                }

                if root.category == "" && !root.settings-open && root.full-mode: Flickable {
                    x: 0px; y: 0px;
                    width: 100%;
                    height: parent.height - root.foot;
                    content-width: self.width;
                    content-height: max(self.height, 550px);
                    Text {
                        x: 28px; y: 26px;
                        text: root.lang == "en-zh" ? "Explore the compendium" : "探索巨商圖鑑";
                        font-size: 27px; font-weight: 600; color: DesktopTheme.text;
                    }
                    Text {
                        x: 28px; y: 66px; width: parent.width - 56px;
                        text: root.lang == "en-zh" ? "Monsters, equipment and the paths that connect them." : "從怪物、裝備到任務，找到下一步需要的資料。";
                        font-size: 13px; color: DesktopTheme.secondary; overflow: elide;
                    }
                    Rectangle {
                        x: 28px; y: 116px;
                        width: (parent.width - 72px) * 0.56;
                        height: 402px;
                        DesktopEntry {
                            x: 0px; y: 0px; width: parent.width; height: 112px;
                            title: root.lang == "en-zh" ? "Monster compendium" : "怪物圖鑑";
                            description: root.lang == "en-zh" ? "Attributes, habitats and drops" : "查屬性、找出沒地，比較掉落物";
                            logo: root.category-logo(0); prominent: true;
                            action-label: root.lang == "en-zh" ? "Browse" : "瀏覽";
                            clicked => { root.open-category("monster"); keys.focus(); }
                        }
                        DesktopEntry {
                            y: 126px; width: parent.width; height: 88px;
                            title: root.lang == "en-zh" ? "Equipment & items" : "裝備與道具";
                            description: root.lang == "en-zh" ? "Stats, sets and ways to obtain them" : "查看能力、套裝效果與取得方式";
                            logo: root.category-logo(1);
                            clicked => { root.open-category("item"); keys.focus(); }
                        }
                        DesktopEntry {
                            y: 220px; width: parent.width; height: 88px;
                            title: root.lang == "en-zh" ? "Quests & crafting" : "任務與製作";
                            description: root.lang == "en-zh" ? "Follow quest chains and their rewards" : "追蹤任務流程、條件與獎勵";
                            logo: root.category-logo(3);
                            clicked => { root.open-category("quest"); keys.focus(); }
                        }
                        HorizontalLayout {
                            y: 338px; width: parent.width; height: 32px; spacing: 8px;
                            FilterChip { label: root.lang == "en-zh" ? "Recipes" : "合成配方"; clicked => { root.open-category("recipe"); keys.focus(); } }
                            FilterChip { label: root.lang == "en-zh" ? "Production" : "生產"; clicked => { root.open-category("works"); keys.focus(); } }
                            FilterChip { label: root.lang == "en-zh" ? "Shops" : "商店"; clicked => { root.open-category("atlas"); keys.focus(); } }
                        }
                    }
                    Rectangle {
                        x: 44px + (parent.width - 72px) * 0.56;
                        y: 116px;
                        width: (parent.width - 72px) * 0.44;
                        height: max(parent.height - 144px, 380px);
                        background: DesktopTheme.surface;
                        border-radius: 12px;
                        Text {
                            x: 20px; y: 18px;
                            text: root.lang == "en-zh" ? "Your favourites" : "我的收藏";
                            font-size: 15px; font-weight: 600; color: DesktopTheme.text;
                        }
                        if root.hits.length > 0: Text {
                            x: parent.width - 60px; y: 20px; width: 40px;
                            text: root.hits.length; color: DesktopTheme.muted; font-size: 12px;
                            horizontal-alignment: right;
                        }
                        Rectangle { x: 20px; y: 50px; width: parent.width - 40px; height: 1px; background: DesktopTheme.border; }
                        if root.hits.length == 0: Rectangle {
                            y: 88px; width: parent.width; height: 228px;
                            DesktopIcon {
                                x: (parent.width - 32px) / 2; y: 22px; width: 32px; height: 32px;
                                ink: DesktopTheme.accent;
                                path: "M12 2 L15 8.5 L22 9.3 L17 14.2 L18.3 21 L12 17.6 L5.7 21 L7 14.2 L2 9.3 L9 8.5 Z";
                            }
                            Text { x: 20px; y: 76px; width: parent.width - 40px; text: root.lang == "en-zh" ? "Keep your next target close" : "把常看的怪物留在這裡"; horizontal-alignment: center; font-size: 14px; font-weight: 500; color: DesktopTheme.text; }
                            Text { x: 28px; y: 108px; width: parent.width - 56px; text: root.lang == "en-zh" ? "Star a monster to return to its stats and drops in one click." : "在怪物旁點星號，下次直接查看能力與掉落物。"; horizontal-alignment: center; wrap: word-wrap; font-size: 12px; color: DesktopTheme.secondary; }
                            SearchToggle { x: (parent.width - self.width) / 2; y: 168px; label: root.lang == "en-zh" ? "Explore monsters" : "瀏覽怪物"; clicked => { root.open-category("monster"); keys.focus(); } }
                        }
                        if root.hits.length > 0: Flickable {
                            x: 12px; y: 60px; width: parent.width - 24px; height: parent.height - 72px;
                            content-width: self.width;
                            content-height: max(root.hits.length * 56px, 1px);
                            for row[i] in root.hits: HitRow {
                                y: i * 56px; width: parent.width; height: 54px;
                                hit: row; selected: root.cursor == i;
                                no-image-label: root.no-image-label;
                                clicked => { root.home-open(row.key); }
                                favourite-clicked => { root.toggle-favourite(row.key); }
                            }
                        }
                    }
                }

                if root.category != "" && !root.settings-open: Rectangle {
                    width: root.pane-w;
                    height: 100%;

                    WinButton {
                        x: root.page-pad;
                        y: 14px;
                        glyph: "←";
                        clicked => { root.go-back(); }
                    }
                    Text {
                        x: root.full-mode ? 66px : 52px;
                        y: root.full-mode ? 13px : 16px;
                        width: root.full-mode && root.viewing == "" ? max(root.pane-w - 390px, 40px) : root.category == "patch" && root.viewing != "" ? max(root.pane-w - 150px, 40px) : root.viewing == "" ? max(root.pane-w - (root.lang == "en-zh" ? 172px : 148px), 40px) : max(root.pane-w - 70px, 40px);
                        overflow: elide;
                        text: root.favourites-only && root.category == "monster" ? (root.lang == "en-zh" ? "Favourites" : "收藏") : root.category == "atlas" && root.area-name != "" ? root.area-name : root.category == "atlas" && root.place-name != "" ? root.place-name : root.category == "works" && root.area-name != "" ? root.area-name : root.category == "works" && root.place-name != "" ? root.place-name : root.category == "hero" && root.area-name != "" ? root.area-name : root.category == "item" && root.area-name != "" ? root.area-name : root.place-name != "" ? root.place-name : root.area-name != "" ? root.area-name : root.nation-name != "" ? root.nation-name : root.category == "monster" ? root.categories[0].name : root.category == "item" ? root.categories[1].name : root.category == "recipe" ? root.categories[2].name : root.category == "patch" ? (root.categories[4].name + "  " + root.client-version) : root.category == "npc" ? root.categories[5].name : root.category == "hero" ? root.categories[6].name : root.category == "works" ? root.categories[7].name : root.category == "atlas" ? root.categories[8].name : root.categories[3].name;
                        font-size: root.full-mode ? 21px : 16px;
                        font-weight: 600;
                        color: DesktopTheme.text;
                    }
                    if root.viewing == "" && !root.full-mode: SearchToggle {
                        x: root.pane-w - self.width - root.page-pad;
