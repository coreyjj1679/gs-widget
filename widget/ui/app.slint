    property <length> side-gap: 14px;
    property <length> portrait-y: 58px;
    property <length> portrait-side: 120px;
    property <length> stage-h: 168px;
    property <bool> battle-picture: show-battle && battle-view;
    property <length> face-side: battle-picture ? 96px : portrait-side;
    property <length> face-x: battle-picture ? side-gap + 8px : side-gap;
    property <length> face-y: battle-picture ? portrait-y + (stage-h - face-side) / 2 : portrait-y;
    property <length> toggle-y: battle-picture ? portrait-y + stage-h + 10px : portrait-y + portrait-side + (sheet-alt == "" ? 62px : 78px);
    property <length> body-room: max(root.height - foot - 42px - toggle-y - 16px, 120px);
    property <length> form-h: min(facts.length * 30px + 2px, body-room - (links.length > 0 ? 52px : 0px) - (related.length > 0 ? 44px : 0px));
    property <length> drops-header-y: form-open ? toggle-y + 52px + form-h : toggle-y + 44px;
    property <length> drops-list-y: drops-header-y + 44px;
    property <length> drops-room: max(root.height - foot - 42px - drops-list-y - (related.length > 0 ? 60px : 12px), 72px);
    property <length> drops-list-h: min(max(links.length * 36px, 36px), drops-room);
    property <length> related-header-y: links.length == 0 ? drops-header-y : drops-open ? drops-list-y + drops-list-h + 8px : drops-header-y + 44px;
    property <length> related-list-y: related-header-y + 44px;
    property <length> related-room: max(root.height - foot - 42px - related-list-y - 12px, 72px);
    property <length> related-list-h: min(max(related.length * 52px, 52px), related-room);
    property <length> stats-y: show-icon ? 124px : 48px;
    property <length> detail-block: links.length > 0 ? 132px : max(root.height - foot - stats-y - 80px, 80px);
    property <length> drops-y: stats-y + detail-block + 4px;
    property <length> drops-view: max(root.height - foot - drops-y - 58px, 48px);

    property <length> dock-side: root.dock-vertical ? min(max(root.width - 28px, 40px), 96px) : min(max(root.height - 28px, 40px), 96px);

    property <[Category]> categories: [
        { id: "monster", name: UiLanguage.tr("Monsters", "怪物") },
        { id: "item", name: UiLanguage.tr("Items", "道具") },
        { id: "recipe", name: UiLanguage.tr("Crafting", "合成") },
        { id: "quest", name: UiLanguage.tr("Quests", "任務") },
        { id: "patch", name: UiLanguage.tr("Updates", "更新") },
        { id: "npc", name: UiLanguage.tr("NPCs", "人物") },
        { id: "hero", name: UiLanguage.tr("Roster", "角色") },
        { id: "works", name: UiLanguage.tr("Production", "生產") },
        { id: "atlas", name: UiLanguage.tr("Shop", "商店") },
    ];

    changed full-mode => {
        root.hotkey-scope-changed(!root.full-mode);
        if (root.full-mode && root.settings-tab == 3) { root.select-settings(0); }
        if (!root.full-mode) { root.calculator-open = false; root.mcp-open = false; }
    }

    changed collapsed => {
        root.collapse-changed(root.collapsed);
    }

    changed hotkey-nth => {
        if (root.hotkey-nth >= 1) {
            if (!root.full-mode && root.hotkeys-on) { root.open-nth-visible(root.hotkey-nth); }
            root.hotkey-nth = 0;
        }
    }

    init => {
        Palette.color-scheme = ColorScheme.dark;
        keys.focus();
    }

    keys := FocusScope {
        focus-on-tab-navigation: false;
        width: 100%;
        height: 100%;
        focus-on-click: true;
        key-pressed(event) => {
            return root.handle-key(event);
        }

    Rectangle {
        width: 100%;
        height: 100%;
        opacity: root.window-opacity;
        background: root.collapsed ? transparent : DesktopTheme.canvas;
        border-radius: root.collapsed ? 0px : 12px;
        clip: !root.collapsed;
        border-width: root.collapsed ? 0px : 1px;
        border-color: DesktopTheme.border;

        if root.collapsed: dock-bar := TouchArea {
            width: 100%;
            height: 100%;
            property <bool> moving: false;
            property <length> grab-x: 0px;
            property <length> grab-y: 0px;
            pointer-event(event) => {
                if (event.button == PointerEventButton.right && event.kind == PointerEventKind.up) {
                    root.dock-menu = !root.dock-menu;
                }
                if (event.button == PointerEventButton.left && event.kind == PointerEventKind.down) {
                    self.moving = true;
                    self.grab-x = self.mouse-x;
                    self.grab-y = self.mouse-y;
                    root.dock-menu = false;
                }
                if (event.button == PointerEventButton.left && event.kind == PointerEventKind.up) {
                    self.moving = false;
                }
            }
            moved => {
                if (self.pressed && self.moving) {
                    root.dock-drag(self.mouse-x - self.grab-x, self.mouse-y - self.grab-y);
                }
            }
            Rectangle {
                x: 4px;
                y: 4px;
                width: parent.width - 8px;
                height: parent.height - 8px;
                border-radius: 20px;
                background: DesktopTheme.canvas.with-alpha(0.83);
                border-width: 1px;
                border-color: DesktopTheme.border;
                if !root.dock-vertical: HorizontalLayout {
                    padding-left: 12px;
                    padding-right: 12px;
                    spacing: 12px;
                    alignment: center;
                    cross-axis-alignment: center;
                    for slot in root.dock-shown: DockChip {
                        side: root.dock-side;
                        logo: root.category-logo(slot);
                        glyph: root.category-glyph(slot);
                        mark: root.visible-index(slot);
                        selected: root.home-cursor == slot;
                        clicked => { root.dock-menu = false; root.open-dock(slot); }
                        right-clicked => { root.dock-menu = true; }
                    }
                    Rectangle { horizontal-stretch: 1; min-width: 4px; }
                }
                if root.dock-vertical: VerticalLayout {
                    padding-top: 12px;
                    padding-bottom: 12px;
                    spacing: 12px;
                    alignment: center;
                    cross-axis-alignment: center;
                    for slot in root.dock-shown: DockChip {
                        side: root.dock-side;
                        logo: root.category-logo(slot);
                        glyph: root.category-glyph(slot);
                        mark: root.visible-index(slot);
                        selected: root.home-cursor == slot;
                        clicked => { root.dock-menu = false; root.open-dock(slot); }
                        right-clicked => { root.dock-menu = true; }
                    }
                    Rectangle { vertical-stretch: 1; min-height: 4px; }
                }
            }
            if root.dock-menu && !root.dock-vertical: HorizontalLayout {
                x: max(8px, parent.width - self.width - 8px);
                y: max(4px, (parent.height - self.height) / 2);
                spacing: 4px;
                DockMenuButton {
                    label: UiLanguage.tr("Open", "放大");
                    clicked => {
                        root.dock-menu = false;
                        root.collapsed = false;
                    }
                }
                DockMenuButton {
                    label: UiLanguage.tr("Close", "關閉");
                    danger: true;
                    clicked => {
                        root.dock-menu = false;
                        root.request-close();
                    }
                }
            }
            if root.dock-menu && root.dock-vertical: VerticalLayout {
                x: max(4px, (parent.width - self.width) / 2);
                y: max(4px, parent.height - self.height - 8px);
                width: min(parent.width - 8px, 72px);
                spacing: 4px;
                DockMenuButton {
                    horizontal-stretch: 1;
                    label: UiLanguage.tr("Open", "放大");
                    clicked => {
                        root.dock-menu = false;
                        root.collapsed = false;
                    }
                }
                DockMenuButton {
                    horizontal-stretch: 1;
                    label: UiLanguage.tr("Close", "關閉");
                    danger: true;
                    clicked => {
                        root.dock-menu = false;
                        root.request-close();
                    }
                }
            }
        }

        if !root.collapsed: HorizontalLayout {
            spacing: 0;
            width: 100%;
            height: 100%;
            if root.full-mode: Rectangle {
                min-width: root.nav-w;
                max-width: root.nav-w;
                horizontal-stretch: 0;
                height: 100%;
                clip: true;
                background: DesktopTheme.sidebar;
                Rectangle {
                    x: 0px; y: 0px;
                    width: root.nav-w;
                    height: 88px;
                    Image { x: 20px; y: 25px; width: 32px; height: 32px; source: @image-url("app-icon.png"); image-fit: contain; }
                    Text { x: 62px; y: 23px; text: UiLanguage.tr("Gersang", "巨商圖鑑"); font-size: 17px; font-weight: 600; color: DesktopTheme.text; }
                    Text {
                        x: 62px; y: 48px;
                        width: parent.width - 74px;
                        text: "v" + root.app-version;
                        font-size: 11px;
                        color: DesktopTheme.muted;
                        overflow: elide;
                        accessible-label: (UiLanguage.tr("App version ", "程式版本 ")) + root.app-version;
                    }
                    WindowMoveArea { width: 100%; height: 100%; }
                }
                Rectangle {
                    y: 88px;
                    width: root.nav-w;
                    height: max(root.height - 88px - root.nav-footer-h, 80px);
                    clip: true;
                nav-scroll := Flickable {
                    interactive: !root.nav-dragging;
                    width: 100%;
                    height: 100%;
                        content-width: self.width;
                        content-height: max(nav-col.preferred-height + 8px, 1px);
                        nav-col := VerticalLayout {
                            width: parent.width;
                            padding-left: 12px;
                            padding-right: 12px;
                            padding-top: 8px;
                            spacing: 4px;
                            DesktopNavRow {
                                width: root.nav-w - 24px;
                                label: UiLanguage.tr("Overview", "圖鑑總覽");
                                icon-path: "M3 10 L12 3 L21 10 M5 9 L5 21 L10 21 L10 14 L14 14 L14 21 L19 21 L19 9";
                                selected: root.category == "" && !root.settings-open && !root.calculator-open && !root.mcp-open;
                                clicked => { root.go-home(); }
                            }
                            DesktopNavRow {
                                width: root.nav-w - 24px;
                                label: UiLanguage.tr("Calculate", "計算");
                                icon-path: "M5 3 L19 3 L19 21 L5 21 Z M8 6 L16 6 L16 9 L8 9 Z M8 12 L10 12 M14 12 L16 12 M8 16 L10 16 M14 16 L16 16 M8 19 L10 19 M14 19 L16 19";
                                selected: root.calculator-open && !root.settings-open;
                                clicked => {
                                    if (root.calculator-open) {
                                        if (root.settings-open) { root.close-settings(); }
                                    } else {
                                        root.go-home(); root.calculator-open = true; root.calculator-refresh();
                                    }
                                }
                            }
                            DesktopNavRow {
                                width: root.nav-w - 24px;
                                label: UiLanguage.tr("Enchantments", "鬼道");
                                logo: root.enchant-logo;
                                show-logo: true;
                                selected: root.category == "enchant" && !root.settings-open && !root.calculator-open && !root.mcp-open;
                                clicked => { root.open-enchant(); }
                            }
                            nav-drag := Rectangle {
                                height: root.dock-shown.length * 44px;
                                width: 100%;
                                property <int> from-row: -1;
                                property <int> over-row: -1;
                                property <bool> moving: false;
                                for slot[i] in root.dock-shown: SidebarCategoryRow {
                                    x: 0px;
                                    y: i * 44px;
                                    width: parent.width;
                                    logo: root.category-logo(slot);
                                    glyph: root.category-glyph(slot);
                                    label: root.category-short(slot);
                                    selected: !root.settings-open && !root.calculator-open && !root.mcp-open && root.category == root.categories[slot].id;
                                    lifted: nav-drag.moving && nav-drag.from-row == i;
                                    english: UiLanguage.primary == "en";
                                    clicked => {
                                        if (root.category != root.categories[slot].id || root.page-back-visible
                                            || root.settings-open || root.calculator-open || root.mcp-open) {
                                            root.open-dock(slot);
                                        }
                                        keys.focus();
                                    }
                                    shift(delta) => {
                                        let next = max(0, min(root.dock-shown.length - 1, i + delta));
                                        if (next != i) { root.dock-moved(i, next); }
                                    }
                                    drag-start => {
                                        root.nav-dragging = true;
                                        nav-drag.from-row = i;
                                        nav-drag.over-row = i;
                                        nav-drag.moving = false;
                                    }
                                    drag-move(py) => {
                                        if (nav-drag.from-row != i) { return; }
                                        nav-drag.moving = true;
                                        let row = floor((i * 44px + py) / 44px);
                                        nav-drag.over-row = max(0, min(root.dock-shown.length - 1, row));
                                    }
                                    drag-end(moved) => {
                                        root.nav-dragging = false;
                                        let from = nav-drag.from-row;
                                        let to = nav-drag.over-row;
                                        nav-drag.from-row = -1;
                                        nav-drag.over-row = -1;
                                        nav-drag.moving = false;
                                        if (moved && from >= 0 && to >= 0 && from != to) {
                                            root.dock-moved(from, to);
                                        }
                                    }
                                }
                                if nav-drag.moving && nav-drag.over-row != nav-drag.from-row: Rectangle {
                                    x: 4px;
                                    y: nav-drag.over-row * 44px + (nav-drag.over-row > nav-drag.from-row ? 42px : -2px);
                                    width: parent.width - 8px;
                                    height: 2px;
                                    border-radius: 1px;
                                    background: DesktopTheme.accent;
                                }
                            }
                        }
                    }
                    }
                    Rectangle {
                        y: root.height - root.nav-footer-h;
                        height: root.nav-footer-h;
                        width: root.nav-w;
                        background: DesktopTheme.sidebar;
                        Rectangle {
                            x: 0px;
                            y: 0px;
                            width: 100%;
                            height: 1px;
                            background: DesktopTheme.border;
                        }
                        Text {
                            x: 20px; y: 20px;
                            width: parent.width - 40px;
                            height: 22px;
                            text: UiLanguage.tr("Drag categories to reorder", "拖曳分類可調整順序");
                            font-size: 11px;
                            color: DesktopTheme.muted;
                            vertical-alignment: center;
                        }
                        if root.updates-supported: DesktopNavRow {
                            x: 12px;
                            y: 48px;
                            width: root.nav-w - 24px;
                            height: 36px;
                            label: root.sidebar-update-action;
                            icon-path: "M12 3 L12 15 M7 10 L12 15 L17 10 M4 16 L4 21 L20 21 L20 16";
                            icon-size: 18px;
                            selected: (root.update-state == 3 || root.update-state == 5) && root.update-error == "";
                            enabled: !root.update-busy;
                            accessible-description: root.update-error != "" ? root.update-error : root.update-status;
                            clicked => {
                                root.nav-dragging = false;
                                if (root.update-state == 5 && root.update-error != "") {
                                    root.settings-tab = 4;
                                    root.settings-open = true;
                                } else {
                                    let show-details = root.update-state == 6;
                                    root.request-update();
                                    // A restart may synchronously reject an unsaved alias
                                    // draft. Show its recovery instructions immediately.
                                    if (show-details || root.update-error != "") {
                                        root.settings-tab = 4;
                                        root.settings-open = true;
                                    }
                                }
                            }
                        }
                        DesktopNavRow {
                            x: 12px;
                            y: parent.height - 100px;
                            width: root.nav-w - 24px;
                            glyph: "⚙️";
                            label: UiLanguage.tr("Settings", "設定");
                            selected: root.settings-open;
                            clicked => {
                                root.nav-dragging = false;
                                root.settings-open = true;
                            }
                        }
                        DesktopNavRow {
                            x: 12px;
                            y: parent.height - 56px;
                            width: root.nav-w - 24px;
                            label: "MCP";
                            icon-path: "M8 3 L8 8 M16 3 L16 8 M5 8 L19 8 L19 12 L16 16 L8 16 L5 12 Z M12 16 L12 21";
                            selected: root.mcp-open && !root.settings-open;
                            clicked => {
                                if (root.mcp-open) {
                                    if (root.settings-open) { root.close-settings(); }
                                } else {
                                    root.go-home(); root.mcp-open = true; root.mcp-copy-notice = "";
                                }
                            }
                        }
                    }
                    Rectangle {
                        x: parent.width - 1px;
                        width: 1px;
                        height: 100%;
                        background: DesktopTheme.border;
                    }
                }
            VerticalLayout {
            spacing: 0;
            horizontal-stretch: 1;
            min-width: 0px;

            Rectangle {
                width: root.pane-w;
                height: 42px;
                background: DesktopTheme.chrome;
                HorizontalLayout {
                    width: 100%;
                    height: 100%;
                    padding-left: 16px;
                    padding-right: 8px;
                    spacing: 4px;
                    Text {
                        visible: root.full-mode || root.pane-w >= 340px;
                        text: root.full-mode && root.category == "monster" ? "" : root.full-mode ? (UiLanguage.tr("Reference workspace", "圖鑑工作台")) : (UiLanguage.tr("GERSANG", "巨商"));
                        font-size: 13px;
                        font-weight: 600;
                        color: DesktopTheme.accent;
                        vertical-alignment: center;
                    }
                    Rectangle {
                        horizontal-stretch: 1;
                        min-width: 0px;
                        WindowMoveArea {
                            width: 100%;
                            height: 100%;
                        }
                    }
                }
                if !root.full-mode: WinButton {
                    x: parent.width < 340px ? 16px : 84px;
                    y: 9px;
                    glyph: "⚙️";
                    clicked => {
                        if (root.settings-open) {
                            root.close-settings();
                        } else {
                            root.settings-open = true;
                        }
                    }
                }
                WindowModeSwitch {
                    x: parent.width - self.width - 88px;
                    y: 7px;
                    full: root.full-mode;
                    english: UiLanguage.primary == "en";
                    choose(full) => {
                        if (root.full-mode == full) { return; }
                        root.nav-dragging = false;
                        root.full-mode = full;
                        root.mode-changed(full);
                    }
                }
                WinButton {
                    x: parent.width - 78px;
                    y: 9px;
                    glyph: "–";
                    clicked => { root.collapsed = true; }
                }
                WinButton {
                    x: parent.width - 40px;
                    y: 9px;
                    glyph: "×";
                    danger: true;
                    clicked => { root.request-close(); }
                }
            }

            body := Rectangle {
                vertical-stretch: 1;

                if root.full-mode && root.mcp-open && !root.settings-open: McpPane {
                    x: root.page-pad; y: 18px;
                    width: parent.width - root.page-pad * 2;
                    height: max(parent.height - 30px, 0px);
                    english: UiLanguage.primary == "en";
                    windows: root.mcp-windows;
                    agent <=> root.mcp-agent;
                    command: root.mcp-command;
                    database: root.mcp-database;
                    codex-config: root.mcp-codex-config;
                    cursor-config: root.mcp-cursor-config;
                    claude-config: root.mcp-claude-config;
                    claude-cli: root.mcp-claude-cli;
                    setup-error: root.mcp-setup-error;
                    copy-notice: root.mcp-copy-notice;
                    copy(text) => { root.mcp-copy(text); }
                    agent-changed => { root.mcp-copy-notice = ""; }
                }

                if root.full-mode && root.calculator-open && !root.settings-open: Rectangle {
                    x: root.page-pad; y: 18px;
                    width: parent.width - root.page-pad * 2;
                    height: 36px;
                    HorizontalLayout {
                        spacing: 4px;
                        item-calc-tab := PatchTab {
                            label: UiLanguage.tr("Items", "道具");
                            width: 120px;
                            active: root.calculator-tab == 0;
                            arrow-navigation: true;
                            tab-stop: root.calculator-tab == 0;
                            clicked => { root.calculator-tab = 0; }
                            navigate(step) => {
                                if (step == -2) { root.calculator-tab = 0; }
                                else { root.calculator-tab = 1; character-calc-tab.focus(); }
                            }
                        }
                        character-calc-tab := PatchTab {
                            label: UiLanguage.tr("Characters / Mercenaries", "角色／傭兵");
                            width: UiLanguage.primary == "en" ? 220px : 168px;
                            active: root.calculator-tab == 1;
                            arrow-navigation: true;
                            tab-stop: root.calculator-tab == 1;
                            clicked => { root.calculator-tab = 1; }
                            navigate(step) => {
                                if (step == 2) { root.calculator-tab = 1; }
                                else { root.calculator-tab = 0; item-calc-tab.focus(); }
                            }
                        }
                        Rectangle { horizontal-stretch: 1; }
                    }
                }
                if root.full-mode && root.calculator-open && !root.settings-open: CalculatorPane {
                    visible: root.calculator-tab == 0;
                    x: root.page-pad; y: 70px;
                    width: parent.width - root.page-pad * 2;
                    height: max(parent.height - 82px, 0px);
                    english: UiLanguage.primary == "en";
                    candidates: root.calculator-candidates;
                    materials: root.calculator-materials;
                    nested-options: root.calculator-nested-options;
                    has-nested: root.calculator-has-nested;
                    recipes: root.calculator-recipes;
                    recipe-index <=> root.calculator-recipe-index;
                    selected-name: root.calculator-selected-name;
                    selected-icon: root.calculator-selected-icon;
                    selected-has-icon: root.calculator-selected-has-icon;
                    selected-meta: root.calculator-selected-meta;
                    quantity: root.calculator-quantity;
                    quantity-draft: root.calculator-quantity-draft;
                    quantity-has-draft: root.calculator-quantity-has-draft;
                    material-total: root.calculator-material-total;
                    fee: root.calculator-fee;
                    total: root.calculator-total;
                    unit-total: root.calculator-unit-total;
                    status: root.calculator-status;
                    notice: root.calculator-notice;
                    error: root.calculator-error;
                    info: root.calculator-info;
                    share-enabled: root.calculator-share-enabled;
                    export-busy: root.calculator-export-busy;
                    complete: root.calculator-complete;
                    compact-total: root.calculator-compact-total;
                    input-valid: root.calculator-input-valid;
                    input-revision: root.calculator-input-revision;
                    library-open <=> root.calculator-library-open;
                    folders: root.calculator-folders;
                    folder-index <=> root.calculator-folder-index;
                    saved: root.calculator-saved;
                    saved-count: root.calculator-saved-count;
                    active-saved-name: root.calculator-active-saved-name;
                    save-state: root.calculator-save-state;
                    library-error: root.calculator-library-error;
                    save-sheet(name, index, copy) => { root.calculator-save-sheet(name, index, copy); }
                    select-folder(index) => { root.calculator-select-folder(index); }
                    new-folder(name) => { root.calculator-new-folder(name); }
                    rename-folder(name) => { root.calculator-rename-folder(name); }
                    delete-folder => { root.calculator-delete-folder(); }
                    open-saved(id) => { root.calculator-open-saved(id); }
                    delete-saved(id) => { root.calculator-delete-saved(id); }
                    move-saved(id, index) => { root.calculator-move-saved(id, index); }
                    export-folder => { root.calculator-export-folder(); }
                    search-query(q) => { root.calculator-search(q); }
                    select-item(id) => { root.calculator-select-item(id); }
                    select-recipe(index) => { root.calculator-select-recipe(index); }
                    quantity-changed(q) => { return root.calculator-quantity-changed(q); }
                    price-changed(key, q) => { return root.calculator-price-changed(key, q); }
                    request-nested-options(key, reuse) => { root.calculator-request-nested-options(key, reuse); }
                    select-nested(key, id) => { root.calculator-select-nested(key, id); }
                    clear-nested(key) => { root.calculator-clear-nested(key); }
                    export-card => { root.calculator-export-card(); }
                    copy-code => { root.calculator-copy-code(); }
                    import-code(code) => { root.calculator-import-code(code); }
                }
                if root.full-mode && root.calculator-open && !root.settings-open: CharacterCalculatorPane {
                    visible: root.calculator-tab == 1;
                    x: root.page-pad; y: 70px;
                    width: parent.width - root.page-pad * 2;
                    height: max(parent.height - 82px, 0px);
                    candidates: root.character-calculator-candidates;
                    groups: root.character-calculator-groups;
                    group-index <=> root.character-calculator-group-index;
                    materials: root.character-calculator-materials;
                    nested-options: root.character-calculator-nested-options;
                    input-valid: root.character-calculator-input-valid;
                    routes: root.character-calculator-routes;
                    route-index <=> root.character-calculator-route-index;
                    selected-name: root.character-calculator-selected-name;
                    selected-icon: root.character-calculator-selected-icon;
                    selected-has-icon: root.character-calculator-selected-has-icon;
                    quantity: root.character-calculator-quantity;
                    quantity-draft: root.character-calculator-quantity-draft;
                    quantity-has-draft: root.character-calculator-quantity-has-draft;
                    conditions: root.character-calculator-conditions;
                    material-total: root.character-calculator-material-total;
                    fee: root.character-calculator-fee;
                    total: root.character-calculator-total;
                    unit-total: root.character-calculator-unit-total;
                    status: root.character-calculator-status;
                    notice: root.character-calculator-notice;
                    error: root.character-calculator-error;
                    complete: root.character-calculator-complete;
                    input-revision: root.character-calculator-input-revision;
                    search-query(q) => { root.character-calculator-search(q); }
                    select-group(index) => { root.character-calculator-select-group(index); }
                    select-character(code) => { root.character-calculator-select-character(code); }
                    select-route(index) => { root.character-calculator-select-route(index); }
                    quantity-changed(q) => { return root.character-calculator-quantity-changed(q); }
                    price-changed(key, q) => { return root.character-calculator-price-changed(key, q); }
                    request-nested-options(key, reuse) => { root.character-calculator-request-nested-options(key, reuse); }
                    set-source(key, source) => { root.character-calculator-set-source(key, source); }
                }
                if root.category == "" && !root.settings-open && !root.calculator-open && !root.full-mode: home := Rectangle {
                    width: parent.width;
                    height: 100%;
                    property <length> board-w: max(self.width - 16px, 40px);
                    property <length> board-h: max(self.height - 52px, 40px);
                    property <int> rows: max(1, (root.home-order.length + root.home-span - 1) / root.home-span);
                    property <length> col-side: (board-w - (root.home-span - 1) * root.home-gap) / root.home-span;
                    property <length> row-side: (board-h - (rows - 1) * root.home-gap) / rows;
                    property <length> side: max(1px, min(col-side, max(root.icon-base, row-side)));
                    property <length> grid-h: rows * side + (rows - 1) * root.home-gap;
                    property <length> origin-x: 8px + max(0px, (board-w - (root.home-span * side + (root.home-span - 1) * root.home-gap)) / 2);
                    property <int> drag-index: -1;
                    property <int> drop-index: -1;
                    property <bool> dragged: false;
                    property <length> press-x: 0px;
                    property <length> press-y: 0px;
                    function stop-arrange() {
                        root.arranging = false;
                        home.drag-index = -1;
                        home.drop-index = -1;
                        home.dragged = false;
                    }
                    Text {
                        x: root.home-pad;
                        y: 14px;
                        width: root.arranging ? max(root.pane-w - 96px, 40px) : max(root.pane-w - 32px, 40px);
                        overflow: elide;
                        text: root.arranging ? (UiLanguage.tr("Drag to move. Tap empty space when done.", "拖曳換位，點空白處完成")) : (UiLanguage.tr("Browse", "分類"));
                        font-size: 12px;
                        color: DesktopTheme.secondary;
                        vertical-alignment: center;
                    }
                    if root.arranging: done-btn := LangChip {
                        x: parent.width - self.width - 14px;
                        y: 8px;
                        width: UiLanguage.primary == "en" ? 64px : 56px;
                        horizontal-stretch: 0;
                        label: UiLanguage.tr("Done", "完成");
                        active: true;
                        clicked => { home.stop-arrange(); }
                    }
                    if !root.arranging: DesktopNavRow {
                        x: parent.width - self.width - 12px;
                        y: 2px;
                        width: UiLanguage.primary == "en" ? 160px : 100px;
                        label: UiLanguage.tr("Enchantments", "鬼道");
                        logo: root.enchant-logo;
                        show-logo: true;
                        clicked => { root.open-enchant(); }
                    }
                    home-grid := Flickable {
                        y: 44px;
                        width: 100%;
                        height: max(parent.height - 44px, 1px);
                        content-width: self.width;
                        content-height: max(home.grid-h, self.height);
                        if root.arranging: TouchArea {
                            width: parent.width;
                            height: max(home.grid-h, parent.height);
                            clicked => { home.stop-arrange(); }
                        }
                        for slot[i] in root.home-order: CategoryTile {
                            property <int> line: floor(i / root.home-span);
                            property <int> column: i - line * root.home-span;
                            x: home.origin-x + column * (home.side + root.home-gap);
                            y: line * (home.side + root.home-gap) + (home.drag-index == i ? -6px : 0px);
                            width: home.side;
                            height: home.side;
                            selected: root.home-cursor == slot && !root.arranging;
                            arranging: root.arranging;
                            lifted: root.arranging && home.drag-index == i;
                            drop-target: root.arranging && home.drop-index == i && home.drag-index != -1 && home.drag-index != i;
                            logo: root.category-logo(slot);
                            glyph: root.category-glyph(slot);
                            name: root.category-short(slot);
                            clicked => {
                                root.home-cursor = slot;
                                root.open-category(root.categories[slot].id);
                            }
                            pressed(px, py) => {
                                home.drag-index = i;
                                home.drop-index = i;
                                home.dragged = false;
                                home.press-x = px;
                                home.press-y = py;
                            }
                            long-pressed(px, py) => {
                                root.arranging = true;
                                home.drag-index = i;
                                home.drop-index = i;
                                home.dragged = false;
                                home.press-x = px;
                                home.press-y = py;
                            }
                            dragged(px, py) => {
                                if (home.drag-index != i) {
                                    return;
                                }
                                if (px < home.press-x - 6px || px > home.press-x + 6px || py < home.press-y - 6px || py > home.press-y + 6px) {
                                    home.dragged = true;
                                }
                                let hit = root.grid-slot(self.x + px, self.y + py, home.origin-x, 0px, home.side, home.side, root.home-gap, root.home-span, root.home-order.length);
                                if (hit >= 0) {
                                    home.drop-index = hit;
                                }
                            }
                            released => {
                                if (home.drag-index == i && home.dragged && home.drop-index >= 0 && home.drop-index != i) {
                                    root.home-reordered(i, home.drop-index);
                                }
                                home.drag-index = -1;
                                home.drop-index = -1;
                                home.dragged = false;
                            }
                        }
                    }
                    if root.detail != "": Text {
                        x: root.home-pad;
                        y: 48px;
                        width: max(root.pane-w - 2 * root.home-pad, 40px);
                        text: root.detail;
                        wrap: word-wrap;
                        color: #e7c7c7;
                    }
                }

                if root.category == "" && !root.settings-open && !root.calculator-open && !root.mcp-open && root.full-mode: Flickable {
                    x: 0px; y: 0px;
                    width: 100%;
                    height: parent.height;
                    content-width: self.width;
                    content-height: max(self.height, 550px);
                    Text {
                        x: 28px; y: 26px;
                        text: UiLanguage.tr("Explore the compendium", "探索巨商圖鑑");
                        font-size: 27px; font-weight: 600; color: DesktopTheme.text;
                    }
                    Text {
                        x: 28px; y: 66px; width: parent.width - 56px;
                        text: UiLanguage.tr("Monsters, equipment and the paths that connect them.", "從怪物、裝備到任務，找到下一步需要的資料。");
                        font-size: 13px; color: DesktopTheme.secondary; overflow: elide;
                    }
                    Rectangle {
                        x: 28px; y: 116px;
