                                            hit: mon;
                                            english: UiLanguage.primary == "en"; no-image-label: root.no-image-label;
                                            selected: root.detail-key == mon.key; expanded: root.detail-key == mon.key; portrait: !root.battle-view;
                                            clicked => {
                                                root.toggle-detail(mon.key, i); keys.focus();
                                            }
                                            favourite-clicked => { root.toggle-favourite(mon.key); }
                                            open-drop(key) => { if (key != "") { root.open-hit(key); } }
