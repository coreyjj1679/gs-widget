        }
    }

        if root.settings-open && !root.collapsed: Rectangle {
            x: 0px;
            y: 42px;
            width: parent.width;
            height: parent.height - 42px - root.foot;
            background: #141210;
            WinButton {
                x: 14px;
                y: 14px;
                glyph: "←";
                clicked => { root.close-settings(); }
            }
            Text {
                x: 52px;
                y: 16px;
                text: root.lang == "en-zh" ? "Settings" : "設定";
                font-size: 16px;
                font-weight: 600;
                color: #f3efe8;
            }
            Rectangle {
                x: 16px;
                y: 52px;
                width: parent.width - 32px;
                height: 32px;
                border-radius: 8px;
                clip: true;
                background: #141210;
                border-width: 1px;
                border-color: #3a342c;
                HorizontalLayout {
                    spacing: 1px;
                    PatchTab {
                        label: root.lang == "en-zh" ? "Look" : "外觀";
                        active: root.settings-tab == 0;
                        clicked => { root.settings-tab = 0; }
                    }
                    PatchTab {
                        label: root.lang == "en-zh" ? "Bar" : "浮動列";
                        active: root.settings-tab == 1;
                        clicked => { root.settings-tab = 1; }
                    }
                    PatchTab {
                        label: root.lang == "en-zh" ? "Aliases" : "別名";
                        active: root.settings-tab == 2;
                        clicked => {
                            root.settings-tab = 2;
                            root.alias-refresh();
                        }
                    }
                    PatchTab {
                        label: root.lang == "en-zh" ? "Keys" : "快捷鍵";
                        active: root.settings-tab == 3;
                        clicked => { root.settings-tab = 3; }
                    }
                }
            }
            if root.settings-tab == 1: VerticalLayout {
                x: 16px;
                y: 96px;
                width: parent.width - 32px;
                height: parent.height - 96px;
                spacing: 8px;
                alignment: start;
                Text {
                    text: root.lang == "en-zh" ? "Direction" : "方向";
                    font-size: 12px;
                    color: #a3988c;
                }
                HorizontalLayout {
                    spacing: 8px;
                    LangChip {
                        label: root.lang == "en-zh" ? "Row" : "橫向";
                        active: !root.dock-vertical;
                        clicked => {
                            if (root.dock-vertical) {
                                root.dock-vertical = false;
                                root.publish-dock();
                            }
                        }
                    }
                    LangChip {
                        label: root.lang == "en-zh" ? "Column" : "直向";
                        active: root.dock-vertical;
                        clicked => {
                            if (!root.dock-vertical) {
                                root.dock-vertical = true;
                                root.publish-dock();
                            }
                        }
                    }
                }
                Text {
                    text: root.lang == "en-zh" ? "Drag the middle of a row. Arrows work too." : "拖中間換順序，也可以用上下箭頭。";
                    font-size: 12px;
                    color: #8a8076;
                    wrap: word-wrap;
                }
                order-list := Rectangle {
                    height: root.dock-draft.length * 56px;
                    property <int> from-row: -1;
                    property <int> over-row: -1;
                    property <length> grab: 0px;
                    property <length> nudge: 0px;
                    for slot[i] in root.dock-draft: DockSortRow {
                        x: order-list.from-row == i ? 10px : 0px;
                        y: order-list.from-row == i ? max(0px, i * 56px + order-list.nudge) : i * 56px;
                        width: order-list.from-row == i ? parent.width - 10px : parent.width;
                        horizontal-stretch: 1;
                        label: root.category-short(slot);
                        logo: root.category-logo(slot);
                        glyph: root.category-glyph(slot);
                        badge: root.dock-on(slot) ? ("F" + root.visible-index(slot)) : "–";
                        on: root.dock-on(slot);
                        lifted: order-list.from-row == i;
                        marked: order-list.over-row == i && order-list.from-row != i;
                        toggled => { root.toggle-dock(slot); }
                        can-up: i > 0 && (root.dock-on(slot) || !root.dock-on(root.dock-draft[i - 1]));
                        can-down: i + 1 < root.dock-draft.length && (!root.dock-on(slot) || root.dock-on(root.dock-draft[i + 1]));
                        up => { root.dock-moved(i, i - 1); }
                        down => { root.dock-moved(i, i + 1); }
                        grip-pressed(py) => {
                            order-list.from-row = i;
                            order-list.over-row = i;
                            order-list.grab = py;
                            order-list.nudge = 0px;
                        }
                        grip-moved(py) => {
                            order-list.nudge = py - order-list.grab;
                            let row = round((i * 56px + order-list.nudge) / 56px - 0.5);
                            if (row < 0) {
                                order-list.over-row = 0;
                            } else if (row >= root.dock-draft.length) {
                                order-list.over-row = root.dock-draft.length - 1;
                            } else {
                                order-list.over-row = row;
                            }
                        }
                        grip-released => {
                            if (order-list.from-row >= 0 && order-list.over-row >= 0 && order-list.from-row != order-list.over-row) {
                                root.dock-moved(order-list.from-row, order-list.over-row);
                            }
                            order-list.from-row = -1;
                            order-list.over-row = -1;
                            order-list.nudge = 0px;
                        }
                    }
                }
            }
            settings-sheet := Flickable {
                y: 96px;
                width: 100%;
                height: parent.height - 96px;
                visible: root.settings-tab != 1;
                content-width: self.width;
                content-height: panel.preferred-height;
                panel := VerticalLayout {
                width: parent.width;
                padding: 16px;
                padding-bottom: 24px;
                spacing: 16px;
                alignment: start;
                if root.settings-tab == 0: HorizontalLayout {
                    alignment: space-between;
                    Text {
                        text: root.lang == "en-zh" ? "Opacity" : "透明度";
                        font-size: 11px;
                        color: #a3988c;
                        vertical-alignment: center;
                    }
                    Text {
                        text: root.opacity-percent + "%";
                        font-size: 12px;
                        font-weight: 600;
                        color: #d4b483;
                        vertical-alignment: center;
                    }
                }
                if root.settings-tab == 0: OpacitySlider {
                    value: root.window-opacity;
                    edited(value) => {
                        root.window-opacity = value;
                        root.opacity-changed(value);
                    }
                }
                if root.settings-tab == 0: Text {
                    text: root.lang == "en-zh" ? "Name order" : "名稱順序";
                    font-size: 11px;
                    color: #a3988c;
                }
                if root.settings-tab == 0: HorizontalLayout {
                    spacing: 6px;
                    LangChip {
                        label: root.lang == "en-zh" ? "Chinese first" : "中文在前";
                        active: root.lang != "en-zh";
                        clicked => { root.choose-lang("zh-en"); }
                    }
                    LangChip {
                        label: root.lang == "en-zh" ? "English first" : "英文在前";
                        active: root.lang == "en-zh";
                        clicked => { root.choose-lang("en-zh"); }
                    }
                }
                if root.settings-tab == 0: Text {
                    text: root.lang == "en-zh" ? "Icon size" : "圖示大小";
                    font-size: 11px;
                    color: #a3988c;
                }
                if root.settings-tab == 0: Text {
                    text: root.lang == "en-zh" ? "Set pieces" : "套裝部件";
                    font-size: 11px;
                    color: #a3988c;
                }
                if root.settings-tab == 0: HorizontalLayout {
                    spacing: 6px;
                    LangChip {
                        label: root.lang == "en-zh" ? "Timed and event" : "期限與活動";
                        active: root.show-set-extra;
                        clicked => {
                            root.show-set-extra = !root.show-set-extra;
                            root.show-set-extra-changed(root.show-set-extra);
                        }
                    }
                }
                if root.settings-tab == 0: Text {
                    text: root.lang == "en-zh" ? "Off hides timed and event copies." : "關閉時不顯示期限和活動版。";
                    font-size: 11px;
                    color: #6f675e;
                    wrap: word-wrap;
                }
                if root.settings-tab == 0: HorizontalLayout {
                    spacing: 6px;
                    LangChip {
                        label: root.lang == "en-zh" ? "Small" : "小";
                        active: root.icon-size == 0;
                        clicked => {
                            root.icon-size = 0;
                            root.icon-size-set(0);
                        }
                    }
                    LangChip {
                        label: root.lang == "en-zh" ? "Medium" : "中";
                        active: root.icon-size == 1;
                        clicked => {
                            root.icon-size = 1;
                            root.icon-size-set(1);
                        }
                    }
                    LangChip {
                        label: root.lang == "en-zh" ? "Large" : "大";
                        active: root.icon-size == 2;
                        clicked => {
                            root.icon-size = 2;
                            root.icon-size-set(2);
                        }
                    }
                }
                if root.settings-tab == 2: Text {
                    text: root.lang == "en-zh" ? "Search aliases" : "搜尋別名";
                    font-size: 11px;
                    color: #a3988c;
                }
                if root.settings-tab == 2: Text {
                    text: root.lang == "en-zh" ? "One line per alias. Edit a row to search and add items." : "一行一個別名。點該列的編輯，再用右邊搜尋加入道具。";
                    font-size: 11px;
                    color: #6f675e;
                    wrap: word-wrap;
                }
                if root.settings-tab == 2: VerticalLayout {
                    spacing: 6px;
                    for row[i] in root.alias-rows: AliasCard {
                        name: row.name;
                        codes: row.codes;
                        detail: row.detail;
                        count: row.count;
                        editing: root.alias-edit == i;
                        edit-label: root.lang == "en-zh" ? "Edit" : "編輯";
                        row-mark: "" + i;
                        icons: root.alias-icons;
                        find-hint: root.lang == "en-zh" ? "Search item" : "搜尋道具";
                        save-label: root.lang == "en-zh" ? "Save" : "儲存";
                        delete-label: root.lang == "en-zh" ? "Delete" : "刪除";
                        suggesting: root.alias-edit == i && root.alias-target == i && root.alias-hits.length > 0;
                        hits: root.alias-hits;
                        pick: root.alias-pick;
                        name-edited(text) => { root.alias-name(i, text); }
                        codes-edited(text) => { root.alias-codes(i, text); }
                        remove => { root.alias-remove(i); }
                        begin-edit => { root.alias-edit = i; }
                        done => {
                            root.alias-edit = -1;
                            root.alias-hits = [];
                            root.alias-target = -1;
                        }
                        save => {
                            root.alias-name(i, self.name-draft);
                            root.alias-finish(i);
                            root.alias-save();
                            root.alias-edit = -1;
                            root.alias-hits = [];
                            root.alias-target = -1;
                        }
                        find-edited(text) => { root.alias-query(i, text); }
                        find-accepted => { root.alias-finish(i); }
                        toggle-hit(index) => { root.alias-toggle(index); }
                        drop-code(key) => { root.alias-drop(i, key); }
                    }
                }
                if root.settings-tab == 2 && root.alias-rows.length == 0 && root.alias-edit < 0: Text {
                    text: root.lang == "en-zh" ? "No aliases yet." : "還沒有別名。";
                    font-size: 12px;
                    color: #8a8076;
                }
                if root.settings-tab == 2: HorizontalLayout {
                    spacing: 8px;
                    LangChip {
                        label: root.lang == "en-zh" ? "Add" : "新增";
                        active: false;
                        clicked => { root.alias-add(); }
                    }
                }
                if root.settings-tab == 3: KeyLine {
                    keys: "F1–F9";
                    action: root.lang == "en-zh" ? "Open that bar item" : "開啟浮動列對應項目";
                }
                if root.settings-tab == 3: KeyLine {
                    keys: "Ctrl+-";
                    action: root.lang == "en-zh" ? "Shrink to the bar. Press again to open the window" : "把介面收成浮動列，再按一次展開";
                }
                if root.settings-tab == 3: KeyLine {
                    keys: "Ctrl+F";
                    action: root.lang == "en-zh" ? "Search" : "搜尋";
                }
                if root.settings-tab == 3: KeyLine {
                    keys: "Esc";
                    action: root.lang == "en-zh" ? "Back, or close search and settings" : "返回，或關閉搜尋和設定";
                }
                if root.settings-tab == 3: KeyLine {
                    keys: "Backspace";
                    action: root.lang == "en-zh" ? "Back" : "返回";
                }
                if root.settings-tab == 3: KeyLine {
                    keys: "Home";
                    action: root.lang == "en-zh" ? "Go to the home page" : "回到主目錄";
                }
                if root.settings-tab == 3: KeyLine {
                    keys: "↑  ↓";
                    action: root.lang == "en-zh" ? "Move in the list. On a set, move between Item, Set, and Total" : "移動清單；套裝資料是在道具、套裝、合計之間";
                }
                if root.settings-tab == 3: KeyLine {
                    keys: "←  →";
                    action: root.lang == "en-zh" ? "Home grid, bar, scroll a set, or the previous and next quest" : "主目錄、浮動列、套裝資料捲動，或任務的上一個和下一個";
                }
                if root.settings-tab == 3: KeyLine {
                    keys: "Enter";
                    action: root.lang == "en-zh" ? "Open. Expand a related heading, or save a monster" : "開啟；相關分類是展開或收合，怪物是收藏";
                }
                if root.settings-tab == 3: KeyLine {
                    keys: "Space";
                    action: root.lang == "en-zh" ? "Open. Expand a heading or a set section" : "開啟；相關分類和套裝分類是展開或收合";
                }
                if root.settings-tab == 3: KeyLine {
                    keys: "Tab";
                    action: root.lang == "en-zh" ? "Switch the filter, or the settings tabs" : "切換本頁篩選，或設定頁的分頁";
                }
                if root.settings-tab == 3: KeyLine {
                    keys: "Ctrl+C";
                    action: root.lang == "en-zh" ? "Copy an update note" : "複製更新內文";
                }
                if root.settings-tab == 3: Text {
                    text: root.lang == "en-zh" ? "While this window is open, F1–F9 open the bar." : "視窗開著時，F1–F9 用來開浮動列。";
                    font-size: 11px;
                    color: #8a8076;
                    wrap: word-wrap;
                }
                }
            }
        }
    }
}
