            background: DesktopTheme.inset;
            if !root.full-mode: WinButton {
                x: 14px;
                y: 14px;
                glyph: "←";
                clicked => { root.close-settings(); }
            }
            if !root.full-mode: Text {
                x: 52px;
                y: 16px;
                text: root.lang == "en-zh" ? "Settings" : "設定";
                font-size: 16px;
                font-weight: 600;
                color: DesktopTheme.text;
            }
            if root.full-mode: Text {
                x: 24px;
                y: 16px;
                text: root.lang == "en-zh" ? "Settings" : "設定";
                font-size: 18px;
                font-weight: 600;
                color: DesktopTheme.text;
            }
            Rectangle {
                x: 16px;
                y: 52px;
                width: min(parent.width - 32px, root.full-mode ? 640px : 300px);
                height: 32px;
                border-radius: 8px;
                clip: true;
                background: DesktopTheme.inset;
                border-width: 1px;
                border-color: DesktopTheme.border;
                HorizontalLayout {
                    spacing: 1px;
                    PatchTab {
                        label: root.lang == "en-zh" ? "Look" : "外觀";
                        active: root.settings-tab == 0;
                        clicked => { root.settings-tab = 0; }
                    }
                    PatchTab {
                        label: root.lang == "en-zh" ? "Bar" : "浮動列";
                        active: root.settings-tab == 1;
                        clicked => { root.settings-tab = 1; }
                    }
                    PatchTab {
                        label: root.lang == "en-zh" ? "Aliases" : "別名";
                        active: root.settings-tab == 2;
                        clicked => {
                            root.settings-tab = 2;
                            root.alias-refresh();
                        }
                    }
                    PatchTab {
                        label: root.lang == "en-zh" ? "Keys" : "快捷鍵";
                        active: root.settings-tab == 3;
                        clicked => { root.settings-tab = 3; }
                    }
                }
            }
            if root.settings-tab == 1: VerticalLayout {
                x: 16px;
