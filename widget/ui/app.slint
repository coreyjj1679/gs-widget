                            for row[i] in root.hits: favourite-slot := Rectangle {
                                y: i * 56px; width: parent.width; height: 54px;
                                if root.cursor == i || (favourite-slot.y + favourite-slot.height >= -home-favourites.content-y - 112px && favourite-slot.y <= -home-favourites.content-y + home-favourites.height + 112px): HitRow {
                                    x: 0px; y: 0px; width: parent.width; height: 54px;
                                    hit: row;
                                    keyboard-focused: keys.has-focus && self.selected;
                                    focus-changed(focused) => { if (focused) { RecordInfo.text = ""; root.cursor = i; } }
                                    selected: root.cursor == i;
