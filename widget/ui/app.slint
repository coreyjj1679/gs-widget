export struct ChangelogItem {
    text-en: string,
    text-zh: string,
}

export struct ChangelogSection {
    heading-en: string,
    heading-zh: string,
    entries: [ChangelogItem],
}

export struct ChangelogRelease {
    version: string,
    date: string,
    sections: [ChangelogSection],
}

component ChangelogHistory inherits Rectangle {
    in property <[ChangelogRelease]> releases;
    in property <string> installed-version;
    in property <bool> english;
    height: history.preferred-height;

    history := VerticalLayout {
        width: parent.width;
        spacing: 20px;
        alignment: start;
        Rectangle { height: 1px; background: DesktopTheme.border; }
        VerticalLayout {
            spacing: 6px;
            Text {
                text: UiLanguage.tr("Changelog", "更新日誌");
                font-size: 18px;
                font-weight: 600;
                color: DesktopTheme.text;
            }
            Text {
                width: root.width;
                height: self.preferred-height;
                text: UiLanguage.tr("Release history included with this app. Available offline.", "此版本附帶的更新紀錄，離線也能閱讀。");
                wrap: word-wrap;
                font-size: 12px;
                color: DesktopTheme.secondary;
            }
        }
        if root.releases.length == 0: Text {
            width: root.width;
            height: self.preferred-height;
            text: UiLanguage.tr("No release notes are included with this version.", "此版本尚未附帶更新日誌。");
            wrap: word-wrap;
            font-size: 13px;
            color: DesktopTheme.secondary;
        }
        for release in root.releases: VerticalLayout {
            spacing: 14px;
            VerticalLayout {
                spacing: 5px;
                HorizontalLayout {
                    spacing: 12px;
                    alignment: start;
                    Text {
                        text: "v" + release.version;
                        font-size: 15px;
                        font-weight: 600;
                        color: DesktopTheme.accent;
                    }
                    if release.version == root.installed-version: Text {
                        text: UiLanguage.tr("Installed", "目前版本");
                        font-size: 12px;
                        color: DesktopTheme.secondary;
                        vertical-alignment: center;
                    }
                }
                Text {
                    text: release.date;
                    font-size: 12px;
                    color: DesktopTheme.secondary;
                }
            }
            for section in release.sections: VerticalLayout {
                spacing: 7px;
                Text {
                    width: root.width;
                    height: self.preferred-height;
                    text: UiLanguage.tr(section.heading-en, section.heading-zh);
                    font-size: 13px;
                    font-weight: 600;
                    color: DesktopTheme.text;
                    wrap: word-wrap;
                }
                for entry in section.entries: Rectangle {
                    width: root.width;
                    // Measure after applying the available width so wrapped
                    // lines contribute to the enclosing scroll content height.
                    height: entry-text.preferred-height;
                    Rectangle {
                        x: 0px;
                        y: 7px;
                        width: 3px;
                        height: 3px;
                        border-radius: 2px;
                        background: DesktopTheme.secondary;
                    }
                    entry-text := Text {
                        x: 12px;
                        width: parent.width - self.x;
                        height: self.preferred-height;
                        text: UiLanguage.primary == "zh" ? entry.text-zh : entry.text-en;
                        font-size: 13px;
                        color: DesktopTheme.text;
                        wrap: word-wrap;
                    }
                }
            }
        }
    }
}

