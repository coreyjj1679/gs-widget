                        clear => { root.clear-monster-filters(); }
                        pick(kind) => { root.filter-element = kind; root.apply-filter(true); }
                        pick-scope(all-monsters) => { root.filter-global = all-monsters; root.apply-filter(true); }
                        edit-min(text) => { root.filter-ela-min = text; root.apply-filter(false); }
                        edit-max(text) => { root.filter-ela-max = text; root.apply-filter(false); }
                        edit-hit-min(text) => { root.filter-hit-min = text; root.apply-filter(false); }
                        edit-hit-max(text) => { root.filter-hit-max = text; root.apply-filter(false); }
                        edit-magic-min(text) => { root.filter-magic-min = text; root.apply-filter(false); }
                        edit-magic-max(text) => { root.filter-magic-max = text; root.apply-filter(false); }
                        pick-sort(key) => { root.monster-sort-key = key; root.apply-filter(true); }
                        toggle-sort-direction => { root.monster-sort-desc = !root.monster-sort-desc; root.apply-filter(true); }
                        edit-drop(text) => { root.edit-monster-drop(text); }
                        request-drops(text) => { root.suggest-drops(text); }
                        select-drop(key, title) => { root.select-monster-drop(key, title); }
                        clear-drop => { root.clear-monster-drop(); }
                    }
