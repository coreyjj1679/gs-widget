                        height: root.quest-chain-h;
                        content-width: self.width;
                        content-height: max(root.chain-next.length * 44px, 1px);
                        content-y: root.next-focus < 1 ? 0px : -min(root.next-focus * 44px, max(root.chain-next.length * 44px - self.height, 0px));
                        for row[i] in root.chain-next: ChainButton {
                            y: i * 44px;
                            width: next-scroll.width;
                            end: true;
                            picked: root.next-focus == i;
