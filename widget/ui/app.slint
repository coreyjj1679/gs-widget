                                x: 0px; y: 0px; width: parent.width;
                                selected: root.cursor == i;
                                hit: row;
                                keyboard-focused: keys.has-focus && self.selected;
                                focus-changed(focused) => { if (focused) { RecordInfo.text = ""; root.cursor = i; } }
                                no-image-label: root.no-image-label;
                                clicked => {
                                    root.cursor = i;
                                    if (row.key != "") {
                                        root.open-hit(row.key);
                                    }
                                }
                            }
                        }
                    }
                    if root.viewing != "" && !root.viewing-hero && !root.record-sheet && !root.quest-sheet && root.category != "patch" && root.links.length > 0 && (!root.monster-sheet || (root.drops-open && !root.full-mode)) && !root.related-open: drops := Flickable {
                        x: root.monster-sheet ? root.side-gap : 0px;
                        y: root.monster-sheet ? root.drops-list-y : (root.viewing-hero ? 124px : 240px);
                        width: root.monster-sheet ? max(parent.width - 2 * root.side-gap, 40px) : max(root.pane-w - 2 * root.page-pad, 40px);
                        height: root.monster-sheet ? root.drops-list-h : (root.viewing-hero ? max(root.height - foot - 136px, 180px) : max(root.height - foot - 310px, 120px));
                        content-width: self.width;
                        content-height: max(root.links.length * 36px, 1px);
                        content-y <=> root.drop-offset;
                        for row[i] in root.links: drop-slot := Rectangle {
                            x: 0px;
                            y: i * 36px;
                            width: drops.width;
                            height: 36px;
                            if root.cursor == i || (drop-slot.y + drop-slot.height >= -drops.content-y - 72px && drop-slot.y <= -drops.content-y + drops.height + 72px): HitRow {
                                x: 0px; y: 0px; width: parent.width;
                                compact: true;
                                selected: root.cursor == i;
