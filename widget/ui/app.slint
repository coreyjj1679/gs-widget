component MonsterCard inherits Rectangle {
    in property <Hit> hit;
    in property <bool> selected: false;
    in property <string> no-image-label: "沒有圖片";
    in property <bool> english: false;
    in property <bool> portrait: false;
    callback clicked();
    callback favourite-clicked();
    height: 214px;
    border-radius: 10px;
    border-width: 1px;
    border-color: selected ? DesktopTheme.accent : DesktopTheme.border;
    background: selected ? DesktopTheme.selected : (area.has-hover ? DesktopTheme.hover : DesktopTheme.surface-alt);
    area := TouchArea {
        width: parent.width - 40px;
        height: 100%;
        clicked => { root.clicked(); }
        mouse-cursor: pointer;
        HorizontalLayout {
            width: 100%;
            height: 100%;
            padding-left: 8px;
            padding-right: 4px;
            spacing: 8px;
                Rectangle {
                    width: root.hit.has-battle ? 128px : 88px;
                    height: 100%;
                    HorizontalLayout {
                        width: 100%;
                        height: 100%;
                        alignment: center;
                        spacing: 6px;
                        cross-axis-alignment: center;
                        if root.hit.has-icon && (!root.hit.has-battle || root.portrait): Image {
                            source: root.hit.icon;
                            width: 72px;
                            height: 72px;
                            image-fit: contain;
                        }
                        if root.hit.no-image && !root.hit.has-battle && !root.portrait: NoImage {
                            side: 72px;
                            label: root.no-image-label;
                        }
                        if root.hit.has-battle && !root.portrait: Image {
                            source: root.hit.battle;
                            width: 108px;
                            height: 156px;
                            image-fit: contain;
                        }
                    }
                }
            VerticalLayout {
                horizontal-stretch: 1;
                min-width: 0px;
                padding-top: 8px;
                padding-bottom: 8px;
                spacing: 1px;
                Text {
                    text: root.hit.title;
                    font-size: 15px;
                    font-weight: 600;
                    color: DesktopTheme.text;
                    overflow: elide;
                }
                if root.hit.subtitle != "": Text {
                    text: root.hit.subtitle;
                    font-size: 12px;
                    color: DesktopTheme.accent;
                    overflow: elide;
                }
                MetaRow { label: root.english ? "Type" : "種類"; value: root.hit.stat-kind; }
                MetaRow { label: root.english ? "Element" : "屬性"; value: root.hit.stat-element; }
                MetaRow { label: root.english ? "HP" : "體力"; value: root.hit.stat-hp; }
                MetaRow { label: root.english ? "MP" : "魔力"; value: root.hit.stat-mp; }
                MetaRow { label: root.english ? "Hit" : "打擊"; value: root.hit.stat-hit; }
                MetaRow { label: root.english ? "Magic" : "魔法"; value: root.hit.stat-magic; }
                MetaRow { label: root.english ? "Attack" : "攻擊"; value: root.hit.stat-atk; }
                MetaRow { label: root.english ? "Exp" : "經驗"; value: root.hit.stat-exp; }
                if root.hit.drop-total > 0: HorizontalLayout {
                    height: 26px;
                    spacing: 4px;
                    alignment: start;
                    Text {
                        width: 52px;
                        text: root.english ? "Drops" : "掉落";
                        font-size: 11px;
                        color: DesktopTheme.muted;
                        vertical-alignment: center;
                    }
                    if root.hit.drop1.width > 0: Image { source: root.hit.drop1; width: 22px; height: 22px; image-fit: contain; }
                    if root.hit.drop2.width > 0: Image { source: root.hit.drop2; width: 22px; height: 22px; image-fit: contain; }
                    if root.hit.drop3.width > 0: Image { source: root.hit.drop3; width: 22px; height: 22px; image-fit: contain; }
                    if root.hit.drop4.width > 0: Image { source: root.hit.drop4; width: 22px; height: 22px; image-fit: contain; }
                    if root.hit.drop-total > 4: Text {
                        text: "+" + (root.hit.drop-total - 4);
                        font-size: 11px;
                        color: DesktopTheme.accent;
                        vertical-alignment: center;
                    }
                }
            }
        }
    }
    StarMark {
        x: parent.width - 36px;
        y: 8px;
        filled: root.hit.favourite;
        clicked => { root.favourite-clicked(); }
    }
}

component BoardFilter inherits Rectangle {
    in property <bool> open;
    in property <bool> menu-open: true;
    in property <bool> active;
    in property <int> element: -1;
    in property <string> ela-min;
    in property <string> ela-max;
    in property <string> drop;
    in property <bool> english;
    callback toggle();
    callback toggle-menu();
    in property <bool> battle-view: true;
    in property <bool> pictures: false;
    callback pick-view(bool);
    callback clear();
    callback pick(int);
    callback edit-min(string);
    callback edit-max(string);
    callback edit-drop(string);
    height: open ? 112px : 32px;
    VerticalLayout {
        width: 100%;
        spacing: 6px;
        HorizontalLayout {
            height: 28px;
            spacing: 6px;
            alignment: start;
            FilterChip {
                horizontal-stretch: 0;
                width: 64px;
                label: root.english ? "Menu" : "目錄";
                active: root.menu-open;
                clicked => { root.toggle-menu(); }
            }
            if root.pictures: FilterChip {
                horizontal-stretch: 0;
                width: 64px;
                label: root.english ? "Filter" : "篩選";
                active: root.open || root.active;
                clicked => { root.toggle(); }
            }
            if root.pictures && root.active: FilterChip {
                horizontal-stretch: 0;
                width: 64px;
                label: root.english ? "Clear" : "清除";
                active: false;
                clicked => { root.clear(); }
            }
            Rectangle { horizontal-stretch: 1; }
            if root.pictures: FilterChip {
                horizontal-stretch: 0;
                width: 52px;
                label: root.english ? "Face" : "頭像";
                active: !root.battle-view;
                clicked => { root.pick-view(false); }
            }
            if root.pictures: FilterChip {
                horizontal-stretch: 0;
                width: 52px;
                label: root.english ? "Battle" : "戰鬥";
                active: root.battle-view;
                clicked => { root.pick-view(true); }
            }
        }
        if root.open: HorizontalLayout {
            height: 28px;
            spacing: 6px;
            alignment: start;
            FilterChip { horizontal-stretch: 0; width: 52px; label: root.english ? "All" : "全部"; active: root.element < 0; clicked => { root.pick(-1); } }
            FilterChip { horizontal-stretch: 0; width: 44px; label: root.english ? "None" : "無"; active: root.element == 0; clicked => { root.pick(0); } }
            FilterChip { horizontal-stretch: 0; width: 44px; label: root.english ? "Fire" : "火"; active: root.element == 1; clicked => { root.pick(1); } }
            FilterChip { horizontal-stretch: 0; width: 52px; label: root.english ? "Water" : "水"; active: root.element == 2; clicked => { root.pick(2); } }
            FilterChip { horizontal-stretch: 0; width: 52px; label: root.english ? "Wind" : "風"; active: root.element == 3; clicked => { root.pick(3); } }
            FilterChip { horizontal-stretch: 0; width: 72px; label: root.english ? "Thunder" : "雷"; active: root.element == 4; clicked => { root.pick(4); } }
            FilterChip { horizontal-stretch: 0; width: 56px; label: root.english ? "Earth" : "地"; active: root.element == 5; clicked => { root.pick(5); } }
        }
        if root.open: HorizontalLayout {
            height: 28px;
            spacing: 8px;
            alignment: start;
            LineEdit {
                width: 180px;
                placeholder-text: root.english ? "Drop" : "掉落物";
                text: root.drop;
                edited => { root.edit-drop(self.text); }
            }
            Text {
                text: root.english ? "ELA" : "屬性值";
                color: DesktopTheme.secondary;
                vertical-alignment: center;
            }
            LineEdit {
                width: 72px;
                placeholder-text: root.english ? "Min" : "最小";
                text: root.ela-min;
                edited => { root.edit-min(self.text); }
            }
            Text {
                text: "–";
                color: DesktopTheme.secondary;
                vertical-alignment: center;
            }
            LineEdit {
                width: 72px;
                placeholder-text: root.english ? "Max" : "最大";
                text: root.ela-max;
                edited => { root.edit-max(self.text); }
            }
        }
    }
}

