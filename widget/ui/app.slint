                                    padding-left: 10px;
                                    padding-right: 10px;
                                    padding-top: 6px;
                                    padding-bottom: 10px;
                                    spacing: 8px;
                                    Rectangle {
                                        height: 1px;
                                        background: DesktopTheme.selected;
                                    }
                                    Text {
                                        width: parent.width;
                                        text: root.sheet-note;
                                        wrap: word-wrap;
                                        font-size: 13px;
                                        color: DesktopTheme.text;
                                    }
                                }
                            }
                        }
                    }
                    if root.quest-sheet && !root.full-mode && root.show-icon: Image {
                        x: root.side-gap;
                        y: root.quest-title-y;
                        width: 48px;
                        height: 48px;
                        source: root.item-icon;
