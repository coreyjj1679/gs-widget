                        border-radius: 10px;
                        border-width: 1px;
                        border-color: #3a342c;
                        quest-form := Flickable {
                            width: 100%;
                            height: 100%;
                            content-width: self.width;
                            content-height: max(task-stack.preferred-height, 1px);
                            content-y <=> root.task-offset;
                            task-stack := VerticalLayout {
                                width: parent.width;
