                height: parent.height - 112px;
                spacing: 8px;
                alignment: start;
                Text {
                    text: root.lang == "en-zh" ? "Direction" : "方向";
                    font-size: 12px;
                    color: DesktopTheme.secondary;
                }
                if root.full-mode: ChoiceBar {
                    first: root.lang == "en-zh" ? "Row" : "橫向";
                    second: root.lang == "en-zh" ? "Column" : "直向";
                    picked: root.dock-vertical ? 1 : 0;
                    pick(index) => {
                        root.dock-vertical = index == 1;
                        root.publish-dock();
                    }
                }
                if !root.full-mode: HorizontalLayout {
                    spacing: 8px;
                    LangChip {
                        label: root.lang == "en-zh" ? "Row" : "橫向";
                        active: !root.dock-vertical;
                        clicked => {
                            if (root.dock-vertical) {
                                root.dock-vertical = false;
                                root.publish-dock();
                            }
                        }
                    }
                    LangChip {
                        label: root.lang == "en-zh" ? "Column" : "直向";
                        active: root.dock-vertical;
