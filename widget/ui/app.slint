}

component ChoiceBar inherits Rectangle {
    in property <string> first;
    in property <string> second;
    in property <string> third: "";
    in property <int> picked: 0;
    callback pick(int);
    height: 32px;
    border-radius: 6px;
    clip: true;
    background: DesktopTheme.sidebar;
    border-width: 1px;
    border-color: DesktopTheme.border;
    HorizontalLayout {
        spacing: 1px;
        Rectangle {
            horizontal-stretch: 1;
            background: root.picked == 0 ? DesktopTheme.raised : transparent;
            Text {
                width: 100%;
                height: 100%;
                text: root.first;
                font-size: 13px;
                color: root.picked == 0 ? DesktopTheme.text : DesktopTheme.secondary;
                horizontal-alignment: center;
                vertical-alignment: center;
            }
            TouchArea {
                width: 100%;
                height: 100%;
                clicked => { root.pick(0); }
                mouse-cursor: pointer;
            }
        }
        Rectangle {
            horizontal-stretch: 1;
            background: root.picked == 1 ? DesktopTheme.raised : transparent;
            Text {
                width: 100%;
                height: 100%;
                text: root.second;
                font-size: 13px;
                color: root.picked == 1 ? DesktopTheme.text : DesktopTheme.secondary;
                horizontal-alignment: center;
                vertical-alignment: center;
            }
            TouchArea {
                width: 100%;
                height: 100%;
                clicked => { root.pick(1); }
                mouse-cursor: pointer;
            }
        }
        if root.third != "": Rectangle {
            horizontal-stretch: 1;
            background: root.picked == 2 ? DesktopTheme.raised : transparent;
            Text {
                width: 100%;
                height: 100%;
                text: root.third;
                font-size: 13px;
                color: root.picked == 2 ? DesktopTheme.text : DesktopTheme.secondary;
                horizontal-alignment: center;
                vertical-alignment: center;
            }
            TouchArea {
                width: 100%;
                height: 100%;
                clicked => { root.pick(2); }
                mouse-cursor: pointer;
            }
        }
    }
}

component FormBlock inherits Rectangle {
    in property <string> title;
    background: DesktopTheme.surface;
    border-radius: 8px;
    border-width: 1px;
    border-color: DesktopTheme.border;
    VerticalLayout {
        padding: 14px;
        spacing: 10px;
        if root.title != "": Text {
            text: root.title;
            font-size: 13px;
            font-weight: 600;
            color: DesktopTheme.accent;
        }
        @children
    }
}

