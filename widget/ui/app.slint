                        if root.monster-cards && !root.full-mode: ModeButton {
                            gallery: true;
                            active: root.monster-gallery;
                            clicked => { root.choose-gallery(true); }
                        }
                        if root.monster-cards && !root.full-mode: FilterChip {
                            horizontal-stretch: 0;
                            width: 52px;
                            label: UiLanguage.tr("Face", "頭像");
                            active: !root.battle-view;
                            clicked => { root.choose-battle(false); }
                        }
                        if root.monster-cards && !root.full-mode: FilterChip {
                            horizontal-stretch: 0;
                            width: 52px;
                            label: UiLanguage.tr("Battle", "戰鬥");
                            active: root.battle-view;
                            clicked => { root.choose-battle(true); }
                        }
                    }
                    if root.viewing-monster && root.show-battle && root.show-icon: HorizontalLayout {
                        x: root.pane-w - 176px;
                        y: 8px;
                        width: 112px;
                        height: 28px;
                        spacing: 4px;
                        FilterChip {
                            horizontal-stretch: 0;
                            width: 52px;
                            label: UiLanguage.tr("Face", "頭像");
                            active: !root.battle-view;
                            clicked => { root.choose-battle(false); }
                        }
                        FilterChip {
                            horizontal-stretch: 0;
                            width: 52px;
                            label: UiLanguage.tr("Battle", "戰鬥");
                            active: root.battle-view;
                            clicked => { root.choose-battle(true); }
                        }
                    }
                    if root.viewing-monster: StarMark {
                        x: root.pane-w - 48px;
                        y: 10px;
                        filled: root.viewing-favourite;
                        clicked => { root.toggle-favourite(root.viewing); }
                    }
                    if root.set-browser: Rectangle {
                        x: root.page-pad;
                        y: 48px;
                        width: max(root.pane-w - 2 * root.page-pad, 40px);
                        height: 32px;
                        border-radius: 8px;
                        clip: true;
                        background: DesktopTheme.inset;
                        border-width: 1px;
                        border-color: DesktopTheme.border;
                        HorizontalLayout {
                            spacing: 1px;
                            PatchTab {
                                label: UiLanguage.tr("Normal", "一般");
                                active: root.area == "" || root.area == "0";
                                clicked => { root.area = "0"; root.cursor = 0; root.list-offset = 0px; root.query-changed(root.category, root.query); }
                            }
                            PatchTab {
                                label: UiLanguage.tr("Exclusive", "專用");
                                active: root.area == "2";
                                clicked => { root.area = "2"; root.cursor = 0; root.list-offset = 0px; root.query-changed(root.category, root.query); }
                            }
                            PatchTab {
                                label: UiLanguage.tr("Charm", "咒術");
                                active: root.area == "1";
                                clicked => { root.area = "1"; root.cursor = 0; root.list-offset = 0px; root.query-changed(root.category, root.query); }
                            }
                        }
                    }
                    if root.viewing == "" && (root.search-open || root.full-mode): search := LineEdit {
                        x: root.full-mode ? root.pane-w - (root.category == "monster" ? 348px : 304px) : root.page-pad;
                        y: root.full-mode ? 10px : root.search-y;
                        width: (root.full-mode ? 280px : max(root.pane-w - 2 * root.page-pad, 40px)) - (root.query != "" ? 64px : 0px);
                        placeholder-text: root.category == "enchant" ? UiLanguage.tr("Scroll, equipment or material…", "搜尋秘訣、裝備或材料…") : root.full-mode && root.category == "quest" ? (UiLanguage.tr("Quest, required item or reward…", "搜尋任務、任務品或獎勵…")) : root.full-mode ? (UiLanguage.tr("Search this category…", "搜尋此分類…")) : (UiLanguage.tr("Search", "搜尋"));
                        text <=> root.query;
                        property <bool> focus-requested: root.search-open;
                        changed focus-requested => { if (self.focus-requested) { self.focus(); } }
                        init => { if (root.search-open) { self.focus(); } }
                        edited => {
                            root.cursor = 0;
                            root.query-changed(root.category, self.text);
                        }
                        accepted => {
                            root.search-open = false;
                            keys.focus();
                        }
                        key-pressed(event) => {
                            if (event.modifiers.control && event.text == "-") {
                                root.shrink-window();
                                return accept;
                            }
                            if (event.modifiers.control && (event.text == "f" || event.text == "F")) {
                                root.close-search();
                                return accept;
                            }
                            if (event.text == Key.Home && !event.modifiers.shift) {
                                self.set-selection-offsets(0, 0);
                                return accept;
                            }
                            if (event.text == Key.Escape || (event.text == Key.Backspace && root.query == "")) {
                                root.close-search();
                                return accept;
                            }
                            if (event.text == Key.UpArrow || event.text == Key.DownArrow || event.text == Key.Tab || event.text == Key.Backtab) {
                                return root.handle-key(event);
                            }
                            return reject;
                        }
                    }
                    if root.viewing == "" && (root.search-open || root.full-mode) && root.query != "": Button {
                        x: root.full-mode ? root.pane-w - (root.category == "monster" ? 126px : 82px) : root.pane-w - root.page-pad - 58px;
                        y: root.full-mode ? 10px : root.search-y;
                        width: 58px; height: 32px;
                        text: UiLanguage.tr("Clear", "清除");
                        clicked => { root.close-search(); }
                    }
