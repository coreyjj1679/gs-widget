                        }
                        DesktopEntry {
                            y: 126px; width: parent.width; height: 88px;
                            title: UiLanguage.tr("Equipment & items", "裝備與道具");
                            description: UiLanguage.tr("Stats, sets and ways to obtain them", "查看能力、套裝效果與取得方式");
                            logo: root.category-logo(1);
                            clicked => { root.open-category("item"); keys.focus(); }
