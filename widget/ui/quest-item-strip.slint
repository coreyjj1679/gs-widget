import { DesktopTheme } from "desktop.slint";

export struct QuestItemChip {
    key: string,
    title: string,
    alternate: string,
    quantity: string,
    icon: image,
    has-icon: bool,
}

export component QuestSummaryBadge inherits Rectangle {
    in property <string> label;
    in property <string> hint;
    in property <float> zoom: 1;
    out property <bool> hint-active: hint != "" && tap.has-hover;
    callback activated();
    width: 44px * zoom; height: 18px * zoom;
    border-radius: 3px * zoom; background: DesktopTheme.control;
    accessible-role: text;
    accessible-label: hint == "" ? label : label + ". " + hint;
    Text {
        x: 0px; y: 0px; width: 100%; height: 100%;
        text: root.label; font-size: 10.5px * root.zoom;
        color: DesktopTheme.secondary; horizontal-alignment: center; vertical-alignment: center;
    }
    tap := TouchArea {
        x: 0px; y: 0px; width: 100%; height: 100%; mouse-cursor: pointer;
        clicked => { root.activated(); }
    }
    if root.hint != "": Tooltip {
        VerticalLayout {
            Rectangle {
                width: 320px; height: tip.preferred-height + 20px;
                background: DesktopTheme.raised; border-radius: 5px;
                border-width: 1px; border-color: DesktopTheme.border;
                tip := Text {
                    x: 12px; y: 10px; width: parent.width - 24px; height: self.preferred-height;
                    text: root.hint; font-size: 12px; color: DesktopTheme.text; wrap: word-wrap;
                }
            }
        }
    }
}

component ItemPreviewRow inherits Rectangle {
    in property <QuestItemChip> item;
    in property <bool> english;
    height: max(28px, names.preferred-height);
    if root.item.has-icon: Image {
        x: 0px; y: 1px; width: 26px; height: 26px;
        source: root.item.icon; image-fit: contain;
    }
    if !root.item.has-icon: Path {
        x: 4px; y: 5px; width: 18px; height: 18px;
        viewbox-width: 24; viewbox-height: 24;
        commands: root.item.key.starts-with("monster:")
            ? "M5 8L4 3L9 6H15L20 3L19 8V15L15 20H9L5 15ZM8 11H10M14 11H16M9 16H15"
            : "M4 7L12 3L20 7V17L12 21L4 17ZM4 7L12 11L20 7M12 11V21";
        fill: transparent; stroke: DesktopTheme.secondary; stroke-width: 1.5px;
    }
    names := VerticalLayout {
        x: 34px; y: 0px; width: parent.width - 34px; height: self.preferred-height;
        spacing: 3px; alignment: start;
        Text {
            width: names.width; height: self.preferred-height;
            text: root.item.title; font-size: 13px; font-weight: 600;
            color: DesktopTheme.text; wrap: word-wrap;
        }
        if root.item.alternate != "": Text {
            width: names.width; height: self.preferred-height;
            text: root.item.alternate; font-size: 12px;
            color: DesktopTheme.secondary; wrap: word-wrap;
        }
        Text {
            width: names.width; height: self.preferred-height;
            text: (root.english ? "Quantity: " : "數量：") + (root.item.quantity != "" ? root.item.quantity : (root.english ? "Not recorded" : "未提供"))
                + (root.item.has-icon ? "" : (root.english ? " · Icon unavailable" : " · 暫無圖示"));
            font-size: 12px; color: DesktopTheme.secondary; wrap: word-wrap;
        }
    }
}

// Native Tooltip places this outside a clipped list or graph viewport. Typography
// stays at its normal size even when the graph is zoomed out.
export component QuestItemTooltip inherits Rectangle {
    in property <[QuestItemChip]> items;
    in property <bool> english;
    in property <length> scroll-offset;
    property <length> previous-scroll-offset: 0px;
    property <bool> two-columns: items.length > 4;
    property <int> first-column-count: two-columns ? ceil(items.length / 2) : items.length;
    width: two-columns ? 600px : 340px;
    height: items.length > 1 ? 320px : min(body.preferred-height + 28px, 260px);
    background: DesktopTheme.raised; border-radius: 5px;
    border-width: 1px; border-color: DesktopTheme.border;
    clip: true;
    changed scroll-offset => {
        scroll.content-y = clamp(scroll.content-y + root.scroll-offset - root.previous-scroll-offset,
            min(0px, scroll.height - scroll.content-height), 0px);
        root.previous-scroll-offset = root.scroll-offset;
    }
    scroll := Flickable {
        x: 12px; y: 12px; width: parent.width - 24px;
        height: parent.height - 24px - (root.items.length > 1 ? 22px : 0px);
        content-width: self.width; content-height: max(self.height, body.preferred-height);
        content-y: 0px;
        body := HorizontalLayout {
            x: 0px; y: 0px; width: scroll.width; height: self.preferred-height;
            spacing: 18px; alignment: start;
            VerticalLayout {
                width: root.two-columns ? (scroll.width - 18px) / 2 : scroll.width;
                height: self.preferred-height; spacing: 12px; alignment: start;
                for i in root.first-column-count: ItemPreviewRow {
                    item: root.items[i]; english: root.english;
                }
            }
            if root.two-columns: VerticalLayout {
                width: (scroll.width - 18px) / 2;
                height: self.preferred-height; spacing: 12px; alignment: start;
                for i in (root.items.length - root.first-column-count): ItemPreviewRow {
                    item: root.items[i + root.first-column-count]; english: root.english;
                }
            }
        }
    }
    if root.items.length > 1: Text {
        x: 12px; y: parent.height - 25px; width: parent.width - 24px; height: 17px;
        text: root.english ? "Scroll over +N to see all entries" : "在 +N 上捲動可查看所有項目";
        font-size: 11px; color: DesktopTheme.secondary;
    }
}

component ItemChip inherits Rectangle {
    in property <QuestItemChip> item;
    in property <bool> english;
    in property <float> zoom: 1;
    callback activated();
    callback hover-changed(bool);
    width: 68px * zoom; height: 26px * zoom;
    border-radius: 3px;
    background: tap.has-hover ? DesktopTheme.hover-strong : transparent;
    accessible-role: text;
    accessible-label: item.title + (item.alternate == "" ? "" : ". " + item.alternate);
    accessible-description: (english ? "Quantity " : "數量 ") + (item.quantity != "" ? item.quantity : (english ? "not recorded" : "未提供"));
    if root.item.has-icon: Image {
        x: 0px; y: 0px; width: 26px * root.zoom; height: 26px * root.zoom;
        source: root.item.icon; image-fit: contain;
    }
    if !root.item.has-icon: Path {
        x: 4px * root.zoom; y: 4px * root.zoom; width: 18px * root.zoom; height: 18px * root.zoom;
        viewbox-width: 24; viewbox-height: 24;
        commands: root.item.key.starts-with("monster:")
            ? "M5 8L4 3L9 6H15L20 3L19 8V15L15 20H9L5 15ZM8 11H10M14 11H16M9 16H15"
            : "M4 7L12 3L20 7V17L12 21L4 17ZM4 7L12 11L20 7M12 11V21";
        fill: transparent; stroke: DesktopTheme.secondary; stroke-width: 1.5px * root.zoom;
    }
    Text {
        x: 28px * root.zoom; y: 0px; width: parent.width - self.x; height: parent.height;
        text: root.item.quantity == "" ? "—" : "×" + root.item.quantity; font-size: 11px * root.zoom;
        color: DesktopTheme.text; vertical-alignment: center; overflow: elide;
    }
    tap := TouchArea {
        x: 0px; y: 0px; width: 100%; height: 100%;
        mouse-cursor: pointer;
        changed has-hover => { root.hover-changed(self.has-hover); }
        clicked => { root.activated(); }
    }
    Tooltip {
        // A layout makes the native popup measure the custom content's size.
        VerticalLayout { spacing: 0px; QuestItemTooltip { items: [root.item]; english: root.english; } }
    }
}

export component QuestItemStrip inherits Rectangle {
    in property <[QuestItemChip]> items;
    in property <bool> english;
    in property <float> zoom: 1;
    out property <bool> item-active: hovered-index >= 0;
    callback activated();
    property <int> hovered-index: -1;
    property <length> tooltip-scroll: 0px;
    property <length> slot-width: 72px * zoom;
    property <int> visible-count: items.length * slot-width <= root.width
        ? items.length : max(0, floor((root.width - 30px * zoom) / slot-width));
    height: 26px * zoom;
    changed items => { root.hovered-index = -1; root.tooltip-scroll = 0px; }
    for item[i] in root.items: ItemChip {
        visible: i < root.visible-count;
        x: i * root.slot-width; y: 0px;
        item: item; zoom: root.zoom; english: root.english;
        activated => { root.activated(); }
        hover-changed(hovered) => {
            if (hovered) { root.hovered-index = i; }
            else if (root.hovered-index == i) { root.hovered-index = -1; }
        }
    }
    if root.visible-count < root.items.length: Rectangle {
        x: root.visible-count * root.slot-width; y: 0px;
        width: 30px * root.zoom; height: 26px * root.zoom;
        border-radius: 3px;
        background: overflow-tap.has-hover ? DesktopTheme.hover-strong : transparent;
        accessible-role: text;
        accessible-label: root.english ? (root.items.length - root.visible-count) + " more entries" : "另有 " + (root.items.length - root.visible-count) + " 項";
        Text {
            x: 0px; y: 0px; width: 100%; height: 100%;
            text: "+" + (root.items.length - root.visible-count); font-size: 11px * root.zoom;
            color: DesktopTheme.secondary; horizontal-alignment: center; vertical-alignment: center;
        }
        overflow-tap := TouchArea {
            x: 0px; y: 0px; width: 100%; height: 100%;
            mouse-cursor: pointer;
            changed has-hover => {
                if (self.has-hover) { root.hovered-index = root.items.length; root.tooltip-scroll = 0px; }
                else if (root.hovered-index == root.items.length) { root.hovered-index = -1; }
            }
            clicked => { root.activated(); }
            scroll-event(event) => { root.tooltip-scroll += event.delta-y; return accept; }
        }
        Tooltip {
            VerticalLayout { spacing: 0px; QuestItemTooltip { items: root.items; english: root.english; scroll-offset: root.tooltip-scroll; } }
        }
    }
}
