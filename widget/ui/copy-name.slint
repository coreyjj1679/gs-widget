import { UiLanguage } from "language.slint";
import { DesktopTheme } from "desktop.slint";

export global NameCopy {
    in-out property <string> lang: "zh-en";
    in-out property <string> notice;
    callback copy(string, bool);
}

// Use a record key, never the displayed label, as the clipboard source.
// Labels elsewhere may include quantities, IDs or both languages.
export component CopyName inherits Text {
    in property <string> record-key;
    in property <bool> alternate: false;
    property <bool> copy-enabled: root.record-key != "" && root.text != "";
    property <bool> english: UiLanguage.primary == "en";
    property <string> hint: UiLanguage.tr("Click to copy this name", "左鍵複製此名稱");
    forward-focus: name-focus;
    accessible-role: button;
    accessible-label: (UiLanguage.tr("Copy name: ", "複製名稱：")) + root.text;
    accessible-enabled: root.copy-enabled;
    accessible-action-default => { if (root.copy-enabled) { NameCopy.copy(root.record-key, root.alternate); } }

    name-focus := FocusScope {
        enabled: root.copy-enabled;
        key-pressed(event) => {
            if (event.text == Key.Return || event.text == Key.Space || (event.modifiers.control && (event.text == "c" || event.text == "C"))) {
                NameCopy.copy(root.record-key, root.alternate);
                return accept;
            }
            return reject;
        }
    }
    tap := TouchArea {
        enabled: root.copy-enabled;
        mouse-cursor: root.copy-enabled ? pointer : default;
        clicked => { name-focus.focus(); NameCopy.copy(root.record-key, root.alternate); }
    }
    if root.copy-enabled: Tooltip {
        Rectangle {
            width: min(360px, tip.preferred-width + 24px);
            height: tip.preferred-height + 20px;
            background: DesktopTheme.raised;
            border-radius: 5px;
            border-width: 1px; border-color: DesktopTheme.border;
            tip := Text {
                x: 12px; y: 10px; width: parent.width - 24px; height: self.preferred-height;
                text: root.text + "\n" + root.hint;
                font-size: 13px; color: DesktopTheme.text; wrap: word-wrap;
            }
        }
    }
}
