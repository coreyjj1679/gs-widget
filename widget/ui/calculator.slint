import { UiLanguage } from "language.slint";
import { Button, ComboBox, LineEdit, ScrollView, TextEdit } from "std-widgets.slint";
import { DesktopTheme, DesktopIcon } from "desktop.slint";
import { CalculatorLibrary, CalcSaved } from "calculator-library.slint";
import { CalcIconButton, CalcFolderChoices } from "calculator-controls.slint";
export { CalcSaved }

export struct CalcChoice {
    id: string,
    title: string,
    subtitle: string,
    icon: image,
    has-icon: bool,
}

export struct CalcNestedOption {
    id: string,
    title: string,
    subtitle: string,
}

export struct CalcMaterial {
    key: string,
    title: string,
    subtitle: string,
    quantity: string,
    price: string,
    draft: string,
    has-draft: bool,
    subtotal: string,
    missing-price: bool,
    depth: int,
    nested: bool,
    can-expand: bool,
    can-reuse: bool,
    detail: string,
    icon: image,
    has-icon: bool,
}

component CalcArt inherits Rectangle {
    in property <image> icon;
    in property <bool> has-icon;
    width: 32px;
    height: 32px;
    if root.has-icon: Image {
        width: 100%; height: 100%;
        source: root.icon;
        image-fit: contain;
    }
    if !root.has-icon: DesktopIcon {
        x: 7px; y: 7px; width: 18px; height: 18px;
        path: "M4 7 L12 3 L20 7 L20 17 L12 21 L4 17 Z M4 7 L12 11 L20 7 M12 11 L12 21";
        ink: DesktopTheme.muted;
    }
}

// Keep live totals current without reformatting the text under the caret.
// Invalid drafts remain visible; only accepted values are formatted on blur.
export component CalcNumber inherits LineEdit {
    in property <string> value;
    in property <string> label;
    in property <int> reset-token;
    in property <string> draft;
    in property <bool> has-draft;
    property <bool> dirty: false;
    callback commit(string) -> bool;
    text: root.value;
    height: 34px;
    min-width: 0px;
    horizontal-alignment: right;
    accessible-label: root.label;
    init => { root.restore-draft(); }
    changed draft => { root.restore-draft(); }
    changed has-draft => { root.restore-draft(); }
    function restore-draft() {
        if (root.has-draft) {
            root.dirty = true;
            if (self.text != root.draft) { self.text = root.draft; }
        }
    }
    changed value => {
        if (!root.dirty) { self.text = root.value; }
    }
    changed reset-token => {
        root.dirty = false;
        self.text = root.value;
    }
    edited => { root.dirty = true; root.commit(self.text); }
    accepted => {
        if (root.dirty && root.commit(self.text)) {
            root.dirty = false;
            self.text = root.value;
        }
    }
    changed has-focus => {
        if (!self.has-focus && root.dirty && root.commit(self.text)) {
            root.dirty = false;
            self.text = root.value;
        }
    }
}

component CalcItemPicker inherits Rectangle {
    in property <bool> english;
    in property <string> selected-name;
    in property <image> selected-icon;
    in property <bool> selected-has-icon;
    in property <[CalcChoice]> options;
    property <string> query;
    property <int> option-index: 0;
    property <length> scroll-y: 0px;
    property <bool> open: popup.is-open;
    callback request(string);
    callback choose(string);
    height: 42px;
    min-width: 0px;
    border-radius: 5px;
    border-width: 1px;
    border-color: root.open || focus.has-focus ? DesktopTheme.accent : DesktopTheme.border;
    background: DesktopTheme.control;
    forward-focus: focus;
    accessible-role: combobox;
    accessible-label: (UiLanguage.tr("Craftable item: ", "合成道具：")) + (root.selected-name == "" ? (UiLanguage.tr("Choose an item", "尚未選擇")) : root.selected-name);
    accessible-value: root.selected-name;
    accessible-expandable: true;
    accessible-expanded: root.open;
    accessible-action-default => { root.show-options(); }
    accessible-action-expand => { root.show-options(); }
    function show-options() {
        root.query = "";
        root.option-index = 0;
        root.request("");
        root.scroll-y = 0px;
        popup.show();
    }
    // Run on the surviving picker: closing a popup destroys its row context.
    function close-options() { popup.close(); focus.focus(); }
    function choose-option(id: string) {
        root.close-options();
        root.choose(id);
    }
    function choose-current() {
        if (root.option-index >= 0 && root.option-index < root.options.length) {
            root.choose-option(root.options[root.option-index].id);
        }
    }
    if root.selected-name != "": CalcArt {
        x: 7px; y: 5px;
        icon: root.selected-icon; has-icon: root.selected-has-icon;
    }
    Text {
        x: root.selected-name == "" ? 12px : 47px;
        y: 0px; width: parent.width - self.x - 36px; height: 100%;
        text: root.selected-name == "" ? (UiLanguage.tr("Search for a craftable item…", "搜尋可合成的道具…")) : root.selected-name;
        color: root.selected-name == "" ? DesktopTheme.secondary : DesktopTheme.text;
        font-size: 14px;
        overflow: elide; vertical-alignment: center;
    }
    DesktopIcon {
        x: parent.width - 27px; y: 13px; width: 16px; height: 16px;
        path: root.open ? "M6 15 L12 9 L18 15" : "M6 9 L12 15 L18 9";
        ink: DesktopTheme.secondary;
    }
    TouchArea {
        mouse-cursor: pointer;
        clicked => { focus.focus(); root.show-options(); }
    }
    focus := FocusScope {
        focus-on-click: false;
        key-pressed(event) => {
            if (event.text == Key.Return || event.text == Key.Space || event.text == Key.DownArrow) {
                root.show-options(); return accept;
            }
            return reject;
        }
    }
    popup := PopupWindow {
        x: 0px; y: root.height + 4px;
        width: root.width;
        height: 64px + min(max(root.options.length, 1), 6) * 52px;
        close-policy: close-on-click-outside;
        forward-focus: query-input;
        Rectangle {
            background: DesktopTheme.surface-alt;
            border-radius: 6px;
            border-width: 1px;
            border-color: DesktopTheme.border;
            query-input := LineEdit {
                x: 8px; y: 8px; width: parent.width - 16px; height: 34px;
                text <=> root.query;
                placeholder-text: UiLanguage.tr("Type an item name…", "輸入道具名稱…");
                accessible-label: UiLanguage.tr("Search craftable items", "搜尋可合成道具");
                edited => {
                    root.option-index = 0;
                    options-scroll.content-y = 0px;
                    root.request(self.text);
                }
                accepted => { root.choose-current(); }
                key-pressed(event) => {
                    if (event.text == Key.Escape) { root.close-options(); return accept; }
                    if (event.text == Key.DownArrow || event.text == Key.UpArrow) {
                        root.option-index = max(0, min(root.options.length - 1, root.option-index + (event.text == Key.DownArrow ? 1 : -1)));
                        if (root.option-index * 52px < -options-scroll.content-y) {
                            options-scroll.content-y = -root.option-index * 52px;
                        } else if ((root.option-index + 1) * 52px > -options-scroll.content-y + options-scroll.height) {
                            options-scroll.content-y = options-scroll.height - (root.option-index + 1) * 52px;
                        }
                        return accept;
                    }
                    return reject;
                }
            }
            options-scroll := Flickable {
                x: 4px; y: 50px; width: parent.width - 8px; height: parent.height - 58px;
                content-width: self.width;
                content-y <=> root.scroll-y;
                content-height: max(root.options.length * 52px, self.height);
                for option[i] in root.options: Rectangle {
                    x: 0px; y: i * 52px; width: parent.width; height: 52px;
                    border-radius: 4px;
                    background: touch.has-hover || root.option-index == i ? DesktopTheme.hover-strong : transparent;
                    accessible-role: button;
                    accessible-label: option.title;
                    accessible-description: option.subtitle;
                    accessible-item-selectable: true;
                    accessible-item-selected: root.option-index == i;
                    accessible-action-default => { root.choose-option(option.id); }
                    CalcArt { x: 8px; y: 10px; icon: option.icon; has-icon: option.has-icon; }
                    Text {
                        x: 50px; y: 6px; width: parent.width - 60px; height: 22px;
                        text: option.title; font-size: 14px; color: DesktopTheme.text;
                        overflow: elide; vertical-alignment: center;
                    }
                    Text {
                        x: 50px; y: 29px; width: parent.width - 60px; height: 17px;
                        text: option.subtitle; font-size: 12px; color: DesktopTheme.secondary;
                        overflow: elide; vertical-alignment: center;
                    }
                    touch := TouchArea {
                        mouse-cursor: pointer;
                        clicked => { root.choose-option(option.id); }
                    }
                }
                if root.options.length == 0: Text {
                    x: 12px; width: parent.width - 24px; height: 52px;
                    text: UiLanguage.tr("No craftable items found. Try another name.", "找不到可合成道具，請換個名稱搜尋。");
                    font-size: 13px; color: DesktopTheme.secondary;
                    vertical-alignment: center; wrap: word-wrap;
                }
            }
        }
    }
}

// Quiet text actions keep the material name and numeric columns prominent.
component CalcAction inherits Rectangle {
    in property <string> label;
    in property <string> description;
    in property <bool> enabled: true;
    callback activated();
    height: 28px;
    min-width: 0px;
    preferred-width: action-label.preferred-width + 16px;
    horizontal-stretch: 0;
    border-radius: 4px;
    border-width: 1px;
    border-color: action-focus.has-focus ? DesktopTheme.accent : transparent;
    background: action-touch.has-hover && root.enabled ? DesktopTheme.hover : transparent;
    opacity: root.enabled ? 1 : 0.5;
    forward-focus: action-focus;
    accessible-role: button;
    accessible-label: root.label;
    accessible-description: root.description;
    accessible-enabled: root.enabled;
    accessible-action-default => { if (root.enabled) { root.activated(); } }
    public function focus-action() { action-focus.focus(); }
    action-label := Text {
        x: 8px; width: parent.width - 16px; height: 100%;
        text: root.label;
        font-size: 12px; color: DesktopTheme.accent;
        vertical-alignment: center;
    }
    action-touch := TouchArea {
        enabled: root.enabled;
        mouse-cursor: pointer;
        clicked => { action-focus.focus(); root.activated(); }
    }
    action-focus := FocusScope {
        enabled: root.enabled;
        focus-on-click: false;
        key-pressed(event) => {
            if (event.text == Key.Return || event.text == Key.Space) {
                root.activated(); return accept;
            }
            return reject;
        }
    }
}

// A bounded choice list for explicit recipe / saved-sheet selection, without
// borrowing the main item search or silently picking the first available recipe.
component CalcNestedPicker inherits Rectangle {
    in property <bool> english;
    in property <string> label;
    in property <string> description;
    in property <string> heading;
    in property <bool> enabled: true;
    in property <[CalcNestedOption]> options;
    in property <bool> auto-single: false;
    in property <length> popup-width: 420px;
    callback request();
    callback choose(string);
    property <int> option-index: 0;
    property <length> scroll-y: 0px;
    height: 28px;
    min-width: 0px;
    preferred-width: action.preferred-width;
    horizontal-stretch: 0;
    forward-focus: action;
    function close-options() { popup.close(); action.focus-action(); }
    function choose-option(id: string) {
        root.close-options();
        root.choose(id);
    }
    function choose-current() {
        if (root.option-index >= 0 && root.option-index < root.options.length) {
            root.choose-option(root.options[root.option-index].id);
        }
    }
    action := CalcAction {
        width: 100%;
        label: root.label;
        description: root.description;
        enabled: root.enabled;
        activated => {
            root.option-index = 0;
            root.request();
            if (root.auto-single && root.options.length == 1) {
                root.choose(root.options[0].id);
            } else {
                root.scroll-y = 0px;
                popup.show();
            }
        }
    }
    popup := PopupWindow {
        x: 0px; y: root.height + 4px;
        width: max(280px, min(460px, root.popup-width));
        height: 48px + min(max(root.options.length, 1), 4) * 84px;
        close-policy: close-on-click-outside;
        forward-focus: popup-focus;
        Rectangle {
            background: DesktopTheme.surface-alt;
            border-radius: 6px;
            border-width: 1px;
            border-color: DesktopTheme.border;
            Text {
                x: 12px; y: 10px; width: parent.width - 24px; height: 24px;
                text: root.heading;
                font-size: 13px; font-weight: 600; color: DesktopTheme.text;
                vertical-alignment: center;
            }
            choices := Flickable {
                x: 4px; y: 40px; width: parent.width - 8px; height: parent.height - 48px;
                content-width: self.width;
                content-y <=> root.scroll-y;
                content-height: max(root.options.length * 84px, self.height);
                for option[i] in root.options: Rectangle {
                    x: 0px; y: i * 84px; width: parent.width; height: 84px;
                    border-radius: 4px;
                    background: option-touch.has-hover || root.option-index == i ? DesktopTheme.hover-strong : transparent;
                    accessible-role: button;
                    accessible-label: option.title;
                    accessible-description: option.subtitle;
                    accessible-item-selectable: true;
                    accessible-item-selected: root.option-index == i;
                    accessible-action-default => { root.choose-option(option.id); }
                    Text {
                        x: 10px; y: 7px; width: parent.width - 20px; height: 36px;
                        text: option.title; font-size: 14px; color: DesktopTheme.text;
                        wrap: word-wrap; overflow: elide; vertical-alignment: center;
                    }
                    Text {
                        x: 10px; y: 45px; width: parent.width - 20px; height: 32px;
                        text: option.subtitle; font-size: 12px; color: DesktopTheme.secondary;
                        wrap: word-wrap; overflow: elide;
                    }
                    option-touch := TouchArea {
                        mouse-cursor: pointer;
                        clicked => { root.choose-option(option.id); }
                    }
                }
                if root.options.length == 0: Text {
                    x: 10px; width: parent.width - 20px; height: 84px;
                    text: UiLanguage.tr("No available choices for this material.", "這項材料目前沒有可用的選項。");
                    font-size: 13px; color: DesktopTheme.secondary;
                    wrap: word-wrap; vertical-alignment: center;
                }
            }
            popup-focus := FocusScope {
                focus-on-click: false;
                key-pressed(event) => {
                    if (event.text == Key.Escape) { root.close-options(); return accept; }
                    if (event.text == Key.Return || event.text == Key.Space) { root.choose-current(); return accept; }
                    if (event.text == Key.DownArrow || event.text == Key.UpArrow || event.text == Key.Home || event.text == Key.End) {
                        root.option-index = event.text == Key.Home ? 0 : event.text == Key.End ? root.options.length - 1 : max(0, min(root.options.length - 1, root.option-index + (event.text == Key.DownArrow ? 1 : -1)));
                        if (root.option-index * 84px < -choices.content-y) {
                            choices.content-y = -root.option-index * 84px;
                        } else if ((root.option-index + 1) * 84px > -choices.content-y + choices.height) {
                            choices.content-y = choices.height - (root.option-index + 1) * 84px;
                        }
                        return accept;
                    }
                    return reject;
                }
            }
        }
    }
}

component CalcMaterialActions inherits Rectangle {
    in property <bool> english;
    in property <bool> enabled;
    in property <bool> nested;
    in property <bool> can-expand;
    in property <bool> can-reuse;
    in property <string> material-name;
    in property <[CalcNestedOption]> options;
    in property <length> popup-width;
    callback request(bool);
    callback choose(string);
    callback clear();
    property <bool> stacked: root.width < 225px;
    height: (root.stacked ? (root.can-expand ? 28px : 0px) + (root.can-reuse ? 28px : 0px) : (root.can-expand || root.can-reuse ? 28px : 0px)) + (root.nested ? 28px : 0px);
    if root.can-expand: CalcNestedPicker {
        x: 0px; y: 0px;
        width: root.stacked ? parent.width : min(self.preferred-width, parent.width);
        english: root.english;
        label: root.nested ? (UiLanguage.tr("Change recipe", "更換配方")) : (UiLanguage.tr("Expand recipe", "展開配方"));
        description: root.material-name + (UiLanguage.tr(": calculate from sub-material prices", "：依子材料價格計算"));
        heading: UiLanguage.tr("Choose a recipe", "選擇子材料配方");
        auto-single: true;
        enabled: root.enabled;
        options: root.options; popup-width: root.popup-width;
        request => { root.request(false); }
        choose(id) => { root.choose(id); }
    }
    if root.can-reuse: CalcNestedPicker {
        x: root.stacked || !root.can-expand ? 0px : 116px;
        y: root.stacked && root.can-expand ? 28px : 0px;
        width: root.stacked ? parent.width : min(self.preferred-width, parent.width - self.x);
        english: root.english;
        label: UiLanguage.tr("Reuse saved", "重用收藏");
        description: root.material-name + (UiLanguage.tr(": copy and expand a saved cost sheet", "：複製並展開已收藏的成本表"));
        heading: UiLanguage.tr("Choose a saved sheet", "選擇已收藏的成本表");
        enabled: root.enabled;
        options: root.options; popup-width: root.popup-width;
        request => { root.request(true); }
        choose(id) => { root.choose(id); }
    }
    if root.nested: CalcAction {
        x: 0px; y: parent.height - 28px;
        width: min(self.preferred-width, parent.width);
        label: UiLanguage.tr("Use unit price", "改用單價");
        description: root.material-name + (UiLanguage.tr(": stop using sub-material costs", "：停止使用子材料成本，改為直接輸入單價"));
        enabled: root.enabled;
        activated => { root.clear(); }
    }
}

export component CalculatorPane inherits Rectangle {
    in property <bool> english;
    in property <string> selected-name;
    in property <image> selected-icon;
    in property <bool> selected-has-icon;
    in property <string> selected-meta;
    in property <[CalcChoice]> candidates;
    in property <[string]> recipes;
    in-out property <int> recipe-index;
    in property <string> quantity;
    in property <string> quantity-draft;
    in property <bool> quantity-has-draft;
    in property <[CalcMaterial]> materials;
    in property <[CalcNestedOption]> nested-options;
    in property <bool> has-nested;
    in property <string> material-total;
    in property <string> fee;
    in property <string> total;
    in property <string> unit-total;
    in property <string> status;
    in property <string> notice;
    in property <string> error;
    in property <string> info;
    in property <bool> export-busy;
    in property <bool> complete;
    in property <bool> compact-total;
    in property <bool> share-enabled;
    in property <bool> input-valid: true;
    in property <int> input-revision;
    in-out property <bool> library-open;
    in property <[string]> folders;
    in-out property <int> folder-index;
    in property <[CalcSaved]> saved;
    in property <int> saved-count;
    in property <string> active-saved-name;
    in property <string> save-state;
    in property <string> library-error;
    callback save-sheet(string, int, bool);
    callback select-folder(int);
    callback new-folder(string);
    callback rename-folder(string);
    callback delete-folder();
    callback open-saved(string);
    callback delete-saved(string);
    callback move-saved(string, int);
    callback export-folder();
    callback search-query(string);
    callback select-item(string);
    callback select-recipe(int);
    callback quantity-changed(string) -> bool;
    callback price-changed(string, string) -> bool;
    callback request-nested-options(string, bool);
    callback select-nested(string, string);
    callback clear-nested(string);
    callback export-card();
    callback copy-code();
    callback import-code(string);
    property <bool> saving: false;
    property <string> save-name;
    property <string> save-name-source;
    property <bool> dismiss-library-requested: false;
    property <length> editor-scroll-y: 0px;
    property <bool> importing: false;
    property <string> import-text;
    property <length> cost-width: root.width < 820px ? 114px : 150px;
    property <length> quantity-width: root.width < 820px ? 62px : 84px;
    background: DesktopTheme.canvas;
    forward-focus: pane-focus;
    init => { if (root.visible) { pane-focus.focus(); } }
    changed library-open => {
        if (!root.library-open && root.visible) { pane-focus.focus(); }
    }

    pane-focus := FocusScope {
        width: 100%; height: 100%;
        focus-on-tab-navigation: false;
        focus-on-click: false;
        key-pressed(event) => {
            if (event.text != Key.Escape) { return reject; }
            if (root.library-open) {
                root.dismiss-library-requested = true;
            } else if (root.saving) {
                root.saving = false;
                self.focus();
            } else if (root.importing) {
                root.importing = false;
                self.focus();
            }
            return accept;
        }

    VerticalLayout {
        spacing: 16px;
        HorizontalLayout {
            spacing: 16px;
            VerticalLayout {
                horizontal-stretch: 1;
                spacing: 6px;
                Text {
                    text: root.library-open ? (UiLanguage.tr("My saved sheets", "我的收藏")) : (UiLanguage.tr("Crafting cost", "合成成本"));
                    font-size: 21px; font-weight: 600; color: DesktopTheme.text;
                }
                Text {
                    text: root.library-open ? (UiLanguage.tr("Keep your cost lists in folders and share them together.", "以資料夾整理合成表，整個資料夾一起分享。")) : (UiLanguage.tr("Choose an item and enter material prices to calculate its cost.", "選擇道具，填入材料單價，即可計算合成成本。"));
                    font-size: 13px; color: DesktopTheme.secondary; wrap: word-wrap;
                }
                if !root.library-open && root.save-state != "": Text {
                    text: root.save-state;
                    font-size: 12px; color: DesktopTheme.accent; wrap: word-wrap;
                }
            }
            if !root.library-open: Button {
                text: UiLanguage.tr("Save", "儲存");
                height: 32px; min-width: 64px;
                enabled: root.share-enabled && root.library-error == "" && root.input-valid;
                clicked => {
                    root.saving = !root.saving;
                    root.importing = false;
                    root.editor-scroll-y = 0px;
                    let suggested-name = root.active-saved-name != "" ? root.active-saved-name : root.selected-name;
                    if (root.save-name-source != suggested-name) {
                        root.save-name = suggested-name;
                        root.save-name-source = root.save-name;
                    }
                }
            }
            CalcIconButton {
                label: root.library-open ? (UiLanguage.tr("Continue calculating", "繼續計算")) : (UiLanguage.tr("Saved (", "我的收藏（") + root.saved-count + UiLanguage.tr(")", "）"));
                icon-path: root.library-open ? "M5 3 L19 3 L19 21 L5 21 Z M8 6 L16 6 L16 9 L8 9 Z M8 13 L10 13 M14 13 L16 13 M8 17 L10 17 M14 17 L16 17" : "M12 3 L14.8 8.8 L21.2 9.7 L16.6 14.2 L17.7 20.5 L12 17.5 L6.3 20.5 L7.4 14.2 L2.8 9.7 L9.2 8.8 Z";
                clicked => { root.library-open = !root.library-open; root.saving = false; }
            }
        }
        if root.error != "": Text {
            text: root.error; color: #f0b5ad; font-size: 13px; wrap: word-wrap;
            accessible-role: text;
        }
        if root.export-busy: Text {
            text: UiLanguage.tr("Exporting JPG… You can keep editing while it finishes.", "正在匯出 JPG… 你可以繼續編輯成本清單。");
            color: DesktopTheme.secondary; font-size: 13px; wrap: word-wrap;
            accessible-role: text;
        }
        if root.library-open: CalculatorLibrary {
            vertical-stretch: 1;
            english: root.english;
            folders: root.folders;
            folder-index <=> root.folder-index;
            saved: root.saved;
            library-error: root.library-error;
            error: root.error;
            dismiss-requested <=> root.dismiss-library-requested;
            back => { root.library-open = false; }
            select-folder(index) => { root.select-folder(index); }
            new-folder(name) => { root.new-folder(name); }
            rename-folder(name) => { root.rename-folder(name); }
            delete-folder => { root.delete-folder(); }
            open-saved(id) => { root.open-saved(id); }
            delete-saved(id) => { root.delete-saved(id); }
            move-saved(id, index) => { root.move-saved(id, index); }
            export-folder => { root.export-folder(); }
            import-code(code) => { root.import-code(code); }
        }
        if !root.library-open: VerticalLayout {
            vertical-stretch: 1;
            spacing: 12px;
        if root.library-error != "": Text {
            text: root.library-error; color: #f0b5ad; font-size: 13px; wrap: word-wrap;
        }
        content-scroll := ScrollView {
            content-y <=> root.editor-scroll-y;
            vertical-stretch: 1;
            content-width: self.width;
            content-height: content.preferred-height;
            horizontal-scrollbar-policy: always-off;
            content := VerticalLayout {
                width: content-scroll.width - 12px;
                spacing: 18px;
                if root.saving: Rectangle {
                    height: save-fields.preferred-height + 20px;
                    border-radius: 6px;
                    background: DesktopTheme.surface;
                    save-fields := VerticalLayout {
                        x: 10px; y: 10px; width: parent.width - 20px;
                        spacing: 8px;
                        Text { text: UiLanguage.tr("Saved sheet name", "合成表名稱"); font-size: 12px; color: DesktopTheme.secondary; }
                        LineEdit {
                            text <=> root.save-name;
                            min-width: 0px; height: 32px;
                            accessible-label: UiLanguage.tr("Saved sheet name", "合成表名稱");
                        }
                        Text { text: UiLanguage.tr("Save to folder", "儲存至資料夾"); font-size: 12px; color: DesktopTheme.secondary; }
                        CalcFolderChoices {
                            folders: root.folders;
                            current-index <=> root.folder-index;
                            english: root.english;
                            enabled: root.library-error == "";
                            selected(index) => { root.select-folder(index); }
                        }
                        HorizontalLayout {
                            spacing: 8px;
                            Button {
                                text: root.active-saved-name == "" ? (UiLanguage.tr("Save sheet", "儲存合成表")) : (UiLanguage.tr("Save changes", "儲存變更"));
                                enabled: root.save-name != "" && root.folders.length > 0 && root.library-error == "" && root.input-valid;
                                clicked => {
                                    root.save-sheet(root.save-name, root.folder-index, false);
                                    if (root.error == "") { root.saving = false; }
                                }
                            }
                            if root.active-saved-name != "": Button {
                                text: UiLanguage.tr("Save a copy", "另存一份");
                                enabled: root.save-name != "" && root.folders.length > 0 && root.library-error == "" && root.input-valid;
                                clicked => {
                                    root.save-sheet(root.save-name, root.folder-index, true);
                                    if (root.error == "") { root.saving = false; }
                                }
                            }
                            Button { text: UiLanguage.tr("Cancel", "取消"); clicked => { root.saving = false; } }
                            Rectangle { horizontal-stretch: 1; }
                            Text {
                                text: UiLanguage.tr("Includes quantity and prices", "連同數量與單價儲存");
                                color: DesktopTheme.secondary; font-size: 12px; vertical-alignment: center;
                            }
                        }
                    }
                }
                HorizontalLayout {
                    spacing: 18px;
                    VerticalLayout {
                        horizontal-stretch: 1; min-width: 0px;
                        spacing: 7px;
                        Text {
                            text: UiLanguage.tr("Item to craft", "合成道具");
                            color: DesktopTheme.secondary; font-size: 12px;
                        }
                        CalcItemPicker {
                            english: root.english;
                            selected-name: root.selected-name;
                            selected-icon: root.selected-icon;
                            selected-has-icon: root.selected-has-icon;
                            options: root.candidates;
                            request(query) => { root.search-query(query); }
                            choose(id) => { root.select-item(id); }
                        }
                    }
                    VerticalLayout {
                        width: 110px; spacing: 7px;
                        Text {
                            text: UiLanguage.tr("Output quantity", "製作數量");
                            color: DesktopTheme.secondary; font-size: 12px;
                        }
                        CalcNumber {
                            height: 42px;
                            value: root.quantity;
                            reset-token: root.input-revision;
                            draft: root.quantity-draft;
                            has-draft: root.quantity-has-draft;
                            label: UiLanguage.tr("Quantity to craft", "製作數量");
                            enabled: root.selected-name != "";
                            commit(value) => { return root.quantity-changed(value); }
                        }
                    }
                }
                if root.selected-name != "": VerticalLayout {
                    spacing: 8px;
                    if root.recipes.length > 1: HorizontalLayout {
                        spacing: 12px;
                        Text {
                            text: UiLanguage.tr("Recipe", "合成配方");
                            font-size: 12px; color: DesktopTheme.secondary;
                            vertical-alignment: center;
                        }
                        ComboBox {
                            model: root.recipes;
                            current-index <=> root.recipe-index;
                            min-width: 0px;
                            accessible-label: UiLanguage.tr("Choose recipe", "選擇合成配方");
                            selected(value) => { root.select-recipe(self.current-index); }
                        }
                    }
                    if root.selected-meta != "": Text {
                        text: root.selected-meta;
                        font-size: 12px; color: DesktopTheme.secondary; wrap: word-wrap;
                    }
                }
                if root.selected-name == "": Rectangle {
                    height: 200px;
                    VerticalLayout {
                        padding-top: 48px;
                        padding-bottom: 48px;
                        spacing: 10px;
                        alignment: center;
                        Text {
                            text: UiLanguage.tr("Start with the item you want to craft", "從想合成的道具開始");
                            color: DesktopTheme.text; font-size: 17px; font-weight: 600;
                            horizontal-alignment: center; wrap: word-wrap;
                        }
                        Text {
                            text: UiLanguage.tr("The list includes craftable items only.\nTheir materials and quantities will appear here.", "下拉選單只列出可合成道具。\n選擇後，這裡會列出所需材料與數量。");
                            color: DesktopTheme.secondary; font-size: 13px;
                            horizontal-alignment: center; wrap: word-wrap;
                        }
                    }
                }
                if root.selected-name != "": VerticalLayout {
                    spacing: 0px;
                    HorizontalLayout {
                        height: 30px;
                        spacing: 16px;
                        padding-right: 4px;
                        Text {
                            horizontal-stretch: 1; min-width: 0px;
                            text: UiLanguage.tr("Material", "材料");
                            color: DesktopTheme.secondary; font-size: 12px;
                        }
                        Text {
                            width: root.quantity-width;
                            text: UiLanguage.tr("Quantity", "數量");
                            color: DesktopTheme.secondary; font-size: 12px;
                            horizontal-alignment: right;
                        }
                        Text {
                            width: root.cost-width;
                            text: UiLanguage.tr("Unit price", "單價");
                            color: DesktopTheme.secondary; font-size: 12px;
                            horizontal-alignment: right;
                        }
                        Text {
                            width: root.cost-width;
                            text: UiLanguage.tr("Subtotal", "小計");
                            color: DesktopTheme.secondary; font-size: 12px;
                            horizontal-alignment: right;
                        }
                    }
                    Rectangle { height: 1px; background: DesktopTheme.border; }
                    for material in root.materials: Rectangle {
                        height: max(60px, material-row.preferred-height + 20px);
                        background: material.nested ? DesktopTheme.surface-alt : transparent;
                        // Only the description is indented: numeric columns stay aligned.
                        // A guide joins the child text to its parent without shrinking type.
                        if material.depth > 0: Rectangle {
                            x: min(material.depth, 8) * 16px - 8px;
                            y: 0px; width: 1px; height: parent.height;
                            background: DesktopTheme.border;
                        }
                        if material.depth > 0: Rectangle {
                            x: min(material.depth, 8) * 16px - 8px;
                            y: 26px; width: 8px; height: 1px;
                            background: DesktopTheme.border;
                        }
                        material-row := HorizontalLayout {
                            x: 0px; y: 10px; width: parent.width - 4px;
                            height: self.preferred-height;
                            spacing: 16px;
                            VerticalLayout {
                                horizontal-stretch: 1; min-width: 0px; spacing: 4px;
                                padding-left: min(material.depth, 8) * 16px;
                                HorizontalLayout {
                                    min-width: 0px; spacing: 10px;
                                    CalcArt { icon: material.icon; has-icon: material.has-icon; }
                                    VerticalLayout {
                                        horizontal-stretch: 1; min-width: 0px; spacing: 4px;
                                        Text {
                                            text: material.title;
                                            font-size: 14px; font-weight: material.nested ? 600 : 400;
                                            color: DesktopTheme.text; wrap: word-wrap;
                                        }
                                        if material.subtitle != "": Text {
                                            text: material.subtitle;
                                            font-size: 12px; color: DesktopTheme.secondary;
                                            wrap: word-wrap;
                                        }
                                    }
                                }
                                if material.detail != "": Text {
                                    text: material.detail;
                                    font-size: 12px; color: DesktopTheme.secondary;
                                    wrap: word-wrap;
                                }
                                if material.can-expand || material.can-reuse || material.nested: CalcMaterialActions {
                                    english: root.english;
                                    enabled: root.input-valid;
                                    nested: material.nested;
                                    can-expand: material.can-expand;
                                    can-reuse: material.can-reuse;
                                    material-name: material.title;
                                    options: root.nested-options;
                                    popup-width: root.width - 32px;
                                    request(reuse) => { root.request-nested-options(material.key, reuse); }
                                    choose(id) => { root.select-nested(material.key, id); }
                                    clear => { root.clear-nested(material.key); }
                                }
                            }
                            Text {
                                width: root.quantity-width;
                                text: material.quantity;
                                font-size: 14px; color: DesktopTheme.text;
                                vertical-alignment: top; horizontal-alignment: right;
                                wrap: word-wrap;
                            }
                            if !material.nested: CalcNumber {
                                width: root.cost-width;
                                value: material.price;
                                reset-token: root.input-revision;
                                draft: material.draft;
                                has-draft: material.has-draft;
                                label: material.title + (UiLanguage.tr(" unit price", "單價"));
                                placeholder-text: UiLanguage.tr("Not entered", "未輸入");
                                commit(value) => { return root.price-changed(material.key, value); }
                            }
                            if material.nested: VerticalLayout {
                                width: root.cost-width; spacing: 4px; alignment: start;
                                Text {
                                    text: material.price;
                                    font-size: 14px;
                                    color: material.missing-price ? DesktopTheme.muted : DesktopTheme.text;
                                    horizontal-alignment: right; wrap: word-wrap;
                                    accessible-description: UiLanguage.tr("Calculated from sub-materials", "依子材料計算");
                                }
                                Text {
                                    text: UiLanguage.tr("Calculated", "依子材料計算");
                                    font-size: 12px; color: DesktopTheme.secondary;
                                    horizontal-alignment: right; wrap: word-wrap;
                                }
                            }
                            Text {
                                width: root.cost-width;
                                text: material.subtotal;
                                font-size: 14px;
                                color: material.missing-price ? DesktopTheme.muted : DesktopTheme.text;
                                vertical-alignment: top; horizontal-alignment: right;
                                wrap: word-wrap;
                            }
                        }
                        Rectangle {
                            y: parent.height - 1px; width: 100%; height: 1px;
                            background: DesktopTheme.border;
                        }
                    }
                    if root.materials.length == 0: Text {
                        text: UiLanguage.tr("This recipe has no listed material inputs.", "此配方沒有列出材料。");
                        color: DesktopTheme.secondary; font-size: 13px;
                    }
                }
                if root.has-nested: Text {
                    text: UiLanguage.tr("Sub-materials are included in their parent subtotal; do not add them again.", "子材料已計入上層小計，毋須再次相加。");
                    font-size: 12px; color: DesktopTheme.secondary; wrap: word-wrap;
                }
                if root.notice != "": Text {
                    text: root.notice;
                    font-size: 12px; color: DesktopTheme.secondary; wrap: word-wrap;
                }
                Rectangle { height: 4px; }
            }
        }
        if root.selected-name != "": HorizontalLayout {
            spacing: 24px;
            VerticalLayout {
                horizontal-stretch: 1; min-width: 0px; spacing: 8px;
                if root.status != "": Text {
                    text: root.status;
                    font-size: 13px; color: root.complete ? DesktopTheme.secondary : DesktopTheme.accent;
                    wrap: word-wrap;
                }
                Text {
                    text: UiLanguage.tr("Prices are per material unit.\nLeave blank if unknown; enter 0 for no cost.", "價格以每件材料為單位。\n未知可留空，免費材料請填 0。");
                    font-size: 12px; color: DesktopTheme.secondary; wrap: word-wrap;
                }
            }
            VerticalLayout {
                width: root.width < 820px ? 294px : 340px;
                spacing: 10px;
                HorizontalLayout {
                    Text {
                        horizontal-stretch: 1;
                        text: root.complete ? (UiLanguage.tr("Material cost", "材料成本")) : (UiLanguage.tr("Priced materials", "已填材料成本"));
                        color: DesktopTheme.secondary; font-size: 13px;
                    }
                    Text { text: root.material-total; color: DesktopTheme.text; font-size: 13px; }
                }
                HorizontalLayout {
                    Text {
                        horizontal-stretch: 1;
                        text: root.has-nested ? (UiLanguage.tr("Top-level crafting fee", "主配方合成費")) : (UiLanguage.tr("Crafting fee", "合成費用"));
                        color: DesktopTheme.secondary; font-size: 13px;
                    }
                    Text { text: root.fee; color: DesktopTheme.text; font-size: 13px; }
                }
                Rectangle { height: 1px; background: DesktopTheme.border; }
                HorizontalLayout {
                    Text {
                        horizontal-stretch: 1;
                        text: root.complete ? (UiLanguage.tr("Total cost", "成本合計")) : (UiLanguage.tr("Known cost", "已知成本"));
                        color: DesktopTheme.text; font-size: 15px; font-weight: 600;
                        vertical-alignment: center;
                    }
                    Text {
                        text: root.total; color: DesktopTheme.accent;
                        font-size: root.total.character-count > 17 ? 13px : 20px; font-weight: 600;
                    }
                }
                HorizontalLayout {
                    Text {
                        horizontal-stretch: 1;
                        text: UiLanguage.tr("Cost per item", "每件成本");
                        color: DesktopTheme.secondary; font-size: 12px;
                    }
                    Text { text: root.unit-total; color: DesktopTheme.secondary; font-size: 12px; }
                }
            }
        }
        Rectangle { height: 1px; background: DesktopTheme.border; }
        HorizontalLayout {
            spacing: 10px;
            Button {
                text: root.export-busy ? UiLanguage.tr("Exporting…", "匯出中…") : UiLanguage.tr("Export JPG", "匯出 JPG");
                enabled: root.share-enabled && root.input-valid && !root.export-busy;
                height: 34px;
                clicked => { root.export-card(); }
            }
            Button {
                text: UiLanguage.tr("Copy share code", "複製分享碼");
                enabled: root.share-enabled && root.input-valid;
                height: 34px;
                clicked => { root.copy-code(); }
            }
            Button {
                text: root.importing ? (UiLanguage.tr("Close import", "收起匯入")) : (UiLanguage.tr("Import code", "匯入分享碼"));
                height: 34px;
                clicked => { root.importing = !root.importing; root.saving = false; }
            }
            Rectangle { horizontal-stretch: 1; }
            Text {
                text: UiLanguage.tr("Works offline", "可離線分享");
                color: DesktopTheme.muted; font-size: 12px;
                vertical-alignment: center;
            }
        }
        if root.importing: VerticalLayout {
            spacing: 8px;
            TextEdit {
                height: 72px;
                text <=> root.import-text;
                wrap: word-wrap;
                accessible-label: UiLanguage.tr("Paste a sheet or folder share code", "貼上合成表或資料夾分享碼");
            }
            HorizontalLayout {
                spacing: 12px;
                Text {
                    horizontal-stretch: 1;
                    text: UiLanguage.tr("Import one cost list, or add an entire shared folder to your saved sheets.", "可匯入單份成本清單，或把整個資料夾加入收藏。");
                    color: DesktopTheme.secondary; font-size: 12px; wrap: word-wrap;
                }
                Button {
                    text: UiLanguage.tr("Import", "匯入");
                    height: 32px;
                    enabled: root.import-text != "";
                    clicked => { root.import-code(root.import-text); }
                }
            }
        }
        }
        if root.info != "": Text {
            text: root.info; color: DesktopTheme.accent; font-size: 12px; wrap: word-wrap;
        }
    }
    }
}
